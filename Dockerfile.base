# The shared runtime base for every Node service — the 4 APIs, the 12 workers,
# and the migration runner. Built once per release; each service image is then
# three lines of metadata on top of it.
#
# ---------------------------------------------------------------------------
# Why this exists
# ---------------------------------------------------------------------------
#
# Each service used to carry its own `pnpm install --filter <svc>...`, which
# meant seventeen images each holding a near-identical dependency tree. Nothing
# deduplicated them: a layer is shared only when its parent chain is identical,
# and every one of those installs produced a different layer. The API images
# landed at ~880 MB apiece and a full release generation cost the node ~18 GB.
#
# That is not an abstract inefficiency. The cluster is ONE node with a 110 GB
# ephemeral OS disk, and a rollout necessarily holds TWO generations at once —
# the pods still serving and the pods coming up. On 2026-08-02 that overran the
# disk: the kubelet raised DiskPressure, image extraction failed with "no space
# left on device", and the entire worker fleet sat in ImagePullBackOff while the
# node had six generations cached and could not reclaim the two that were in
# use. The alternative on the table was a managed 256 GB OS disk at roughly
# $38/month, forever, to store the same dependencies seventeen times.
#
# With a shared base the node stores that tree ONCE per release. Every service
# image below resolves to the same layers, so a generation costs what one image
# costs.
#
# ---------------------------------------------------------------------------
# Two decisions worth keeping
# ---------------------------------------------------------------------------
#
# 1. NO `chown -R` AFTER INSTALLING. `RUN chown -R node:node /app` rewrites every
#    file it touches, and a rewritten file is a new file in the layer — so the
#    image carried a SECOND full copy of node_modules. Roughly half of each 880 MB
#    was that one line. Here /app is created owned by `node` and everything runs
#    as `node` from the start, so ownership is never rewritten.
#
# 2. pnpm INSTALLED GLOBALLY, NOT VIA COREPACK. corepack prepares its cache for
#    the user that ran it; prepared as root, it is unreadable by the runtime
#    `node` user, which is why the old images could not use `pnpm exec` at
#    runtime and re-downloaded pnpm from the registry on a cold start. A global
#    npm install puts it in /usr/local where every user can read it, which also
#    lets the install itself run unprivileged.
FROM node:24-alpine

# dumb-init is the PID-1 reaper the workers use. Installed here rather than in
# each worker image so the layer is shared with the services that do not need it
# — one 20 KB binary is cheaper than a second base.
RUN apk add --no-cache dumb-init \
    && npm install --global pnpm@9.15.0 \
    && mkdir -p /app \
    && chown node:node /app

USER node
WORKDIR /app

# Workspace manifests first: this layer changes only when a dependency changes,
# so the expensive install below stays cached across ordinary source edits.
COPY --chown=node:node pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./

# `patchedDependencies` in the root package.json makes pnpm hash every patch file
# before it resolves anything, so the patch has to be present even when the
# `--filter` scope excludes the package it patches. Without this COPY the install
# below dies with ENOENT on the patch — regardless of what is being built.
COPY --chown=node:node patches ./patches

# ── THE IMAGE MIRRORS THE REPO, PATH FOR PATH ───────────────────────────────
#
# It did not, once: sources came from the new tree and landed flat at
# `./apps`, `./packages`, `./services`. That was the pre-tree-move layout, and it
# broke twice over — `COPY packages ./packages` failed outright because no such
# directory exists any more, and even had it not, the `pnpm-workspace.yaml`
# copied above globs `wizeworks/packages/*` and would have matched nothing inside
# the image.
#
# Mirroring is what makes the copied workspace file TRUE rather than a second
# thing to keep in step. It also means the destination is never worth thinking
# about: whatever the repo calls a path, the image calls it the same.
#
# The apps are NOT built from this base — they ship standalone bundles and are
# already small. Their MANIFESTS are still needed, because `--frozen-lockfile`
# refuses to run when the workspace on disk does not match the lockfile's
# importers, and every workspace glob has to resolve for that to hold. Manifests
# only: no source, and nothing installs for them.
COPY --chown=node:node wizeworks/apps/admin/package.json ./wizeworks/apps/admin/
COPY --chown=node:node wizeworks/apps/site/package.json ./wizeworks/apps/site/
COPY --chown=node:node sparx/apps/market/package.json ./sparx/apps/market/
COPY --chown=node:node sparx/apps/web/package.json ./sparx/apps/web/
COPY --chown=node:node sparx/apps/workbench/package.json ./sparx/apps/workbench/
COPY --chown=node:node sparx/packages/brand/package.json ./sparx/packages/brand/
COPY --chown=node:node piggles/apps/account/package.json ./piggles/apps/account/
COPY --chown=node:node piggles/apps/web/package.json ./piggles/apps/web/
COPY --chown=node:node piggles/apps/workbench/package.json ./piggles/apps/workbench/
COPY --chown=node:node piggles/packages/auth-handoff/package.json ./piggles/packages/auth-handoff/
COPY --chown=node:node piggles/packages/brand/package.json ./piggles/packages/brand/
COPY --chown=node:node piggles/packages/config/package.json ./piggles/packages/config/
COPY --chown=node:node piggles/packages/mascot/package.json ./piggles/packages/mascot/
COPY --chown=node:node piggles/packages/ui/package.json ./piggles/packages/ui/

COPY --chown=node:node wizeworks/packages ./wizeworks/packages
COPY --chown=node:node wizeworks/services ./wizeworks/services

# The authored first-party blueprint bundles (docs/85). api-rest reads these at
# BOOT and publishes them into the marketplace itself — writing each manifest and
# card image to object storage and upserting the catalog row — so the source has to
# travel with the code. It resolves repoRoot/marketplace-catalog → /app/marketplace-catalog.
#
# NOTHING IS SERVED FROM HERE. This is the SOURCE; the bytes a browser fetches come
# from storage, which is what a collaborator's upload will also write to. Keeping the
# two apart is what stops first-party and third-party listings needing separate paths.
# ~11 MB, of which ~7 MB is the card imagery.
COPY --chown=node:node marketplace-catalog ./marketplace-catalog

# Everything under services/, plus the transitive workspace closure each one
# needs. `{...}` is pnpm's filter-by-DIRECTORY syntax and the trailing `...` is
# its dependency-closure suffix, so this is the union of what all seventeen
# images used to install separately — installed once. Verified to select 77
# packages including @wizeworks/db and NONE of the Next.js apps.
#
# @wizeworks/db is named explicitly as well: the migration runner image is built
# from this base and needs it even though nothing under services/ would be
# required to depend on it forever.
RUN pnpm install --filter "{./wizeworks/services/*}..." --filter "@wizeworks/db..." \
    --frozen-lockfile --prod=false

# Pre-generate the Prisma client so no service pays for it on first request.
RUN cd wizeworks/packages/db && pnpm exec prisma generate

# Each service image sets its own WORKDIR, EXPOSE and ENTRYPOINT. Nothing here
# starts: this image is a base, and running it directly is a mistake worth
# failing loudly on.
ENTRYPOINT ["/bin/sh", "-c", "echo 'Dockerfile.base is a base image and has no entrypoint of its own.' >&2; exit 1"]
