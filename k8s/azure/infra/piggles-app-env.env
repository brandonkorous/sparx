# piggles-app-env — the values that MUST differ for the Piggles brand.
#
# ── HOW THIS IS APPLIED, AND WHY THAT ORDER MATTERS ─────────────────────────
#
# The three Piggles Deployments list their sources in this order:
#
#     envFrom:
#       - configMapRef: sparx-app-env        # the platform: database, api-rest, buckets
#       - secretRef:    sparx-app-secrets    # the platform's credentials
#       - configMapRef: piggles-app-env      # ← this file, and it wins
#
# Later entries override earlier ones, so every key below REPLACES the shared
# value for Piggles pods only, and nothing here can affect a sparx pod.
#
# That ordering is the whole design. The alternative — per-pod `env:` blocks —
# means three places to change one origin, and the failure mode when they drift
# is the one recorded in piggles/STATUS.md under "THE LOCKOUT": a wrong
# BETTER_AUTH_URL makes Better Auth answer `Invalid origin` to every BROWSER
# sign-in while sign-up (a server action, no Origin header) and curl (no Origin
# header) both keep working, and the UI blames the password. Hours, for one
# string.
#
# Anything NOT listed here is deliberately inherited: one database, one api-rest,
# one media bucket. Piggles and sparx are two applications on one platform
# (piggles/CLAUDE.md RULE #0) — sharing a database is not sharing an application.

# ── Better Auth ─────────────────────────────────────────────────────────────
#
# getpiggles.com is the auth authority for this brand; mypiggles.com mounts no
# handler and receives a session through the handoff. Both still need to know
# which origin they are running on, and they are DIFFERENT origins — so this
# value cannot be shared between the two Piggles pods either. It is set per-pod
# in each Deployment and deliberately NOT here, where it would be one value for
# both. What IS here is the name, which is the same for both.
#
# BETTER_AUTH_APP_NAME was hardcoded to `sparx` before Piggles existed, and it
# feeds the PASSKEY PROMPT — so a Piggles customer was going to be asked to
# "save a passkey for sparx".
BETTER_AUTH_APP_NAME=Piggles

# The SESSION COOKIE's name — `piggles-account.session_token`, and
# `__Secure-piggles-account.session_token` over HTTPS.
#
# Better Auth defaults to `better-auth`, which named a library on the cookie
# policy a Piggles customer is entitled to read. Unset it and the default comes
# back, which is correct for sparx and wrong here.
#
# CHANGING THIS SIGNS EVERYBODY OUT. The cookie name is the session's address, so
# a rename makes every live session unreachable — not broken, just invisible.
# Piggles is pre-launch, so that cost is zero today and will not be later.
BETTER_AUTH_COOKIE_PREFIX=piggles-account

# ── WHICH BRAND THESE PODS ARE ──────────────────────────────────────────────
#
# Read by @wizeworks/brand-core's `currentPlatformBrand()`. It answers the one
# question a Piggles process cannot get from a tenant row: which brand a signup
# belongs to BEFORE the tenant exists.
#
# Three consequences, all of them permanent once wrong:
#   • `tenants.platform_brand` on a Google signup — the OAuth hook runs inside
#     Better Auth's user-creation callback, before any tenant is written, so the
#     column cannot be read to decide what the column should be. Unset, every
#     social signup was stamped `sparx`, and that value decides the branding of
#     every email that tenant ever receives.
#   • The free subdomain a new tenant is minted with — `<slug>.piggles.site`
#     rather than `<slug>.sparx.zone`.
#   • The `issuer` an authenticator app displays for two-step verification. It
#     is baked into the QR at enrollment and cannot be corrected afterwards.
#
# Correct HERE and wrong in `sparx-app-env`, which is why it is not there:
# api-rest and the event workers serve both brands from one process, and for
# them the answer varies per request and comes from the tenant's own column.
PLATFORM_BRAND=piggles

# The identity this brand speaks with — same keys the shared configmap sets for
# sparx, overridden here for the pods that are Piggles' own.
PIGGLES_BRAND_NAME=Piggles
PIGGLES_BRAND_URL=https://meetpiggles.com
PIGGLES_ZONE_DOMAIN=piggles.site

# The billing PLAN a Piggles tenant is born on (@wizeworks/billing/plans). Stamped
# once onto `tenants.billing_plan` at provisioning; billing reads the column and
# never asks about the brand again.
#
# It MUST be set wherever Piggles tenants are created. The fallback is `modules` —
# sparx's per-module subscription, on sparx's Stripe account — and a Piggles business
# billed that way looks completely normal until somebody reads the invoice.
PIGGLES_BILLING_PLAN=piggles
# The email palette, for the direct-send path. These pods are SINGLE-brand, so a
# send that bypasses the bus (an OTP goes out synchronously) resolves the palette
# from PLATFORM_BRAND above rather than from a tenant row. Unset here and a
# Piggles OTP arrives in the achromatic fallback — legible, and nobody's.
PIGGLES_EMAIL_PALETTE={"accent":"#ff6f86","accentContent":"#ffffff","ink":"#2d3443","inkContent":"#ffffff","paper":"#ffffff","canvas":"#eef0f3","well":"#f7f8fa","line":"#eef0f3","heading":"#202631","body":"#202631","meta":"#52454f","dark":{"background":"#272d39","foreground":"#f4f5f7","muted":"#1c212c","border":"#151922","primary":"#ff7c91","primaryForeground":"#20151a"}}

# ── The three surfaces ──────────────────────────────────────────────────────
#
# Where the console sends somebody who is not signed in, and where "Manage
# account", billing and sign-out lead. The console never shows a price
# (piggles/CLAUDE.md RULE #2) — it links here.
PIGGLES_ACCOUNT_ORIGIN=https://getpiggles.com
# Where the account app redirects after minting a handoff token. An origin-bound,
# single-use, 60-second token must only ever travel to an origin we own: this
# value defaulting to production while running on localhost is exactly how a live
# token was sent to a PARKED domain returning 403 (STATUS.md, bug #2).
PIGGLES_CONSOLE_ORIGIN=https://mypiggles.com

# ── api-rest ────────────────────────────────────────────────────────────────
#
# The BROWSER calls this one directly with the short-lived bearer token from
# /api/token, so it must be reachable from a browser — never the in-cluster
# service address, which stays inherited as SPARX_API_REST_URL for server-side
# calls.
#
# `api.mypiggles.com` rather than the inherited `api.sparx.works`: this URL is
# handed to the customer's browser and shows up in their network tab, their
# devtools and any CORS error they ever see. It is the same api-rest Service
# behind the same Caddy — one extra host block, no extra pod — but it is not
# another company's domain. api-rest runs `cors: { origin: true }`, so no
# allowlist change is needed.
#
# NOT yet true of media: api-rest mints variant URLs server-side from
# MEDIA_PUBLIC_URL, which is shared and still says sparx. That is a separate
# change (it would need the media host too) and is flagged in STATUS.md rather
# than half-done here.
NEXT_PUBLIC_API_URL=https://api.mypiggles.com
# The account app's own name for the same service, used SERVER-SIDE to furnish a
# brand-new business. In-cluster, so it stays the private address.
PIGGLES_API_REST_URL=http://api-rest.sparx-prod.svc.cluster.local:3000

# ── Marketing ───────────────────────────────────────────────────────────────
# Overrides the shared value so a link "back to the site" from either app lands
# on meetpiggles.com and not on sparx.works.
NEXT_PUBLIC_MARKETING_URL=https://meetpiggles.com
