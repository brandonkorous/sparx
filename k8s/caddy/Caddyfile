{
  email ops@sparx.works
  admin off

  # On-demand TLS — issues Let's Encrypt certs for tenant subdomains
  # (slug.sparx.zone) and custom domains (shop.merchant.com) on first
  # HTTPS request. Validated against the API before issuance to prevent
  # unauthorized cert minting.
  on_demand_tls {
    ask http://api-rest.sparx-prod.svc.cluster.local:3000/internal/domain-check
    interval 2m
    burst 5
  }
}

# Baseline security headers (docs/50 §4). Conservative on purpose: HSTS
# (no includeSubDomains/preload, to avoid surprising tenant custom domains),
# nosniff, clickjacking protection, and a tight referrer policy. Deliberately
# NO Content-Security-Policy or Permissions-Policy here — those need per-app
# tuning (Stripe/checkout, PostHog, Satori) and land as a Report-Only pass.
(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

# ----- HTTP → HTTPS -----
:80 {
  redir https://{host}{uri} permanent
}

# ----- Platform hostnames (Cloudflare-proxied; cert from on-demand) -----
api.sparx.works {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy api-rest.sparx-prod.svc.cluster.local:3000
}

# media.sparx.works — public CDN domain for transcoded media variants.
# Cloudflare caches everything for a year; the origin only sees a sliver
# of traffic, and merchants get fast TTFB worldwide. The path under it
# is identical to api.sparx.works so MEDIA_PUBLIC_URL is a single env
# swap. Only the /v1/public/media/* routes serve here — anything else
# 404s by virtue of the api-rest route map.
media.sparx.works {
  tls {
    on_demand
  }
  header {
    # Belt + suspenders: Cloudflare already adds these but origin-side
    # headers survive a CF bypass. `immutable` is critical — the URL
    # encodes width + format, so the bytes never change.
    Cache-Control "public, max-age=31536000, immutable"
    # Strip any cookies merchant proxies might forward — the CDN
    # variants are pure content.
    -Set-Cookie
  }
  reverse_proxy api-rest.sparx-prod.svc.cluster.local:3000
}

graphql.sparx.works {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy api-graphql.sparx-prod.svc.cluster.local:3200
}

mcp.sparx.works {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy api-mcp.sparx-prod.svc.cluster.local:3000
}

# Canonical shopper-facing storefront MCP host (docs/113). A reserved slug, so
# no tenant owns it; authorized as a static platform host in
# /internal/domain-check. The store is named in the path
# (/s/<tenant>[/<property>]/mcp) since a fixed host can't encode it.
mcp.sparx.zone {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy mcp-storefront.sparx-prod.svc.cluster.local:3200
}

app.sparx.works {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy dashboard.sparx-prod.svc.cluster.local:3000
}

sparx.works, www.sparx.works {
  tls {
    on_demand
  }
  import security_headers
  reverse_proxy web.sparx-prod.svc.cluster.local:3000
}

# ----- kanNINJA (co-tenant in the `kanninja` namespace) -----
# Added 2026-06-06 during the kanNINJA AKS→GKE migration. kanNINJA's workloads
# live in their own `kanninja` namespace; Caddy reaches them cross-namespace via
# ClusterIP Services (port 80 → app's http port).
#
# IMPORTANT: these blocks deliberately OMIT `tls { on_demand }`. On-demand would
# call the global ask endpoint (api-rest /internal/domain-check), which only
# knows sparx tenants/custom domains and would REJECT kanninja.com — no cert.
# Explicit host blocks get a normal Caddy-managed Let's Encrypt cert (HTTP-01 /
# TLS-ALPN), which is what we want. Requires kanninja.com / api / mcp DNS to
# resolve to this LB (35.254.145.54) first; keep them DNS-only (no Cloudflare
# proxy) until the certs issue, then optionally proxy with Full(strict).
kanninja.com {
  import security_headers
  reverse_proxy frontend.kanninja.svc.cluster.local:80
}

www.kanninja.com {
  import security_headers
  redir https://kanninja.com{uri} permanent
}

api.kanninja.com {
  import security_headers
  reverse_proxy backend.kanninja.svc.cluster.local:80
}

mcp.kanninja.com {
  import security_headers
  reverse_proxy mcp.kanninja.svc.cluster.local:80
}

