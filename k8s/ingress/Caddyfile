}

# piggles.site apex — the same shape, one brand over. The zone exists to carry
# `<slug>.piggles.site` tenant sites; the apex itself is not a destination, so it
# goes to the brand's home.
#
# Tenant sites need NO block of their own: the catch-all below already serves any
# host that reaches it, which is how `<tenant>.sparx.zone` works today. What they
# DO need is a certificate, and that is decided by the on-demand ask endpoint —
# which now knows BOTH zones (SPARX_ZONE_DOMAINS=sparx.zone,piggles.site in the
# shared ConfigMap, read by api-rest's lib/domain.ts). This note used to warn that
# it recognised only one and that failed handshakes were the symptom to expect;
# that has been fixed, and the warning was left behind to send somebody chasing it.
{$SX_SCHEME:https}://piggles.site, {$SX_SCHEME:https}://www.piggles.site {
	import tls_policy
	redir https://meetpiggles.com{uri} permanent
}

# ----- Catch-all: tenant sites -----
# Matches <tenant>.sparx.zone (wildcard DNS), <property>.<tenant>.sparx.zone,
# and any custom domain pointing here. The ask endpoint decides whether a
# certificate is issued, per hostname, at any depth.
#
#   /mcp*            → the shopper-facing MCP (docs/113), which resolves the
#                      site from the Host header. `handle`, not `handle_path`,
#                      so the /mcp prefix survives to the service that routes on
#                      it.
#   protected-resource well-knowns → mcp-site (the RFC 9728 resource server), in
#                      every discovery shape a client may construct: bare root,
#                      path-inserted, and the /mcp-suffixed one that already
#                      rides /mcp*. WITHOUT these they fall through to the site
#                      app and 404, so a client whose unauthenticated
#                      `initialize` succeeds (no WWW-Authenticate to read)
#                      cannot discover the authorization server.
#   /v1/public/auth* + the AS well-knowns → api-rest, with the Host preserved,
#                      so the browser keeps its sparx_customer_session cookie
#                      through authorize → consent on the store's OWN origin.
#
# Everything else reaches the site app.
{$SX_CATCHALL::443} {
	import tls_policy
	import security_headers

	handle /mcp* {
		reverse_proxy mcp-site.sparx-prod.svc.cluster.local:3200
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy mcp-site.sparx-prod.svc.cluster.local:3200
	}
	handle /v1/public/auth* {
		reverse_proxy api-rest.sparx-prod.svc.cluster.local:3000
	}
	handle /.well-known/oauth-authorization-server* {
		reverse_proxy api-rest.sparx-prod.svc.cluster.local:3000
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy api-rest.sparx-prod.svc.cluster.local:3000
	}
	handle {
		reverse_proxy site.sparx-prod.svc.cluster.local:3000
	}
}

# ----- AGCONN (co-tenant in the `agconn` namespace) -----------------------------
#
# AGCONN (agconn.com) is a bilingual farmworker platform, a FIFTH product on this
# cluster. It deploys from its own repository (brandonkorous/AgConnect) into the
# `agconn` namespace; Caddy reaches its Services cross-namespace. Its database and
# object storage are NOT on Azure — they stay on Supabase — so nothing here or in
# terraform/envs/azure/agconn.tf touches its data.
#
# FOUR HOSTNAMES, THREE SERVICES. Confirmed against the cluster on 2026-08-27
# (`kubectl -n agconn get svc` -> admin, api, web, all :80):
#
#   agconn.com        marketing site AND the app  -> web
#   www.agconn.com    301 to the apex             -> (no backend)
#   api.agconn.com    the Hono API                -> api
#   admin.agconn.com  the admin console           -> admin
#
# There is no separate marketing Service. Unlike kanNINJA, whose `frontend` serves
# the app and whose marketing lives elsewhere, AGCONN's public pages and its
# signed-in surfaces are one Next.js Service — which is why the apex proxies to
# the same place the app does.
#
# ON-DEMAND TLS (`tls_policy`), like kanNINJA and silicaui, and for the reason
# spelled out on the kanNINJA block above: this Caddy is `replicas: 1` on a
# `Recreate` rollout, so every boot has a window with no registered load-balancer
# backend, and an explicit managed block spends all of its startup issuance
# attempts inside it. On-demand defers issuance to the first HTTPS request, which
# lands on a warm pod.
#
# THE ALLOW-LIST IS THE OTHER HALF OF THIS CHANGE. All four names must appear in
# PLATFORM_HOSTNAMES in
# wizeworks/services/api-rest/src/routes/internal/domain-check.ts. Removing one
# there silently costs that hostname its certificate, and Cloudflare answers 525
# for that name alone — which reads like a routing bug and is a TLS failure.
#
# ADMIN IS AN ORDINARY BLOCK, not an Origin CA one. sparx's own admin host takes
# `tls_admin_origin` because it sits behind Cloudflare Access; AGCONN's admin is a
# Next.js app gated by Clerk, with no such arrangement, so it takes the same
# on-demand policy as everything else.
# X-FORWARDED-PORT IS LOAD-BEARING ON THE TWO NEXT.JS BLOCKS, and it is the one
# thing these need that no other tenant's blocks do.
#
# AGCONN's web and admin are Next.js 16 apps whose `src/proxy.ts` runs next-intl's
# locale middleware. That middleware answers `/` with a 307 to `/<locale>` and
# builds the Location as an ABSOLUTE url from `request.nextUrl`. Caddy sets
# X-Forwarded-Proto and X-Forwarded-Host by default but NOT X-Forwarded-Port, so
# Next fell back to the port it listens on and published
#
#     https://agconn.com:3000/es
#
# a public redirect to a port nothing serves. Measured against the running pod:
#
#     Host only                -> http://web:3000/es
#     + XF-Proto / XF-Host     -> https://agconn.com:3000/es
#     + XF-Port 443            -> https://agconn.com/es
#
# `{http.request.port}` rather than a literal 443, because this same file is
# mounted in workstation mode from k8s/local where the scheme is http and the
# port is not 443. A hardcoded value would be right in cloud and wrong on a
# laptop — exactly the divergence the mode.caddy split exists to prevent.
#
# kanNINJA and jotacular do not need this: neither serves a locale-prefix
# redirect from its apex, so nothing there builds an absolute URL from the port.
{$SX_SCHEME:https}://agconn.com {
	import tls_policy
	import security_headers
	reverse_proxy web.agconn.svc.cluster.local:80 {
		header_up X-Forwarded-Port {http.request.port}
	}
}

{$SX_SCHEME:https}://www.agconn.com {
	import tls_policy
	import security_headers
	redir https://agconn.com{uri} permanent
}

{$SX_SCHEME:https}://api.agconn.com {
	import tls_policy
	import security_headers
	reverse_proxy api.agconn.svc.cluster.local:80
}

{$SX_SCHEME:https}://admin.agconn.com {
	import tls_policy
	import security_headers
	# Same reasoning as the apex block. Admin's redirects happen to come from
	# Clerk today, which builds its own absolute URLs from configuration and so
	# is unaffected — but it is the same Next.js runtime with the same proxy.ts,
	# and the first redirect it emits itself would carry :3100.
	reverse_proxy admin.agconn.svc.cluster.local:80 {
		header_up X-Forwarded-Port {http.request.port}
	}
}
