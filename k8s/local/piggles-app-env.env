# piggles-app-env — WORKSTATION variant. Read the header of
# k8s/azure/infra/piggles-app-env.env for what this ConfigMap is and why the
# envFrom order matters; only the values differ here.
#
# The delta from production is entirely origins: on a laptop the three surfaces
# are three ports on localhost rather than three registrable domains, and the
# cross-domain auth story collapses into a same-machine one. Everything else —
# the app name, the shape of the handoff — is identical, deliberately, so the
# thing being tested locally is the thing that ships.

BETTER_AUTH_APP_NAME=Piggles

# The SESSION COOKIE's name — `piggles-account.session_token`, and
# `__Secure-piggles-account.session_token` over HTTPS.
#
# Better Auth defaults to `better-auth`, which named a library on the cookie
# policy a Piggles customer is entitled to read. Unset it and the default comes
# back, which is correct for sparx and wrong here.
#
# CHANGING THIS SIGNS EVERYBODY OUT. The cookie name is the session's address, so
# a rename makes every live session unreachable — not broken, just invisible.
# Piggles is pre-launch, so that cost is zero today and will not be later.
BETTER_AUTH_COOKIE_PREFIX=piggles-account

# 3020 meet · 3021 get · 3022 my. The ports are fixed in each app's `dev` script.
PIGGLES_ACCOUNT_ORIGIN=http://localhost:3021
PIGGLES_CONSOLE_ORIGIN=http://localhost:3022

# api-rest on the workstation. Both the browser and the server reach it at the
# same address here, which is the one simplification a laptop earns.
NEXT_PUBLIC_API_URL=http://localhost:3100
PIGGLES_API_REST_URL=http://api-rest.sparx-prod.svc.cluster.local:3000

NEXT_PUBLIC_MARKETING_URL=http://localhost:3020

# Which brand these pods ARE. Read the block of the same name in
# k8s/azure/infra/piggles-app-env.env for the three permanent consequences of
# getting it wrong; a fourth is now the MCP resource identifier the account app's
# Better Auth mints tokens for, which is per brand.
#
# It was ABSENT here while production set it, so the workstation overlay was
# quietly running the Piggles pods as sparx — the exact drift this file's own
# header promises does not exist ("only the values differ"). A brand-blind value
# below is IDENTICAL to production on purpose: the name of the product and the
# color of its email do not change because the origin is a port.
PLATFORM_BRAND=piggles
PIGGLES_BRAND_NAME=Piggles
PIGGLES_BRAND_URL=http://localhost:3020
PIGGLES_ZONE_DOMAIN=piggles.site
PIGGLES_BILLING_PLAN=piggles
PIGGLES_EMAIL_PALETTE={"accent":"#ff6f86","accentContent":"#ffffff","ink":"#2d3443","inkContent":"#ffffff","paper":"#ffffff","canvas":"#eef0f3","well":"#f7f8fa","line":"#eef0f3","heading":"#202631","body":"#202631","meta":"#52454f","dark":{"background":"#272d39","foreground":"#f4f5f7","muted":"#1c212c","border":"#151922","primary":"#ff7c91","primaryForeground":"#20151a"}}
