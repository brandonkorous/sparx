# Template for the `sparx-app-secrets` Secret. Copy to `secrets.env` (which is
# gitignored) and fill in. scripts/local-up.ps1 reads it.
#
#   cp k8s/local/secrets.example.env k8s/local/secrets.env
#
# THIS FILE IS ALSO THE CANONICAL LIST OF WHAT PRODUCTION NEEDS. Prod values live
# in Azure Key Vault, one secret per value (k8s/azure/README.md); seed the vault
# from a filled-in copy of this file with:
#
#   ./k8s/scripts/sync-secrets.ps1 -VaultName kv-sparx-prod-cus -FromEnvFile secrets.env
#
# Vault names are the kebab-case form — CRM_VOICE_TOKEN_KEY is `crm-voice-token-key`.
# Adding a key here means adding it to the vault; nothing reads a hardcoded list.
#
# These were previously synced from GCP Secret Manager by k8s/scripts/sync-secrets.ps1.
# With the project shut down, every value has to come from its own source system.
# The good news is that almost none of them were only in Secret Manager:
#
#   REGENERATE FREELY (they are just random strings; rotating logs sessions out
#   and invalidates existing push subscriptions, nothing more):
#     BETTER_AUTH_SECRET, CUSTOMER_AUTH_SECRET, SPARX_INTERNAL_JWT_SECRET,
#     SPARX_INTERNAL_CRON_TOKEN, SOCIAL_TOKEN_KEY, SEARCH_CONSOLE_TOKEN_KEY,
#     TYPESENSE_API_KEY, VAPID_PRIVATE_KEY
#       → openssl rand -base64 32
#       → VAPID pair: npx web-push generate-vapid-keys (the PUBLIC half also has
#         to be updated in app-env-configmap.env, or push silently fails to
#         verify)
#
#   RE-READ FROM THE PROVIDER'S OWN DASHBOARD (unaffected by the GCP shutdown):
#     STRIPE_*, MAILGUN, CLOUDFLARE_API_TOKEN, GOOGLE_*, META_*, THREADS_*,
#     LINKEDIN_*, PINTEREST_*, TIKTOK_*, GODADDY_*
#
# SOCIAL_TOKEN_KEY IS THE ONE EXCEPTION. It encrypts the per-tenant social OAuth
# grants already stored in the database. Changing it does not break anything
# visibly — it makes every stored token undecryptable, and each tenant has to
# reconnect every platform. Since this deployment starts from a fresh database,
# a new key is correct. Do not paste a new key over an inherited database.

# --- Database --------------------------------------------------------------
# Points at the in-cluster Postgres Service (k8s/local/infra.yaml), not
# PgBouncer — the overlay does not run a pooler, see infra.yaml for why.
# The password is the one 01-roles.sql assigns to `sparx_app`.
DATABASE_URL=postgresql://sparx_app:devpassword@postgres.sparx-prod.svc.cluster.local:5432/sparx
# api-mcp introspects OAuth tokens as the owner role.
AUTH_DATABASE_URL=postgresql://sparx_owner:devpassword@postgres.sparx-prod.svc.cluster.local:5432/sparx

# --- Auth ------------------------------------------------------------------
BETTER_AUTH_SECRET=
CUSTOMER_AUTH_SECRET=
SPARX_INTERNAL_JWT_SECRET=
# Shared by all 15 CronJobs to authenticate their POSTs to /internal/*.
SPARX_INTERNAL_CRON_TOKEN=

# --- Encryption keys -------------------------------------------------------
SOCIAL_TOKEN_KEY=
SEARCH_CONSOLE_TOKEN_KEY=
# CRM phone systems (docs/144 §5.6) — encrypts the tenant's own phone-vendor auth
# token at rest. UNSET MEANS THE FEATURE IS OFF, not that it stores in the clear:
# POST /v1/crm/voice refuses, and Customers → Setting up → Phone systems says so
# rather than taking a token it cannot protect. Set it and click-to-call works.
CRM_VOICE_TOKEN_KEY=
# CRM mailboxes (docs/144 §5.2) — same contract for the mailbox app password.
# Connecting a mailbox is refused until it is set.
CRM_MAILBOX_TOKEN_KEY=

# --- Web push --------------------------------------------------------------
# Must be the private half of VAPID_PUBLIC_KEY in app-env-configmap.env.
VAPID_PRIVATE_KEY=

# --- Google OAuth (staff sign-in; also YouTube + Business Profile) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Piggles ----------------------------------------------------------------
# The sister brand's own credentials. They live in this ONE secret store rather
# than a second `piggles-app-secrets`, because a second store is a second thing
# to keep populated and a second place for a credential to go missing. The
# Piggles Deployments map these keys onto the ordinary names with `secretKeyRef`
# (k8s/apps/piggles-account.yaml), so nothing here collides with the sparx pair
# above.
#
# BETTER_AUTH_SECRET — Piggles' own, DISTINCT from sparx's: a different brand on
# a different cookie domain, and a session signed by one must not be readable by
# the other. It is also the SAME value for both Piggles pods: getpiggles mints
# the session and mypiggles reads it after the handoff, against the same session
# rows, so a mismatch makes every handed-off session unverifiable. Generate with
# `openssl rand -base64 32`.
PIGGLES_BETTER_AUTH_SECRET=
# A client in a SEPARATE Google Cloud project, not another client in sparx's:
# the consent screen (name, logo, support email) is configured per PROJECT and
# shared by every client in it, so a Piggles customer would otherwise be asked
# to grant access to "sparx".
#
# getpiggles.com is the only Piggles domain that gets one. mypiggles.com
# deliberately has no OAuth client and no Better Auth handler — a callback there
# would be a second thing able to mint sessions, which is what the three-domain
# split exists to prevent.
#
#   JavaScript origins  https://getpiggles.com, http://localhost:3021
#   Redirect URIs       https://getpiggles.com/api/auth/callback/google
#                       http://localhost:3021/api/auth/callback/google
PIGGLES_GOOGLE_CLIENT_ID=
PIGGLES_GOOGLE_CLIENT_SECRET=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Mailgun on sparx.email) ----------------------------------------
# Only read when SPARX_EMAIL_PROVIDER=mailgun; the overlay ships `console`.
SPARX_MAILGUN_API_KEY=

# --- Social platform OAuth apps --------------------------------------------
# An adapter's isConfigured() returns false when its pair is missing, so the
# platform silently disappears from the connect UI rather than erroring — a
# blank here reads as a bug in the adapter. Threads uses its OWN app id/secret,
# not the Meta pair; graph.threads.net rejects the Facebook app's.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Registrar (domain purchase) -------------------------------------------
GODADDY_API_KEY_OTE=
GODADDY_API_SECRET_OTE=
GODADDY_API_KEY_PROD=
GODADDY_API_SECRET_PROD=

# --- Cloudflare ------------------------------------------------------------
# DNS record management. Mint a fresh token in the Cloudflare dashboard — the
# old one is only in the dead Secret Manager.
CLOUDFLARE_API_TOKEN=

# --- Search ----------------------------------------------------------------
# Also written into the separate `typesense-secrets` Secret by local-up.ps1,
# because the Typesense StatefulSet and commerce-indexer both read it from
# there (matching the base manifests' secretKeyRef).
TYPESENSE_API_KEY=
