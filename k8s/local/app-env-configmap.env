# sparx-app-env — LOCAL self-hosted variant of k8s/sparx-prod/app-env-configmap.yaml.
# dotenv format because kustomize's configMapGenerator reads it via `envs:`.
# Secrets still come from `sparx-app-secrets` (see secrets.example.env).
#
# Public hostnames are DELIBERATELY unchanged from production. Cloudflare
# Tunnel lets the same names resolve to this workstation, so every OAuth
# callback, webhook target (Stripe, Mailgun, the social platforms), Better Auth
# cookie scope and MCP resource identifier stays valid. Changing them would mean
# re-registering callbacks with six external providers for no benefit.

# --- The GCP switch --------------------------------------------------------
# GCP_PROJECT_ID is ABSENT, and that absence is load-bearing. In
# packages/events/src/publisher.ts `createPublisher` branches on it: set → a real
# Pub/Sub client (which would now fail against a dead project); unset → local
# dispatch if SPARX_DEV_WORKER_ROUTES is present, else a logging no-op.
#
# SPARX_DEV_WORKER_ROUTES is that dispatch table: the publisher POSTs each event
# to the matching worker's HTTP endpoint in the exact Pub/Sub push envelope the
# worker already parses, so worker code is unchanged from its Cloud Run form.
#
# KNOWN LIMITATION — this is a direct HTTP hand-off, not a broker. It is
# fire-and-forget with no retry, no dead-letter queue and no durability: an
# event published while its worker is restarting is lost silently (the failure
# is logged by the publisher, not surfaced to the caller). Acceptable for a
# dogfood/demo deployment; NOT equivalent to Pub/Sub. Replacing this with a real
# broker is the one genuine gap in this migration — see k8s/local/README.md.
#
# Topics are validated against the EventType union in packages/events/src/types.ts.
# Six subscriptions in terraform/envs/prod/serverless.tf reference event types that
# do not exist in that union (order.created, order.payment.recorded and the four
# crm.customer.*) and are therefore omitted here — they were dead config in prod
# too, matching the warning in CLAUDE.md. Customer re-indexing rides
# search.entity.changed instead.
SPARX_DEV_WORKER_ROUTES=[{"url":"http://email-worker:8080/","events":["email.send"]},{"url":"http://push-worker:8080/","events":["push.send"]},{"url":"http://markup-recompute-worker:8080/","events":["variant.cost.updated"]},{"url":"http://media-worker:8080/","events":["media.uploaded"]},{"url":"http://commerce-indexer:8080/","events":["product.created","product.updated","product.deleted","variant.created","variant.updated","variant.deleted","inventory.adjusted","order.cancelled","order.fulfilled","order.delivered","order.refunded","search.reindex.requested","search.entity.changed"]},{"url":"http://channel-sync-worker:8080/","events":["product.created","product.updated","product.deleted","inventory.adjusted","order.fulfilled"]},{"url":"http://social-worker:8080/","events":["social.post.due","social.metrics.collect","social.connection.check","social.inbox.sync","social.inbox.reply"]},{"url":"http://legal-seed-worker:8080/","events":["tenant.created"]},{"url":"http://platform-crm-worker:8080/","events":["tenant.created","tenant.updated","tenant.subscription.changed","module.activated","module.deactivated"]},{"url":"http://domain-worker:8080/","events":["domain.purchased"]},{"url":"http://dropship-worker:8080/","events":["dropship.supplier.sync_started","dropship.order.route","order.placed"]}]

# --- Public origins (unchanged from prod) ----------------------------------
BETTER_AUTH_URL=https://app.sparx.works
MCP_RESOURCE_URL=https://mcp.sparx.works/mcp
MCP_AUTH_SERVER_URL=https://app.sparx.works
SITE_MCP_PUBLIC_ORIGIN=https://mcp.sparx.zone
CUSTOMER_AUTH_URL=https://api.sparx.works
CUSTOMER_MCP_LOGIN_PAGE=/account/login
NEXT_PUBLIC_APP_URL=https://app.sparx.works
NEXT_PUBLIC_API_URL=https://api.sparx.works
NEXT_PUBLIC_MARKETING_URL=https://sparx.works
SPARX_PUBLIC_API_REST_URL=https://api.sparx.works

# --- In-cluster addresses --------------------------------------------------
# Namespace is still sparx-prod (see kustomization.yaml for why), so these are
# byte-identical to production.
SPARX_API_REST_URL=http://api-rest.sparx-prod.svc.cluster.local:3000
SPARX_DASHBOARD_INTERNAL_URL=http://workbench.sparx-prod.svc.cluster.local:3000
REDIS_URL=redis://redis.sparx-prod.svc.cluster.local:6379

# --- Media -----------------------------------------------------------------
# GCS_MEDIA_BUCKET / GCS_MEDIA_PUBLIC_BUCKET are ABSENT, which is what selects
# the local-disk backend in packages/media/src/storage.ts (`getStorage` falls
# through to LocalStorage when the bucket env is unset). MEDIA_LOCAL_DIR is
# backed by a PVC shared by api-rest and media-worker — the worker writes
# variants, api-rest streams them, so they MUST see the same volume.
MEDIA_LOCAL_DIR=/media
MEDIA_PUBLIC_URL=https://media.sparx.works

# --- Email -----------------------------------------------------------------
# `console` logs the rendered message instead of sending. Flip to `mailgun` and
# populate SPARX_MAILGUN_API_KEY in the secret to send for real — Mailgun is
# unaffected by the GCP shutdown. SPARX_POSTAL_URL is dropped: Postal is
# decommissioned and its Service does not exist in this overlay.
SPARX_EMAIL_PROVIDER=console

# --- Search ----------------------------------------------------------------
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

