#!/usr/bin/env bash
# Pre-push guard. Runs the exact checks CI runs so red builds never reach
# `main`. Enable once with `git config core.hooksPath .githooks` (the root
# `prepare` script in package.json does this automatically after install).
#
# Bypass intentionally with `git push --no-verify` if you really need to.

set -e

# Color helpers (no-op when not a TTY)
if [ -t 1 ]; then
  GREY=$'\033[90m'; RED=$'\033[31m'; GREEN=$'\033[32m'; RESET=$'\033[0m'
else
  GREY=""; RED=""; GREEN=""; RESET=""
fi

step() { printf "${GREY}→${RESET} %s\n" "$1"; }
ok()   { printf "${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "${RED}✗ %s${RESET}\n" "$1"; exit 1; }

step "pre-push: verifying tree before push"

step "pnpm install --frozen-lockfile (lockfile drift check)"
# --ignore-scripts skips postinstall (prisma generate); the hook only needs
# to verify lockfile consistency, not regenerate the client. Avoids the
# Windows EPERM file-lock that postinstall is prone to on already-built
# Prisma engines.
#
# `< /dev/null` is load-bearing, not tidiness. Git hands a pre-push hook the
# ref list on stdin, and pnpm inherits it and blocks on it forever: the process
# sits at 1.1s of CPU and never returns, so the push hangs with NO output at all.
# Two pushes wedged that way on 2026-08-23, one of them for 8.5 hours, and 15
# commits sat unpushed behind them. The identical command finishes in seconds
# once stdin is closed.
pnpm install --frozen-lockfile --ignore-scripts --silent < /dev/null || fail "pnpm-lock.yaml out of sync with a package.json — run \`pnpm install\` and commit the updated lockfile"
ok "lockfile in sync"

# `--ignore-scripts` above means NOTHING here generates the Prisma client, and
# the lint/typecheck steps below simply use whatever is already on disk. In a
# checkout that has ever run a full `pnpm install`, that is fine.
#
# In a FRESH one it is not, and the failure is maximally misleading: with no
# generated client, every `prisma.*` call types as `any`, and typed-lint reports
# ~1500 `no-unsafe-*` errors naming YOUR source files. Nothing in that output
# says "the client is missing."
#
# This is not a hypothetical checkout. It is the standard escape hatch when a
# parallel agent's half-finished work is blocking a push: `git worktree add
# <path> origin/main`, commit there, push from there — the hook then validates
# committed state instead of somebody else's WIP. That worktree is always fresh,
# so the recipe for getting out of one trap landed directly in another
# (2026-08-09, and again 2026-08-10).
#
# Generating only when ABSENT is what keeps this compatible with the reason
# `--ignore-scripts` exists. The Windows EPERM file-lock happens when Prisma
# tries to overwrite an engine binary that a running `next dev` still holds
# open; if there is no client at all, there is nothing to overwrite and nothing
# holding a lock. So the case we skip and the case we handle are disjoint.
#
# The probe resolves @prisma/client and looks for the GENERATED tree beside it,
# rather than `require.resolve('.prisma/client')` — under pnpm's isolated layout
# `.prisma` is a sibling of `@prisma` inside the virtual store and resolves from
# nowhere the hook could run. Both candidate positions are checked so a hoisted
# node_modules works too; getting this wrong in the safe direction (reporting
# ABSENT when it is present) would regenerate on every push, which is the exact
# EPERM risk `--ignore-scripts` was added to avoid.
step "prisma client present"
if node -e "
  const path = require('path'), fs = require('fs');
  // Resolved FROM packages/db, never from the repo root: pnpm does not hoist,
  // so @prisma/client is not resolvable at the top level and a bare
  // require.resolve here throws MODULE_NOT_FOUND even when the client is
  // perfectly healthy — which would regenerate on every single push.
  const dir = path.dirname(
    require.resolve('@prisma/client', { paths: [path.join(process.cwd(), 'wizeworks', 'packages', 'db')] })
  );
  const found = ['../..', '..', '../../..']
    .map((up) => path.join(dir, up, '.prisma', 'client', 'index.js'))
    .some((p) => fs.existsSync(p));
  process.exit(found ? 0 : 1);
" 2>/dev/null; then
  ok "client already generated"
else
  printf "  no generated Prisma client (fresh checkout) — generating once\n"
  pnpm --filter @wizeworks/db db:generate >/dev/null 2>&1 \
    || fail "prisma generate failed — run \`pnpm --filter @wizeworks/db db:generate\` to see it"
  ok "client generated"
fi

# The pure-Node structural checks CI runs. Under a second each, no install, and
# they catch the class of drift that otherwise surfaces minutes into a release
# build: an event with no topic, a surface with no address, an image built
# without a package it imports.
# ── UNTRACKED FILES MAKE THE PRESENCE CHECKS BELOW PASS FOR THE WRONG REASON ─
#
# Everything from here reads the WORKING TREE. For the compile-shaped checks
# that is the point — you are pushing what you just built. For the checks that
# ask WHETHER A FILE EXISTS it is not, because an untracked file exists here and
# does not exist on CI.
#
# check:console-parity is the one that bit, on 2026-08-27. It counted 21 Piggles
# routes, paired every one, and went green; CI counted the 14 that were committed
# and failed with 7 divergent. Seven route files were sitting untracked in a
# parallel agent's working tree. Nothing was wrong with the check — it answered
# honestly about a tree that is not what `git push` sends.
#
# Note the direction. The worktree recipe further up exists for WIP that BLOCKS a
# push, which is loud and self-correcting. This is WIP that UNBLOCKS one, which
# is silent: the hook goes green, the push succeeds, and CI fails on a commit
# that is already on main.
#
# Counted, not failed. Pushing with unrelated work in progress is normal, and a
# hook that refused it would simply get bypassed — so this buys back the one
# thing the green below cannot tell you on its own.
untracked=$(git ls-files --others --exclude-standard | wc -l | tr -d '[:space:]')
if [ "$untracked" -gt 0 ]; then
  printf "  %s untracked file(s) in the tree — the presence checks below can see them and CI cannot\n" "$untracked"
fi

step "structural checks (events, routes, dockerfiles, brand isolation, console parity, migration order, blueprint versions)"
node scripts/check-platform-brand.mjs >/dev/null || fail "shared code gained a NEW hardcoded product name — it serves both brands, so the string is wrong in one of them. Run \`pnpm check:brand\` to see it"
node scripts/check-event-topics.mjs >/dev/null || fail "event/topic parity failed — run \`pnpm check:events\` to see it"
node scripts/check-worker-events.mjs >/dev/null || fail "a worker subscribes to or routes an event nobody publishes — run \`pnpm check:worker-events\` to see it. NOTE: a dead \`case\` reads exactly like coverage, and check:events cannot see it."
node scripts/check-surface-routes.mjs >/dev/null || fail "surface/address parity failed — run \`pnpm check:routes\` to see it"
node scripts/check-cms-routes.mjs >/dev/null || fail "the console promises a web address for a kind of content the site has no route for — run \`pnpm check:cms-routes\` to see it. A published entry of an unserved kind 404s while the console says \"Live since…\"."
node scripts/check-notification-entities.mjs >/dev/null || fail "a notification would lead nowhere — its \`entityType\` is not a key in the links entity table, or its route takes an id it was never given. Run \`pnpm check:notify-entities\` to see it. NOTE: a dead-end notification looks IDENTICAL to a working one until somebody clicks it, and no test connects a string in a seed to a key in another package."
node scripts/check-dockerfile-deps.mjs >/dev/null || fail "a Dockerfile is missing a workspace package it imports — run \`pnpm check:docker\` to see it"
node scripts/check-nullable-inputs.mjs >/dev/null || fail "a service writes null into a field its own input schema refuses — run \`pnpm check:nullable-inputs\` to see it. NOTE: every console form sends null for an empty box, so each one is a Save that comes back 422 naming no field, and it typechecks, lints and passes every unit test because no test sends the payload a blank form does."
node scripts/check-platform-seed.mjs >/dev/null || fail "platform content written as code has no deploy stage that applies it — run \`pnpm check:platform-seed\` to see it. NOTE: an exported array is not a row. Editing one changes NOTHING on any database that already ran the migration which first wrote it, and no check notices: marketplace_themes served an empty page for a month, and the built-in product types drifted twice, once in their icons and once in their words."
node scripts/check-service-env.mjs >/dev/null || fail "a service cannot start on a fresh checkout — its required env is not in its .env.example. Run \`pnpm check:service-env\` to see it. NOTE: this class of failure passes typecheck, lint and every test, because none of them boot the service."
node scripts/check-brand-wordmark.mjs >/dev/null || fail "a brand wordmark and its deployed copy have drifted — run \`pnpm check:brand-wordmark\` to see it, and \`--update\` to rewrite it from the art. NOTE: this class of failure DEPLOYS green and draws last year's logo on every tenant site."
node scripts/check-dockerfile-paths.mjs >/dev/null || fail "a Dockerfile path no longer resolves — run \`pnpm check:docker-paths\` to see it. NOTE: the destination class of this failure BUILDS fine and crashloops on start."
node scripts/check-boundaries.mjs >/dev/null || fail "a product boundary broke, or piggles grew a new \`@sparx/*\` dependency — run \`pnpm check:boundaries\` to see it"
node scripts/check-deletability.mjs >/dev/null || fail "piggles now depends on a sparx-owned package — deleting sparx would break its build. Run \`pnpm check:deletability\` for the chain"
node scripts/check-webhook-events.mjs >/dev/null || fail "webhook event lists have drifted — run \`pnpm check:webhooks\` to see it"
node scripts/check-billing-plans.mjs >/dev/null || fail "a billing plan and the prod ConfigMap have drifted, or a plan is malformed — run \`pnpm check:billing-plans\` to see it. NOTE: this class of failure DEPLOYS green and charges the wrong price."
node scripts/check-inventory-api-docs.mjs >/dev/null || fail "the inventory API reference is stale — run \`pnpm gen:inventory-api\` to rebuild it"
node scripts/check-shadowed-relations.mjs >/dev/null || fail "a Prisma query asks for a RELATION whose name a client extension has already taken, so the join comes back null and nothing says so - run `pnpm check:shadowed` to see it. NOTE: this class of failure RENDERS. `Customer.company` is a relation in the schema AND a computed field on the client (the typed employer string, because that is the wire name ~120 payloads use), and the computed one wins. MEASURED: the company row reads fine directly, raw SQL joins it, and Prisma hands back null. Two screens depended on it - the order detail's "Wholesale customer" line and the wholesale approvals queue - and neither has ever rendered a business name, on any order, in either console. Fetch it under a name of its own: see `accountsFor` in packages/crm/src/services/order-service.ts."
node scripts/check-field-names.mjs >/dev/null || fail "a form control has no name a person can hear - run `pnpm check:field-names` to see it. NOTE: it LOOKS labelled. Base UI wires a <FieldLabel> to its control by id, but only when the control is the direct child of <FieldControl render={...}>; a <div className=\"max-w-40\"> in between for sizing breaks the wiring and leaves no id, no aria-labelledby and no name at all, with the placeholder as the only clue - and that vanishes on the first keystroke. MEASURED on one wholesale customer record: 6 of 13 controls unnamed, including the Discount box on the terms she buys on. 33 across both consoles. Prefer DELETING the wrapper and putting its class on the control, which leaves no second copy of the label to drift; keep it only when it holds something else too, and give the control its own aria-label."
node scripts/check-workflow-exit.mjs >/dev/null || fail "a built-in document workflow has no way OUT of it - run `pnpm check:workflow-exit` to see it. NOTE: nothing fails and every test passes; the document is simply permanent. The DEFAULT Invoice workflow every tenant is seeded with had two stages, Invoice and Paid, and no `void` one - and the console offers a delete only on a `draft` stage, which it also has not got. So an invoice raised by mistake could never be canceled, and the order behind it refused every later attempt with \"void it before raising another\", an instruction with nowhere to carry it out. MEASURED: 205 live workflows, 52 with an exit. The QUOTE workflows in the same source file have had Declined and Expired since they were written. Add a terminal `stageType: 'void'` stage; entering one stamps voidedAt, sets the status and publishes crm.billing_document.voided."
node scripts/check-destructive-confirm.mjs >/dev/null || fail "a console screen deletes something with no confirm anywhere in the file - run `pnpm check:confirm` to see it. NOTE: the control for a delete is almost always a small icon sitting beside a harmless one. On Orders to approve, a trash can sat a thumb-width from the on/off switch of a spending limit: the switch is reversible and the bin was not, with no question asked, no toast and no way back - and what it took away was the only thing holding a large wholesale order for sign-off. Nothing fails, nothing logs, and the row is simply gone. Put it behind `useConfirm` from lib/confirm naming what STOPS happening, or add the file to ALLOWED with the reason it takes nothing away."
node scripts/check-broker-topics.mjs >/dev/null || fail "the CRM bridge tees a topic onto the event bus that nothing can receive - run `pnpm check:broker-topics` to see it. NOTE: a publish that reaches nobody looks exactly like one that works. An order is announced to the platform on `order.placed` and only that topic - the search indexer, the dropship router and every automation keyed on a new order subscribe it - and checkout-service was the only publisher. Every other caller of orderService.create relied on the `order.created` the service emits, which is the CRM spine's IN-PROCESS signal, is not in the event catalog, and was teed onto the bus where no worker subscribes it. MEASURED on one shop: 18 orders, 16 indexed; the two missing were the one typed in at the till and the one a repeat order raised. Put the topic in the EventType catalog and give it a subscriber, stop teeing it, or list it in FAN_IN_ONLY with the file that reads it."
node scripts/check-price-offers.mjs >/dev/null || fail "a price-offer workflow slug is spelled out somewhere other than the one file that owns it - run `pnpm check:price-offers` to see where. NOTE: a quote and an invoice are the SAME ROW on two different workflows, and only the slug tells them apart (the stage customer label cannot - on the quotes workflow it holds a standing like Draft or Quoted, on the invoice workflow it holds a name like Invoice or Receipt). Four places had to know, three kept their own copy, and the page a shop received said INVOICE, Unpaid, Balance due 504.00 over a price nobody had agreed to. Import B2B_QUOTE_WORKFLOW_SLUG, CUSTOMER_ESTIMATE_WORKFLOW_SLUG, isPriceOfferWorkflow or billingDocumentNoun from @wizeworks/crm-schemas/builtins, or add the file to EXEMPT in the check WITH the reason."
node scripts/check-color-names.mjs >/dev/null || fail "a component was given a color name the app never registered - run `pnpm check:colors` to see it. NOTE: this class of failure RENDERS. Silica emits one class per registered name, an unregistered one emits nothing, and the component falls back to grey - so `color: 'b2b'` against a registered `module-b2b` put a grey Wholesale badge beside every trade buyer in both consoles, on the till where that badge is what says who gets agreed prices. TypeScript cannot catch it: `SilicaColor` is `... | (string & {})`, so every string is assignable. The registered list is each app's own `@plugin '@wizeworks/silicaui' { colors: ... }` block; module hues are `module-<slug>`, never `<slug>`."
node scripts/check-toolbar-primary.mjs >/dev/null || fail "a console toolbar put a commit action in the relocatable \`controls\` slot — run \`pnpm check:toolbars\` to see it. NOTE: the failure is INVISIBLE at the width anyone develops at — a Save in \`controls\` looks perfect on a desktop pane and only folds into the overflow popover below 672px, putting the one control a person came to press behind a tap they have no reason to expect. This check scanned only piggles until 2026-09-19, while sparx carried the rule in its own header and 21 breaches of it; those are pinned in SPARX_DEBT and the list can only shrink."
node scripts/check-toolbar-glyph.mjs >/dev/null || fail "a console toolbar button renders as an icon with NO WORDS - run \`pnpm check:toolbar-glyph\` to see it. NOTE: \`controls\` is relocated into the overflow popover VERBATIM, and only \`actions\` are re-authored there as labelled rows. A menu has no position to read and no hover on a touch screen, so a bare glyph among labelled rows is a button with no meaning. Both pane-toolbar-overflow.tsx and calendar-toolbar.tsx already said so, next to 48 call sites that did it anyway - on a purchase order the popover read: a printer glyph, Close, Refresh this list, Copy a link to this. Declare it in \`actions\` (label + icon, tone: danger when destructive), or put a word inside the button."
node scripts/check-select-name-width.mjs >/dev/null || fail "a picker puts a width WE chose on a name the BUSINESS typed - run \`pnpm check:select-name-width\` to see it. NOTE: the recipe pane's location picker read \"Fulfillment Cente\" with 700 pixels going spare beside it, because \`max-w-40\` is a guess about how long somebody else's warehouse name is. Worse, the guess is invisible in a toolbar: PaneToolbar sets \`[&>.select]:max-w-full\` on its slots, which OUTRANKS the cap, so somebody widened the calendar's picker a step, wrote a note explaining the new number, and changed nothing at all. A cap on one of these is a lie in a bar and a defect in a card. Use \`FITS_ITS_NAME\` from components/pane-toolbar.tsx instead."
node scripts/check-country-picker.mjs >/dev/null || fail "a Country field is a box to type a two-letter code into - run \`pnpm check:country-picker\` to see it. NOTE: \`lib/geo.ts\` has said \"a shop owner should never SEE a code\" in its own header since it was written, and it said it to TWO screens; the other seven address forms per console asked her to type it, one of them under a line teaching her that Germany is DE. The drift is already in the data: one scheduling place holds \`country = \"United States\"\` while every other address row holds \`US\`, which no shipping zone or tax zone will ever match. Use \`CountryField\` from components/country-field.tsx - it lists every country by NAME, hands back the code, and keeps an existing value that is not a code rather than dropping it silently."
node scripts/check-currency-picker.mjs >/dev/null || fail "a Currency field is an empty box to type three letters into - run `pnpm check:currency-picker` to see it. NOTE: nine Currency fields per console did FOUR different things - gift cards listed names, selling settings listed names with the code, special prices and bookings listed bare codes, and five were an empty box with maxLength 3 and no list at all. `US Dollar` was already written down twice, in two spellings, while five screens still asked a shop owner to know that dollars are USD. The schema behind them checks three letters and nothing else, so ZZZ saves and prints on an invoice forever, and `money-format.ts` exists because 123 typed into one of them took a delivery pane out. Use `CurrencyField` from components/currency-field.tsx - it lists every currency by NAME with its code in brackets, hands back the code, and keeps an existing value it cannot name rather than dropping it silently."
node scripts/check-scroll-squash.mjs >/dev/null || fail "a scrolling column can squash its own content flat - run \`pnpm check:scroll-squash\` to see it. NOTE: \`PANE_SHELL_SCROLL\` has carried the reason in its own header since issue 505 - silica's \`.card\` sets \`overflow: hidden\`, so \`min-height: auto\` resolves to 0 and a card shrinks below its own content and clips the rest, with no scrollbar of its own to get it back - and that was written about the pane SHELL while 59 INNER scroll columns were the same shape without it. Paying for what sold squashed both its empty states by about 130px and cut both explanations off mid-sentence, and the outer column measured as fitting so there was no scrollbar anywhere. Add \`[&>*]:shrink-0\`."
node scripts/check-load-error-reason.mjs >/dev/null || fail "a pane decides for itself why it could not load - run \`pnpm check:load-error-reason\` to see it. NOTE: \`paneLoadReason\` answers three ways and each one has a persona issue behind it (286: a 404 is not an unreachable server; 467: a 5xx is not one either, the server answered; 726: a malformed address is a 404 wearing a different number). 43 call sites wrote the TWO-case version by hand as \`reason={gone ? 'missing' : 'unreachable'}\` where \`gone\` is a 404-only test, so every one of them was still answering 286 and neither of the other two. \`<PaneLoadError>\` already takes \`title\`/\`description\` for the reachable case and \`missingTitle\`/\`missingDescription\` for the gone one and works the reason out from \`error\`. Hand it the error and the words, never the verdict. A LITERAL \`reason=\"missing\"\` is still fine: that is a pane that knows, with no error to read."
node piggles/scripts/check-theme-opacity.mjs >/dev/null || fail "a Piggles color token carries an alpha byte, so everything painted from it is see-through — run \`pnpm check:piggles-theme\` to see it. NOTE: this class of failure is valid CSS and passes typecheck, lint and every test; the only symptom is that a whole group of apps looks washed out."
node piggles/scripts/check-apps.mjs >/dev/null || fail "a Piggles app has no glyph, or a module has surfaces and no door — run \`pnpm check:piggles-apps\` to see it. NOTE: an app nobody can reach renders nothing at all; \`funnels\` shipped two surfaces, a hue and a nav slot with no app claiming it, so All apps — which says \"Everything Piggles does\" — did not list it."
node piggles/scripts/check-nav-vocabulary.mjs >/dev/null || fail "a Piggles screen is showing sparx's words, or naming another company — run \`pnpm check:piggles-nav\` to see it. NOTE: this guard existed and was NOT wired here, so the leak it was written for (issue 362, fourteen competitors named on the first screen a business meets) could have shipped again unblocked."
node piggles/scripts/check-screen-names.mjs >/dev/null || fail "a Piggles pane calls itself by the name Piggles renamed away - run \`pnpm check:screen-names\` to see it. NOTE: vocabulary.ts renames the screen on the TAB, the nav and the launcher, and reaches none of the sentences INSIDE the pane. A shop owner opened Half-finished checkouts and read \"Loading checkout sessions...\" and \"No checkout sessions\" in its own body - two names for one thing, and the second is the word the rename exists to keep away from her. 84 sentences across 23 panes were doing it. Write the sentence, never substitute the name: \"Could not load your page results\" becomes \"Could not load how your pages are doing\", not \"Could not load your how your pages do\"."
