#!/usr/bin/env bash
# Pre-push guard. Runs the exact checks CI runs so red builds never reach
# `main`. Enable once with `git config core.hooksPath .githooks` (the root
# `prepare` script in package.json does this automatically after install).
#
# Bypass intentionally with `git push --no-verify` if you really need to.

set -e

# Color helpers (no-op when not a TTY)
if [ -t 1 ]; then
  GREY=$'\033[90m'; RED=$'\033[31m'; GREEN=$'\033[32m'; RESET=$'\033[0m'
else
  GREY=""; RED=""; GREEN=""; RESET=""
fi

step() { printf "${GREY}→${RESET} %s\n" "$1"; }
ok()   { printf "${GREEN}✓${RESET} %s\n" "$1"; }
fail() { printf "${RED}✗ %s${RESET}\n" "$1"; exit 1; }

step "pre-push: verifying tree before push"

step "pnpm install --frozen-lockfile (lockfile drift check)"
# --ignore-scripts skips postinstall (prisma generate); the hook only needs
# to verify lockfile consistency, not regenerate the client. Avoids the
# Windows EPERM file-lock that postinstall is prone to on already-built
# Prisma engines.
pnpm install --frozen-lockfile --ignore-scripts --silent || fail "pnpm-lock.yaml out of sync with a package.json — run \`pnpm install\` and commit the updated lockfile"
ok "lockfile in sync"

# `--ignore-scripts` above means NOTHING here generates the Prisma client, and
# the lint/typecheck steps below simply use whatever is already on disk. In a
# checkout that has ever run a full `pnpm install`, that is fine.
#
# In a FRESH one it is not, and the failure is maximally misleading: with no
# generated client, every `prisma.*` call types as `any`, and typed-lint reports
# ~1500 `no-unsafe-*` errors naming YOUR source files. Nothing in that output
# says "the client is missing."
#
# This is not a hypothetical checkout. It is the standard escape hatch when a
# parallel agent's half-finished work is blocking a push: `git worktree add
# <path> origin/main`, commit there, push from there — the hook then validates
# committed state instead of somebody else's WIP. That worktree is always fresh,
# so the recipe for getting out of one trap landed directly in another
# (2026-08-09, and again 2026-08-10).
#
# Generating only when ABSENT is what keeps this compatible with the reason
# `--ignore-scripts` exists. The Windows EPERM file-lock happens when Prisma
# tries to overwrite an engine binary that a running `next dev` still holds
# open; if there is no client at all, there is nothing to overwrite and nothing
# holding a lock. So the case we skip and the case we handle are disjoint.
#
# The probe resolves @prisma/client and looks for the GENERATED tree beside it,
# rather than `require.resolve('.prisma/client')` — under pnpm's isolated layout
# `.prisma` is a sibling of `@prisma` inside the virtual store and resolves from
# nowhere the hook could run. Both candidate positions are checked so a hoisted
# node_modules works too; getting this wrong in the safe direction (reporting
# ABSENT when it is present) would regenerate on every push, which is the exact
# EPERM risk `--ignore-scripts` was added to avoid.
step "prisma client present"
if node -e "
  const path = require('path'), fs = require('fs');
  // Resolved FROM packages/db, never from the repo root: pnpm does not hoist,
  // so @prisma/client is not resolvable at the top level and a bare
  // require.resolve here throws MODULE_NOT_FOUND even when the client is
  // perfectly healthy — which would regenerate on every single push.
  const dir = path.dirname(
    require.resolve('@prisma/client', { paths: [path.join(process.cwd(), 'wizeworks', 'packages', 'db')] })
  );
  const found = ['../..', '..', '../../..']
    .map((up) => path.join(dir, up, '.prisma', 'client', 'index.js'))
    .some((p) => fs.existsSync(p));
  process.exit(found ? 0 : 1);
" 2>/dev/null; then
  ok "client already generated"
else
  printf "  no generated Prisma client (fresh checkout) — generating once\n"
  pnpm --filter @wizeworks/db db:generate >/dev/null 2>&1 \
    || fail "prisma generate failed — run \`pnpm --filter @wizeworks/db db:generate\` to see it"
  ok "client generated"
fi

# The pure-Node structural checks CI runs. Under a second each, no install, and
# they catch the class of drift that otherwise surfaces minutes into a release
# build: an event with no topic, a surface with no address, an image built
# without a package it imports.
step "structural checks (events, routes, dockerfiles, brand isolation, console parity)"
node scripts/check-event-topics.mjs >/dev/null || fail "event/topic parity failed — run \`pnpm check:events\` to see it"
node scripts/check-surface-routes.mjs >/dev/null || fail "surface/address parity failed — run \`pnpm check:routes\` to see it"
node scripts/check-dockerfile-deps.mjs >/dev/null || fail "a Dockerfile is missing a workspace package it imports — run \`pnpm check:docker\` to see it"
node scripts/check-dockerfile-paths.mjs >/dev/null || fail "a Dockerfile path no longer resolves — run \`pnpm check:docker-paths\` to see it. NOTE: the destination class of this failure BUILDS fine and crashloops on start."
node scripts/check-boundaries.mjs >/dev/null || fail "a product boundary broke, or piggles grew a new \`@sparx/*\` dependency — run \`pnpm check:boundaries\` to see it"
node scripts/check-deletability.mjs >/dev/null || fail "piggles now depends on a sparx-owned package — deleting sparx would break its build. Run \`pnpm check:deletability\` for the chain"
node scripts/check-webhook-events.mjs >/dev/null || fail "webhook event lists have drifted — run \`pnpm check:webhooks\` to see it"
node scripts/check-billing-plans.mjs >/dev/null || fail "a billing plan and the prod ConfigMap have drifted, or a plan is malformed — run \`pnpm check:billing-plans\` to see it. NOTE: this class of failure DEPLOYS green and charges the wrong price."
node scripts/check-inventory-api-docs.mjs >/dev/null || fail "the inventory API reference is stale — run \`pnpm gen:inventory-api\` to rebuild it"
node piggles/scripts/check-toolbar-primary.mjs >/dev/null || fail "a Piggles toolbar put a commit action in the relocatable `controls` slot — run `pnpm check:piggles-toolbars` to see it"
node scripts/check-console-parity.mjs >/dev/null || fail "the two consoles have drifted — one has system furniture the other lacks. Run \`pnpm check:console-parity\` to see which, and either build it or argue it onto the exception list"
ok "structure clean"

step "pnpm format:check"
pnpm format:check >/dev/null || fail "prettier found unformatted files — run \`pnpm format\` and commit"
ok "format clean"

# Terraform has its OWN formatter, enforced by a SEPARATE CI job, so `fmt` drift
# is invisible to every check above it and surfaces only after the push — in the
# one place this hook exists to keep green. It needs neither providers nor state
# (`fmt` is pure lexical rewriting), so it costs milliseconds and no init.
#
# What actually breaks is alignment, and it breaks at a distance: `fmt` aligns
# `=` across a run of CONSECUTIVE lines, so adding a COMMENT between two aligned
# entries splits the run and re-flows lines nobody touched. That is exactly how
# envs/prod/main.tf drifted (2026-08-14) — two comments added above two already
# correct entries, and the diff CI rejected was on neither of them.
#
# Skipped, not failed, when terraform is absent: it is not part of the JS
# toolchain, `pnpm install` does not provide it, and a hook that blocks a push
# over a missing binary is stricter than CI — which is how hooks get bypassed.
# Printed either way so the skip stays a visible decision.
step "terraform fmt -check"
if command -v terraform >/dev/null 2>&1; then
  (cd terraform && terraform fmt -check -recursive >/dev/null) \
    || fail "terraform fmt found unformatted files — run \`(cd terraform && terraform fmt -recursive)\` and commit"
  ok "terraform fmt clean"
else
  printf "  terraform not installed — skipped (the CI terraform job still enforces it)\n"
fi

# Bypass turbo's `^build` dep graph by running each workspace's lint/typecheck
# script directly, against the generated artifacts on disk — which the step
# above has now guaranteed exist. CI runs the full turbo graph as the source of
# truth. Avoids EPERM on locked Prisma DLLs when `next dev` is running locally.
# NODE_OPTIONS raises the V8 old-space cap for both steps below.
#
# `@sparx/api-rest` is one `tsc` program over 469 files and type-checks just
# under V8's DEFAULT ceiling (~4 GB), so it is permanently on the edge: it
# finishes on a good run and dies on a bad one. When it dies here it does NOT
# look like a memory problem — on Windows it is a bare `Segmentation fault` and
# `Exit status 3221225477` from whichever package happened to be running when
# the box ran short, so the hook blames an innocent workspace and the same push
# succeeds on retry. CI hit the identical wall as
# `FATAL ERROR: Ineffective mark-compacts near heap limit`.
#
# 8192 rather than CI's 6144 because a dev machine has the headroom and this
# runs at workspace-concurrency=4.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=8192}"

step "pnpm -r run lint"
pnpm -r --workspace-concurrency=4 run lint || fail "eslint failed — fix errors above and commit"
ok "lint clean"

step "pnpm -r run typecheck"
pnpm -r --workspace-concurrency=4 run typecheck || fail "tsc found type errors — fix errors above and commit"
ok "typecheck clean"

# CI=true so this excludes the same DB-backed integration suites CI excludes
# (see e.g. packages/inventory/vitest.config.ts). Without it the hook would
# demand a running `pnpm db:up` on every push and fail for anyone who has not
# got one — a check stricter than CI, which is how hooks get bypassed.
step "pnpm -r run test"
CI=true pnpm -r --workspace-concurrency=4 run test || fail "tests failed — fix the failures above and commit"
ok "tests clean"

step "pnpm --filter @wizeworks/db db:rls-audit"
pnpm --filter @wizeworks/db db:rls-audit >/dev/null || fail "RLS audit failed — see output above; hand-edit the migration SQL to add the missing clauses (ENABLE+FORCE+POLICY, a current_tenant_id() GUC read, or an owner-read policy for a cross-tenant scan)"
ok "RLS audit clean"

printf "${GREEN}✓ pre-push checks passed${RESET}\n"
