// Sparx data layer — generator + datasource configuration.
//
// Multi-file schema: every .prisma file in this directory contributes to a
// single Prisma schema. One file (this one) owns the generator and
// datasource blocks; the rest add models. Splitting by domain keeps every
// file under the 200-line limit and stops the monolith from turning into a
// 1500-line scroll-wall on every CRM/Commerce/B2B addition.
//
// Conventions every model file follows:
//   • Tenant-scoped tables FK back to Tenant with onDelete: Cascade.
//   • Multi-tenant rows get @map'd snake_case + the standard FORCE RLS
//     policy in their migration (see packages/db/prisma/migrations/).
//   • updatedAt uses @updatedAt; the migration ALTER TABLE ... DROP DEFAULT
//     so Prisma owns the timestamp end-to-end.
//
// Better Auth conventions: User, Session, Account, Verification shapes are
// Better Auth-compatible (docs/16-auth-security.md §1) with Sparx-specific
// extensions on User.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATION_DATABASE_URL")
  extensions = [pgcrypto]
}

// Tenant — the dispatch row every other table FKs back to. Better Auth's
// `organization` plugin maps 1:1 onto this row (docs/16 §2 Layer 1) — the
// org id will be stored alongside this tenant when Better Auth is wired in.
//
// This file is unavoidably the "relation hub" — every module that owns
// tenant-scoped tables declares an inverse relation here. New modules add
// their array to the matching section below; the field count is a quick
// way to see how much surface the platform exposes per tenant.

model Tenant {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String    @unique @db.VarChar(63)
  name                 String    @db.VarChar(255)
  email                String    @db.VarChar(255)
  plan                 String    @default("starter") @db.VarChar(50)
  status               String    @default("active") @db.VarChar(20)
  settings             Json      @default("{}")
  // Site-wide social links — an ORDERED array of { platform, url } (the same
  // shape the storefront `site.social` binding renders): `platform` is a known
  // key (instagram, x, …) for icon mapping, or a free-text label for an "Other"
  // link. A SITE setting (not brand identity, not theme): edited in
  // /settings/general, theme-independent — switching the storefront theme never
  // touches it. The public tenant payload carries it so the storefront chrome
  // resolves real links. Moved here from TenantBrand.socials (docs/45 §3).
  socials              Json      @default("[]")
  // Platform billing (docs/67) — the WizeWorks subscription that charges this
  // tenant per active module. `stripeCustomerId` + `trialEndsAt` already existed;
  // the rest complete the picture. Reconciled from Stripe webhooks (the source of
  // truth for subscription state). `stripeCustomerId` is unique — one platform
  // customer per tenant. Tenants is non-RLS (the dispatch row), so the webhook can
  // resolve a tenant from a Stripe customer id before any tenant context is set.
  stripeCustomerId     String?   @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeAccountId      String?   @map("stripe_account_id") @db.VarChar(255)
  stripeSubscriptionId String?   @map("stripe_subscription_id") @db.VarChar(255)
  // trialing | active | past_due | canceled | unpaid | paused
  subscriptionStatus   String?   @map("subscription_status") @db.VarChar(20)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  billingInterval      String    @default("monthly") @map("billing_interval") @db.VarChar(10)
  trialEndsAt          DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Marketing attribution (docs/80 §8.3) — L-PLAT acquisition snapshot, written
  // once at signup from the first-party attribution cookies. The tenants table is
  // intentionally non-RLS (the dispatch row), so these are a pure additive ALTER —
  // no policy SQL, no backfill.
  acquisitionChannel    String?   @map("acquisition_channel") @db.VarChar(50)
  acquisitionSource     String?   @map("acquisition_source") @db.VarChar(255)
  acquisitionCampaign   String?   @map("acquisition_campaign") @db.VarChar(255)
  acquisitionFirstTouch Json?     @map("acquisition_first_touch")
  acquisitionLastTouch  Json?     @map("acquisition_last_touch")
  acquiredAt            DateTime? @map("acquired_at") @db.Timestamptz

  // Platform core — brand identity (tenant-level source of truth, docs/30 §6)
  brand TenantBrand?

  // Multi-property (multi-site) — a tenant's web properties (docs/49). Phase 1
  // seeds exactly one is_primary property per tenant; the Builder presentation
  // layer re-keys onto property_id in a later slice.
  properties        Property[]
  // Tenant blueprint installs (docs/54) — one row per marketplace template
  // installed into one of this tenant's properties.
  blueprintInstalls TenantBlueprintInstall[]
  // Custom + purchased hostnames across this tenant's sites (docs/49 §5, docs/24).
  domains           Domain[]
  // Billing + audit ledger for every domain registration/renewal/transfer (docs/24 §7).
  domainPurchases   DomainPurchase[]

  // Auth + audit
  users             User[]
  auditLogs         AuditLog[]
  // Bulk-operation revert ledger (docs/69 B-3) — before-state for undoable
  // bulk mutations (price adjustment, …) retained for a 30-minute window.
  bulkOpReverts     BulkOpRevert[]
  // Web Push subscriptions for staff browser notifications (docs/69 A-6).
  pushSubscriptions PushSubscription[]
  apiKeys           ApiKey[]

  // Marketplace (docs/60 §6) — the publisher identities this tenant owns when it
  // publishes blueprints/themes/components/integrations (Phase 5+). Sparx-core
  // listings belong to the seeded `sparx` publisher, not a tenant.
  marketplacePublishers MarketplacePublisher[]

  // Dashboard shell — per-user pinned/recent navigation state
  userFavorites UserFavorite[]
  userRecents   UserRecent[]

  // CMS module
  pages                Page[]
  contentTypes         ContentType[]
  contentEntries       ContentEntry[]
  contentRevisions     ContentRevision[]
  contentReferences    ContentReference[]
  taxonomies           Taxonomy[]
  taxonomyTerms        TaxonomyTerm[]
  entryTaxonomyTerms   EntryTaxonomyTerm[]
  authors              Author[]
  redirects            Redirect[]
  navigationMenus      NavigationMenu[]
  navigationItems      NavigationItem[]
  previewTokens        PreviewToken[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries    WebhookDelivery[]
  mediaAssets          MediaAsset[]
  mediaVariants        MediaVariant[]

  // CRM module — customer spine
  customers         Customer[]
  customerAddresses CustomerAddress[]
  b2bAccounts       B2BAccount[]

  // CRM module — sales pipeline
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  dealOrders     DealOrder[]
  dealQuotes     DealQuote[]

  // CRM module — orders, payments, refunds, fulfillments
  orders                Order[]
  orderItems            OrderItem[]
  orderPayments         OrderPayment[]
  orderRefunds          OrderRefund[]
  orderRefundItems      OrderRefundItem[]
  orderFulfillments     OrderFulfillment[]
  orderFulfillmentItems OrderFulfillmentItem[]

  // CRM module — quotes
  quotes     Quote[]
  quoteItems QuoteItem[]

  // CRM module — activity, tasks, segments, views
  crmActivities  CrmActivity[]
  tasks          Task[]
  segments       Segment[]
  segmentMembers SegmentMember[]
  savedViews     SavedView[]

  // Commerce module — catalog
  products            Product[]
  productTranslations ProductTranslation[]
  productOptions      ProductOption[]
  productOptionValues ProductOptionValue[]
  productVariants     ProductVariant[]
  variantImages       VariantImage[]
  productCategories   ProductCategory[]
  productCollections  ProductCollection[]

  // Commerce module — fitment (generalized: vehicle, pet, device, ...)
  fitmentDomains    FitmentDomain[]
  fitmentCategories FitmentCategory[]
  fitmentItems      FitmentItem[]
  fitmentVariants   FitmentVariant[]
  productFitments   ProductFitment[]

  // Commerce module — inventory + lots
  warehouses            Warehouse[]
  inventoryLevels       InventoryLevel[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryReservations InventoryReservation[]
  lotBatches            LotBatch[]
  serialUnits           SerialUnit[]

  // Commerce module — pricing + discounts
  priceLists             PriceList[]
  priceListEntries       PriceListEntry[]
  bulkPriceTiers         BulkPriceTier[]
  contractPrices         ContractPrice[]
  markupRules            MarkupRule[]
  markupRecomputeReviews MarkupRecomputeReview[]
  surchargeRules         SurchargeRule[]

  // Invoicing module (docs/87) — authored billing documents
  documentWorkflows        DocumentWorkflow[]
  documentStages           DocumentStage[]
  billingDocumentLineTypes BillingDocumentLineType[]
  billingDocuments         BillingDocument[]
  billingDocumentLines     BillingDocumentLine[]
  billingDocumentSnapshots BillingDocumentSnapshot[]
  billingDocumentPayments  BillingDocumentPayment[]
  billingDocumentTemplates BillingDocumentTemplate[]
  discounts                Discount[]
  discountUsages           DiscountUsage[]
  giftCards                GiftCard[]
  giftCardTransactions     GiftCardTransaction[]
  storeCredits             StoreCredit[]
  storeCreditTransactions  StoreCreditTransaction[]

  // Commerce module — bundles + configurator
  bundles                Bundle[]
  bundleComponents       BundleComponent[]
  configurationTemplates ConfigurationTemplate[]
  configurationOptions   ConfigurationOption[]
  configurationRules     ConfigurationRule[]
  configurationAddOns    ConfigurationAddOn[]

  // Commerce module — cart + checkout
  carts            Cart[]
  cartItems        CartItem[]
  cartDiscounts    CartDiscount[]
  checkoutSessions CheckoutSession[]

  // Commerce module — subscriptions
  subscriptions      Subscription[]
  subscriptionItems  SubscriptionItem[]
  subscriptionEvents SubscriptionEvent[]
  dunningAttempts    DunningAttempt[]

  // Commerce module — reviews + Q&A + wishlists
  productReviews      ProductReview[]
  reviewMedia         ReviewMedia[]
  reviewHelpfulVotes  ReviewHelpfulVote[]
  reviewModerationLog ReviewModerationLog[]
  productQuestions    ProductQuestion[]
  productAnswers      ProductAnswer[]
  wishlists           Wishlist[]
  wishlistItems       WishlistItem[]

  // Commerce module — returns
  returnRequests    ReturnRequest[]
  returnLineItems   ReturnLineItem[]
  returnInspections ReturnInspection[]
  returnLabels      ReturnLabel[]

  // Commerce module — shipping
  shippingZones    ShippingZone[]
  shippingProfiles ShippingProfile[]
  shippingRates    ShippingRate[]

  // Commerce module — tax
  taxZones      TaxZone[]
  taxRates      TaxRate[]
  taxExemptions TaxExemption[]

  // Commerce module — provider marketplace
  providerInstallations ProviderInstallation[]
  providerWebhookEvents ProviderWebhookEvent[]

  // Commerce module — storefront defaults + theme. Per web PROPERTY (docs/49
  // Phase 6): a tenant's sites each keep their own applied theme + settings, so
  // these are arrays, not one-per-tenant.
  storefrontSettings StorefrontSettings[]
  storefrontThemes   StorefrontTheme[]

  // Customer-auth (Layer 2) — storefront shopper credentials/sessions (docs/27)
  customerIdentities     CustomerIdentity[]
  customerCredentials    CustomerCredential[]
  customerAuthSessions   CustomerSession[]
  customerPasswordResets CustomerPasswordReset[]

  // Sitebuilder module — theme/layout/page composition + publish history (docs/29).
  // The applied-theme trio (config/versions/schedules) is per web PROPERTY
  // (docs/49 Phase 6): each of a tenant's sites publishes its own theme, so
  // siteConfigs is an array. The legacy section tier + the saved-theme LIBRARY
  // stay tenant-wide.
  siteConfigs          SiteConfig[]
  siteVersions         SiteVersion[]
  pageLayouts          PageLayout[]
  siteSections         SiteSection[]
  siteLayoutBlocks     SiteLayoutBlock[]
  sitePublishSchedules SitePublishSchedule[]
  siteThemes           SiteTheme[]
  siteLayoutDefaults   SiteLayoutDefault[]
  siteLayoutAssign     SiteLayoutAssignment[]
  sectionDefinitions   TenantSectionDefinition[]

  // Builder module — composition-model page editor (docs/41)
  builderPages             BuilderPage[]
  // Builder module — the site layout / chrome shell (docs/45)
  builderLayouts           BuilderLayout[]
  // Builder module — per-record template overrides (docs/51 §6)
  builderPageAssignments   BuilderPageAssignment[]
  // Builder module — the Email Builder's emails (docs/52)
  builderEmails            BuilderEmail[]
  // Builder module — tenant-authored components + their versions (docs/53)
  builderComponents        BuilderComponent[]
  builderComponentVersions BuilderComponentVersion[]

  // SEO — stored audit scorecard snapshots for the site-wide overview (docs/50 §7)
  seoAudits SeoAudit[]

  // Email platform — management surface (docs/13)
  emailSettings       EmailSettings?
  sendingDomains      SendingDomain[]
  emailTemplates      EmailTemplate[]
  emailScheduledSends ScheduledSend[]
  broadcasts          Broadcast[]
  emailEvents         EmailEvent[]
  emailSuppressions   EmailSuppression[]

  // Legal & consent (docs/42)
  storefrontDocPlacements StorefrontDocPlacement[]
  consentSettings         ConsentSettings?
  consentRecords          ConsentRecord[]
  legalAcceptances        PlatformLegalAcceptance[]

  // Onboarding (docs/65 Ph2) — per-tip progress rows shown for 7 days post-signup
  onboardingChecklist OnboardingChecklist[]

  // Import jobs (docs/68 §8) — background CSV import processing
  importJobs ImportJob[]

  // Live Chat module (docs/56, docs/69 Track A)
  chatConversations ChatConversation[]
  chatMessages      ChatMessage[]
  chatQuickReplies  ChatQuickReply[]

  // B2B pricing (docs/10, docs/64) — pricing tiers, per-product overrides, invoices, portal contacts, approval rules
  b2bPricingTiers            B2bPricingTier[]
  b2bTierProductOverrides    B2bTierProductOverride[]
  b2bAccountProductOverrides B2bAccountProductOverride[]
  b2bInvoices                B2bInvoice[]
  b2bAccountContacts         B2bAccountContact[]
  purchaseApprovalRules      PurchaseApprovalRule[]

  // B2B scheduling (docs/64 Ph7)
  serviceTypes        ServiceType[]
  serviceAppointments ServiceAppointment[]

  // Dropship (docs/14, docs/64 Ph1)
  dropshipSuppliers    DropshipSupplier[]
  dropshipProducts     DropshipProduct[]
  dropshipProductLinks DropshipProductLink[]
  dropshipOrders       DropshipOrder[]

  // Inventory Sync (docs/64 Ph Inv-1)
  inventorySources     InventorySource[]
  stockLocations       StockLocation[]
  stockLevels          StockLevel[]
  inventorySourceLinks InventorySourceLink[]

  // Automation module (docs/81) — the cross-module rule engine
  automations        Automation[]
  automationRuns     AutomationRun[]
  automationRunSteps AutomationRunStep[]
  automationVersions AutomationVersion[]

  // Platform billing (docs/67) — one Stripe subscription item per active module
  billingSubscriptionItems BillingSubscriptionItem[]

  @@map("tenants")
}

// ─── OnboardingChecklist ─────────────────────────────────────────────────────
// Per-tenant onboarding tip/task visibility state. Created eagerly at tenant
// creation (or lazily on first dashboard open); dismissed_at stamps when the
// tenant owner clicks the dismiss button on a tip card.
model OnboardingChecklist {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String    @db.VarChar(63)
  shownAt     DateTime? @map("shown_at") @db.Timestamptz
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "onboarding_checklist_tenant_key_unique")
  @@index([tenantId], map: "onboarding_checklist_tenant_idx")
  @@map("onboarding_checklist")
}

// Staff users + sessions + auth credentials (Layer 1 — tenant staff).
//
// Better Auth-compatible base columns + Sparx tenant/role extensions on
// `User`. Customer-facing accounts (Layer 2) live in `customers` and share
// zero rows with `users` per docs/16 §2.

model User {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Globally unique — Better Auth's sign-in flow keys on email alone, and
  // signUpMerchant creates a fresh tenant per registration, so the older
  // @@unique([tenantId, email]) compound never fired in practice. The
  // CITEXT-equivalent normalisation lives at the app layer (signUpMerchant
  // lowercases before insert); the migration adds a case-insensitive
  // expression index as a backstop.
  email         String  @unique @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")
  name          String? @db.VarChar(255)
  image         String? @db.Text

  // Sparx-specific extensions
  tenantId    String    @map("tenant_id") @db.Uuid
  role        String    @default("editor") @db.VarChar(50) // owner | admin | editor | viewer | api
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  // Per-user preferences bag. Keep narrow — anything tenant-scoped goes
  // on Tenant.settings; anything device-scoped goes in localStorage.
  // Known keys (TypeScript-narrowed in apps/dashboard/_shell/preferences.ts):
  //   defaultDetailView: 'drawer' | 'modal' | 'fullPage' | 'newTab'
  preferences Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          Session[]
  accounts          Account[]
  // Web Push subscriptions registered from this user's browsers (docs/69 A-6).
  pushSubscriptions PushSubscription[]

  // CRM module — staff acting as sales rep / task owner / activity actor
  assignedCustomers        Customer[]                @relation("CustomerAssignedRep")
  assignedB2bAccounts      B2BAccount[]              @relation("B2BAccountAssignedRep")
  assignedDeals            Deal[]                    @relation("DealAssignedRep")
  assignedTasks            Task[]                    @relation("TaskAssignedTo")
  createdTasks             Task[]                    @relation("TaskCreatedBy")
  completedTasks           Task[]                    @relation("TaskCompletedBy")
  createdQuotes            Quote[]                   @relation("QuoteCreatedBy")
  b2bInvoicesPaid          B2bInvoice[]              @relation("B2bInvoicePaidBy")
  billingDocumentsAssigned BillingDocument[]         @relation("BillingDocumentAssignee")
  billingLinesAsTechnician BillingDocumentLine[]     @relation("BillingLineTechnician")
  billingSnapshotsAuthored BillingDocumentSnapshot[] @relation("BillingSnapshotAuthor")
  billingPaymentsRecorded  BillingDocumentPayment[]  @relation("BillingPaymentRecordedBy")
  approvalRulesAsApprover  PurchaseApprovalRule[]    @relation("ApprovalRuleApprover")
  confirmedAppointments    ServiceAppointment[]      @relation("AppointmentConfirmedBy")

  // Live Chat module — conversations this staff user is assigned to (docs/56)
  assignedChats ChatConversation[] @relation("ChatAssignedTo")

  // Dashboard shell — per-user pinned/recent navigation state
  favorites UserFavorite[]
  recents   UserRecent[]

  // Platform legal — Sparx ToS/Privacy/AUP/DPA acceptance (docs/42 §6)
  legalAcceptances PlatformLegalAcceptance[]

  @@index([tenantId])
  @@map("users")
}

// Refresh-token rows used by Better Auth (docs/16 §3). The access JWT is
// stateless; this table backs the rotating refresh token + device tracking.

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255) // SHA-256 of refresh token
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// One row per (provider, userId). For email/password the providerId is
// "credential" and `password` carries the Argon2 hash; for OAuth providers
// it's "google" / "github" / etc. with access/refresh tokens.

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id") @db.VarChar(50)
  accountId             String    @map("account_id") @db.VarChar(255)
  password              String?   @db.Text
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?   @db.Text
  idToken               String?   @map("id_token") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Short-lived single-use tokens for magic links / email verification /
// password reset. `identifier` is typically the email; `value` is the
// hashed token; `expiresAt` is enforced by the auth service.

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

// Append-only audit log. Every state-changing service writes one row inside
// the same transaction as the primary write (docs/05 §5, docs/16 §7).
// Partitioned by month + archived to GCS after 2 years in a follow-up
// migration — for now a single table is sufficient.

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String?  @map("actor_type") @db.VarChar(20) // user | system | api | mcp | customer
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  diff       Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// External API keys (docs/07 §5).
//
// Issued by the dashboard's AI Integrations settings page. Each key is
// hashed with Argon2id on insert; the plaintext is shown ONCE in the modal
// and never persisted. Verification reads the row by `keyPrefix` (the first
// 12 visible characters: `sk_live_xxxx`) then Argon2-verifies the suffix
// against `keyHash`.
//
// Scopes carry the same vocabulary as the MCP tool registry —
// `read:crm`, `write:crm`, `write:crm_bulk`, plus per-module additions as
// they ship. Empty array = no permissions (still a valid key for a
// future "lookup-only" flow).

model ApiKey {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Human-readable label set by the tenant in the dashboard.
  name String @db.VarChar(120)

  // First 12 chars of the displayed key — `sk_live_<8 random>`. Stored
  // separately from the hash so the dashboard can render a recognizable
  // truncated form ("sk_live_ab12…") next to last-used timestamps.
  keyPrefix String @map("key_prefix") @db.VarChar(16)

  // Argon2id hash of the full key minus the prefix. Verification:
  // `argon2.verify(keyHash, request_full_key.slice(prefix.length))`.
  keyHash String @map("key_hash") @db.Text

  // Whitelisted scopes. Stored as a Postgres TEXT[] for cheap `&&` overlap
  // checks during MCP tool dispatch.
  scopes String[] @db.Text

  // Optional expiry the tenant sets at issuance; null = no expiry.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  // Bumped each time the key successfully authenticates. The dashboard
  // shows this so a tenant can confidently revoke a stale key.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  // Soft-delete: revocation sets `revokedAt`; verification rejects revoked
  // keys without deleting the row so the audit trail survives.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // The staff member who issued the key — needed for the audit-log actor
  // on tool calls made with this key.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([keyPrefix]) // collisions vanishingly unlikely (8 random chars) but enforced
  @@index([tenantId])
  @@index([tenantId, revokedAt])
  @@map("api_keys")
}

// Dashboard shell — per-user, per-tenant pinned navigation state.
//
// Favorites and Recents both key on (user_id, tenant_id) rather than a
// `tenant_membership_id` row, because the platform's User model carries
// `tenantId` directly today (one user, one tenant). When Better Auth's
// organization plugin lands and introduces real membership rows, this
// compound key migrates cleanly to `tenant_membership_id`.
//
// `action_id` is a free-form text matching a ModuleManifest action.id. No
// FK — manifests are code, not data. If a module is removed, orphaned
// favorites/recents become unrenderable and are filtered client-side.
//
// See docs/24-dashboard-shell.md §8.

model UserFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actionId  String   @map("action_id") @db.VarChar(120)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, actionId])
  @@index([userId, tenantId, position])
  @@map("user_favorites")
}

model UserRecent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actionId      String   @map("action_id") @db.VarChar(120)
  lastVisitedAt DateTime @default(now()) @map("last_visited_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, actionId])
  @@index([userId, tenantId, lastVisitedAt(sort: Desc)])
  @@map("user_recents")
}

// Tenant brand — the platform-wide source of truth for brand IDENTITY, owned
// ABOVE every module (not Site Builder, Commerce, or Email). It is captured in
// onboarding, survives any single module being gated off, and is READ-ONLY to
// every consumer (docs/30 §6): no module may override these tokens.
//
// The storefront theme APPLIES brand as its foundation and layers presentation
// tokens on top, but cannot redefine identity (brand color = brand color,
// everywhere). Email reads it directly for its BrandTokens (replacing the old
// EmailSettings.brandingOverride). Commerce's StorefrontTheme logo/favicon/
// palette source from here rather than being independently editable identity.
//
// Media ids (logo/favicon) are plain UUID soft references — no FK to MediaAsset
// — mirroring StorefrontTheme, so brand stays decoupled from the CMS media
// table being present. PK = tenantId (one brand per tenant).

model TenantBrand {
  tenantId String @id @map("tenant_id") @db.Uuid

  businessName String? @map("business_name") @db.VarChar(255)
  tagline      String? @db.VarChar(255)

  // Brand assets (soft references to MediaAsset by id).
  logoLightMediaId String? @map("logo_light_media_id") @db.Uuid
  logoDarkMediaId  String? @map("logo_dark_media_id") @db.Uuid
  faviconMediaId   String? @map("favicon_media_id") @db.Uuid

  // Core identity palette (hex). Presentation tokens stay in the storefront theme.
  // The `*Foreground` columns are the optional `-content` overrides for their
  // base colour (docs/33 §3.1); null = auto-derive for AA legibility. `secondary`
  // is the brand's second identity colour; it falls back to `primary` if unset.
  colorPrimary             String? @map("color_primary") @db.VarChar(7)
  colorPrimaryForeground   String? @map("color_primary_foreground") @db.VarChar(7)
  colorAccent              String? @map("color_accent") @db.VarChar(7)
  colorAccentForeground    String? @map("color_accent_foreground") @db.VarChar(7)
  colorSecondary           String? @map("color_secondary") @db.VarChar(7)
  colorSecondaryForeground String? @map("color_secondary_foreground") @db.VarChar(7)

  // Brand typography (font family names).
  fontHeading String? @map("font_heading") @db.VarChar(127)
  fontBody    String? @map("font_body") @db.VarChar(127)

  // Token Model v2 brand-owned NON-IDENTITY tokens (docs/33): shape (radius
  // trio + border width), rhythm (space base + control sizes), effect (depth).
  // A partial BrandTokenDoc — only the shape/rhythm/effect branches; colour +
  // type stay in the dedicated columns above (one source of truth per axis).
  // Null = no overrides → the theme preset's defaults apply.
  tokens Json? @db.JsonB

  // NOTE: social links moved OUT of brand to Tenant.socials — they are a SITE
  // setting (edited in /settings/general), not brand identity, and must not
  // change when the theme changes (docs/45 §3).

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brands")
}

// Property — a tenant's web property (a distinct site: presentation + page tree
// + domain) over the shared back office. The multi-site axis (docs/49): one
// TENANT has one-or-more PROPERTIES. Phase 1 seeds exactly one is_primary
// property per tenant and changes no behavior; the Builder presentation layer
// (builder_pages / builder_layouts) re-keys onto property_id in a later slice.
//
// NOT a security boundary. tenant_id remains the only RLS isolation boundary;
// property_id is application-tier scoping WITHIN a tenant (docs/49 §2). Two
// properties in one tenant can read each other's rows as far as Postgres is
// concerned — the app scopes by property_id. A tenant needing hard isolation
// uses two WORKSPACES, not two properties.
//
// Tenant-scoped + ENABLE/FORCE RLS on tenant_id (policy in the migration). The
// "exactly one primary per tenant" rule is a PARTIAL UNIQUE index
// (tenant_id) WHERE is_primary — hand-added in the migration (Prisma can't
// express the predicate), mirroring builder_layouts_one_active_per_tenant.

model Property {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Stable per-tenant handle. The primary property is seeded as 'primary'.
  slug String @db.VarChar(63)
  name String @db.VarChar(255)

  // Exactly one per tenant (DB-enforced by the partial unique index). The
  // primary keeps the tenant's existing subdomain for backward compatibility;
  // additional properties get their own hostnames (Phase 2).
  isPrimary Boolean @default(false) @map("is_primary")

  // active | paused | archived
  status String @default("active") @db.VarChar(20)

  // Per-property settings bag (shape validated in the service, not the DB).
  settings Json @default("{}")

  // Per-site module scope (docs/49 Slice F) — a string[] of module slugs that are
  // DISABLED for this site only. Empty = all tenant-active modules are on.
  // Tenant-level module.activated/deactivated is still the primary gate;
  // this list can only narrow further, never grant a module that is not active at
  // the tenant level. Stored as JSONB, validated in the service.
  moduleScope Json @default("[]") @map("module_scope")

  // OPTIONAL per-site brand override (docs/49 §3 — the deliberate amendment to
  // doc-34's "brand overridable by none"). Null = inherit the tenant brand
  // (TenantBrand stays the default/source of truth). A partial override:
  // { businessName?, colorPrimary?, colorPrimaryForeground?, colorAccent?,
  //   logoMediaId? } — any absent/null field falls back to the tenant brand.
  // Presentation-only identity (display name + theme colours + logo), NOT a full
  // brand fork; merged over the tenant brand in the public tenant payload.
  brandOverride Json? @map("brand_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Builder presentation layer, re-keyed per-property (docs/49 Phase 1B).
  // Tenant-authored components stay tenant-wide and do NOT relate here.
  builderPages       BuilderPage[]
  builderLayouts     BuilderLayout[]
  builderAssignments BuilderPageAssignment[]
  // Per-site email overrides (docs/49 Phase 7b / docs/91 §6) — a site's fork of a
  // provisioned default, or a site-specific custom email. null-property emails are
  // tenant-wide (the 13 defaults + tenant custom emails). SetNull on delete.
  builderEmails      BuilderEmail[]

  // Sitebuilder applied-theme trio, re-keyed per-property (docs/49 Phase 6). Each
  // site keeps its own draft config + published version history + publish
  // schedules, and its own write-through StorefrontTheme. The saved-theme LIBRARY
  // (SiteTheme) + the legacy section tier stay tenant-wide and do NOT relate here.
  siteConfig           SiteConfig?
  siteVersions         SiteVersion[]
  sitePublishSchedules SitePublishSchedule[]
  storefrontTheme      StorefrontTheme?
  // Per-site commerce defaults + checkout policy (docs/49 Phase 6b); a site with
  // no row inherits the primary's at read time.
  storefrontSettings   StorefrontSettings?
  // Per-site legal/footer doc placements (docs/49 Phase 6c); null-property
  // placements are tenant-wide and show on every site.
  docPlacements        StorefrontDocPlacement[]
  // Per-site email sends (docs/49 Phase 7) — broadcasts, queued sends, and the
  // engagement events they produce render/attribute against this site's brand.
  // null-property rows fall back to the tenant's primary brand.
  broadcasts           Broadcast[]
  scheduledSends       ScheduledSend[]
  emailEvents          EmailEvent[]

  // Custom + purchased hostnames pointing at this site (docs/49 §5, docs/24).
  domains Domain[]

  // Model B per-site scoping (docs/49 §3) — which products / content entries this
  // site exposes. EMPTY = the site shows ALL (the default, Model A behavior).
  productLinks      ProductProperty[]
  contentEntryLinks ContentEntryProperty[]

  // Origin-site tagging (docs/58 D1) — orders + carts placed on this site. These
  // SetNull on delete (orders outlive their site); they are NOT a fork.
  orders Order[]
  carts  Cart[]

  // Per-site customer MEMBERSHIPS (docs/58 D2) — shoppers who belong to this site.
  customerMemberships Customer[]

  // Per-site navigation menus. null-property menus are tenant-wide fallbacks;
  // these override for this specific site.
  navigationMenus NavigationMenu[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("properties")
}

// Domain — the host→site dispatch table. Every routable hostname for a tenant's
// web PROPERTIES/sites lives here (docs/49 §5, docs/24-domain-purchase-management.md):
//   · type='subdomain' — the always-on `<label>.sparx.zone` host, created with
//                        the property, status='active' immediately (we own the zone).
//   · type='custom'    — a domain the tenant already owns, connected via DNS
//                        (CNAME → customers.sparx.zone) + a TXT verification.
//   · type='purchased' — a domain registered through Sparx (GoDaddy reseller).
//                        The registrar columns stay null until that slice lands.
//
// LIFECYCLE (status): pending → verifying → verified → active. The Caddy
// on-demand-TLS ask endpoint (services/.../internal/domain-check.ts) authorizes a
// host once status is 'verified'/'active'; the cert issues on first HTTPS hit.
//
// THIS TABLE IS A NON-RLS DISPATCH TABLE — deliberately, exactly like `tenants`.
// The host→property resolver and the Caddy ask endpoint look up `host` BEFORE any
// tenant is known, so the row must be readable without a tenant GUC. `host` is
// GLOBALLY unique (a hostname maps to exactly one site), which is the cross-tenant
// guard (you can't claim a host another tenant already holds). The sensitive
// content a host points at (pages, orders, customers) stays FORCE-RLS on its own
// tables. Management routes (list/add/remove my domains) filter by tenant_id in
// the app, as they do for the tenants table.

model Domain {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  // The full hostname, lowercased (`acme.com`, `www.acme.com`, `shop.sparx.zone`).
  host   String @unique @db.VarChar(255)
  // subdomain | custom | purchased
  type   String @default("custom") @db.VarChar(20)
  // pending | verifying | verified | active | failed
  status String @default("pending") @db.VarChar(20)

  // The TXT value the tenant adds (at `_sparx-verify.<host>`) to prove control;
  // the verify worker polls DNS for it. Null once verified.
  verificationToken String?   @map("verification_token") @db.VarChar(120)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  // The canonical host for its property (the apex; `www` redirects to it).
  isCanonical       Boolean   @default(false) @map("is_canonical")

  // Registrar columns — populated only for type='purchased' (docs/24 §7).
  registrar            String?   @db.VarChar(50)
  registrarOrderId     String?   @map("registrar_order_id") @db.VarChar(255)
  registeredAt         DateTime? @map("registered_at") @db.Timestamptz
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz
  autoRenew            Boolean   @default(true) @map("auto_renew")
  whoisPrivacy         Boolean   @default(false) @map("whois_privacy")
  renewalPriceCents    Int?      @map("renewal_price_cents")
  // DKIM keypair generated at purchase time (docs/24 §3). Public key goes into
  // the DKIM TXT record; private key is kept for signing outbound email.
  dkimPublicKey        String?   @map("dkim_public_key") @db.Text
  dkimPrivateKey       String?   @map("dkim_private_key") @db.Text
  // Renewal reminder thresholds already notified: '30d', '14d', '7d'. The
  // domain-worker's nightly cron checks this before sending to avoid duplicates.
  renewalRemindersSent String[]  @default([]) @map("renewal_reminders_sent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  domainPurchases DomainPurchase[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("domains")
}

// Append-only billing + audit ledger for every domain registration, renewal,
// and transfer processed through Sparx's GoDaddy reseller account (docs/24 §7,
// docs/64 Module 1 Ph1). Tenant-scoped with FORCE RLS.
//
// type:  registration | renewal | transfer
// status: pending | completed | failed
model DomainPurchase {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  // FQDN denormalised — survives the domain row being deleted after a transfer.
  domain   String @db.VarChar(255)

  registrar             String  @default("godaddy") @db.VarChar(50)
  registrarOrderId      String? @map("registrar_order_id") @db.VarChar(255)
  // Null until Stripe billing is wired; set to a mock value during the stub phase.
  stripePaymentIntentId String? @map("stripe_payment_intent_id") @db.VarChar(255)
  amountCents           Int     @map("amount_cents")
  years                 Int     @default(1) @db.SmallInt
  type                  String  @default("registration") @db.VarChar(20)
  status                String  @default("pending") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Soft FK to domains — null if the domain row was removed post-transfer.
  domainRow Domain? @relation(fields: [domain], references: [host])

  @@index([tenantId])
  @@index([domain])
  @@index([tenantId, domain])
  @@map("domain_purchases")
}

// CMS — Pages
//
// Static pages (About / Contact / landing pages / policy pages) per docs/12
// §3. Content is stored as TipTap-compatible JSON. Tenant-scoped + FORCE
// RLS so a callsite that forgets `withTenant()` returns nothing rather than
// leaking cross-tenant content.

model Page {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  slug            String    @db.VarChar(255)
  title           String    @db.VarChar(255)
  status          String    @default("draft") @db.VarChar(20) // draft | published
  content         Json      @default("{}")
  seoTitle        String?   @map("seo_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description") @db.Text
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("pages")
}

// CMS — Content types + entries + revisions + references.
//
// Polymorphic content model (docs/12 §3, plan Phase 1.1). Each ContentType
// defines the field schema for a class of entries; built-in types live
// under the sentinel "Sparx Platform" tenant and the RLS policy exposes
// them read-visible to every tenant.

model ContentType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(63)
  name        String   @db.VarChar(120)
  pluralName  String   @map("plural_name") @db.VarChar(120)
  description String?  @db.Text
  schemaJson  Json     @map("schema_json")
  urlPattern  String?  @map("url_pattern") @db.VarChar(255)
  icon        String?  @db.VarChar(64)
  isSingleton Boolean  @default(false) @map("is_singleton")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("content_types")
}

// One row per editable record. `body` JSONB validated against the resolved
// ContentType.schemaJson at write time.

model ContentEntry {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  typeKey       String    @map("type_key") @db.VarChar(63)
  slug          String?   @db.VarChar(255)
  status        String    @default("draft") @db.VarChar(20)
  body          Json      @default("{}")
  seoJson       Json      @default("{}") @map("seo_json")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  scheduledAt   DateTime? @map("scheduled_at") @db.Timestamptz
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz
  authorId      String?   @map("author_id") @db.Uuid
  localeCode    String?   @map("locale_code") @db.VarChar(10)
  parentEntryId String?   @map("parent_entry_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Legal pages (docs/42 §3) — a `page` entry that IS a tenant policy doc
  // carries a stable `legalKind` discriminator. Set by the seed/instantiate
  // path, never the CMS editor (so it survives edits regardless of form
  // behaviour); the Legal checklist groups by it. `legalTemplateVersion`
  // drives the "newer starter template available" indicator;
  // `legalDisclaimerAckAt` is null until the tenant reviews the starter text.
  legalKind            String?   @map("legal_kind") @db.VarChar(40)
  legalTemplateVersion Int?      @map("legal_template_version")
  legalDisclaimerAckAt DateTime? @map("legal_disclaimer_ack_at") @db.Timestamptz

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author          Author?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent          ContentEntry?            @relation("EntryLocalization", fields: [parentEntryId], references: [id], onDelete: SetNull)
  localeVariants  ContentEntry[]           @relation("EntryLocalization")
  revisions       ContentRevision[]
  refsFrom        ContentReference[]       @relation("ContentReferenceFrom")
  refsTo          ContentReference[]       @relation("ContentReferenceTo")
  terms           EntryTaxonomyTerm[]
  previewTokens   PreviewToken[]
  navigationItems NavigationItem[]
  docPlacements   StorefrontDocPlacement[]
  propertyLinks   ContentEntryProperty[]

  @@unique([tenantId, typeKey, slug])
  @@index([tenantId, typeKey, status])
  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, legalKind])
  @@map("content_entries")
}

// Per-site content scoping (docs/49 §3 Model B) — which web PROPERTIES a content
// entry publishes to. NO rows = ALL sites (the default, backward-compatible);
// rows = only those sites. Junction (composite PK, NO tenant_id — rides the FK
// parents like ProductProperty), so existing entries stay global with no
// backfill. The public read filters `propertyLinks none OR some(propertyId)`.
model ContentEntryProperty {
  propertyId String @map("property_id") @db.Uuid
  entryId    String @map("entry_id") @db.Uuid

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entry    ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([propertyId, entryId])
  @@index([entryId])
  @@map("content_entry_properties")
}

// Every PATCH creates a revision tagged `autosave`; explicit Save/Publish
// creates `manual`. Retain ~25 per entry; older `autosave` rows GC monthly.

model ContentRevision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  kind           String   @db.VarChar(20)
  body           Json
  seoJson        Json     @map("seo_json")
  status         String   @db.VarChar(20)
  authorId       String?  @map("author_id") @db.Uuid
  summary        String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry  ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, revisionNumber])
  @@index([tenantId, entryId, createdAt(sort: Desc)])
  @@map("content_revisions")
}

// Maintained on entry save: every reference / asset field in `body` produces
// one row. Powers usage-tracking, broken-link detection, and orphan-asset GC.

model ContentReference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  fromEntryId String   @map("from_entry_id") @db.Uuid
  toEntryId   String?  @map("to_entry_id") @db.Uuid
  toAssetId   String?  @map("to_asset_id") @db.Uuid
  field       String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromEntry ContentEntry  @relation("ContentReferenceFrom", fields: [fromEntryId], references: [id], onDelete: Cascade)
  toEntry   ContentEntry? @relation("ContentReferenceTo", fields: [toEntryId], references: [id], onDelete: Cascade)
  toAsset   MediaAsset?   @relation(fields: [toAssetId], references: [id], onDelete: Cascade)

  @@index([tenantId, fromEntryId])
  @@index([tenantId, toEntryId])
  @@index([tenantId, toAssetId])
  @@map("content_references")
}

// CMS — Taxonomies (categories, tags, custom vocabularies).
//
// Taxonomies are tenant-defined; terms can be hierarchical (parent_term_id)
// or flat. Entries link to terms via the EntryTaxonomyTerm join table.

model Taxonomy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String   @db.VarChar(63) // e.g. "blog_category", "blog_tag"
  name         String   @db.VarChar(120)
  pluralName   String   @map("plural_name") @db.VarChar(120)
  hierarchical Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  TaxonomyTerm[]

  @@unique([tenantId, key])
  @@map("taxonomies")
}

model TaxonomyTerm {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  taxonomyId   String   @map("taxonomy_id") @db.Uuid
  parentTermId String?  @map("parent_term_id") @db.Uuid
  slug         String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy            @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent   TaxonomyTerm?       @relation("TaxonomyTermTree", fields: [parentTermId], references: [id], onDelete: SetNull)
  children TaxonomyTerm[]      @relation("TaxonomyTermTree")
  entries  EntryTaxonomyTerm[]

  @@unique([taxonomyId, slug])
  @@index([tenantId, taxonomyId])
  @@map("taxonomy_terms")
}

model EntryTaxonomyTerm {
  entryId   String   @map("entry_id") @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry  ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  term   TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([entryId, termId])
  @@index([tenantId, termId])
  @@map("entry_taxonomy_terms")
}

// CMS — Authors, redirects, preview tokens.
//
// Editorial primitives that ride alongside the content model. Authors are
// distinct from User so a single user can publish under multiple pen names
// and an author can persist after the user row is removed.
//
// Navigation menus moved to the Site Builder module — see
// 50-sitebuilder-navigation.prisma. The tables (navigation_menus /
// navigation_items) are unchanged; only ownership of the model definitions
// moved.

model Author {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  slug          String   @db.VarChar(255)
  displayName   String   @map("display_name") @db.VarChar(255)
  bio           String?  @db.Text
  avatarAssetId String?  @map("avatar_asset_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset?    @relation(fields: [avatarAssetId], references: [id], onDelete: SetNull)
  entries     ContentEntry[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("authors")
}

// 301/302 manual redirects with chain/loop detection enforced at the API.

model Redirect {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fromPath   String    @map("from_path") @db.VarChar(2048)
  toPath     String    @map("to_path") @db.VarChar(2048)
  statusCode Int       @default(301) @map("status_code")
  hitCount   BigInt    @default(0) @map("hit_count")
  lastHitAt  DateTime? @map("last_hit_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromPath])
  @@index([tenantId])
  @@map("redirects")
}

// HS256 JWTs are stateless; this row keyed on `jti` lets us revoke
// individual tokens (or all tokens for an entry) without rotating the
// tenant secret.

model PreviewToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  entryId    String    @map("entry_id") @db.Uuid
  issuedById String?   @map("issued_by_id") @db.Uuid
  jti        String    @unique @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry  ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([tenantId, entryId])
  @@index([expiresAt])
  @@map("preview_tokens")
}

// CMS / platform — Webhooks.
//
// Outgoing webhooks for state-change events. Subscriptions describe what to
// listen to; deliveries are the retry queue with status / response capture.

model WebhookSubscription {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(120)
  url           String   @db.VarChar(2048)
  events        String[] @db.VarChar(120)
  signingSecret String   @map("signing_secret") @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, active])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(120)
  payload        Json
  attemptCount   Int       @default(0) @map("attempt_count")
  status         String    @default("pending") @db.VarChar(20)
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body") @db.Text
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextAttemptAt])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// CMS — Media assets + transcoded variants.
//
// Defined now so ContentReference can carry asset edges and Author can link
// an avatar. Transcode worker, signed-URL routes, and focal-point UI all
// land in Phase 3 of the CMS workstream.

model MediaAsset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  key              String    @db.VarChar(1024)
  originalFilename String    @map("original_filename") @db.VarChar(512)
  mimeType         String    @map("mime_type") @db.VarChar(127)
  byteSize         BigInt    @map("byte_size")
  width            Int?
  height           Int?
  durationSec      Float?    @map("duration_sec")
  dominantColor    String?   @map("dominant_color") @db.VarChar(9)
  blurhash         String?   @db.VarChar(128)
  focalPointX      Float     @default(0.5) @map("focal_point_x")
  focalPointY      Float     @default(0.5) @map("focal_point_y")
  altText          String?   @map("alt_text") @db.VarChar(500)
  caption          String?   @db.Text
  status           String    @default("uploading") @db.VarChar(20)
  processingError  String?   @map("processing_error") @db.Text
  usageCount       Int       @default(0) @map("usage_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants      MediaVariant[]
  refsTo        ContentReference[]
  authorAvatars Author[]

  @@index([tenantId, status])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("media_assets")
}

model MediaVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  format    String   @db.VarChar(20)
  width     Int
  height    Int
  byteSize  BigInt   @map("byte_size")
  key       String   @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, format, width])
  @@index([tenantId, assetId])
  @@map("media_variants")
}

// CMS — navigation menus.
//
// Navigation menus are information architecture — content — and are owned by the
// CMS module: the tenant edits header / footer / mega / custom_* menus under
// the CMS dashboard (/cms/navigation), and the storefront renders them via the
// SiteLayoutBlock → NavigationMenu reference. Site Builder owns only the layout
// SLOTS (header/footer/announcement) that point at a menu; it does not own the
// menus themselves. See docs/30-sitebuilder-redesign.md §8.
//
// Items link to a CMS ContentEntry OR an external URL (exactly one, validated at
// the API). The `entry` relation is now an intra-module reference.
//
// Table names (navigation_menus / navigation_items) are unchanged across every
// ownership move this model has lived through (CMS → Site Builder → CMS) — the
// `@@map` is the contract, so relocating the model between schema files is a
// no-op at the database level, never a data migration.

model NavigationMenu {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // Null = tenant-wide fallback (serves all sites). Non-null = overrides the
  // tenant-wide menu for that specific site. The public by-location route tries
  // the site-specific menu first, then falls back to the tenant-wide one.
  propertyId String? @map("property_id") @db.Uuid
  location   String  @db.VarChar(63)
  name       String  @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items            NavigationItem[]
  // Site Builder header/footer slots reference this menu by id. docs/30 §8.
  siteLayoutBlocks SiteLayoutBlock[]

  // Uniqueness enforced by two PARTIAL indexes in the migration (Prisma can't
  // express partial unique constraints):
  //   UNIQUE (tenant_id, location) WHERE property_id IS NULL
  //   UNIQUE (tenant_id, property_id, location) WHERE property_id IS NOT NULL
  @@index([tenantId, propertyId, location])
  @@map("navigation_menus")
}

model NavigationItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  menuId       String   @map("menu_id") @db.Uuid
  parentItemId String?  @map("parent_item_id") @db.Uuid
  position     Int
  label        String   @db.VarChar(255)
  entryId      String?  @map("entry_id") @db.Uuid
  externalUrl  String?  @map("external_url") @db.VarChar(2048)
  openInNewTab Boolean  @default(false) @map("open_in_new_tab")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavTree")
  entry    ContentEntry?    @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([menuId, position])
  @@index([tenantId])
  @@map("navigation_items")
}

// CRM — Customers + addresses.
//
// The customer-intelligence spine introduced by the CRM module. Commerce
// and B2B FK into this row rather than defining a parallel customer table.
//
// Locked architectural commitments (memory/feedback_crm_architecture.md):
//   • One table, three types — `type` ∈ {prospect, retail, b2b}. Promotion
//     is a column update, not a row migration.
//   • `authUserId` is NOT a FK to staff `users` (which is staff-only per
//     docs/16 §2 Layer 1). It will FK to a customer-auth-layer table when
//     that module lands. Stored as plain UUID for now.
//   • `totalSpent` / `orderCount` are denormalized fast-read columns
//     updated by the order-event consumer. Never written inline.
//   • `mergedIntoCustomerId` carries the dedup audit trail — soft-deleted
//     duplicates retain a pointer to the surviving primary.

model Customer {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  type          String  @default("prospect") @db.VarChar(20) // prospect | retail | b2b
  authUserId    String? @map("auth_user_id") @db.Uuid
  // Membership scoping (docs/58 D2): the SITE this customer belongs to + the
  // tenant-wide identity (login) behind it. property_id null = a tenant-level CRM
  // contact not tied to a site; identity_id null = no storefront login yet.
  propertyId    String? @map("property_id") @db.Uuid
  identityId    String? @map("identity_id") @db.Uuid
  b2bAccountId  String? @map("b2b_account_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  email                  String?  @db.VarChar(255)
  phone                  String?  @db.VarChar(50)
  firstName              String?  @map("first_name") @db.VarChar(255)
  lastName               String?  @map("last_name") @db.VarChar(255)
  company                String?  @db.VarChar(255)
  jobTitle               String?  @map("job_title") @db.VarChar(255)
  preferredContactMethod String?  @map("preferred_contact_method") @db.VarChar(20) // email | phone | sms
  doNotContact           Boolean  @default(false) @map("do_not_contact")
  gdprConsent            Json     @default("{}") @map("gdpr_consent")
  tags                   String[] @default([]) @db.VarChar(63)
  metadata               Json     @default("{}")

  totalSpent   Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  orderCount   Int       @default(0) @map("order_count")
  firstOrderAt DateTime? @map("first_order_at") @db.Timestamptz
  lastOrderAt  DateTime? @map("last_order_at") @db.Timestamptz

  mergedIntoCustomerId String? @map("merged_into_customer_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  identity    CustomerIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  b2bAccount  B2BAccount?       @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  assignedRep User?             @relation("CustomerAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  mergedInto  Customer?         @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id], onDelete: SetNull)
  mergedFrom  Customer[]        @relation("CustomerMerge")

  addresses        CustomerAddress[]
  deals            Deal[]
  activities       CrmActivity[]
  tasks            Task[]
  segmentMembers   SegmentMember[]
  orders           Order[]
  quotes           Quote[]
  billingDocuments BillingDocument[]

  // Commerce module inverse relations
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  storeCredits     StoreCredit[]
  subscriptions    Subscription[]
  reviews          ProductReview[]
  productQuestions ProductQuestion[]
  wishlists        Wishlist[]
  taxExemptions    TaxExemption[]

  // Customer-auth (Layer 2) — sessions stay per-MEMBERSHIP (a login to this
  // site's customer); the credential + resets now hang off the tenant-wide
  // CustomerIdentity (docs/58 D2), reached via `identity`.
  customerSessions CustomerSession[]

  // Cookie consent — records this shopper authored while signed in (docs/42 §4)
  consentRecords ConsentRecord[]

  // B2B portal — contact role membership rows (docs/64 B2B Ph5)
  b2bContactRoles B2bAccountContact[]

  // B2B scheduling — appointments booked by this customer (docs/64 Ph7)
  serviceAppointments ServiceAppointment[]

  // Live Chat — conversations opened by this customer (docs/56)
  chatConversations ChatConversation[]

  @@unique([tenantId, propertyId, email], map: "customers_tenant_property_email_unique")
  @@index([tenantId, propertyId])
  @@index([identityId])
  @@index([tenantId, type])
  @@index([tenantId, assignedRepId])
  @@index([tenantId, b2bAccountId])
  @@index([tenantId, lastOrderAt(sort: Desc)])
  @@index([tenantId, totalSpent(sort: Desc)])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([authUserId])
  @@map("customers")
}

// Multiple addresses per customer; one flagged default per type. Used by
// Commerce / B2B for shipping/billing.

model CustomerAddress {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  type       String  @db.VarChar(20) // shipping | billing | both
  label      String? @db.VarChar(120) // "HQ", "Warehouse 2"
  isDefault  Boolean @default(false) @map("is_default")

  recipientName String? @map("recipient_name") @db.VarChar(255)
  company       String? @db.VarChar(255)
  line1         String  @db.VarChar(255)
  line2         String? @db.VarChar(255)
  city          String  @db.VarChar(120)
  region        String? @db.VarChar(120)
  postalCode    String? @map("postal_code") @db.VarChar(32)
  country       String  @db.VarChar(2)
  phone         String? @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

// CRM — B2B accounts (docs/10 §2).
//
// Business entity that aggregates multiple customer contacts. Owned by the
// CRM module; B2B module adds credit holds and approval workflows on top
// of this base record when it lands.

model B2BAccount {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  companyName   String  @map("company_name") @db.VarChar(255)
  taxId         String? @map("tax_id") @db.VarChar(64)
  website       String? @db.VarChar(2048)
  // Legacy free-text tier name kept during the FK migration window.
  pricingTier   String? @map("pricing_tier") @db.VarChar(63)
  pricingTierId String? @map("pricing_tier_id") @db.Uuid

  creditLimit     Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditUsed      Decimal @default(0) @map("credit_used") @db.Decimal(12, 2)
  paymentTerms    String? @map("payment_terms") @db.VarChar(20)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  status String @default("active") @db.VarChar(20) // active | credit_hold | suspended | inactive

  // Fleet-specific (Gillett Diesel reference case)
  fleetSize      Int? @map("fleet_size")
  engineProfiles Json @default("[]") @map("engine_profiles")

  notes String?  @db.Text
  tags  String[] @default([]) @db.VarChar(63)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedRep   User?           @relation("B2BAccountAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  pricingTierFk B2bPricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)

  customers  Customer[]
  deals      Deal[]
  activities CrmActivity[]
  quotes     Quote[]

  // Commerce module inverse relations
  priceLists       PriceList[]
  contractPrices   ContractPrice[]
  checkoutSessions CheckoutSession[]
  taxExemptions    TaxExemption[]

  // B2B module inverse relations
  productOverrides B2bAccountProductOverride[]
  invoices         B2bInvoice[]
  billingDocuments BillingDocument[]
  contacts         B2bAccountContact[]
  approvalRules    PurchaseApprovalRule[]
  appointments     ServiceAppointment[]

  @@index([tenantId, status])
  @@index([tenantId, assignedRepId])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("b2b_accounts")
}

// CRM — Sales pipelines + stages + deals.
//
// Tenants run multiple pipelines (e.g. "New B2B Acquisition", "Fleet
// Contract Renewals"). Stages are tenant-editable rows on PipelineStage.
//
// Deals attach to either a customer or a B2B account (or both for a B2B
// contact). Orders/quotes link via the join tables in 23-crm-deal-joins —
// never via a deal_id column on orders/quotes (locked decision #5).

model Pipeline {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(120)
  slug       String    @db.VarChar(63)
  isDefault  Boolean   @default(false) @map("is_default")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([tenantId, slug])
  @@index([tenantId, archivedAt])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  name        String   @db.VarChar(120)
  sortOrder   Int      @map("sort_order")
  probability Decimal  @default(0) @db.Decimal(5, 2)
  stageType   String   @default("open") @map("stage_type") @db.VarChar(20) // open | won | lost
  color       String?  @db.VarChar(9)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, sortOrder])
  @@index([tenantId, pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  pipelineId    String  @map("pipeline_id") @db.Uuid
  stageId       String  @map("stage_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid
  b2bAccountId  String? @map("b2b_account_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  title             String    @db.VarChar(255)
  value             Decimal   @default(0) @db.Decimal(12, 2)
  currency          String    @default("USD") @db.VarChar(3)
  probability       Decimal   @default(0) @db.Decimal(5, 2)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  closedReason      String?   @map("closed_reason") @db.VarChar(500)
  source            String?   @db.VarChar(63)
  tags              String[]  @default([]) @db.VarChar(63)
  metadata          Json      @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage       PipelineStage @relation(fields: [stageId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  b2bAccount  B2BAccount?   @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  assignedRep User?         @relation("DealAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)

  activities CrmActivity[]
  tasks      Task[]
  orderLinks DealOrder[]
  quoteLinks DealQuote[]

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, assignedRepId, stageId])
  @@index([tenantId, customerId])
  @@index([tenantId, b2bAccountId])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, closedAt])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("deals")
}

// CRM — Deal/order and deal/quote join tables (locked decision #5).
//
// Pure join tables — no business state, no `deal_id` column on orders or
// quotes. One deal can yield multiple orders; most orders have no deal.
// The CRM owns the deal lifecycle; orders and quotes attach later without
// the commerce/B2B engines ever knowing CRM exists.

model DealOrder {
  dealId    String   @map("deal_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([dealId, orderId])
  @@index([tenantId, orderId])
  @@map("deal_orders")
}

model DealQuote {
  dealId    String   @map("deal_id") @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@id([dealId, quoteId])
  @@index([tenantId, quoteId])
  @@map("deal_quotes")
}

// CRM — Orders.
//
// The order spine the whole platform agrees on. Commerce will layer a
// catalog (products, variants, inventory) and a checkout flow that PRODUCES
// these rows; it never redefines "what an order is."
//
// State machine: placed → fulfilled → delivered, with cancelled / refunded
// branches available from any non-terminal state. The `status` column
// captures the high-water mark; per-fulfillment / per-payment / per-refund
// detail lives in the child tables (see 25-crm-order-items,
// 26-crm-order-payments, 27-crm-order-fulfillments).
//
// Address snapshots (`shippingAddress`, `billingAddress` JSONB) freeze the
// values at placement time. Editing the customer's address later does NOT
// rewrite past orders — required for audit, tax reporting, and dispute
// resolution.
//
// State transitions emit upstream platform events (`order.created`,
// `order.fulfilled`, `order.delivered`, `order.cancelled`, `order.refunded`)
// that the CRM consumer picks up to populate the activity feed and the
// denormalized customer stats.

model Order {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  customerId  String  @map("customer_id") @db.Uuid
  // Origin site (docs/58 D1) — which property the order was placed on. Nullable:
  // legacy / admin / import / MCP orders may have no site (null = no specific
  // site, shows under "All sites"). App-tier scoping only, never an RLS boundary.
  propertyId  String? @map("property_id") @db.Uuid
  orderNumber String  @map("order_number") @db.VarChar(63)

  status        String  @default("placed") @db.VarChar(20) // placed | fulfilled | delivered | cancelled | refunded
  paymentStatus String  @default("unpaid") @map("payment_status") @db.VarChar(20) // unpaid | partially_paid | paid | refunded
  channel       String? @db.VarChar(63) // storefront | b2b_portal | admin | import | mcp
  source        String? @db.VarChar(63)

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal     Decimal @default(0) @map("shipping_total") @db.Decimal(12, 2)
  discountTotal     Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  // Document-level fee pass-through (docs/48 §6) — chiefly the card processing
  // fee. Snapshotted in `appliedSurcharges` ([{name,type,value,basis,paymentMethod,
  // amountCents,label}]) so it's reproducible and reversible proportionally on refund.
  surchargeTotal    Decimal @default(0) @map("surcharge_total") @db.Decimal(12, 2)
  appliedSurcharges Json    @default("[]") @map("applied_surcharges")
  total             Decimal @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)
  refundTotal       Decimal @default(0) @map("refund_total") @db.Decimal(12, 2)
  currency          String  @default("USD") @db.VarChar(3)

  // Frozen at placement time. Shape mirrors CustomerAddress.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  placedAt        DateTime  @map("placed_at") @db.Timestamptz
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  fulfilledAt     DateTime? @map("fulfilled_at") @db.Timestamptz
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledReason String?   @map("cancelled_reason") @db.VarChar(500)
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz

  customerNote String? @map("customer_note") @db.Text
  internalNote String? @map("internal_note") @db.Text
  metadata     Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Deleting a site must NOT delete its orders (finance / tax history) → SetNull.
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  items               OrderItem[]
  payments            OrderPayment[]
  refunds             OrderRefund[]
  fulfillments        OrderFulfillment[]
  dealLinks           DealOrder[]
  convertedFromQuotes Quote[]            @relation("QuoteConvertedToOrder")
  dropshipOrders      DropshipOrder[]

  @@unique([tenantId, orderNumber], map: "orders_tenant_number_unique")
  @@index([tenantId, customerId, placedAt(sort: Desc)])
  @@index([tenantId, propertyId, placedAt(sort: Desc)])
  @@index([tenantId, status, placedAt(sort: Desc)])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, placedAt(sort: Desc)])
  @@map("orders")
}

// CRM — Order line items.
//
// Free-text sku / name today; a future Products module adds the FK on
// `productId` / `variantId` without rewriting history.
//
// `quantityFulfilled` / `quantityRefunded` track partial-shipment and
// partial-refund quantities against the original `quantity`. The
// fulfillment and refund subresources (see 26-, 27-) link back through
// their own per-line-item join tables.

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  sku            String  @db.VarChar(127)
  name           String  @db.VarChar(255)
  description    String? @db.Text
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineSubtotal   Decimal @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  quantityFulfilled Int @default(0) @map("quantity_fulfilled")
  quantityRefunded  Int @default(0) @map("quantity_refunded")

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Commerce wires these once the catalog ships. Both nullable so
  // pre-Commerce orders and external-system imports still validate.
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  fulfillmentItems OrderFulfillmentItem[]
  refundItems      OrderRefundItem[]

  @@index([tenantId, orderId])
  @@index([tenantId, sku])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// CRM — Order payments + refunds.
//
// Multiple payment rows per order allow partial payments, split tenders,
// and net-terms B2B with multiple installments. Refunds reference the
// payment they reverse (or null for goodwill credits issued against the
// order header). Per-line-item refund quantities live in OrderRefundItem
// so partial refunds can target specific lines.

model OrderPayment {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  processor     String  @db.VarChar(63) // stripe | paypal | manual | check | wire | net_terms
  processorRef  String? @map("processor_ref") @db.VarChar(255)
  amount        Decimal @db.Decimal(12, 2)
  currency      String  @default("USD") @db.VarChar(3)
  status        String  @default("pending") @db.VarChar(20) // pending | authorized | captured | failed | voided | refunded
  failureReason String? @map("failure_reason") @db.VarChar(500)

  authorizedAt DateTime? @map("authorized_at") @db.Timestamptz
  capturedAt   DateTime? @map("captured_at") @db.Timestamptz
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refunds OrderRefund[]

  // processor_ref is nullable but the unique must only fire when present.
  // The partial-unique lives in the migration; the @@unique here is the
  // schema-level expectation.
  @@unique([tenantId, processor, processorRef], map: "order_payments_processor_ref_unique")
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("order_payments")
}

model OrderRefund {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  paymentId String? @map("payment_id") @db.Uuid

  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("USD") @db.VarChar(3)
  reason       String? @db.VarChar(500)
  processorRef String? @map("processor_ref") @db.VarChar(255)
  status       String  @default("pending") @db.VarChar(20) // pending | completed | failed

  refundedAt DateTime? @map("refunded_at") @db.Timestamptz
  metadata   Json      @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment OrderPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  refundItems OrderRefundItem[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("order_refunds")
}

model OrderRefundItem {
  refundId    String  @map("refund_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(12, 2)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refund    OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([refundId, orderItemId])
  @@index([tenantId, orderItemId])
  @@map("order_refund_items")
}

// CRM — Order fulfillments.
//
// Multiple fulfillments per order supports split shipments, digital +
// physical mixed orders, drop-ship + own-warehouse splits. Per-line-item
// fulfillment quantities live in OrderFulfillmentItem.

model OrderFulfillment {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  status         String  @default("pending") @db.VarChar(20) // pending | shipped | delivered | failed | cancelled
  carrier        String? @db.VarChar(63) // ups | usps | fedex | dhl | digital | dropship
  service        String? @db.VarChar(63) // ground | 2day | overnight | …
  trackingNumber String? @map("tracking_number") @db.VarChar(127)
  trackingUrl    String? @map("tracking_url") @db.VarChar(2048)

  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz

  notes    String? @db.Text
  metadata Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  items OrderFulfillmentItem[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, trackingNumber])
  @@map("order_fulfillments")
}

model OrderFulfillmentItem {
  fulfillmentId String @map("fulfillment_id") @db.Uuid
  orderItemId   String @map("order_item_id") @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  quantity      Int    @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fulfillment OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([fulfillmentId, orderItemId])
  @@index([tenantId, orderItemId])
  @@map("order_fulfillment_items")
}

// CRM — Quotes + line items.
//
// Full quote lifecycle: draft → submitted → (accepted | declined | expired).
// Accepted quotes convert to an Order via `convertedToOrderId` — the
// service stamps the pointer + status transition + activity row in a
// single transaction.

model Quote {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  b2bAccountId String? @map("b2b_account_id") @db.Uuid
  quoteNumber  String  @map("quote_number") @db.VarChar(63)

  status String @default("draft") @db.VarChar(20) // draft | submitted | accepted | declined | expired | converted

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal Decimal @default(0) @map("shipping_total") @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  currency      String  @default("USD") @db.VarChar(3)

  paymentTerms String?   @map("payment_terms") @db.VarChar(20)
  validUntil   DateTime? @map("valid_until") @db.Timestamptz

  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz
  viewedAt       DateTime? @map("viewed_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  declinedAt     DateTime? @map("declined_at") @db.Timestamptz
  declinedReason String?   @map("declined_reason") @db.VarChar(500)
  expiredAt      DateTime? @map("expired_at") @db.Timestamptz

  convertedToOrderId String?   @map("converted_to_order_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at") @db.Timestamptz

  customerNote String? @map("customer_note") @db.Text
  internalNote String? @map("internal_note") @db.Text
  metadata     Json    @default("{}")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  b2bAccount       B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  createdBy        User?       @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  convertedToOrder Order?      @relation("QuoteConvertedToOrder", fields: [convertedToOrderId], references: [id], onDelete: SetNull)

  items     QuoteItem[]
  dealLinks DealQuote[]

  @@unique([tenantId, quoteNumber], map: "quotes_tenant_number_unique")
  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@index([tenantId, b2bAccountId, createdAt(sort: Desc)])
  @@index([tenantId, status, validUntil])
  @@index([tenantId, convertedToOrderId])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  quoteId   String  @map("quote_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  sku            String  @db.VarChar(127)
  name           String  @db.VarChar(255)
  description    String? @db.Text
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineSubtotal   Decimal @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(12, 2)
  metadata       Json    @default("{}")

  // Document-line markup (docs/48 §5). When a line is priced "by markup" — a
  // rule or an ad-hoc markup against a cost basis — costCents records the cost
  // used and appliedMarkup snapshots the computation ({ ruleId, ruleName,
  // method, value, costSource, costBasisValueCents, computedPriceCents,
  // marginPct, markupPct, computedAt }; ruleId null for ad-hoc) so the quoted
  // unitPrice stays reproducible after catalog costs drift. Null = priced
  // manually / from the catalog, detached from any markup.
  costCents     Int?  @map("cost_cents")
  appliedMarkup Json? @map("applied_markup")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@index([tenantId, sku])
  @@index([productId])
  @@map("quote_items")
}

// Commerce — Products.
//
// The wrapping row that variants hang off. A product carries the catalog-
// level shape (title, description, SEO, fulfillment type, hazmat class,
// shipping defaults); each Variant overrides for a purchasable SKU.
//
// Money columns store integer cents (matches @sparx/commerce-schemas
// MoneyCents). CRM-side Decimal columns are kept for historical orders;
// Commerce-side reads convert at the boundary.
//
// Hand-edited RLS lives in the migration SQL — Prisma does not generate
// `ENABLE / FORCE ROW LEVEL SECURITY` (memory/feedback_sparx_db_rls_pattern).

model Product {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title       String  @db.VarChar(255)
  handle      String  @db.VarChar(127)
  description String? @db.Text // rich-text HTML allowed

  status          String   @default("draft") @db.VarChar(20) // draft | active | archived
  productType     String?  @map("product_type") @db.VarChar(127)
  vendor          String?  @db.VarChar(127)
  tags            String[] @default([]) @db.VarChar(63)
  fulfillmentType String   @default("physical") @map("fulfillment_type") @db.VarChar(20)
  // ^ physical | digital | service | configurable | bundle | subscription

  // Defaults inherited by variants when omitted.
  weightGrams      Int?    @map("weight_grams")
  lengthMm         Int?    @map("length_mm")
  widthMm          Int?    @map("width_mm")
  heightMm         Int?    @map("height_mm")
  hazmatClass      String  @default("none") @map("hazmat_class") @db.VarChar(32)
  requiresShipping Boolean @default(true) @map("requires_shipping")
  taxClass         String? @map("tax_class") @db.VarChar(63)
  originCountry    String? @map("origin_country") @db.VarChar(2)
  hsCode           String? @map("hs_code") @db.VarChar(15)
  metadata         Json    @default("{}")

  // SEO.
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)
  ogImageId      String? @map("og_image_id") @db.Uuid

  // Default fulfillment warehouse — order picker falls back to this when
  // a line item doesn't pin one explicitly.
  defaultWarehouseId String? @map("default_warehouse_id") @db.Uuid

  // Aggregated read columns updated by event consumers — never written
  // inline. Drives storefront sort + low-stock badges.
  priceMinCents  Int?    @map("price_min_cents")
  priceMaxCents  Int?    @map("price_max_cents")
  inStock        Boolean @default(false) @map("in_stock")
  bestSellerRank Int?    @map("best_seller_rank")
  averageRating  Float?  @map("average_rating")
  reviewCount    Int     @default(0) @map("review_count")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultWarehouse       Warehouse?               @relation("ProductDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  options                ProductOption[]
  variants               ProductVariant[]
  images                 VariantImage[]
  fitments               ProductFitment[]
  collectionLinks        CollectionProduct[]
  categoryLinks          CategoryProduct[]
  propertyLinks          ProductProperty[]
  shippingProfileLinks   ShippingProfileProduct[]
  bundlesAsWrapper       Bundle[]                 @relation("BundleWrapper")
  bundleComponents       BundleComponent[]
  configurationTemplates ConfigurationTemplate[]
  reviews                ProductReview[]
  questions              ProductQuestion[]
  translations           ProductTranslation[]
  orderItems             OrderItem[]
  dropshipLinks          DropshipProductLink[]
  billingDocumentLines   BillingDocumentLine[]

  @@unique([tenantId, handle], map: "products_tenant_handle_unique")
  @@index([tenantId, status])
  @@index([tenantId, productType])
  @@index([tenantId, vendor])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("commerce_products")
}

// Per-site catalog scoping (docs/49 §3 Model B) — which web PROPERTIES a product
// is visible on. NO rows for a product = visible on ALL sites (the default,
// backward-compatible); one-or-more rows = visible ONLY on those sites. A
// junction (composite PK, NO tenant_id — tenant scoping rides the FK parents,
// exactly like CollectionProduct), so "empty means all" keeps existing catalogs
// global with zero backfill. The storefront read filters
// `propertyLinks none OR propertyLinks some(propertyId)` (lib/property-scope.ts).
model ProductProperty {
  propertyId String @map("property_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([propertyId, productId])
  @@index([productId])
  @@map("commerce_product_properties")
}

// Localized title / description / SEO. Optional — Phase 1 ships en-US
// only; the table is here so locale rollout is a row insert, not a
// schema change.

model ProductTranslation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  locale    String @db.VarChar(10) // en-US | es-MX | fr-CA | ...

  title          String  @db.VarChar(255)
  description    String? @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale], map: "product_translations_locale_unique")
  @@index([tenantId])
  @@map("commerce_product_translations")
}

// CRM — Activities (locked decision #3 — append-only event log).
//
// Append-only. Never UPDATE. Editing a note inserts a `note` row with
// `correctsActivityId` pointing at the original; the original stays for
// audit.
//
// Native Postgres RANGE-partitioned by month on `occurredAt`. The
// partition key must be part of the primary key, so PK is the composite
// (id, occurredAt). `id` is still a UUID and unique in practice; the
// composite is a Postgres requirement, not a logical change. No code path
// uses `findUnique({ id })` — every read is filtered by tenant first and
// is happy with `findFirst({ where: { id } })` if a single-row fetch ever
// becomes necessary.
//
// `linkedEntityType` / `linkedEntityId` carries the soft reference to the
// originating record (order, email, quote, …) without a hard FK because
// those tables span modules and lifecycles.

model CrmActivity {
  id           String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  dealId       String? @map("deal_id") @db.Uuid
  b2bAccountId String? @map("b2b_account_id") @db.Uuid

  type        String  @db.VarChar(63)
  description String? @db.Text

  actorId   String? @map("actor_id") @db.Uuid
  actorType String  @map("actor_type") @db.VarChar(20) // staff | customer | system | api | mcp

  occurredAt       DateTime @map("occurred_at") @db.Timestamptz
  linkedEntityType String?  @map("linked_entity_type") @db.VarChar(63)
  linkedEntityId   String?  @map("linked_entity_id") @db.Uuid

  metadata           Json    @default("{}")
  correctsActivityId String? @map("corrects_activity_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  b2bAccount B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)

  @@id([id, occurredAt], map: "crm_activities_pkey")
  @@index([tenantId, customerId, occurredAt(sort: Desc)])
  @@index([tenantId, dealId, occurredAt(sort: Desc)])
  @@index([tenantId, b2bAccountId, occurredAt(sort: Desc)])
  @@index([tenantId, type, occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("crm_activities")
}

// Commerce — Variants, options, option values, and per-variant image
// bindings. A purchasable SKU = one ProductVariant row.

model ProductOption {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  name        String @db.VarChar(63) // Color, Size, Material, ...
  displayType String @default("dropdown") @map("display_type") @db.VarChar(20)
  // ^ dropdown | swatch | image_swatch | radio | segmented
  position    Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name], map: "product_options_name_unique")
  @@index([tenantId, productId])
  @@map("commerce_product_options")
}

model ProductOptionValue {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  optionId      String  @map("option_id") @db.Uuid
  value         String  @db.VarChar(127)
  swatchHex     String? @map("swatch_hex") @db.VarChar(7)
  swatchImageId String? @map("swatch_image_id") @db.Uuid
  position      Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  option             ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantAssignments ProductVariantOptionValue[]
  imageBindings      VariantImageOptionValue[]

  @@unique([optionId, value], map: "product_option_values_value_unique")
  @@index([tenantId, optionId])
  @@map("commerce_product_option_values")
}

model ProductVariant {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  sku     String  @db.VarChar(127)
  barcode String? @db.VarChar(14)
  title   String? @db.VarChar(255) // computed from options when omitted

  priceCents          Int    @map("price_cents")
  compareAtPriceCents Int?   @map("compare_at_price_cents")
  costCents           Int?   @map("cost_cents")
  currency            String @db.VarChar(3)

  weightGrams Int? @map("weight_grams")
  lengthMm    Int? @map("length_mm")
  widthMm     Int? @map("width_mm")
  heightMm    Int? @map("height_mm")

  inventoryPolicy  String  @default("deny") @map("inventory_policy") @db.VarChar(20)
  // ^ deny | continue | preorder
  requiresShipping Boolean @default(true) @map("requires_shipping")
  fulfillmentType  String? @map("fulfillment_type") @db.VarChar(20) // overrides product-level when set
  dropshipSourceId String? @map("dropship_source_id") @db.Uuid

  // Catalog markup (docs/48) — when bound to a rule, `priceCents` is DERIVED.
  // `appliedMarkup` snapshots the computation: { method, value, costBasisValueCents,
  // computedPriceCents, computedAt } so margin reporting stays reproducible after
  // costs drift. Null markupRuleId = manually priced (detached from any rule).
  markupRuleId  String? @map("markup_rule_id") @db.Uuid
  appliedMarkup Json?   @map("applied_markup")

  isDefault Boolean @default(false) @map("is_default")
  position  Int     @default(0)
  metadata  Json    @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  markupRule            MarkupRule?                 @relation(fields: [markupRuleId], references: [id], onDelete: SetNull)
  optionAssignments     ProductVariantOptionValue[]
  images                VariantImage[]
  inventoryLevels       InventoryLevel[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryReservations InventoryReservation[]
  lotBatches            LotBatch[]
  serialUnits           SerialUnit[]
  priceListEntries      PriceListEntry[]
  bulkPriceTiers        BulkPriceTier[]
  contractPrices        ContractPrice[]
  b2bTierOverrides      B2bTierProductOverride[]
  b2bAccountOverrides   B2bAccountProductOverride[]
  bundleComponents      BundleComponent[]
  cartItems             CartItem[]
  subscriptionItems     SubscriptionItem[]
  reviews               ProductReview[]
  shippingProfileLinks  ShippingProfileVariant[]
  orderItems            OrderItem[]
  stockLevels           StockLevel[]
  inventorySourceLinks  InventorySourceLink[]
  recomputeReviews      MarkupRecomputeReview[]
  billingDocumentLines  BillingDocumentLine[]

  @@unique([tenantId, sku], map: "product_variants_sku_unique")
  @@index([tenantId, productId])
  @@index([tenantId, dropshipSourceId])
  @@index([tenantId, markupRuleId])
  @@index([tenantId, deletedAt])
  @@map("commerce_product_variants")
}

// Join — pins a variant onto an option-value lattice point. The full
// (variant, option, value) triple is unique so a variant can't have two
// values for the same option.

model ProductVariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("commerce_product_variant_option_values")
}

// Per-variant image — solves the per-color-image case PRD §3 flagged as
// TBD. mediaAssetId references the shared @sparx/db MediaAsset row from
// the CMS module; images live in the shared media library, not a
// commerce-specific table.

model VariantImage {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  variantId    String? @map("variant_id") @db.Uuid // null = product-level
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  position     Int     @default(0)
  // The product's HERO image — the thumbnail surfaced in admin/storefront lists,
  // product cards, Builder email product blocks, and the search index. At most one
  // per product, enforced by a PARTIAL UNIQUE index on (tenant_id, product_id)
  // WHERE is_primary (in the migration SQL — Prisma can't express the predicate).
  // When no image is primary, readers fall back to the first product-level image by
  // position, so products keep a sensible thumbnail without an explicit pick.
  isPrimary    Boolean @default(false) @map("is_primary")
  alt          String? @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  optionValueLinks VariantImageOptionValue[]

  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@index([mediaAssetId])
  @@map("commerce_variant_images")
}

// Many-to-many: an image can be pinned to a set of option values. When
// the storefront resolves "show me the gallery for Color=Red", it picks
// images whose option-value set is a superset of the active selection.

model VariantImageOptionValue {
  variantImageId String @map("variant_image_id") @db.Uuid
  optionValueId  String @map("option_value_id") @db.Uuid

  variantImage VariantImage       @relation(fields: [variantImageId], references: [id], onDelete: Cascade)
  optionValue  ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantImageId, optionValueId])
  @@index([optionValueId])
  @@map("commerce_variant_image_option_values")
}

// CRM — Tasks (docs/11 §6).
//
// Task assigned to a staff user, optionally scoped to a customer or deal.
// Overdue tasks fan out via the email automation engine in Phase 5; the
// scheduler reads `getOverdue()` from taskService.

model Task {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  assignedToUserId  String  @map("assigned_to_user_id") @db.Uuid
  createdByUserId   String  @map("created_by_user_id") @db.Uuid
  completedByUserId String? @map("completed_by_user_id") @db.Uuid
  customerId        String? @map("customer_id") @db.Uuid
  dealId            String? @map("deal_id") @db.Uuid

  title       String    @db.VarChar(255)
  description String?   @db.Text
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  priority    String    @default("medium") @db.VarChar(10) // low | medium | high | urgent
  status      String    @default("open") @db.VarChar(20) // open | completed | cancelled
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo  User      @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  completedBy User?     @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId, assignedToUserId, status, dueAt])
  @@index([tenantId, dueAt])
  @@index([tenantId, customerId])
  @@index([tenantId, dealId])
  @@map("tasks")
}

// Commerce — Categories (nested tree) and Collections (manual + rules).
//
// Distinct concepts: a category is the organizational tree (Auto Parts >
// Engine > Fuel Injection); a collection is a merchandising surface
// ("Featured", "New for Spring"). A product has zero-or-one canonical
// category and zero-or-many collections.

model ProductCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  // Materialized path used for fast subtree queries — store as text and
  // populate in a trigger / service after each move. Ltree extension can
  // upgrade this column later without migrating data.
  path        String  @db.VarChar(2000)
  name        String  @db.VarChar(127)
  handle      String  @db.VarChar(127)
  description String? @db.Text
  position    Int     @default(0)
  featured    Boolean @default(false)
  iconMediaId String? @map("icon_media_id") @db.Uuid
  heroMediaId String? @map("hero_media_id") @db.Uuid

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)
  ogImageId      String? @map("og_image_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products CategoryProduct[]

  @@unique([tenantId, handle], map: "product_categories_tenant_handle_unique")
  @@index([tenantId, parentId])
  @@index([tenantId, path])
  @@map("commerce_product_categories")
}

// Join — a product can sit in many categories (its primary plus
// cross-referenced ones).

model CategoryProduct {
  categoryId String  @map("category_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")
  position   Int     @default(0)

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@index([productId])
  @@map("commerce_category_products")
}

model ProductCollection {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(127)
  handle      String  @db.VarChar(127)
  description String? @db.Text
  type        String  @default("manual") @db.VarChar(20) // manual | rules
  // When type=rules, ruleSet drives membership; commerce-indexer worker
  // re-projects to CollectionProduct on each change.
  ruleSet     Json    @default("{}") @map("rule_set")
  heroMediaId String? @map("hero_media_id") @db.Uuid
  featured    Boolean @default(false)

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)
  ogImageId      String? @map("og_image_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products             CollectionProduct[]
  priceLists           PriceList[]
  discounts            Discount[]
  shippingProfileLinks ShippingProfileCollection[]
  b2bTierOverrides     B2bTierProductOverride[]
  b2bAccountOverrides  B2bAccountProductOverride[]

  @@unique([tenantId, handle], map: "product_collections_tenant_handle_unique")
  @@index([tenantId, type])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("commerce_product_collections")
}

// Join — populated for both manual and rules-driven collections (rules
// resolution materializes here so storefront reads stay one indexed
// query, not a rule re-evaluation).

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)
  addedBy      String @default("manual") @map("added_by") @db.VarChar(20) // manual | rule

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("commerce_collection_products")
}

// CRM — Segments (locked decision #4 — materialized, incremental).
//
// `rules` JSONB is validated against SegmentRuleSchema in @sparx/crm-schemas
// at write time. Membership is materialized into segment_members by the
// segment-evaluator consumer — never re-evaluated at email send or filter
// time.

model Segment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(63)
  description String?   @db.Text
  rules       Json
  color       String?   @db.VarChar(9)
  isSystem    Boolean   @default(false) @map("is_system")
  isBuiltIn   Boolean   @default(false) @map("is_built_in")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members SegmentMember[]

  @@unique([tenantId, slug])
  @@index([tenantId, archivedAt])
  @@map("segments")
}

model SegmentMember {
  segmentId  String   @map("segment_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  enteredAt  DateTime @default(now()) @map("entered_at") @db.Timestamptz
  score      Decimal? @db.Decimal(10, 4)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segment  Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([segmentId, customerId])
  @@index([tenantId, segmentId, enteredAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@map("segment_members")
}

// Commerce — Fitment data. Generalized "this product fits that thing"
// model. Originally vehicle-only (Make/Model/Engine) for the Gillett
// Diesel reference case; generalized so the same UI + storefront filter
// affordances cover any merchant whose catalog is filtered by what the
// product is compatible with — vehicles, pets, devices, apparel,
// industrial equipment, anything.
//
// Shape:
//   FitmentDomain   — top-level fitment vocabulary (vehicle, pet, device, ...)
//     ↳ FitmentCategory  — L1 grouping (Make / Brand / Species / Platform)
//        ↳ FitmentItem    — L2 grouping (Model / Device / Breed / OS Version) — optional
//           ↳ FitmentVariant — L3 grouping (Engine / Storage Tier / Size Class) — optional
//   ProductFitment  — one applicability row per product, naming domain +
//                     category (required), item/variant (optional), and
//                     an optional numeric range (year / weight / age /
//                     shoe size — unit declared on the domain).
//
// Domains can have 1, 2, or 3 levels:
//   vehicle  → 3 levels (Make → Model → Engine) + Year range
//   pet      → 2 levels (Species → Breed) + Weight range
//   device   → 2 levels (Brand → Model)
//   apparel  → 1 level (Size)
// The `labels` jsonb on FitmentDomain renames the level headers in the
// dashboard + storefront filter UI — same code, merchant-appropriate copy.
//
// Sparx seeds Vehicle as a global domain (tenantId IS NULL); tenants
// can extend within it (custom modifications, racing builds) and add
// their own domains entirely (a fishing-tackle store builds a "Species"
// domain, a phone-case shop builds a "Device" domain, etc.).

model FitmentDomain {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid // null = platform-seeded global
  slug        String  @db.VarChar(63)
  displayName String  @map("display_name") @db.VarChar(127)
  description String? @db.Text
  iconKey     String? @map("icon_key") @db.VarChar(63)
  // ^ lucide icon name the dashboard renders alongside the domain
  //   ("car" for vehicle, "paw-print" for pet, "smartphone" for device)
  labels      Json    @default("{}") @db.JsonB
  // ^ { l1: "Make", l2?: "Model", l3?: "Engine", range?: "Year" }
  //   `range` only present when rangeUnit is set.
  rangeUnit   String? @map("range_unit") @db.VarChar(20)
  // ^ "year" | "lb" | "kg" | "month" | "us_shoe" | "eu_shoe" | "mm" | "in"
  //   Drives storefront filter widget (year picker vs slider vs select).
  position    Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories FitmentCategory[]
  fitments   ProductFitment[]

  @@unique([tenantId, slug], map: "fitment_domains_tenant_slug_unique")
  @@index([tenantId])
  @@map("commerce_fitment_domains")
}

model FitmentCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid // null = platform-seeded
  domainId    String  @map("domain_id") @db.Uuid
  name        String  @db.VarChar(127)
  slug        String  @db.VarChar(127)
  attributes  Json    @default("{}") @db.JsonB
  // ^ free-form per-domain: { countryOfOrigin: "US" } for vehicle make,
  //   { taxonomyClass: "mammalia" } for pet species, etc.
  iconMediaId String? @map("icon_media_id") @db.Uuid
  position    Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain   FitmentDomain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  items    FitmentItem[]
  fitments ProductFitment[]

  @@unique([domainId, slug], map: "fitment_categories_domain_slug_unique")
  @@index([tenantId])
  @@index([domainId])
  @@map("commerce_fitment_categories")
}

model FitmentItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String? @map("tenant_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  name       String  @db.VarChar(127)
  slug       String  @db.VarChar(127)
  attributes Json    @default("{}") @db.JsonB
  // ^ vehicle: { bodyStyle: "truck" }; device: { platform: "ios" };
  //   pet: { breedGroup: "working" }
  position   Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category FitmentCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants FitmentVariant[]
  fitments ProductFitment[]

  @@unique([categoryId, slug], map: "fitment_items_category_slug_unique")
  @@index([tenantId])
  @@index([categoryId])
  @@map("commerce_fitment_items")
}

model FitmentVariant {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String? @map("tenant_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  name       String  @db.VarChar(127)
  slug       String  @db.VarChar(127)
  attributes Json    @default("{}") @db.JsonB
  // ^ vehicle engine: { displacementCc, cylinders, fuelType, aspiration };
  //   device: { storageGb, screenSizeIn }; apparel: { material }
  position   Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     FitmentItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fitments ProductFitment[]

  @@unique([itemId, slug], map: "fitment_variants_item_slug_unique")
  @@index([tenantId])
  @@index([itemId])
  @@map("commerce_fitment_variants")
}

// One row = one applicability rule. A product can carry many: a brake
// pad fits both 6.0L and 6.7L Power Stroke 2003-2010 + the 7.3L
// 1999-2003 — three rows. A dog harness fits Labradors 40-80 lb + Golden
// Retrievers 50-90 lb — two rows. Narrower fields are optional; absent
// columns widen the rule.

model ProductFitment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  domainId   String   @map("domain_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  itemId     String?  @map("item_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  rangeMin   Decimal? @map("range_min") @db.Decimal(12, 4)
  rangeMax   Decimal? @map("range_max") @db.Decimal(12, 4)
  // ^ Decimal so years (2018) and weights (12.5 lb) and shoe sizes (9.5)
  //   all fit one column. Unit lives on FitmentDomain.rangeUnit.
  notes      String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  domain   FitmentDomain   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  category FitmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  item     FitmentItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  variant  FitmentVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([tenantId, domainId, categoryId])
  @@index([tenantId, itemId])
  @@index([tenantId, variantId])
  @@index([tenantId, rangeMin, rangeMax])
  @@map("commerce_product_fitments")
}

// CRM — Saved views (cosmetic per-staff filter persistence).
//
// Customer/deal/task list views persist their filters here so a staff
// member can save "B2B fleet customers with overdue invoices" once and
// open it on any device. `config` is opaque JSON the consuming component
// interprets; `ownerUserId` null = shared with the tenant.

model SavedView {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  target      String   @db.VarChar(63) // customers | deals | tasks | pipeline | activities | orders | quotes
  name        String   @db.VarChar(120)
  config      Json     @default("{}")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, target, ownerUserId])
  @@map("saved_views")
}

// Commerce — Inventory: warehouses, levels, adjustments, reservations.
//
// `inventoryService.reserve()` is the single entry point for stock holds —
// cart soft (TTL 30m), order hard (until fulfillment), subscription
// renewal hard (until charge). Dropship supplier feeds project a virtual
// warehouse here; the platform sees one model regardless of who owns
// the stock.

model Warehouse {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(127)
  code     String @db.VarChar(15)
  type     String @default("owned") @db.VarChar(20) // owned | 3pl | dropship | virtual

  line1      String? @db.VarChar(255)
  line2      String? @db.VarChar(255)
  city       String? @db.VarChar(120)
  region     String? @db.VarChar(120)
  postalCode String? @map("postal_code") @db.VarChar(32)
  country    String? @db.VarChar(2)
  phone      String? @db.VarChar(50)
  latitude   Float?
  longitude  Float?

  // Per-channel default — when a line item lacks an explicit warehouse,
  // the picker resolves through here. Stored as JSONB string[].
  defaultForChannel Json @default("[]") @map("default_for_channel")
  hoursOfOperation  Json @default("[]") @map("hours_of_operation")
  metadata          Json @default("{}")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels             InventoryLevel[]
  adjustments        InventoryAdjustment[]
  reservations       InventoryReservation[]
  lotBatches         LotBatch[]
  serialUnits        SerialUnit[]
  defaultForProducts Product[]              @relation("ProductDefaultWarehouse")

  @@unique([tenantId, code], map: "warehouses_tenant_code_unique")
  @@index([tenantId, isActive])
  @@map("commerce_warehouses")
}

// (variant, warehouse) snapshot. onHand is authoritative; allocated +
// available are derived (allocated = sum of active hard reservations;
// available = onHand - allocated). reorderPoint / leadTimeDays drive
// the low-stock report + inventory.low events.

model InventoryLevel {
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid

  onHand    Int @default(0) @map("on_hand")
  allocated Int @default(0) @map("allocated")

  reorderPoint    Int? @map("reorder_point")
  reorderQuantity Int? @map("reorder_quantity")
  leadTimeDays    Int? @map("lead_time_days")
  unitCostCents   Int? @map("unit_cost_cents")

  asOf      DateTime @default(now()) @map("as_of") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([variantId, warehouseId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, onHand])
  @@map("commerce_inventory_levels")
}

// Every onHand change writes a row here. Reason categorizes the source;
// reference (Order, Return, Transfer, etc.) lets the dashboard surface
// "who touched this stock and when".

model InventoryAdjustment {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  delta  Int // signed
  reason String @db.VarChar(20)
  // ^ sale | return | recount | loss | damage | transfer_in | transfer_out | receive | reserve | release | manual

  referenceType String? @map("reference_type") @db.VarChar(63)
  referenceId   String? @map("reference_id") @db.Uuid
  actorUserId   String? @map("actor_user_id") @db.Uuid
  note          String? @db.Text
  unitCostCents Int?    @map("unit_cost_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId, createdAt(sort: Desc)])
  @@index([tenantId, warehouseId, createdAt(sort: Desc)])
  @@index([tenantId, referenceType, referenceId])
  @@map("commerce_inventory_adjustments")
}

// Holds against future fulfillment. Cart reservations have a TTL
// (`expiresAt`) and are released by a cleanup worker; order/subscription
// reservations carry no TTL and are released only on fulfill / cancel.

model InventoryReservation {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  quantity   Int
  holderType String @map("holder_type") @db.VarChar(20) // cart | order | subscription
  holderId   String @map("holder_id") @db.Uuid

  status     String    @default("active") @db.VarChar(20) // active | released | committed | expired
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedAt DateTime? @map("released_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId, status])
  @@index([tenantId, holderType, holderId])
  @@index([status, expiresAt])
  @@map("commerce_inventory_reservations")
}

// Commerce — Lot batches + per-unit serial numbers.
//
// Beauty products carry lot + expiry; auto parts carry serial numbers
// for traceability; food/supplements (dogfood, additives) need recall-
// ready batch identification. One model serves all three.
//
// `LotBatch.quantity` is the as-shipped batch count; runtime stock at
// the variant+warehouse level lives in commerce_inventory_levels and is
// the authoritative source for availability checks.

model LotBatch {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  lotNumber                    String    @map("lot_number") @db.VarChar(63)
  manufacturedAt               DateTime? @map("manufactured_at") @db.Timestamptz
  expiresAt                    DateTime? @map("expires_at") @db.Timestamptz
  quantity                     Int       @default(0)
  hazmatClass                  String    @default("none") @map("hazmat_class") @db.VarChar(32)
  supplierBatchRef             String?   @map("supplier_batch_ref") @db.VarChar(127)
  certificateOfAnalysisMediaId String?   @map("coa_media_id") @db.Uuid

  recallStatus String?   @map("recall_status") @db.VarChar(20)
  // ^ null | pending | active | cleared
  recallReason String?   @map("recall_reason") @db.Text
  recalledAt   DateTime? @map("recalled_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  serialUnits SerialUnit[]

  @@unique([variantId, lotNumber], map: "lot_batches_variant_lot_unique")
  @@index([tenantId, expiresAt])
  @@index([tenantId, recallStatus])
  @@map("commerce_lot_batches")
}

// One row per physical unit. For variants tracked at the unit level
// (high-value auto parts, regulated products), the serial is sold +
// pinned to an order item so the merchant can answer "where did this
// specific unit go?".

model SerialUnit {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  lotBatchId  String? @map("lot_batch_id") @db.Uuid

  serial String @db.VarChar(127)
  status String @default("in_stock") @db.VarChar(20)
  // ^ in_stock | reserved | sold | returned | scrapped | lost

  soldOnOrderItemId String?   @map("sold_on_order_item_id") @db.Uuid
  soldAt            DateTime? @map("sold_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lotBatch  LotBatch?      @relation(fields: [lotBatchId], references: [id], onDelete: SetNull)

  @@unique([variantId, serial], map: "serial_units_variant_serial_unique")
  @@index([tenantId, status])
  @@index([tenantId, lotBatchId])
  @@index([soldOnOrderItemId])
  @@map("commerce_serial_units")
}

// Commerce — Pricing: price lists, bulk tiers, contract prices.
// Discounts and gift cards are siblings in 37-commerce-discounts.
//
// Resolution order (pricingService.resolve):
//   contract_price (B2B) → price_list → bulk_tier → variant.priceCents
// Then layered: discounts → gift cards → store credit.

model PriceList {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(127)
  description       String?   @db.Text
  currency          String    @db.VarChar(3)
  channel           String?   @db.VarChar(20) // null = any | storefront | b2b_portal | subscription
  // Targeting — at most one of these is set; both null = default for channel.
  customerSegmentId String?   @map("customer_segment_id") @db.Uuid
  b2bAccountId      String?   @map("b2b_account_id") @db.Uuid
  collectionId      String?   @map("collection_id") @db.Uuid // restrict to one collection
  priority          Int       @default(0)
  validFrom         DateTime? @map("valid_from") @db.Timestamptz
  validTo           DateTime? @map("valid_to") @db.Timestamptz
  status            String    @default("draft") @db.VarChar(20) // draft | active | archived

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  b2bAccount B2BAccount?        @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
  collection ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  entries    PriceListEntry[]
  bulkTiers  BulkPriceTier[]

  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, b2bAccountId])
  @@map("commerce_price_lists")
}

// Per-variant override on a price list. Either fixed price OR percent-
// off-list — service-layer Zod enforces XOR; the DB stores both columns
// nullable so the row can be partially edited in the dashboard.

model PriceListEntry {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  priceListId     String @map("price_list_id") @db.Uuid
  variantId       String @map("variant_id") @db.Uuid
  fixedPriceCents Int?   @map("fixed_price_cents")
  percentOffList  Float? @map("percent_off_list")
  minQuantity     Int    @default(1) @map("min_quantity")
  maxQuantity     Int?   @map("max_quantity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQuantity], map: "price_list_entries_unique")
  @@index([tenantId, variantId])
  @@map("commerce_price_list_entries")
}

// "10+ at $5 off each" without writing a discount. Lives on a variant
// (storefront-wide) or scoped to a price list (B2B-specific tiering).

model BulkPriceTier {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  priceListId    String? @map("price_list_id") @db.Uuid
  minQuantity    Int     @map("min_quantity")
  unitPriceCents Int     @map("unit_price_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceList PriceList?      @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId, minQuantity])
  @@index([tenantId, priceListId, minQuantity])
  @@map("commerce_bulk_price_tiers")
}

// B2B contract price — negotiated, optionally with a signed agreement
// PDF attached as a media asset. Highest-priority pricing tier.

model ContractPrice {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  b2bAccountId           String    @map("b2b_account_id") @db.Uuid
  variantId              String    @map("variant_id") @db.Uuid
  priceCents             Int       @map("price_cents")
  validFrom              DateTime  @map("valid_from") @db.Timestamptz
  validTo                DateTime? @map("valid_to") @db.Timestamptz
  signedAgreementMediaId String?   @map("signed_agreement_media_id") @db.Uuid
  notes                  String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  b2bAccount B2BAccount     @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([b2bAccountId, variantId, validFrom], map: "contract_prices_unique")
  @@index([tenantId, b2bAccountId])
  @@index([tenantId, variantId])
  @@map("commerce_contract_prices")
}

// Markup rule (docs/48) — a reusable, tenant-owned recipe for turning a
// variant's COST into a charged price. Sits BEFORE the B2B/discount
// resolution order above: markup is a cost→list function; tiers and
// discounts are list→net functions (docs/48 §4). A variant bound to a
// catalog rule has its `price_cents` DERIVED, not typed; the snapshot on
// the variant (`applied_markup`) records how the price was computed.
//
// Money fields are integer cents to match `priceCents`/`costCents`. `value`
// is a unitless number whose meaning depends on `method`:
//   percentage    → fraction over cost  (0.40 = "+40%")
//   multiplier    → keystone factor     (2.50 = "×2.5")
//   margin_target → target margin frac  (0.45 = "45% margin")
//   flat          → dollars added to cost (15.00 = "+$15")
//   matrix        → null; bands[] carries per-band {method,value}
model MarkupRule {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String   @db.VarChar(255)
  method            String   @db.VarChar(20) // percentage | multiplier | flat | margin_target | matrix
  value             Decimal? @db.Decimal(12, 4)
  // Cost-band matrix (docs/48 §3.4): ordered [{ costMinCents, costMaxCents, method, value }];
  // first band whose range contains the cost wins. Empty for non-matrix methods.
  bands             Json     @default("[]")
  // Which cost to read (docs/48 §3.2). Phase 1 supports variant_cost + supplier_cost.
  costBasis         String   @default("variant_cost") @map("cost_basis") @db.VarChar(20)
  // Rounding strategy (docs/48 §3.3): { strategy:'none'|'nearest'|'charm', precisionCents?, endingCents? }
  rounding          Json     @default("{}")
  // Floor — raise price if it violates either guard.
  floorProfitCents  Int?     @map("floor_profit_cents")
  floorMargin       Decimal? @map("floor_margin") @db.Decimal(5, 2) // percent number, 30.00 = 30%
  // Ceiling — cap the result. ceiling_src: none | compare_at | msrp | fixed.
  ceilingSrc        String   @default("none") @map("ceiling_src") @db.VarChar(20)
  ceilingValueCents Int?     @map("ceiling_value_cents")
  // Application point (docs/48 §3.5): catalog | document | both.
  appliesTo         String   @default("catalog") @map("applies_to") @db.VarChar(10)
  // Scope (docs/48 §3.5): { type:'all'|'collection'|'product_type'|'vendor'|'products', ids?, value? }.
  scope             Json     @default("{}")
  priority          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")

  // Cost-driven recompute (docs/48 §8). When a bound variant's cost moves, the
  // markup-recompute-worker re-derives the list price. `recomputeMode`:
  //   auto   → apply automatically when the new price moves within tolerance; stage beyond it
  //   review → always stage the change for approval (a cost spike never silently reprices)
  //   off    → freeze; cost changes are ignored
  // `recomputeTolerancePct` is the auto-apply band as a percent price delta
  // (10.00 = ±10%); null = unbounded (any delta auto-applies under `auto`).
  recomputeMode         String   @default("auto") @map("recompute_mode") @db.VarChar(10)
  recomputeTolerancePct Decimal? @map("recompute_tolerance_pct") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants                ProductVariant[]
  recomputeReviews        MarkupRecomputeReview[]
  // Invoicing line types that default to this rule (docs/87 §5).
  billingLineTypeDefaults BillingDocumentLineType[] @relation("LineTypeDefaultMarkupRule")

  @@index([tenantId, isActive])
  @@map("markup_rules")
}

// Staged price recompute (docs/48 §8/§11). When a bound variant's cost changes
// and the rule's mode is `review` — or `auto` but the new price moves BEYOND the
// rule's tolerance band — the markup-recompute-worker does NOT silently reprice.
// It records the proposed change here for a human to approve or reject, with the
// full computed snapshot stored so approval is a pure write (no recompute) and the
// price stays reproducible even if the cost drifts again before someone acts.
// At most one PENDING review exists per variant (partial unique index, hand-SQL —
// Prisma can't express the predicate); a re-trigger replaces the prior proposal.
model MarkupRecomputeReview {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  variantId    String @map("variant_id") @db.Uuid
  markupRuleId String @map("markup_rule_id") @db.Uuid

  // What moved + what it would become. `oldCostCents` is best-effort (the cost
  // before the change, when the publisher knows it); `newCostCents` is the basis
  // the proposed price was computed from.
  oldCostCents  Int? @map("old_cost_cents")
  newCostCents  Int  @map("new_cost_cents")
  oldPriceCents Int  @map("old_price_cents")
  newPriceCents Int  @map("new_price_cents")

  // The AppliedMarkupSnapshot stamped onto the variant verbatim on approve —
  // { ruleId, method, value, costBasis, costBasisValueCents, computedPriceCents, computedAt }.
  appliedMarkup Json @map("applied_markup")

  // 'tolerance_exceeded' (auto mode, Δ beyond the band) | 'review_mode' (always-review rule).
  reason String @default("review_mode") @db.VarChar(30)
  // pending | approved | rejected
  status String @default("pending") @db.VarChar(20)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy String?   @map("resolved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  rule    MarkupRule     @relation(fields: [markupRuleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, variantId])
  @@map("markup_recompute_reviews")
}

// Surcharge rule (docs/48 §6) — a document-level fee that passes through a
// transaction cost the merchant incurs (chiefly the credit-card processing
// fee, default ~3%). NOT product markup: it applies to the order TOTAL, is
// gated by payment method, shows as its own line, and is snapshotted onto the
// order for refund proration. Platform default is OFF; surcharging is legally
// constrained (docs/48 §6.2) — the tenant opts in and owns compliance.
//
// `value` is a percent (3.0 = 3%) when type='percentage', or dollars (5.00)
// when type='flat'. `cap_cents` caps the computed amount.
model SurchargeRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(255)
  type           String   @default("percentage") @db.VarChar(10) // percentage | flat
  value          Decimal  @db.Decimal(8, 4)
  // What the % is computed on (docs/48 §6.1).
  basis          String   @default("total") @db.VarChar(25) // subtotal | subtotal_plus_shipping | total
  // Which checkout payment methods trigger it (e.g. ["card"]); excludes
  // ACH/check/net-terms. Coarse classification at checkout: a session with a
  // payment provider = 'card', net-terms = 'account'.
  paymentMethods String[] @default(["card"]) @map("payment_methods") @db.VarChar(20)
  appliesTo      String   @default("both") @map("applies_to") @db.VarChar(10) // checkout | invoice | both
  label          String   @db.VarChar(120) // customer-facing line label
  capCents       Int?     @map("cap_cents")
  isActive       Boolean  @default(false) @map("is_active") // platform default OFF

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("surcharge_rules")
}

// Commerce — Discounts, gift cards, store credit.
// Pricing pipeline applies these after the base / price-list / bulk-tier
// resolution from 36-commerce-pricing. Stacking is governed per
// discount; `usage` row enforces total + per-customer limits.

model Discount {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  code        String? @db.VarChar(63) // null = automatic
  name        String  @db.VarChar(127)
  description String? @db.Text

  type  String @db.VarChar(20) // percent | fixed | free_shipping | buy_x_get_y | bundle
  scope String @default("order") @db.VarChar(20) // order | product | collection | shipping

  valueCents   Int?    @map("value_cents")
  valuePercent Float?  @map("value_percent")
  currency     String? @db.VarChar(3)

  collectionId String? @map("collection_id") @db.Uuid
  conditions   Json    @default("[]")
  // ^ discriminated union of preconditions; see commerce-schemas/discounts.

  startAt          DateTime? @map("start_at") @db.Timestamptz
  endAt            DateTime? @map("end_at") @db.Timestamptz
  totalUsageLimit  Int?      @map("total_usage_limit")
  perCustomerLimit Int       @default(1) @map("per_customer_limit")
  stacking         String    @default("none") @db.VarChar(40)
  // ^ none | combine_with_subscribe_and_save | combine_with_loyalty | combine_with_all
  priority         Int       @default(0)
  status           String    @default("draft") @db.VarChar(20) // draft | active | archived
  usageCount       Int       @default(0) @map("usage_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection    ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  usages        DiscountUsage[]
  cartDiscounts CartDiscount[]

  @@unique([tenantId, code], map: "discounts_tenant_code_unique")
  @@index([tenantId, status])
  @@index([tenantId, startAt, endAt])
  @@map("commerce_discounts")
}

// One row per redemption. Enforces perCustomerLimit + totalUsageLimit at
// the service layer via SELECT COUNT before insert; the unique index is
// a backstop.

model DiscountUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  discountId   String   @map("discount_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  cartId       String?  @map("cart_id") @db.Uuid
  redeemedAt   DateTime @default(now()) @map("redeemed_at") @db.Timestamptz
  appliedCents Int      @default(0) @map("applied_cents")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([tenantId, discountId])
  @@index([tenantId, customerId])
  @@index([orderId])
  @@map("commerce_discount_usages")
}

// Gift cards. Cards sold as a product link back via purchasingOrderItemId
// so a refund of the sale revokes any remaining balance.

model GiftCard {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  code                  String    @db.VarChar(63)
  initialBalanceCents   Int       @map("initial_balance_cents")
  balanceCents          Int       @map("balance_cents")
  currency              String    @db.VarChar(3)
  status                String    @default("active") @db.VarChar(20) // active | spent | expired | cancelled
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz
  recipientEmail        String?   @map("recipient_email") @db.VarChar(255)
  recipientName         String?   @map("recipient_name") @db.VarChar(127)
  message               String?   @db.Text
  purchasingOrderItemId String?   @map("purchasing_order_item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions GiftCardTransaction[]

  @@unique([tenantId, code], map: "gift_cards_tenant_code_unique")
  @@index([tenantId, status])
  @@index([tenantId, recipientEmail])
  @@map("commerce_gift_cards")
}

model GiftCardTransaction {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  giftCardId  String  @map("gift_card_id") @db.Uuid
  orderId     String? @map("order_id") @db.Uuid
  deltaCents  Int     @map("delta_cents")
  reason      String  @db.VarChar(20) // issue | redeem | adjust | refund | expire
  actorUserId String? @map("actor_user_id") @db.Uuid
  note        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([tenantId, giftCardId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("commerce_gift_card_transactions")
}

// Per-customer credit balance. Single row per (tenant, customer,
// currency); transactions write deltas that the service sums + caches.

model StoreCredit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  currency     String    @db.VarChar(3)
  balanceCents Int       @default(0) @map("balance_cents")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions StoreCreditTransaction[]

  @@unique([tenantId, customerId, currency], map: "store_credit_unique")
  @@map("commerce_store_credit")
}

model StoreCreditTransaction {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  storeCreditId String  @map("store_credit_id") @db.Uuid
  deltaCents    Int     @map("delta_cents")
  reason        String  @db.VarChar(20)
  // ^ grant | refund | spend | adjust | expire | loyalty_conversion
  referenceType String? @map("reference_type") @db.VarChar(63)
  referenceId   String? @map("reference_id") @db.Uuid
  actorUserId   String? @map("actor_user_id") @db.Uuid
  note          String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeCredit StoreCredit @relation(fields: [storeCreditId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeCreditId, createdAt(sort: Desc)])
  @@map("commerce_store_credit_transactions")
}

// Commerce — Bundles + Configurator (option matrix + rules + add-ons).
//
// Drives play structures, beauty gift sets, auto-parts kits, custom
// dogfood crates. configuratorService.resolve() takes a selection
// payload from the storefront and emits a ResolvedConfiguration the
// cart stores on CartItem.configurationPayload.

model Bundle {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  bundleProductId String @map("bundle_product_id") @db.Uuid

  pricingMode     String @default("sum_of_components") @map("pricing_mode") @db.VarChar(20)
  // ^ sum_of_components | fixed | percent_off_sum
  fixedPriceCents Int?   @map("fixed_price_cents")
  percentOffSum   Float? @map("percent_off_sum")
  inventoryMode   String @default("decrement_components") @map("inventory_mode") @db.VarChar(30)
  // ^ decrement_components | decrement_bundle_sku

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundleProduct Product           @relation("BundleWrapper", fields: [bundleProductId], references: [id], onDelete: Cascade)
  components    BundleComponent[]

  @@unique([bundleProductId], map: "bundles_product_unique")
  @@index([tenantId])
  @@map("commerce_bundles")
}

model BundleComponent {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  bundleId           String  @map("bundle_id") @db.Uuid
  variantId          String  @map("variant_id") @db.Uuid
  productIdSwappable String? @map("product_id_swappable") @db.Uuid
  // ^ when isSwappable, the storefront can replace this variant with
  //   any variant of the linked product; null = exact-variant only
  defaultQuantity    Int     @default(1) @map("default_quantity")
  isRequired         Boolean @default(true) @map("is_required")
  isSwappable        Boolean @default(false) @map("is_swappable")
  position           Int     @default(0)

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundle               Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  swappableFromProduct Product?       @relation(fields: [productIdSwappable], references: [id], onDelete: SetNull)

  @@index([tenantId, bundleId])
  @@map("commerce_bundle_components")
}

// Configurator — the option-matrix-with-rules engine. One template per
// configurable product; the storefront submits a selection payload and
// the configurator yields a ResolvedConfiguration.

model ConfigurationTemplate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String  @db.VarChar(127)
  description String? @db.Text
  // Layout payload — step order, headers, visual hints. Free-form JSONB
  // so the editor UI can evolve without schema changes.
  layout      Json    @default("{}")
  status      String  @default("draft") @db.VarChar(20) // draft | active | archived

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ConfigurationOption[]
  rules   ConfigurationRule[]
  addOns  ConfigurationAddOn[]

  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@map("commerce_configuration_templates")
}

model ConfigurationOption {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  templateId        String  @map("template_id") @db.Uuid
  key               String  @db.VarChar(63)
  label             String  @db.VarChar(127)
  helpText          String? @map("help_text") @db.Text
  type              String  @db.VarChar(20)
  // ^ single_choice | multi_choice | toggle | quantity | text | color_swatch | image_picker
  required          Boolean @default(false)
  minSelections     Int?    @map("min_selections")
  maxSelections     Int?    @map("max_selections")
  defaultChoiceKeys Json    @default("[]") @map("default_choice_keys")
  groupHeader       String? @map("group_header") @db.VarChar(127)
  position          Int     @default(0)
  // Choices payload kept on the option row as JSONB — small, rarely
  // queried independently. A normalized table can split out later if
  // choice-level analytics emerge.
  choices           Json    @default("[]")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template ConfigurationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key], map: "configuration_options_key_unique")
  @@index([tenantId, templateId])
  @@map("commerce_configuration_options")
}

model ConfigurationRule {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid
  name       String @db.VarChar(127)
  match      String @default("all") @db.VarChar(10) // all | any
  conditions Json   @default("[]")
  actions    Json   @default("[]")
  priority   Int    @default(0)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template ConfigurationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@map("commerce_configuration_rules")
}

model ConfigurationAddOn {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  templateId         String  @map("template_id") @db.Uuid
  variantId          String  @map("variant_id") @db.Uuid
  defaultIncluded    Boolean @default(false) @map("default_included")
  priceOverrideCents Int?    @map("price_override_cents")
  position           Int     @default(0)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template ConfigurationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@index([variantId])
  @@map("commerce_configuration_addons")
}

// Commerce — Cart, cart items, applied discounts. Cart is the only thing
// storefront/B2B writes before checkout; once a CheckoutSession is
// created the cart freezes.

model Cart {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  // Origin site (docs/58 D1) — set from the storefront's active property so the
  // order placed from this cart inherits it. Nullable for admin / MCP carts.
  propertyId String? @map("property_id") @db.Uuid
  guestToken String? @map("guest_token") @db.VarChar(127)
  channel    String  @db.VarChar(20) // storefront | b2b_portal | admin | mcp
  currency   String  @db.VarChar(3)

  // Source provenance — populated when the cart was bootstrapped from
  // an existing quote or subscription. Both nullable; CRM owns the rows.
  fromQuoteId        String? @map("from_quote_id") @db.Uuid
  fromSubscriptionId String? @map("from_subscription_id") @db.Uuid

  // Cached totals; the deterministic pricing pipeline writes these on
  // every cart mutation so the storefront can render without recomputing.
  subtotalCents           Int @default(0) @map("subtotal_cents")
  discountTotalCents      Int @default(0) @map("discount_total_cents")
  shippingTotalCents      Int @default(0) @map("shipping_total_cents")
  taxTotalCents           Int @default(0) @map("tax_total_cents")
  giftCardAppliedCents    Int @default(0) @map("gift_card_applied_cents")
  storeCreditAppliedCents Int @default(0) @map("store_credit_applied_cents")
  totalCents              Int @default(0) @map("total_cents")

  // Per-tenant pricing trace — every step of the resolution pipeline is
  // recorded here so the storefront can answer "why is this the price?"
  // without re-running the math.
  pricingTrace Json @default("{}") @map("pricing_trace")

  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  abandonedAt DateTime? @map("abandoned_at") @db.Timestamptz
  recoveredAt DateTime? @map("recovered_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  items            CartItem[]
  discounts        CartDiscount[]
  checkoutSessions CheckoutSession[]

  @@index([tenantId, customerId])
  @@index([tenantId, guestToken])
  @@index([tenantId, abandonedAt])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("commerce_carts")
}

model CartItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int    @default(1)

  unitPriceCents Int @map("unit_price_cents")
  subtotalCents  Int @map("subtotal_cents")

  // Configurator payload (when the variant is the resolution of a
  // configurable parent). Stored intact so the line item can be
  // re-resolved on price refresh.
  configurationPayload Json? @map("configuration_payload")
  attributes           Json  @default("{}")

  // Per-line trace from pricingService.resolve.
  unitPriceTrace Json @default("[]") @map("unit_price_trace")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, cartId])
  @@index([variantId])
  @@map("commerce_cart_items")
}

// Applied discounts on a cart. A cart can carry multiple (when stacking
// rules permit). Applied gift cards live alongside in cartGiftCards
// (next model).

model CartDiscount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  discountId   String   @map("discount_id") @db.Uuid
  appliedCents Int      @map("applied_cents")
  appliedAt    DateTime @default(now()) @map("applied_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([cartId, discountId], map: "cart_discounts_unique")
  @@index([tenantId, cartId])
  @@map("commerce_cart_discounts")
}

// Commerce — Checkout sessions. Multi-step state machine driving cart →
// order. The session captures the chosen provider refs (payment intent,
// shipping rate, tax breakdown) so the flow is idempotent across page
// reloads.

model CheckoutSession {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  cartId   String @map("cart_id") @db.Uuid

  step String @default("cart_review") @db.VarChar(20)
  // ^ cart_review | contact | shipping | payment | review | completed | expired

  channel  String @db.VarChar(20)
  currency String @db.VarChar(3)

  customerId       String? @map("customer_id") @db.Uuid
  b2bAccountId     String? @map("b2b_account_id") @db.Uuid
  customerEmail    String? @map("customer_email") @db.VarChar(255)
  customerPhone    String? @map("customer_phone") @db.VarChar(50)
  acceptsMarketing Boolean @default(false) @map("accepts_marketing")

  // Address snapshots persisted on the session so the storefront can
  // replay them between steps without re-fetching from CustomerAddress.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  // Provider refs captured at each step.
  shippingProviderSlug String? @map("shipping_provider_slug") @db.VarChar(63)
  shippingRateRef      String? @map("shipping_rate_ref") @db.VarChar(255)
  shippingDescription  String? @map("shipping_description") @db.VarChar(255)
  paymentProviderSlug  String? @map("payment_provider_slug") @db.VarChar(63)
  paymentRef           String? @map("payment_ref") @db.VarChar(255)
  taxProviderSlug      String? @map("tax_provider_slug") @db.VarChar(63)
  taxBreakdownRef      String? @map("tax_breakdown_ref") @db.VarChar(255)
  taxBreakdown         Json?   @map("tax_breakdown")

  // B2B-only inputs surfaced during net-terms checkout.
  poNumber              String? @map("po_number") @db.VarChar(63)
  paymentTermsRequested String? @map("payment_terms_requested") @db.VarChar(20)

  // Cached totals at session-completion time. After complete() runs,
  // these mirror the Order's totals so refund flows can find the
  // numbers without joining back to CRM.
  subtotalCents           Int @default(0) @map("subtotal_cents")
  discountTotalCents      Int @default(0) @map("discount_total_cents")
  shippingTotalCents      Int @default(0) @map("shipping_total_cents")
  taxTotalCents           Int @default(0) @map("tax_total_cents")
  giftCardAppliedCents    Int @default(0) @map("gift_card_applied_cents")
  storeCreditAppliedCents Int @default(0) @map("store_credit_applied_cents")
  // Document-level surcharge (docs/48 §6), computed at complete() after tax and
  // folded into totalCents. Cached here so refund/serialization paths read it.
  surchargeTotalCents     Int @default(0) @map("surcharge_total_cents")
  totalCents              Int @default(0) @map("total_cents")

  // Idempotency on complete(). The same key always resolves to the same
  // resulting orderId, even on retry.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(127)
  resultOrderId  String? @map("result_order_id") @db.Uuid

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart       Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  b2bAccount B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey], map: "checkout_sessions_idempotency_unique")
  @@index([tenantId, cartId])
  @@index([tenantId, customerId])
  @@index([tenantId, step])
  @@index([tenantId, expiresAt])
  @@map("commerce_checkout_sessions")
}

// Commerce — Subscriptions (auto-ship). First-class recurring orders for
// dogfood / diesel-additive / supplement merchants. SubscriptionBilling
// provider (Stripe by default) drives the actual charge schedule; the
// subscription-billing-worker advances Sparx state on the back of
// provider webhook events.

model Subscription {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  channel    String @default("storefront") @db.VarChar(20)
  currency   String @db.VarChar(3)

  status String @default("active") @db.VarChar(20)
  // ^ trialing | active | past_due | paused | cancelled

  // Provider linkage — slug + provider's internal schedule ref.
  providerSlug        String  @map("provider_slug") @db.VarChar(63)
  providerCustomerRef String? @map("provider_customer_ref") @db.VarChar(255)
  providerScheduleRef String? @map("provider_schedule_ref") @db.VarChar(255)

  // Schedule shape — the worker reads these to compute next occurrences
  // when the provider doesn't drive the cadence.
  intervalUnit        String    @map("interval_unit") @db.VarChar(10) // day | week | month | year
  intervalCount       Int       @map("interval_count")
  deliveriesPerCycle  Int       @default(1) @map("deliveries_per_cycle")
  anchorDayOfMonth    Int?      @map("anchor_day_of_month")
  anchorDayOfWeek     Int?      @map("anchor_day_of_week")
  endAfterOccurrences Int?      @map("end_after_occurrences")
  endOnDate           DateTime? @map("end_on_date") @db.Timestamptz

  // Address snapshots used for renewal orders; can be changed mid-cycle
  // via subscriptionService.changeAddress.
  shippingAddress Json  @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  // Lifecycle timestamps.
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz
  nextOccurrenceAt   DateTime? @map("next_occurrence_at") @db.Timestamptz
  pausedUntil        DateTime? @map("paused_until") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz

  // Dunning policy override per subscription; null = use tenant default.
  dunningPolicy Json? @map("dunning_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items           SubscriptionItem[]
  events          SubscriptionEvent[]
  dunningAttempts DunningAttempt[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([nextOccurrenceAt])
  @@map("commerce_subscriptions")
}

model SubscriptionItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  quantity       Int    @default(1)
  unitPriceCents Int    @map("unit_price_cents")

  // Configurator selection (when the item resolves through a configurator
  // template at signup time). Stored intact so renewals stay deterministic.
  configurationPayload Json? @map("configuration_payload")

  // Add-on parent — used when an item was added by a configurator rule
  // ("add a slide pack to the swing set"). The parent SubscriptionItem
  // is the primary; this row carries the add-on alongside it.
  addonOfId String? @map("addon_of_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  addonOf      SubscriptionItem?  @relation("SubscriptionItemAddon", fields: [addonOfId], references: [id], onDelete: SetNull)
  addons       SubscriptionItem[] @relation("SubscriptionItemAddon")

  @@index([tenantId, subscriptionId])
  @@index([variantId])
  @@map("commerce_subscription_items")
}

// Audit-log-shaped event stream — created, renewed, paused, etc. Used
// by the storefront customer-facing subscription history surface.

model SubscriptionEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  event          String   @db.VarChar(40)
  // ^ created | renewed | payment_failed | paused | resumed | cancelled | skipped | item_changed | address_changed
  payload        Json     @default("{}")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId, occurredAt(sort: Desc)])
  @@map("commerce_subscription_events")
}

// Per-subscription retry attempt log. The subscription-billing-worker
// reads the tail of this to decide whether to retry, escalate, or
// follow the policy's finalOutcome.

model DunningAttempt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  paymentRef     String?   @map("payment_ref") @db.VarChar(255)
  attemptNumber  Int       @map("attempt_number")
  outcome        String    @db.VarChar(20) // pending | succeeded | failed | retry_scheduled
  failureReason  String?   @map("failure_reason") @db.Text
  attemptedAt    DateTime  @default(now()) @map("attempted_at") @db.Timestamptz
  nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId, attemptedAt(sort: Desc)])
  @@map("commerce_dunning_attempts")
}

// Commerce — Reviews, Q&A, wishlists. Moderation gate lives on the
// service layer; `review.published` event fires when status flips to
// `approved` so the storefront cache invalidates.

model ProductReview {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  orderId    String? @map("order_id") @db.Uuid // populated → verified-purchase badge

  rating Int    @db.SmallInt
  title  String @db.VarChar(127)
  body   String @db.Text

  // Anonymous reviews use displayName; signed-in reviews fall back to the
  // customer's profile name.
  displayName String? @map("display_name") @db.VarChar(63)

  status         String    @default("pending") @db.VarChar(20)
  // ^ pending | approved | rejected | flagged
  moderationNote String?   @map("moderation_note") @db.Text
  moderatedBy    String?   @map("moderated_by") @db.Uuid
  moderatedAt    DateTime? @map("moderated_at") @db.Timestamptz

  // Merchant response — displayed beside the review.
  response         String?   @db.Text
  responseAuthorId String?   @map("response_author_id") @db.Uuid
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz

  helpfulCount   Int @default(0) @map("helpful_count")
  unhelpfulCount Int @default(0) @map("unhelpful_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  media         ReviewMedia[]
  helpfulVotes  ReviewHelpfulVote[]
  moderationLog ReviewModerationLog[]

  @@index([tenantId, productId, status])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@map("commerce_product_reviews")
}

model ReviewMedia {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  reviewId     String @map("review_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewId])
  @@index([mediaAssetId])
  @@map("commerce_review_media")
}

// One vote per (review, voter). voterFingerprint is the hashed IP+UA
// for anonymous voters; customerId carries authenticated voters.

model ReviewHelpfulVote {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  reviewId         String  @map("review_id") @db.Uuid
  customerId       String? @map("customer_id") @db.Uuid
  voterFingerprint String  @map("voter_fingerprint") @db.VarChar(127)
  helpful          Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterFingerprint], map: "review_helpful_votes_unique")
  @@index([tenantId, reviewId])
  @@map("commerce_review_helpful_votes")
}

model ReviewModerationLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  reviewId    String  @map("review_id") @db.Uuid
  action      String  @db.VarChar(20) // submitted | approved | rejected | flagged | edited
  actorUserId String? @map("actor_user_id") @db.Uuid
  note        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewId, createdAt(sort: Desc)])
  @@map("commerce_review_moderation_log")
}

// ─── Q&A ──────────────────────────────────────────────────────────────

model ProductQuestion {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  displayName  String? @map("display_name") @db.VarChar(63)
  body         String  @db.Text
  status       String  @default("pending") @db.VarChar(20)
  // ^ pending | published | rejected
  helpfulCount Int     @default(0) @map("helpful_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  answers  ProductAnswer[]

  @@index([tenantId, productId, status])
  @@map("commerce_product_questions")
}

model ProductAnswer {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  questionId       String  @map("question_id") @db.Uuid
  body             String  @db.Text
  isOfficial       Boolean @default(false) @map("is_official") // merchant staff answer
  authorCustomerId String? @map("author_customer_id") @db.Uuid
  authorUserId     String? @map("author_user_id") @db.Uuid
  helpfulCount     Int     @default(0) @map("helpful_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId, questionId])
  @@map("commerce_product_answers")
}

// ─── Wishlists ────────────────────────────────────────────────────────

model Wishlist {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  name       String  @default("My Wishlist") @db.VarChar(127)
  isPublic   Boolean @default(false) @map("is_public")
  shareToken String? @map("share_token") @db.VarChar(63)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([tenantId, shareToken], map: "wishlists_share_token_unique")
  @@index([tenantId, customerId])
  @@map("commerce_wishlists")
}

model WishlistItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  wishlistId String  @map("wishlist_id") @db.Uuid
  variantId  String  @map("variant_id") @db.Uuid
  note       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, variantId], map: "wishlist_items_unique")
  @@index([tenantId, wishlistId])
  @@map("commerce_wishlist_items")
}

// Commerce — Returns / RMA workflow. Customer- or staff-initiated;
// inspection + restock decision per line item; refund or store-credit
// settlement.

model ReturnRequest {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  requestedBy String @map("requested_by") @db.VarChar(20) // customer | staff

  status           String  @default("requested") @db.VarChar(20)
  // ^ requested | approved | denied | awaiting_shipment | in_transit |
  //   received | inspecting | inspected | refunded | cancelled
  preferredOutcome String  @default("refund") @map("preferred_outcome") @db.VarChar(20)
  // ^ refund | store_credit | exchange | repair
  staffNote        String? @map("staff_note") @db.Text

  refundedAmountCents Int?    @map("refunded_amount_cents")
  restockingFeeCents  Int?    @map("restocking_fee_cents")
  refundIssuedAs      String? @map("refund_issued_as") @db.VarChar(20)
  // ^ original_payment | store_credit | gift_card

  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  receivedAt  DateTime? @map("received_at") @db.Timestamptz
  refundedAt  DateTime? @map("refunded_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       ReturnLineItem[]
  inspections ReturnInspection[]
  labels      ReturnLabel[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("commerce_return_requests")
}

model ReturnLineItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  returnId         String  @map("return_id") @db.Uuid
  orderItemId      String  @map("order_item_id") @db.Uuid
  quantity         Int
  approvedQuantity Int     @default(0) @map("approved_quantity")
  reasonCode       String  @map("reason_code") @db.VarChar(40)
  // ^ wrong_item | wrong_size | defective | damaged_in_transit |
  //   not_as_described | no_longer_needed | arrived_late | other
  customerNote     String? @map("customer_note") @db.Text
  mediaAssetIds    Json    @default("[]") @map("media_asset_ids") // customer photos

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnId])
  @@index([orderItemId])
  @@map("commerce_return_line_items")
}

model ReturnInspection {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  returnId         String  @map("return_id") @db.Uuid
  returnLineItemId String  @map("return_line_item_id") @db.Uuid
  condition        String  @db.VarChar(20)
  // ^ unopened | like_new | used_good | used_acceptable | damaged | destroyed
  restockable      Boolean
  warehouseId      String? @map("warehouse_id") @db.Uuid
  photoMediaIds    Json    @default("[]") @map("photo_media_ids")
  note             String? @db.Text
  inspectedBy      String? @map("inspected_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnId])
  @@index([returnLineItemId])
  @@map("commerce_return_inspections")
}

model ReturnLabel {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  returnId       String  @map("return_id") @db.Uuid
  providerSlug   String  @map("provider_slug") @db.VarChar(63)
  labelRef       String  @map("label_ref") @db.VarChar(255)
  trackingNumber String? @map("tracking_number") @db.VarChar(127)
  trackingUrl    String? @map("tracking_url") @db.VarChar(2048)
  labelMediaId   String? @map("label_media_id") @db.Uuid
  costCents      Int     @default(0) @map("cost_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnId])
  @@map("commerce_return_labels")
}

// Commerce — Shipping zones, profiles, manual rates. Real-time carrier
// rates and label purchases delegate to the ShippingProvider plug-in
// chosen at checkout time.

model ShippingZone {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(127)
  priority Int    @default(0)

  // Targeting payload — countries[], regions[], postalCodeRanges[]
  // (ISO codes + ranges). Service-layer Zod validates the shape.
  targeting Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates  ShippingRate[]

  @@index([tenantId, priority])
  @@map("commerce_shipping_zones")
