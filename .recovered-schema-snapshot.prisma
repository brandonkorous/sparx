// Commerce — Provider installations + webhook idempotency log. The
// marketplace plug-in model: tenants pick payment/tax/shipping/
// subscription/dropship providers from the marketplace; each install
// row carries the encrypted config + status; every inbound webhook is
// idempotently recorded here before downstream processing.

model ProviderInstallation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  providerSlug String  @map("provider_slug") @db.VarChar(63)
  kind         String  @db.VarChar(30)
  // ^ payment | tax | shipping | subscription_billing | dropship | identity
  environment  String  @default("production") @db.VarChar(20) // sandbox | production
  enabled      Boolean @default(true)

  status String @default("pending_configuration") @db.VarChar(40)
  // ^ pending_configuration | pending_oauth | pending_verification |
  //   active | errored | disabled

  label             String? @db.VarChar(127)
  // Encrypted configuration JSON. Secrets reference Google Secret
  // Manager paths rather than carrying the secret value directly.
  configEncrypted   Json    @default("{}") @map("config_encrypted")
  scopes            Json    @default("[]")
  // Provider-side IDs the platform needs to remember (Stripe account_id,
  // Shippo carrier_account ids, etc.).
  providerAccountId String? @map("provider_account_id") @db.VarChar(255)

  lastHealthCheckAt DateTime? @map("last_health_check_at") @db.Timestamptz
  lastHealthStatus  String?   @map("last_health_status") @db.VarChar(40)
  lastHealthDetail  String?   @map("last_health_detail") @db.Text
  errorCount        Int       @default(0) @map("error_count")
  lastErrorAt       DateTime? @map("last_error_at") @db.Timestamptz

  installedAt   DateTime  @default(now()) @map("installed_at") @db.Timestamptz
  uninstalledAt DateTime? @map("uninstalled_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents ProviderWebhookEvent[]

  @@unique([tenantId, providerSlug, environment, label], map: "provider_installations_unique")
  @@index([tenantId, kind, enabled])
  @@index([tenantId, status])
  @@map("commerce_provider_installations")
}

// Provider webhook log. Idempotency key = (providerSlug, providerEventId)
// — duplicates from provider retries get dropped at insert time.

model ProviderWebhookEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  installationId      String   @map("installation_id") @db.Uuid
  providerSlug        String   @map("provider_slug") @db.VarChar(63)
  providerEventId     String   @map("provider_event_id") @db.VarChar(255)
  providerEventType   String   @map("provider_event_type") @db.VarChar(127)
  signatureVerifiedAt DateTime @map("signature_verified_at") @db.Timestamptz
  rawPayload          Json     @map("raw_payload")

  status      String    @default("received") @db.VarChar(20)
  // ^ received | processing | processed | failed | discarded
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  errorReason String?   @map("error_reason") @db.Text
  retryCount  Int       @default(0) @map("retry_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installation ProviderInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([providerSlug, providerEventId], map: "provider_webhook_events_idempotency")
  @@index([tenantId, installationId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("commerce_provider_webhook_events")
}

// Commerce — Per-tenant storefront settings + theme token overrides.
// Sitebuilder owns layout + page composition (separate module);
// Commerce owns the commerce-side defaults (currency, default warehouse,
// channels enabled, abandonment threshold) and the limited set of theme
// tokens a tenant can override without touching Sitebuilder.

// One row per (tenant, PROPERTY) — each site's commerce defaults + checkout
// policy (docs/49 Phase 6b). A site with no row of its own INHERITS the tenant's
// PRIMARY site's settings at read time (services resolve property → primary →
// code defaults), so adding a site never silently resets currency/locale. The
// migration adds property_id, backfills to the primary, and swaps the PK.
model StorefrontSettings {
  tenantId   String @map("tenant_id") @db.Uuid
  // One settings row per property → property_id is globally unique, making the
  // Property↔StorefrontSettings back-relation one-to-one.
  propertyId String @unique @map("property_id") @db.Uuid

  defaultCurrency         String  @default("USD") @map("default_currency") @db.VarChar(3)
  defaultLocale           String  @default("en-US") @map("default_locale") @db.VarChar(10)
  defaultWarehouseId      String? @map("default_warehouse_id") @db.Uuid
  channelsEnabled         Json    @default("[\"storefront\"]") @map("channels_enabled")
  cartAbandonmentMinutes  Int     @default(120) @map("cart_abandonment_minutes")
  showStockBelow          Int     @default(10) @map("show_stock_below")
  hidePricesWhenSignedOut Boolean @default(false) @map("hide_prices_when_signed_out")
  requireAuthForCheckout  Boolean @default(false) @map("require_auth_for_checkout")

  // Default dunning policy used by every subscription on this tenant
  // unless overridden per-subscription.
  defaultDunningPolicy Json @default("{}") @map("default_dunning_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@map("commerce_storefront_settings")
}

// PRESENTATION-only token overrides applied on top of @sparx/ui's storefront
// variants. Brand IDENTITY (primary/accent colour, typography, logo, favicon)
// is owned by the tenant-level TenantBrand (docs/30 §6) and read live + overlaid
// at render — it is NOT mirrored here. The former identity columns
// (color_primary/_primary_foreground/_accent, font_heading/_body,
// logo_media_id/logo_dark_media_id/favicon_media_id) were removed in migration
// 20260610000200 once every reader cut over to brand.

// One row per (tenant, PROPERTY) — the sitebuilder publish write-through target,
// now per-site (docs/49 Phase 6). Each site's publish compiles its own light
// tokens here; the migration adds property_id, backfills to the primary, and
// swaps the PK to the composite. property_id is NOT a security boundary.
model StorefrontTheme {
  tenantId   String @map("tenant_id") @db.Uuid
  // One theme per property → property_id is globally unique, making the
  // Property↔StorefrontTheme back-relation one-to-one.
  propertyId String @unique @map("property_id") @db.Uuid

  colorBackground String? @map("color_background") @db.VarChar(7)
  colorMuted      String? @map("color_muted") @db.VarChar(7)
  radiusBase      String? @map("radius_base") @db.VarChar(15)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@map("commerce_storefront_themes")
}

// Customer auth — Layer 2 (storefront shoppers). See docs/27-customer-accounts-storefront-auth.md.
//
// Distinct from Layer 1 (staff Better Auth: users/sessions/accounts). These
// tables hang off the CRM `customers` spine — the CRM owns the customer record;
// auth only adds credentials + sessions + reset tokens.
//
// Why not Better Auth: Better Auth keys credential sign-in on a GLOBALLY unique
// email; shoppers must register the same email at different tenants as
// separate accounts (unique per (tenantId, email)). For a shopper the tenant is
// known BEFORE auth (it's the storefront hostname), so every operation runs in
// withTenant() and RLS isolates by tenant — no global-email requirement.
//
// Passwords are stored ONLY as Argon2id hashes. Session/reset tokens are stored
// ONLY as SHA-256 hashes; the plaintext lives in the cookie / reset link.

// Tenant-wide shopper IDENTITY (docs/58 D2) — one per (tenant, email). This is
// the LOGIN: it owns the credential + password resets. A person who shops more
// than one of the tenant's sites is ONE identity (one password) linked to a
// per-site `customers` MEMBERSHIP each (which owns that site's consent, orders,
// and LTV). Lets us recognize "you already have an account on a sister site"
// without merging consent (docs/58 D6). Tenant-scoped + FORCE RLS on tenant_id.
model CustomerIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential     CustomerCredential?
  passwordResets CustomerPasswordReset[]
  memberships    Customer[]

  @@unique([tenantId, email], map: "customer_identities_tenant_email_unique")
  @@map("customer_identities")
}

// One credential per IDENTITY (the login). A `customers` membership can exist
// without one (guest checkout, CRM-imported prospect); the credential hangs off
// the identity, not the membership, so a single login spans the person's sites.
model CustomerCredential {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  identityId    String    @unique @map("identity_id") @db.Uuid
  passwordHash  String    @map("password_hash") @db.Text // Argon2id — NEVER plaintext
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identity CustomerIdentity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions CustomerSession[]

  @@index([tenantId])
  @@map("customer_credentials")
}

// Opaque rotating session. `tokenHash` = SHA-256 hex of the random token in the
// httpOnly cookie. Expiry enforced in-app and indexed for cheap cleanup.
model CustomerSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  credentialId String   @map("credential_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  credential CustomerCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

// Single-use password-reset tokens. `tokenHash` = SHA-256 hex of the token
// mailed to the customer. Short-lived; consumed (usedAt set) on use.
model CustomerPasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identity CustomerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([tenantId, identityId])
  @@map("customer_password_resets")
}

// Sitebuilder — theme selection, page/section composition, layout slots,
// and the draft → publish → schedule → rollback lifecycle (docs/29).
//
// SiteConfig is the editable source of truth (one per tenant). Publishing
// snapshots it into an immutable SiteVersion and write-through-compiles the
// light token subset into the commerce-owned StorefrontTheme row (the
// storefront's existing themeToCss() read path is unchanged). Sitebuilder
// never adds columns to commerce_storefront_themes and never writes CMS
// navigation rows — SiteLayoutBlock only *references* a NavigationMenu.
//
// Tenant-scoped + FORCE RLS so a callsite that forgets withTenant() returns
// nothing rather than leaking cross-tenant site config.

// One row per (tenant, PROPERTY) — each site's working draft + pointer to its
// live version (docs/49 Phase 6). Pre-Phase-6 this was one row per tenant; the
// migration adds property_id, backfills to the primary, and swaps the PK to the
// composite (mirroring builder_layouts going per-property). property_id is NOT a
// security boundary — tenant_id (the RLS GUC) is.
model SiteConfig {
  tenantId   String @map("tenant_id") @db.Uuid
  // A property has exactly one config, so property_id is globally unique (a
  // property belongs to one tenant) — @unique makes the Property↔SiteConfig
  // back-relation one-to-one.
  propertyId String @unique @map("property_id") @db.Uuid

  themeKey         String @default("apex") @map("theme_key") @db.VarChar(63)
  // light-only | dark-only | auto | toggle
  appearancePolicy String @default("light-only") @map("appearance_policy") @db.VarChar(20)
  // Tenant overlay: { colors: { light, dark }, typography, layout, customCss }.
  // Shape validated by @sparx/sitebuilder-schemas, not the DB.
  draftSettings    Json   @default("{}") @map("draft_settings")

  publishedVersionId String? @unique @map("published_version_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property         Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  publishedVersion SiteVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@id([tenantId, propertyId])
  @@map("sitebuilder_configs")
}

// Immutable published snapshot. Rollback = copy a snapshot back into the
// draft and republish (creating a new version). compiledTokens holds the
// exact { light, dark } maps so a rollback re-writes StorefrontTheme
// deterministically without recompiling.
model SiteVersion {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this version belongs to (docs/49 Phase 6). Version
  // numbers run per (tenant, property); each site has its own publish history.
  propertyId String @map("property_id") @db.Uuid

  versionNumber    Int    @map("version_number")
  themeKey         String @map("theme_key") @db.VarChar(63)
  appearancePolicy String @map("appearance_policy") @db.VarChar(20)

  settingsSnapshot    Json @map("settings_snapshot")
  sectionsSnapshot    Json @map("sections_snapshot")
  layoutSnapshot      Json @map("layout_snapshot")
  compiledTokens      Json @map("compiled_tokens")
  // Pinned custom-section definitions (docs/38 Phase C) the snapshot's sections
  // reference, keyed by slug — so a `custom:<slug>` section renders deterministically
  // from the template AST as it was at publish, surviving later edits/deletes.
  // Defaults to [] (no custom sections / pre-Phase-C versions).
  definitionsSnapshot Json @default("[]") @map("definitions_snapshot")

  publishedById String? @map("published_by_id") @db.Uuid
  note          String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Back-relation for SiteConfig.publishedVersion (the currently-live snapshot).
  publishedByConfig SiteConfig? @relation("PublishedVersion")

  @@unique([tenantId, propertyId, versionNumber])
  @@index([tenantId, propertyId, createdAt(sort: Desc)])
  @@map("sitebuilder_versions")
}

// PageLayout — a reusable page layout for a layout TARGET (docs/30 §4, docs/36
// PageLayout tier; docs/handoffs/sitebuilder-pb-spec.md). Sections (SiteSection)
// hang off a layout. `targetId` is the data-driven layout-target id (docs/36 §4 —
// `commerce:product`, `cms:content-page`, `cms:content-type:<id>`, …) that
// determines the layout's data context + allowed section types; it replaced the
// old fixed `scope` enum (P-B). `key` is stable within (tenant, targetId) —
// "default" for a target's single layout, a slug for cms:content-page standalone
// pages. Tenant-scoped, ENABLE+FORCE RLS.
model PageLayout {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  targetId String @map("target_id") @db.VarChar(63)
  key      String @db.VarChar(255)
  name     String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections    SiteSection[]
  defaults    SiteLayoutDefault[]
  assignments SiteLayoutAssignment[]

  @@unique([tenantId, targetId, key])
  @@index([tenantId, targetId])
  @@map("sitebuilder_page_layouts")
}

// Draft page composition — one row per section instance, hanging off a
// PageLayout. Published copies are denormalized into SiteVersion.sectionsSnapshot
// (which also carries the owning layout's targetId/key so old + new snapshots
// both resolve).
model SiteSection {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  pageLayoutId String @map("page_layout_id") @db.Uuid

  sectionType String  @map("section_type") @db.VarChar(63)
  position    Int
  visible     Boolean @default(true)
  config      Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pageLayout PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)

  @@index([tenantId, pageLayoutId, position])
  @@map("sitebuilder_sections")
}

// Header / footer / announcement composition. navigationMenuId points at a
// CMS-owned NavigationMenu (reference only — CMS stays the sole writer of
// nav rows). config carries slot extras (announcement text, footer social
// links, logo placement, container width).
model SiteLayoutBlock {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // header | footer | announcement
  slot             String  @db.VarChar(31)
  navigationMenuId String? @map("navigation_menu_id") @db.Uuid
  config           Json    @default("{}")
  visible          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  navigationMenu NavigationMenu? @relation(fields: [navigationMenuId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slot])
  @@index([tenantId])
  @@map("sitebuilder_layout_blocks")
}

// Scheduled publish records. The in-process tick scans (status, scheduled_at)
// via a SECURITY DEFINER function and runs publish-service.publishNow per
// due tenant.
model SitePublishSchedule {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this scheduled publish targets (docs/49 Phase 6). The
  // cross-tenant scan stays keyed by (status, scheduled_at); the per-row publish
  // reads property_id off the schedule to scope the snapshot to that site.
  propertyId String @map("property_id") @db.Uuid

  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz
  // pending | published | cancelled | failed
  status      String   @default("pending") @db.VarChar(20)
  note        String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid

  // Optional saved theme to apply to the draft before this scheduled publish
  // snapshots — seasonal/holiday theme swaps (docs/36). SET NULL if the saved
  // theme is later deleted (the publish then just uses the current draft theme).
  themeId String? @map("theme_id") @db.Uuid

  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  resultVersionId String?   @map("result_version_id") @db.Uuid
  error           String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  theme    SiteTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  // Explicit name — the default (table + all three columns + _idx) exceeds
  // Postgres's 63-char identifier limit and would truncate (drift risk; cf.
  // builder_page_assignments_property_record_item_key).
  @@index([tenantId, propertyId, scheduledAt(sort: Desc)], map: "sitebuilder_schedules_tenant_property_scheduled_idx")
  @@map("sitebuilder_publish_schedules")
}

// A tenant-saved theme variant (docs/36 Brand+Theme tier). The tenant's own
// NAMED presentation snapshots — distinct from the read-only platform presets
// (THEME_LIST in @sparx/site-themes, which stay code-first). `presentation`
// is the Token-Model-v2 presentation overlay only (brand identity/feel stay
// brand-owned); `basePresetKey` is the preset it layers on. Applied to the draft
// (theme_key + draftSettings presentation) on "Use this theme" or by a scheduled
// publish that points at it. Tenant-scoped, ENABLE+FORCE RLS.
model SiteTheme {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name          String @db.VarChar(120)
  basePresetKey String @map("base_preset_key") @db.VarChar(63)
  presentation  Json   @default("{}") @db.JsonB
  // The theme's captured brand "look": identity colours, fonts, and shape/feel
  // tokens (docs/33). Null on legacy rows saved before themes carried a brand
  // snapshot. Applying the theme writes these onto the tenant brand.
  brand         Json?  @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules SitePublishSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sitebuilder_themes")
}

// Per-target tenant default layout (docs/36 §6, docs/handoffs/sitebuilder-pc-spec.md).
// Which PageLayout renders by default for a layout target when an item has no
// per-item override. Absent → the target's `key='default'` layout, then the code
// default. Tenant-scoped, ENABLE+FORCE RLS.
model SiteLayoutDefault {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  targetId     String @map("target_id") @db.VarChar(63)
  pageLayoutId String @map("page_layout_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pageLayout PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)

  @@unique([tenantId, targetId])
  @@index([tenantId])
  @@map("sitebuilder_layout_defaults")
}

// Per-item layout override (docs/36 §6). Pins one record (a product, collection,
// or content entry — by its STABLE id) to a specific PageLayout, overriding the
// per-target default. `itemRef` is the owning module's record id; SB references
// it without a cross-module FK (the module owns its data). Tenant-scoped, RLS.
model SiteLayoutAssignment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  targetId     String @map("target_id") @db.VarChar(63)
  itemRef      String @map("item_ref") @db.VarChar(255)
  pageLayoutId String @map("page_layout_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pageLayout PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)

  @@unique([tenantId, targetId, itemRef])
  @@index([tenantId, targetId])
  @@map("sitebuilder_layout_assignments")
}

// A tenant-defined custom section TYPE (docs/38 Phase C;
// docs/handoffs/sitebuilder-custom-section-template-spec.md). This is the
// data-defined analogue of a code-first SECTION_REGISTRY entry: `fieldSpec` is
// the editor form spec (a SectionField[] — same shape the dashboard already
// auto-renders) and `template` is the validated render-template AST the
// storefront interpreter walks. Merged into the registry under the `custom:`
// namespace as `custom:<slug>`; both halves are validated by
// @sparx/sitebuilder-schemas (fieldSpecToZod + validateTemplate), never by the
// DB. `binding` mirrors the registry's data binding (null | "product" |
// "collection"); `version` bumps on every edit so publish snapshots can pin
// `custom:<slug>@<version>` for deterministic rollback. Tenant-scoped,
// ENABLE+FORCE RLS — a callsite that forgets withTenant() sees no definitions.
model TenantSectionDefinition {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  slug        String  @db.VarChar(63)
  label       String  @db.VarChar(120)
  description String? @db.VarChar(500)
  icon        String? @db.VarChar(63)
  // null (static) | "product" | "collection" — gates the binding scope the
  // template may read (validateTemplate enforces it).
  binding     String? @db.VarChar(31)

  fieldSpec Json   @default("[]") @map("field_spec") @db.JsonB
  template  Json   @db.JsonB
  version   Int    @default(1)
  // active | archived (archived defs stop appearing in the editor library but
  // still resolve for already-published pages via the pinned snapshot).
  status    String @default("active") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("sitebuilder_section_definitions")
}

// Email Platform — management featureset (docs/13-email-platform-prd.md).
//
// The send PIPELINE already exists (email.send Pub/Sub → email-worker →
// @sparx/email render → Mailgun). These tables are the MANAGEMENT surface the
// PRD §3–§10 describes: settings, sending domains, templates, automations,
// the scheduled-send queue, broadcasts, the append-only event log, and the
// suppression list. @sparx/email stays the render lib; @sparx/email-platform
// owns this domain logic (mirrors the packages/crm split).
//
// All tenant-scoped + ENABLE+FORCE RLS (tenant_isolation on current_tenant_id()).
// Cross-module references that would couple email to CRM being enabled
// (customerId, segmentId) are stored as plain UUIDs (soft references,
// validated at the app layer) — mirrors CrmActivity.linkedEntityId.

// One row per tenant — sender identity, CAN-SPAM footer, branding fallback.
model EmailSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  fromName        String? @map("from_name") @db.VarChar(255)
  fromAddress     String? @map("from_address") @db.VarChar(255)
  replyTo         String? @map("reply_to") @db.VarChar(255)
  // CAN-SPAM / GDPR-required physical postal address rendered in the footer.
  physicalAddress String? @map("physical_address") @db.Text

  // NOTE: brand identity (logo/colors/type) is NOT stored here. It is read from
  // the tenant-level TenantBrand (docs/30 §6) by resolveEmailBrand — email may
  // never override the brand. The old `branding_override` column was removed in
  // migration 20260610000100.

  defaultSendingDomainId String? @map("default_sending_domain_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSendingDomain SendingDomain? @relation("DefaultSendingDomain", fields: [defaultSendingDomainId], references: [id], onDelete: SetNull)

  @@map("email_settings")
}

// A Mailgun sending domain. Provisioned via POST /v4/domains; dnsRecords holds
// the verbatim sending_dns_records[] response (the SPF string must be copied
// exactly — see memory/feedback_mailgun_spf_exact_string).
model SendingDomain {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  domain          String  @db.VarChar(255)
  mailgunDomainId String? @map("mailgun_domain_id") @db.VarChar(255)
  region          String  @default("us") @db.VarChar(8) // us | eu
  // pending | verifying | verified | failed | disabled
  state           String  @default("pending") @db.VarChar(20)
  dnsRecords      Json    @default("[]") @map("dns_records")
  dkimSelector    String? @map("dkim_selector") @db.VarChar(63)
  isDefault       Boolean @default(false) @map("is_default")

  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForSettings EmailSettings[] @relation("DefaultSendingDomain")

  @@unique([tenantId, domain])
  @@index([tenantId, state])
  @@map("email_sending_domains")
}

// A template record. `source` discriminates the render path:
//   builtin   → renders via a code-defined @sparx/email React component keyed
//               by `key`; `body` holds only the tenant's slot + branding
//               overrides (intro/outro rich text), never structure.
//   authored  → tenant-authored marketing body; `body` is a CMS TipTap doc
//               now (serialized to email-safe HTML), a reorderable section
//               list once the shared SECTION_REGISTRY ships (plan P9).
model EmailTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  source String  @default("authored") @db.VarChar(20) // builtin | authored
  key    String? @db.VarChar(63) // builtin id (e.g. order-confirmed); null when authored
  kind   String  @default("marketing") @db.VarChar(20) // transactional | marketing

  name      String  @db.VarChar(160)
  subject   String? @db.VarChar(255)
  preheader String? @db.VarChar(255)
  body      Json    @default("{}")
  // draft | active | archived
  status    String  @default("draft") @db.VarChar(20)
  version   Int     @default(1)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcasts     Broadcast[]
  scheduledSends ScheduledSend[]

  @@unique([tenantId, key])
  @@index([tenantId, kind, status])
  @@map("email_templates")
}

// The dispatch queue — drives delayed automation sends and scheduled/batched
// broadcast sends. The in-process due-scan tick (services/api-rest) finds rows
// via find_due_scheduled_sends() and publishes email.send when dueAt passes.
// dedupeKey enforces frequency caps + idempotency.
model ScheduledSend {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) whose brand this send renders (docs/49 Phase 7) —
  // copied from the broadcast, or resolved from the source event for an
  // automation send. NULL = the tenant's primary brand. SetNull: a send outlives
  // its site.
  propertyId String? @map("property_id") @db.Uuid

  broadcastId String? @map("broadcast_id") @db.Uuid
  templateId  String? @map("template_id") @db.Uuid

  recipient  String  @db.VarChar(255)
  customerId String? @map("customer_id") @db.Uuid // soft reference (no FK)
  payload    Json    @default("{}") // template props / merge variables

  // Builder-email personalization (docs/91 §3). An automation send carries the
  // entity ids it fired on so the dispatch tick re-resolves the live entity into
  // the email's DataSources (`{ customerId, orderId, cartId, quoteId,
  // billingDocumentId, b2bAccountId }`); `entitySnapshot` is the automation's flat,
  // trigger-time resolved field map (`{ "invoice.number": "INV-9", … }`) used as a
  // scalar fallback when a live entity no longer resolves. Both null for a coded
  // template or a pre-rendered broadcast.
  entityRefs     Json? @map("entity_refs")
  entitySnapshot Json? @map("entity_snapshot")

  dueAt     DateTime  @map("due_at") @db.Timestamptz
  // pending | sent | cancelled | failed
  status    String    @default("pending") @db.VarChar(20)
  dedupeKey String?   @map("dedupe_key") @db.VarChar(255)
  attempts  Int       @default(0)
  lastError String?   @map("last_error") @db.Text
  sentAt    DateTime? @map("sent_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broadcast Broadcast?     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  template  EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([status, dueAt])
  @@index([tenantId, status, dueAt])
  @@map("email_scheduled_sends")
}

// A marketing broadcast — segment-targeted, scheduled or immediate. campaignTag
// is the Mailgun o:tag that joins EmailEvent rows back to this broadcast for
// analytics.
model Broadcast {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this broadcast is sent on behalf of (docs/49 Phase 7).
  // NULL = the tenant's primary brand (the default + every pre-rollout row); a
  // non-null value renders that site's brand (Property.brandOverride merged over
  // the tenant brand). NOT a security boundary.
  propertyId String? @map("property_id") @db.Uuid

  name           String  @db.VarChar(160)
  templateId     String? @map("template_id") @db.Uuid
  // A published Builder email used as the body (docs/52). Soft reference (no FK,
  // like segmentId) — the Builder module owns the row. The body source is exactly
  // one of templateId (legacy section list) or builderEmailId (the node tree).
  builderEmailId String? @map("builder_email_id") @db.Uuid
  body           Json    @default("{}") // inline body when not using a template
  subject        String  @db.VarChar(255)
  preheader      String? @db.VarChar(255)

  segmentId String? @map("segment_id") @db.Uuid // soft reference to CRM Segment
  audience  Json    @default("{}") // alternate audience definition

  // draft | scheduled | sending | sent | cancelled | failed
  status          String    @default("draft") @db.VarChar(20)
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  recipientCount  Int       @default(0) @map("recipient_count")
  campaignTag     String?   @map("campaign_tag") @db.VarChar(120)
  sendingDomainId String?   @map("sending_domain_id") @db.Uuid

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  template       EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledSends ScheduledSend[]
  events         EmailEvent[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, campaignTag])
  @@map("email_broadcasts")
}

// Append-only delivery/engagement events from Mailgun webhooks (and our own
// accepted/failed markers). The source of truth for analytics and the feed
// the CRM email-events consumer mirrors into CrmActivity.
model EmailEvent {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) the send was on behalf of (docs/49 Phase 7), copied
  // from the ScheduledSend/broadcast so analytics can break engagement down per
  // site. NULL = tenant-wide / primary. SetNull: events outlive their site.
  propertyId String? @map("property_id") @db.Uuid

  messageId     String?  @map("message_id") @db.VarChar(255)
  recipient     String   @db.VarChar(255)
  customerId    String?  @map("customer_id") @db.Uuid // soft reference
  broadcastId   String?  @map("broadcast_id") @db.Uuid
  automationKey String?  @map("automation_key") @db.VarChar(63)
  // accepted | delivered | opened | clicked | bounced | complained | unsubscribed | failed
  type          String   @db.VarChar(20)
  reason        String?  @db.Text
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  raw           Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([tenantId, broadcastId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, type])
  @@index([tenantId, messageId])
  @@map("email_events")
}

// The suppression list — mirrors Mailgun suppressions + manual entries.
// Complements Customer.doNotContact (set by the CRM consumer on unsubscribe).
model EmailSuppression {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  email      String  @db.VarChar(255)
  // transactional | marketing | all
  scope      String  @default("all") @db.VarChar(20)
  // bounce | complaint | unsubscribe | manual
  reason     String  @db.VarChar(20)
  source     String? @db.VarChar(63) // mailgun | manual | import
  customerId String? @map("customer_id") @db.Uuid // soft reference
  note       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email, scope])
  @@index([tenantId, email])
  @@map("email_suppressions")
}

// Builder — composition-model page editor persistence (docs/41-builder-page-model.md).
//
// One row per page a tenant has. A page TEMPLATE and a page INSTANCE are the
// same row: Sparx ships a curated starter set (seeded on the tenant's first
// list, at runtime by the service), the tenant edits them and creates more.
// The node-tree JSON is validated by @sparx/builder-schemas, never by the DB.
//
// Distinct from the legacy `sitebuilder_*` tables — Builder is the successor
// surface (docs/40), deliberately kept on its own clean storage so the eventual
// Site Builder retirement is a deletion rather than a surgical extraction.
//
// Tenant-scoped + FORCE RLS so a callsite that forgets withTenant() returns
// nothing rather than leaking cross-tenant pages.

model BuilderPage {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this page belongs to (docs/49). Pages are per-property:
  // each of a tenant's sites has its own page tree. NOT a security boundary —
  // tenant_id (the RLS GUC) is; property_id is application-tier scoping.
  propertyId String @map("property_id") @db.Uuid

  name       String  @db.VarChar(255)
  // singleton | collection (docs/40 page types)
  kind       String  @default("singleton") @db.VarChar(20)
  // collection only — the content type each record fills (e.g. "cms.post").
  recordType String? @map("record_type") @db.VarChar(63)
  // The URL a published SINGLETON page serves at on the storefront (docs/44).
  // Null for collection templates (they render per-record) and unrouted pages.
  // Unique per tenant; Postgres treats NULLs as distinct, so many stay null.
  slug       String? @db.VarChar(160)

  // The editable BuilderNode root. Shape validated by @sparx/builder-schemas.
  draftTree     Json      @map("draft_tree")
  // Last published snapshot; null until first publish. No storefront consumer
  // yet (docs/41 §1) — publishing just snapshots draft → published.
  publishedTree Json?     @map("published_tree")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  // Catalog ordering.
  position      Int       @default(0)

  // The DEFAULT template for `recordType` — the per-type winner the storefront
  // renders when a record has no per-record override (docs/51 §6). At most one
  // per (tenant, recordType): a partial unique index hand-added in the migration
  // (Prisma can't express the predicate — cf. BuilderLayout.isActive). Only
  // meaningful on a `kind='collection'` page that has a recordType.
  isDefault Boolean @default(false) @map("is_default")

  // SEO — applies to published SINGLETON pages (docs/50). The storefront's
  // catch-all titles/describes the page from these; null falls back to the page
  // `name`. Collection templates render per-record and inherit SEO from the
  // bound record (product/entry), so these stay null there.
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(500)
  canonical      String? @db.VarChar(2048)
  // A full image URL (the Builder is URL-first for images, cf. box.backgroundImage)
  // — the storefront passes it straight to openGraph.images.
  ogImage        String? @map("og_image") @db.VarChar(2048)
  noindex        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignments BuilderPageAssignment[]

  // Slug is unique per (tenant, property) — two sibling sites can each have an
  // `/about`. The per-(tenant, property, recordType) default-template partial
  // unique lives in the migration (Prisma can't express the predicate).
  @@unique([tenantId, propertyId, slug])
  @@index([tenantId, propertyId, position])
  @@map("builder_pages")
}

// Per-record template OVERRIDE (docs/51 §6) — pins ONE record (a content entry,
// a product, …) to a specific collection template, beating that record type's
// default. The builder-owned analogue of the legacy sections tier's
// SiteLayoutAssignment: `itemRef` is the owning module's record id, referenced
// WITHOUT a cross-module FK (the module owns its data). `recordType` is the same
// source key the template targets (`cms.blog_post`, `commerce.product`).
//
// Resolution order (page-service): override → type default (BuilderPage.isDefault)
// → lowest-position published fallback. Additive + no backfill — a record with no
// row resolves to the type default, preserving prior behaviour.
//
// Tenant-scoped + ENABLE/FORCE RLS (hand-added in the migration), like every
// other builder_* table.
model BuilderPageAssignment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  // Per-property (docs/49): a record can map to different templates on different
  // sites. The owning BuilderPage is itself per-property, so this rides along.
  propertyId    String @map("property_id") @db.Uuid
  recordType    String @map("record_type") @db.VarChar(63)
  itemRef       String @map("item_ref") @db.VarChar(255)
  builderPageId String @map("builder_page_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  builderPage BuilderPage @relation(fields: [builderPageId], references: [id], onDelete: Cascade)

  // Explicit name — the default (tenant_id+property_id+record_type+item_ref) would
  // exceed Postgres's 63-char identifier limit and truncate (drift risk).
  @@unique([tenantId, propertyId, recordType, itemRef], map: "builder_page_assignments_property_record_item_key")
  @@index([tenantId, propertyId, recordType])
  @@index([builderPageId])
  @@map("builder_page_assignments")
}

// The site LAYOUT — the chrome shell (header / outlet / footer) every page
// renders inside (docs/45). Same draft/publish lifecycle as BuilderPage. A tenant
// now keeps MANY layouts (a catalog, like BuilderPage), but exactly one is the
// ACTIVE one — the live chrome the storefront serves. Publishing a layout just
// snapshots its draft → published (a layout can be published-but-idle); a
// separate "make active" flips which published layout is live. The tree carries
// the special `Outlet` node marking where the routed page goes; chrome binds to
// the `site` sources (nav / identity / social), which reference existing platform
// data — the Builder stores no parallel nav or brand.
//
// Tenant-scoped + FORCE RLS, like BuilderPage.
model BuilderLayout {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this chrome belongs to (docs/49). Each site keeps its
  // own layout catalog with its own ACTIVE layout. Per-property, not a security
  // boundary (tenant_id is the RLS boundary).
  propertyId String @map("property_id") @db.Uuid

  name String @db.VarChar(255)

  // The editable BuilderNode root. Shape validated by @sparx/builder-schemas.
  draftTree     Json      @map("draft_tree")
  // Last published snapshot; null until first publish. The storefront renders
  // the ACTIVE published layout as the chrome around every page (docs/45 §2.6).
  publishedTree Json?     @map("published_tree")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  // The live layout — exactly one per PROPERTY. "At most one active" is enforced
  // in the DB by a partial unique index on (tenant_id, property_id) WHERE is_active
  // (hand-added in the migration; Prisma can't express the predicate). Activation
  // requires a prior publish (the storefront reads the active layout's published tree).
  isActive      Boolean   @default(false) @map("is_active")
  // Catalog ordering (cf. BuilderPage.position).
  position      Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId, position])
  @@map("builder_layouts")
}

// The Builder EMAIL — the Email Builder's persisted unit (docs/52). One row per
// email a tenant has, with the SAME draft/publish lifecycle as BuilderPage. An
// email is ONE self-contained body tree: no site/page split, no Outlet, no
// layout tier. Two document-level fields the page model lacks — `subject` (the
// email subject line) and `preheader` (inbox preview text); no slug, kind,
// recordType, or SEO. The branded frame (wordmark header + legal footer) is fixed
// chrome the email renderer supplies, so the tree is just the body.
//
// Supersedes the legacy section-list bodies (EmailTemplate.body / Broadcast.body
// on @sparx/email-sections — docs/31), which are migrated off + retired (docs/52
// §8). Tenant-scoped + FORCE RLS, like BuilderPage.
model BuilderEmail {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The site this email belongs to (docs/49 Phase 7b / docs/91 §6). NULL =
  // tenant-wide: the 13 provisioned defaults and any tenant-level custom email. A
  // non-null row is a per-SITE override (or per-site custom email). The override
  // join is (tenant, property, key) → (tenant, key): a site fork wins, else the
  // tenant-wide default. SetNull on delete so a removed site's overrides fall back
  // to the tenant-wide row instead of vanishing mid-flight. NOT a security
  // boundary (tenant_id is); property scoping is application-tier (docs/49 §2).
  propertyId String? @map("property_id") @db.Uuid

  // Built-in identity (docs/91). One of the provisioned default keys
  // (welcome-customer, abandoned-cart, …) for a default or its per-site override;
  // NULL for a tenant-authored custom email. Two PARTIAL UNIQUE indexes (hand-SQL
  // in the migration, Prisma can't express the predicate) enforce one tenant-wide
  // default per key and one per-site override per key; custom emails (key NULL)
  // are unconstrained.
  key String? @db.VarChar(63)

  name      String  @db.VarChar(255)
  // The email subject line. Stored '' when blank (not null) — always present.
  subject   String  @default("") @db.VarChar(255)
  // Inbox preview text shown after the subject; null when unset.
  preheader String? @db.VarChar(255)

  // The editable BuilderNode root (the email body). Validated by @sparx/builder-schemas.
  draftTree     Json      @map("draft_tree")
  // Last published snapshot; null until first publish. A broadcast/template that
  // references this email renders its published tree (docs/52 §6).
  publishedTree Json?     @map("published_tree")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  // Catalog ordering (cf. BuilderPage.position).
  position      Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId, position])
  // The override-resolution reads — (tenant, key, property=null) and
  // (tenant, key, property=X) — are served by the two PARTIAL UNIQUE indexes
  // hand-added in the migration (Prisma can't express their WHERE predicate).
  @@map("builder_emails")
}

// A TENANT-AUTHORED component (docs/53) — the user's own reusable building block,
// composed in the builder rather than shipped in code. Distinct from SYSTEM
// components (the in-code registry, which carry a renderLeaf function): a tenant
// component is purely DECLARATIVE — a saved node tree + a prop schema — so it can
// be stored, validated, and rendered by EXPANSION through the same trusted
// renderers, never as user code (no RCE on the multi-tenant SSR surface).
//
// Identity lives here; the editable content lives in versioned snapshots
// (BuilderComponentVersion) so a placement can PIN a version and opt into
// upgrades. `latestVersion` points at the newest version row.
//
// Tenant-scoped + ENABLE/FORCE RLS (hand-added in the migration), like every
// other builder_* table.
model BuilderComponent {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Stable key, unique per tenant (^[a-z][a-z0-9_]*$); the placement type is
  // `custom:<key>`, so key ≤ 56 keeps the namespaced type ≤ VarChar(63).
  key           String  @db.VarChar(56)
  name          String  @db.VarChar(120)
  // Palette group: layout | content | data (mirrors the registry PaletteGroup).
  group         String  @default("content") @db.VarChar(20)
  // Lucide icon name shown in the catalog + palette.
  icon          String  @default("box") @db.VarChar(64)
  description   String? @db.VarChar(500)
  // Editor surfaces this component appears in (e.g. ["page","site"]).
  surfaces      Json    @default("[\"page\"]")
  // Points at the newest BuilderComponentVersion.version. Bumped on every edit.
  latestVersion Int     @default(1) @map("latest_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions BuilderComponentVersion[]

  @@unique([tenantId, key])
  @@index([tenantId, group])
  @@map("builder_components")
}

// One immutable version snapshot of a BuilderComponent (docs/53 §6). Editing a
// component creates a NEW version and bumps the parent's latestVersion; old
// versions persist so pages pinned to them keep rendering. The `tree` is a
// BuilderNode (validated by @sparx/builder-schemas, never the DB); `propSpec` is
// the instance-fillable slot schema (docs/53 §5).
//
// Tenant-scoped + ENABLE/FORCE RLS (hand-added in the migration).
model BuilderComponentVersion {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid
  version     Int

  // The editable BuilderNode root for this version. Shape validated by @sparx/builder-schemas.
  tree     Json
  // PropSpec[] — the instance-fillable slots (docs/53 §5). [] = a fixed component.
  propSpec Json @default("[]") @map("prop_spec")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  component BuilderComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, version])
  @@index([tenantId, componentId])
  @@map("builder_component_versions")
}

// Legal/policy document placements — where a tenant's legal pages surface on
// its storefront (footer, checkout, terms gate). docs/42 §5.
//
// Polymorphic `source_kind`: today every placement points at a CMS content
// entry (`cms_entry`); the marketplace integration-published-docs bridge
// (ProviderMetadata.publishedDocs[], docs/09) adds `integration_doc` rows
// later WITHOUT a schema change. Resolution drops placements whose entry is
// unpublished/deleted, exactly like dead nav-item resolution.
//
// RLS: ENABLE + FORCE + tenant_isolation (tenant-scoped storefront data).

model StorefrontDocPlacement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  // The web PROPERTY (site) this placement is scoped to (docs/49 Phase 6c). NULL =
  // tenant-wide — shows on EVERY site (the default + every pre-rollout row). A
  // non-null value scopes the placement to that one site, so a multi-brand tenant
  // can give each site its own footer legal links. The public read resolves the
  // active site and returns (NULL ∪ that site). NOT a security boundary.
  propertyId   String?  @map("property_id") @db.Uuid
  placement    String   @db.VarChar(40) // footer | checkout | terms_gate
  sourceKind   String   @map("source_kind") @db.VarChar(30) // cms_entry | integration_doc
  entryId      String?  @map("entry_id") @db.Uuid
  legalKind    String?  @map("legal_kind") @db.VarChar(40)
  providerSlug String?  @map("provider_slug") @db.VarChar(63)
  label        String?  @db.VarChar(120)
  columnKey    String?  @map("column_key") @db.VarChar(40)
  position     Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entry    ContentEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Per-site uniqueness (docs/49 Phase 6c): the same entry can be placed on
  // different sites (and tenant-wide). Explicit map name — the default
  // (table + 5 columns + _key) blows past Postgres's 63-char identifier limit.
  @@unique([tenantId, propertyId, placement, sourceKind, entryId], map: "storefront_doc_placements_prop_placement_source_entry_key")
  @@index([tenantId, placement, enabled, position])
  @@map("storefront_doc_placements")
}

// SEO — stored audit scorecard snapshots (docs/50 §7).
//
// One row per audited entity per tenant: the last computed score + grade + the
// full scorecard JSON. The live endpoint (`GET /v1/seo/audit`) recomputes on
// demand and upserts here; a reindex recomputes the whole site. The site-wide
// SEO overview reads these snapshots so it can rank every page without firing N
// live audits.
//
// Tenant-scoped + FORCE RLS, like the rest of the tenant tables — a callsite that
// forgets withTenant() sees nothing rather than leaking cross-tenant scores. The
// ENABLE+FORCE RLS and the tenant_isolation policy are hand-added in the migration
// SQL (Prisma doesn't generate RLS).

model SeoAudit {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // builder_page | cms_page | product | collection (matches @sparx/seo-audit EntityType).
  entityType String @map("entity_type") @db.VarChar(20)
  entityId   String @map("entity_id") @db.Uuid

  // Denormalized for cheap sorting/filtering + rendering in the overview without
  // re-fetching each entity: the score, grade, top fix, the display title, and a
  // best-effort storefront path.
  score    Int
  grade    String  @db.VarChar(20)
  fixFirst String? @map("fix_first") @db.VarChar(500)
  title    String? @db.VarChar(300)
  path     String? @db.VarChar(2048)
  // The full Scorecard JSON — lets the overview render the report without a live
  // recompute. Shape owned by @sparx/seo-audit; never validated by the DB.
  card     Json

  computedAt DateTime @map("computed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, score])
  @@index([tenantId, entityType])
  @@map("seo_audits")
}

// Cookie consent — per-tenant config + append-only consent log. docs/42 §4.
//
// Config lives in its own 1:1-per-tenant table (NOT Tenant.settings, NOT the
// Commerce-owned StorefrontSettings) because consent applies to content-only
// tenants too and must never sit behind the Commerce module gate. The
// `bannerEnabled` flag is DERIVED in code (mode != off AND a non-essential
// category is active) — not stored.
//
// RLS: ENABLE + FORCE + tenant_isolation on both tables — every read/write
// runs inside withTenant() (the storefront always knows the tenant up front).

model ConsentSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  mode             String   @default("off") @db.VarChar(10) // off | gdpr | ccpa
  activeCategories Json     @default("[]") @map("active_categories") // e.g. ["analytics","marketing"]
  bannerTitle      String?  @map("banner_title") @db.VarChar(255)
  bannerBody       String?  @map("banner_body") @db.Text
  policyPageSlug   String   @default("cookie-policy") @map("policy_page_slug") @db.VarChar(255)
  policyVersion    String   @default("1") @map("policy_version") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("consent_settings")
}

// Append-only (like audit_logs). The latest row per visitor_id is the current
// consent state; the history is the legal proof of when consent was given or
// changed. visitor_id is the UUID held in the strictly-necessary sparx_consent
// cookie; customer_id is set only when the visitor is signed in.

model ConsentRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  visitorId     String   @map("visitor_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  mode          String   @db.VarChar(10) // gdpr | ccpa (snapshot at decision time)
  categories    Json // { strictly_necessary, preferences, analytics, marketing }
  action        String   @db.VarChar(20) // accept_all | reject_all | save_prefs | opt_out
  policyVersion String   @map("policy_version") @db.VarChar(20)
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, visitorId, createdAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@map("consent_records")
}

// Sparx's OWN platform legal docs — the acceptance record. docs/42 §6.
//
// Tenants (their staff owner) accept Sparx's ToS/Privacy/AUP at sign-up; the
// DPA later for EU tenants. The docs themselves are versioned pages on the
// marketing site (apps/web); this table records WHO accepted WHICH version,
// WHEN, and from WHERE.
//
// RLS: ENABLE only, NO FORCE — matches the staff auth tables (users/sessions/
// accounts). This is read by the owner connection during sign-up / dashboard
// boot, BEFORE any tenant context is set on the sparx_app connection, so a
// FORCE policy keyed on current_tenant_id() would hide every row. Queries pin
// tenant_id / user_id explicitly (the same belt-and-suspenders the tenant
// routes use against the RLS-exempt tenants table).

model PlatformLegalAcceptance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  docType    String   @map("doc_type") @db.VarChar(20) // terms | privacy | dpa | aup
  docVersion String   @map("doc_version") @db.VarChar(20)
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, docType, docVersion])
  @@map("platform_legal_acceptance")
}

// Import jobs — background CSV import processing (docs/68 §8).
//
// Created by the REST API when a tenant submits a CSV file for bulk import.
// The import-worker Cloud Run service receives the `import.job.created`
// Pub/Sub event, processes rows from rawRows, and writes per-row results
// back to import_job_rows.
//
// Jobs are retained 30 days then purged by a scheduled task.
//
// RLS: ENABLE + FORCE on both tables (see migration 20260713000000_import_jobs).

model ImportJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  entityType    String    @map("entity_type") @db.VarChar(50)
  status        String    @default("pending") @db.VarChar(20)
  fileName      String?   @map("file_name") @db.VarChar(255)
  rowCount      Int       @default(0) @map("row_count")
  importedCount Int       @default(0) @map("imported_count")
  updatedCount  Int       @default(0) @map("updated_count")
  errorCount    Int       @default(0) @map("error_count")
  options       Json      @default("{}")
  rawRows       Json      @default("[]") @map("raw_rows")
  actorId       String?   @map("actor_id") @db.Uuid
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   ImportJobRow[]

  @@index([tenantId], map: "import_jobs_tenant_idx")
  @@index([tenantId, status], map: "import_jobs_tenant_status_idx")
  @@map("import_jobs")
}

model ImportJobRow {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  rowIndex   Int      @map("row_index")
  status     String   @db.VarChar(20)
  naturalKey String?  @map("natural_key") @db.VarChar(255)
  errorMsg   String?  @map("error_msg") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "import_job_rows_job_idx")
  @@index([tenantId], map: "import_job_rows_tenant_idx")
  @@map("import_job_rows")
}

// Tenant blueprint installs (docs/54 §9) — one row per marketplace template a
// tenant installs into one of its web properties. The record is the idempotency
// key (one install per blueprint per property), the audit trail, the id map for
// the "Review & go live" surface, and the status (draft `installed` → `live`).
//
// Tenant-scoped, ENABLE + FORCE RLS on tenant_id (policy in the migration),
// mirroring `properties`. `property_id` is application-tier scoping (which site
// the blueprint was installed into), NOT a security boundary — no FK, no policy
// of its own (docs/49 §2).

model TenantBlueprintInstall {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The web property (site) the blueprint was installed into. App-tier scope.
  propertyId String @map("property_id") @db.Uuid

  // The blueprint key + the version installed (from the @sparx/blueprints catalog).
  blueprintKey     String @map("blueprint_key") @db.VarChar(63)
  blueprintVersion String @map("blueprint_version") @db.VarChar(20)

  // installed — artifacts created as drafts; live — the tenant published/went
  // live; failed — a run errored (partial artifacts may exist).
  status String @default("installed") @db.VarChar(20)

  // The id map (handle/key → created UUID) + per-slice counts + any upsell flags.
  result Json @default("{}")

  // Failure detail when status = failed.
  error String? @db.Text

  installedAt DateTime  @default(now()) @map("installed_at") @db.Timestamptz
  liveAt      DateTime? @map("live_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One install per blueprint per property (re-install is an explicit reset).
  @@unique([tenantId, propertyId, blueprintKey])
  @@index([tenantId])
  @@map("tenant_blueprint_installs")
}

// Live Chat module (docs/56, docs/69 Track A) — first-party customer chat.
//
// Three tables: conversations (one thread per customer/visitor), messages (the
// thread body; sender_type ∈ customer | staff | ai), and quick_replies
// (tenant-authored canned responses). Tenant-scoped with ENABLE + FORCE RLS via
// current_tenant_id() (policies in migration 20260722000000_chat). Messages
// denormalize tenant_id so the isolation policy filters without joining
// conversations (same pattern as order_items / import_job_rows).

model ChatConversation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  assignedToId String? @map("assigned_to") @db.Uuid

  status  String  @default("open") @db.VarChar(20) // open | pending | resolved | spam
  source  String  @default("storefront") @db.VarChar(20) // storefront | sparx_market | dashboard
  subject String? @db.VarChar(255)

  // Captured by the pre-chat form for an anonymous visitor (customer_id null).
  // Promoted onto a Customer row once the CRM resolves/creates the contact.
  visitorName  String? @map("visitor_name") @db.VarChar(255)
  visitorEmail String? @map("visitor_email") @db.VarChar(255)

  // Opaque ownership token for an anonymous storefront visitor — issued when the
  // widget opens a conversation, echoed back via the `x-chat-token` header on
  // every subsequent public call (mirrors carts.guest_token). Never exposed to
  // staff endpoints.
  visitorToken String? @map("visitor_token") @db.VarChar(64)

  // Inbound (customer) messages the staff inbox hasn't read yet — drives the
  // sidebar unread badge without scanning chat_messages on every render.
  unreadStaff Int @default(0) @map("unread_staff")

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("ChatAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages ChatMessage[]

  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedToId])
  @@index([customerId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  senderType String  @map("sender_type") @db.VarChar(10) // customer | staff | ai
  senderId   String? @map("sender_id") @db.Uuid // user id (staff) or customer id; null for anon/ai

  body        String @db.Text
  attachments Json   @default("[]")

  aiGenerated  Boolean @default(false) @map("ai_generated")
  aiConfidence Float?  @map("ai_confidence")

  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("chat_messages")
}

model ChatQuickReply {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  title    String  @db.VarChar(100)
  body     String  @db.Text
  shortcut String? @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("chat_quick_replies")
}

// B2B / Wholesale — pricing tier tables (docs/10, docs/64 Ph1).
//
// These models back the B2B module's pricing engine. The CRM module owns
// `b2b_accounts`; these tables augment it with structured tier definitions,
// per-product overrides, and the `resolve_b2b_price()` SQL function.
//
// Resolution order (highest precedence first):
//   1. B2bAccountProductOverride (product-level override on the account)
//   2. B2bTierProductOverride (product-level override on the account's tier)
//   3. Tier discount applied to variant.priceCents
//   4. Account-level flat discount stacked on top
//   5. variant.priceCents (list price)
//
// The `resolve_b2b_price()` Postgres function encodes this logic so it
// stays consistent across the API, the order placement check, and future
// storefront B2B portal queries.

model B2bPricingTier {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String  @db.VarChar(127)
  description String? @db.Text

  // discount_type: percentage | fixed
  //   percentage: discount_value is a percentage off list (e.g. 20 = 20% off)
  //   fixed:      discount_value is a flat amount off in cents (e.g. 500 = $5 off)
  discountType  String  @map("discount_type") @db.VarChar(20)
  discountValue Decimal @map("discount_value") @db.Decimal(10, 4)

  // product_scope: all | collections | products
  //   The narrower overrides below handle specific products/collections.
  productScope String @default("all") @map("product_scope") @db.VarChar(20)

  // Minimum order value in cents to qualify for this tier's pricing.
  minOrderCents Int @default(0) @map("min_order_cents")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts  B2BAccount[]
  overrides B2bTierProductOverride[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("b2b_pricing_tiers")
}

// Product-level or collection-level price override on a pricing tier.
// Takes precedence over the tier's blanket discount for the matched scope.
model B2bTierProductOverride {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tierId   String @map("tier_id") @db.Uuid

  // Either variantId OR collectionId is set (service enforces XOR).
  variantId    String? @map("variant_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid

  // Either a fixed price in cents OR a percentage off list.
  priceCents         Int?     @map("price_cents")
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier       B2bPricingTier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  variant    ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  collection ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, tierId])
  @@index([tenantId, variantId])
  @@index([tenantId, collectionId])
  @@map("b2b_tier_product_overrides")
}

// Product-level or collection-level price override on a specific B2B account.
// Highest-priority override — overrides both tier discounts and tier overrides.
model B2bAccountProductOverride {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  variantId    String? @map("variant_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid

  priceCents         Int?     @map("price_cents")
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    B2BAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  variant    ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  collection ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
  @@index([tenantId, variantId])
  @@index([tenantId, collectionId])
  @@map("b2b_account_product_overrides")
}

// B2B invoices — net-terms accounts generate an invoice per order instead of
// paying immediately. Credit utilization = sum of unpaid invoices; the
// b2b-overdue-worker checks daily and escalates based on overdue thresholds.
// (docs/10 §9, docs/64 Ph3)

model B2bInvoice {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  // Pointer to the originating Commerce order. NULL for manually-created
  // invoices (e.g. service work billed outside an order flow).
  orderId String? @map("order_id") @db.Uuid

  invoiceNumber String @map("invoice_number") @db.VarChar(63)
  amountCents   Int    @map("amount_cents")

  // Status: unpaid → paid (or unpaid → overdue → paid/written_off)
  status      String @default("unpaid") @db.VarChar(20)
  // overdue_days tracks how many days past due for escalation decisions.
  overdueDays Int    @default(0) @map("overdue_days")

  dueAt        DateTime  @map("due_at") @db.Timestamptz
  paidAt       DateTime? @map("paid_at") @db.Timestamptz
  paidByUserId String?   @map("paid_by_user_id") @db.Uuid
  paidMethod   String?   @map("paid_method") @db.VarChar(63) // check | ach | wire | credit_card | other

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account B2BAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paidBy  User?      @relation("B2bInvoicePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, invoiceNumber], map: "b2b_invoices_tenant_number_unique")
  @@index([tenantId, accountId])
  @@index([tenantId, status, dueAt])
  @@index([orderId])
  @@map("b2b_invoices")
}

// B2B account contacts — maps Customer memberships to B2B accounts with roles.
// (docs/10 §11, docs/64 B2B Ph5)
//
// A B2B account can have multiple customer contacts, each with a role.
// The portal access check: find a B2bAccountContact where customerId = current
// customer AND isActive = true. The `role` gates which portal sections appear.
//
// Role hierarchy (docs/64 §5.2):
//   primary_contact → all portal features + can submit quotes
//   buyer           → can place orders + submit quotes + view invoices
//   approver        → can approve orders (Ph6 purchase approval)
//   viewer          → read-only (invoices, orders, quotes)
//
// Note: `customers.b2b_account_id` remains the "primary account" FK. This
// table is additive — a contact can see their primary account, plus other
// accounts they've been explicitly added to. Most customers will have exactly
// one row here matching their `customers.b2b_account_id`.

model B2bAccountContact {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  // Role: primary_contact | buyer | approver | viewer
  role     String  @default("buyer") @db.VarChar(30)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  B2BAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, customerId], map: "b2b_account_contacts_unique")
  @@index([tenantId, customerId])
  @@index([tenantId, accountId])
  @@map("b2b_account_contacts")
}

// B2B purchase approval rules — per-account or tenant-wide thresholds that
// require manager sign-off before a B2B portal order is placed.
// (docs/10 §12, docs/64 B2B Ph6)
//
// When an order's total exceeds `minAmountCents` (and the account has no
// explicit rule, or the account's rule fires), checkout sets
// `order.status = 'pending_approval'` and publishes `b2b.order.pending_approval`.
//
// Approval decisions are logged as `CrmActivity` rows for the audit trail; the
// order transitions to `placed` (approved) or `cancelled` (rejected).
//
// Rule evaluation order:
//   1. Account-specific rule (account_id IS NOT NULL) — most specific wins.
//   2. Tenant-wide rule (account_id IS NULL) — catch-all.
// If multiple account rules exist for the same account, the most recently
// created active one wins. Only one rule fires per order.

model PurchaseApprovalRule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  // null = tenant-wide catch-all; set = account-specific.
  accountId String? @map("account_id") @db.Uuid

  // Orders with total >= minAmountCents require approval. 0 = all B2B orders.
  minAmountCents Int @default(0) @map("min_amount_cents")

  // Specific approver; null = any staff user with editor role may approve.
  requiredApproverUserId String? @map("required_approver_user_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account          B2BAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requiredApprover User?       @relation("ApprovalRuleApprover", fields: [requiredApproverUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, isActive])
  @@map("purchase_approval_rules")
}

// B2B service scheduling — types + appointments (docs/64 B2B Ph7).
//
// ServiceType defines what kinds of service a tenant offers (oil change,
// inspection, repair, etc.). ServiceAppointment is a booked slot, linked
// to a B2B account and optionally a specific fleet vehicle (vehicleRef JSON
// snapshot). Parts expected for the service are listed in partsLinked.

model ServiceType {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  durationMinutes Int       @default(60) @map("duration_minutes")
  color           String?   @db.VarChar(7) // hex color for calendar (#RRGGBB)
  isActive        Boolean   @default(true) @map("is_active")
  requiresVehicle Boolean   @default(false) @map("requires_vehicle")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments ServiceAppointment[]

  @@index([tenantId, isActive])
  @@map("service_types")
}

model ServiceAppointment {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  serviceTypeId String  @map("service_type_id") @db.Uuid
  b2bAccountId  String? @map("b2b_account_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  scheduledAt     DateTime @map("scheduled_at") @db.Timestamptz
  durationMinutes Int      @default(60) @map("duration_minutes")

  // requested | confirmed | in_progress | completed | cancelled
  status String @default("requested") @db.VarChar(20)

  // JSON snapshot of the vehicle at booking time:
  //   { year, make, model, vin?, licensePlate?, engineProfile? }
  vehicleRef Json? @map("vehicle_ref")

  // Array of parts expected for this appointment:
  //   [{ productId?, sku?, description, quantity }]
  partsLinked Json @default("[]") @map("parts_linked")

  notes      String? @db.Text // customer-visible notes
  staffNotes String? @map("staff_notes") @db.Text

  confirmedByUserId  String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason String?   @map("cancellation_reason") @db.Text
  reminderSentAt     DateTime? @map("reminder_sent_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  b2bAccount  B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  confirmedBy User?       @relation("AppointmentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, b2bAccountId])
  @@map("service_appointments")
}

// Dropship connector framework — suppliers, products, links, orders.
// (docs/14, docs/64 Dropship Ph1)
//
// One DropshipSupplier per configured connection (CSV, DSers, Spocket, etc.).
// DropshipProduct holds the normalized catalog imported from that supplier.
// DropshipProductLink bridges a Sparx Product to a supplier's SKU.
// DropshipOrder tracks the per-supplier fulfillment groups for a Sparx order.

model DropshipSupplier {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  // csv | dsers | spocket | faire | autods | custom
  type        String    @db.VarChar(20)
  // Encrypted credentials bag (API key, secret, etc.) — never log raw.
  credentials Json      @default("{}")
  // connecting | active | error | disconnected
  status      String    @default("connecting") @db.VarChar(20)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz
  // Serialized PricingRule JSON (applied at import time)
  pricingRule Json?     @map("pricing_rule")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       DropshipProduct[]
  dropshipOrders DropshipOrder[]

  @@index([tenantId, status])
  @@map("dropship_suppliers")
}

model DropshipProduct {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  supplierId        String @map("supplier_id") @db.Uuid
  supplierProductId String @map("supplier_product_id") @db.VarChar(255)

  title       String  @db.VarChar(255)
  description String? @db.Text
  // Normalized image URLs: string[]
  images      Json    @default("[]")
  // Normalized variant array: NormalizedProductVariant[]
  variants    Json    @default("[]")

  costPriceCents Int  @map("cost_price_cents")
  msrpCents      Int? @map("msrp_cents")

  // Raw supplier payload retained for debugging / re-parsing.
  raw        Json     @default("{}")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier DropshipSupplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  links    DropshipProductLink[]

  @@unique([tenantId, supplierId, supplierProductId], map: "dropship_products_supplier_product_unique")
  @@index([tenantId, supplierId])
  @@map("dropship_products")
