{
  "name": "@wizeworks/api-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "sparx MCP server — exposes per-module tool registries (today: @wizeworks/crm's crmMcpTools) to Claude / ChatGPT / Copilot via Streamable HTTP. JWT-authenticated for now; API-key issuance lands when the dashboard's AI Integrations settings page does.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/jwt": "^9.0.4",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@prisma/client": "^6.19.3",
    "@wizeworks/api-core": "workspace:*",
    "@wizeworks/auth": "workspace:*",
    "@wizeworks/automation": "workspace:*",
    "@wizeworks/automation-schemas": "workspace:*",
    "@wizeworks/b2b": "workspace:*",
    "@wizeworks/builder": "workspace:*",
    "@wizeworks/cms": "workspace:*",
    "@wizeworks/commerce": "workspace:*",
    "@wizeworks/crm": "workspace:*",
    "@wizeworks/db": "workspace:*",
    "@wizeworks/events": "workspace:*",
    "@wizeworks/godaddy": "workspace:*",
    "@wizeworks/inventory": "workspace:*",
    "@wizeworks/media": "workspace:*",
    "@wizeworks/email-platform": "workspace:*",
    "@wizeworks/registrar": "workspace:*",
    "@wizeworks/scheduling": "workspace:*",
    "@wizeworks/scheduling-schemas": "workspace:*",
    "@wizeworks/search": "workspace:*",
    "@wizeworks/social": "workspace:*",
    "@wizeworks/sitebuilder": "workspace:*",
    "@socket.io/redis-emitter": "^5.1.0",
    "ioredis": "^5.4.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^16.4.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
