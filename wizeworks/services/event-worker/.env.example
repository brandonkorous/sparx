# wizeworks/services/event-worker — local dev defaults.
#
# ── WHY THIS FILE DID NOT EXIST, AND WHAT THAT COST ─────────────────────────
#
# `pnpm dev` runs the dev script of every workspace package, and this service
# has one — so turbo started it on every run. It then read its environment,
# found no DATABASE_URL, printed "invalid environment" and exited 78, inside a
# thirty-pane turbo TUI where nobody was looking. It was the only service in
# wizeworks/services/* with neither a .env nor a .env.example, and the result
# was that the platform's ENTIRE event fleet has never once run locally.
#
# The failure was invisible from the outside, because the OTHER half of the gap
# hid it: with EVENT_BROKER unset, `resolveTransport` picks the `log` transport,
# which logs an event and drops it. api-rest therefore reported a successful
# publish for every event it ever raised in dev, with nothing on the other end
# and nothing to be on the other end of. Publishing a product left the search
# index untouched, so the shop's own listing page stayed empty while the console
# showed a full catalogue — and no error was raised anywhere in that chain.
#
# Copy this to `.env`. `pnpm db:up` brings up the broker it points at.

NODE_ENV=development
LOG_LEVEL=debug

# One HTTP listener: /healthz plus the cron routes.
#
# NOT 8080, which is this service's own default and is already taken by
# cache-revalidation-worker. Two services on one port is the same silent death
# as a missing .env — the loser dies of EADDRINUSE in one pane of a thirty-pane
# TUI, and its fourteen handlers stop consuming while the broker fills up. That
# happened on the very first run of this file. `pnpm check:service-env` now
# refuses two services that declare the same port.
PORT=8086

# The same docker-compose Postgres every other local service uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# ── The broker ───────────────────────────────────────────────────────────────
#
# Named explicitly rather than left to a default, and that is the point: an
# unset EVENT_BROKER means the `log` transport, which acknowledges nothing and
# delivers nothing. Production refuses to boot on it; dev quietly accepted it.
# `nats` is what the cluster runs, so this exercises the real code path.
EVENT_BROKER=nats
EVENT_BROKER_URL=nats://localhost:4222
EVENT_BROKER_STREAM=SPARX_EVENTS

# ── Typesense ────────────────────────────────────────────────────────────────
#
# @wizeworks/commerce-indexer validates these when it is imported, so a missing
# key stops the whole worker rather than one handler. Same values as api-rest's
# .env — both ends of search have to agree on the instance.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key

# Create missing Typesense collections at boot. OFF in production (a
# misconfigured deploy must not recreate an indexed collection); ON locally,
# where the alternative is a first run that indexes into nothing.
ENSURE_SCHEMAS_ON_BOOT=true

# Product image URLs stamped into the search projection. Points at api-rest's
# local media route, matching MEDIA_PUBLIC_URL there.
SPARX_MEDIA_CDN_URL=http://localhost:3100

# ── The cron endpoints ───────────────────────────────────────────────────────
#
# `/internal/cron/tick` (automations, every minute in prod) and
# `/internal/cron/reconcile-seeds` (daily) both refuse without this, so locally
# they answered 403 and nothing could drive them by hand. The reconcile pass is
# the platform's self-heal for a tenant that missed its `module.activated`
# event — which, before there was a broker in dev, was EVERY tenant created on a
# laptop. That is why a locally-signed-up business had none of the ~46 system
# automations its modules are supposed to install, and therefore no
# order-confirmation email.
#
# Dev-only value, and long enough to satisfy the schema's min(16).
SPARX_INTERNAL_CRON_TOKEN=dev-only-internal-cron-token-change-me
