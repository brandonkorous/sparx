# Site MCP server (docs/113). Copy to .env for local dev.
NODE_ENV=development
# 3300 locally to avoid colliding with api-graphql (which owns 3200) under
# `pnpm dev`. In prod each service is its own pod, so k8s pins PORT=3200 there.
PORT=3300
LOG_LEVEL=debug
# The public site REST API this server adapts. Local api-rest listens on
# 3100; in-cluster it's http://api-rest.sparx-prod.svc.cluster.local:3000.
SPARX_API_REST_URL="http://localhost:3100"
# This server's own public origin (used only to build discovery URLs).
SITE_MCP_PUBLIC_ORIGIN="http://localhost:3300"
