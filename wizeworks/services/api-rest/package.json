  "version": "0.0.0",
  "private": true,
  "description": "sparx public REST API — Fastify service hosting /v1/* endpoints. Authoritative for content, media, navigation, redirects, webhooks, and the headless surface consumed by storefronts, the dashboard, MCP, and external SDKs (docs/06-api-specification.md).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "marketplace:self-register": "node --import tsx src/scripts/marketplace-self-register.ts",
    "blueprint:capture": "node --import tsx src/scripts/blueprint-capture.ts",
    "seed:demo": "node --import tsx src/scripts/seed-demo.ts",
    "backfill:webhook-secrets": "node --import tsx src/scripts/backfill-webhook-secrets.ts",
