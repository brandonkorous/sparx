# wizeworks/services/import-worker local dev defaults. Real values for sparx-prod come
# from Google Secret Manager (DATABASE_URL ← `database-url` secret), mounted by
# the cloud-run-worker Terraform module. Copy this file to `.env` to run locally.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev, so it idles on its
# listen port. DATABASE_URL is REQUIRED — a missing URL throws at boot.

NODE_ENV=development
LOG_LEVEL=debug
# Distinct local port — workers default to 8080, which is taken; 8081-8086 are
# also claimed by other workers, so import-worker takes 8087 to avoid EADDRINUSE
# under `turbo dev`.
PORT=8087

# Same docker-compose Postgres the rest of the stack uses (Cloud SQL Auth Proxy
# in prod).
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Optional: SA email validated from the Pub/Sub OIDC token's `email` claim.
# Unset in dev (no OIDC verification). In prod: set to the Pub/Sub invoker SA.
# PUBSUB_INVOKER_SA=

# ── The event broker ────────────────────────────────────────────────────────
#
# Was absent, which meant `resolveTransport` fell through to the `log`
# transport: every publishEvent() wrote a line and DROPPED the event. Nothing
# errored, because dropping is what that transport is for — so a publish in dev
# reported success with no queue, no consumer and no delivery behind it. The
# search index was never told about a new product, no confirmation email was
# ever rendered, and the console showed a full catalogue over a shop page with
# nothing on it.
#
# `nats` is the transport production runs (k8s/self-hosted/nats.yaml). The
# broker comes up with `pnpm db:up`; the consumers live in
# wizeworks/services/event-worker, which now has a .env of its own.
EVENT_BROKER=nats
EVENT_BROKER_URL=nats://localhost:4222
EVENT_BROKER_STREAM=SPARX_EVENTS
