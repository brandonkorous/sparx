# wizeworks/services/api-graphql local dev defaults — copy to `.env`.
#
# Prod values come from the sparx-app-env ConfigMap + sparx-app-secrets Secret.
# The secret below is a DEV placeholder and is safe to commit precisely because
# it is not a secret anywhere: it is shared with api-rest so an internal call
# between the two verifies locally.

NODE_ENV=development
PORT=3200
LOG_LEVEL=debug
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"
SPARX_INTERNAL_JWT_SECRET="dev-only-internal-jwt-secret-change-me-32chars"

# ── The event broker ────────────────────────────────────────────────────────
#
# Was absent, which meant `resolveTransport` fell through to the `log`
# transport: every publishEvent() wrote a line and DROPPED the event. Nothing
# errored, because dropping is what that transport is for — so a publish in dev
# reported success with no queue, no consumer and no delivery behind it. The
# search index was never told about a new product, no confirmation email was
# ever rendered, and the console showed a full catalogue over a shop page with
# nothing on it.
#
# `nats` is the transport production runs (k8s/self-hosted/nats.yaml). The
# broker comes up with `pnpm db:up`; the consumers live in
# wizeworks/services/event-worker, which now has a .env of its own.
EVENT_BROKER=nats
EVENT_BROKER_URL=nats://localhost:4222
EVENT_BROKER_STREAM=SPARX_EVENTS
