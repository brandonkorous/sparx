// Automation module (docs/81, docs/84) — the cross-module rule engine. ONE
// engine, three tiers (Locked / Managed / Custom) keyed by `origin` + `locked`.
// Every tenant-facing "when X, if Y, do Z" runs here; inline invariants
// (suppression, tax, RLS) stay inline by shape (docs/81 §3.1).
//
// All three tables are tenant-scoped → ENABLE + FORCE RLS + tenant_isolation in
// the migration (run_steps carries its own tenant_id; a join can't satisfy FORCE
// RLS). The rule document shape lives in @wizeworks/automation-schemas.

model Automation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // WHICH BUSINESS this rule belongs to (docs/131 §3.1). Null = tenant-wide,
  // which is a real and useful state — but it is NOT the safe default for
  // authoring, because a tenant running two unrelated businesses (a machine shop
  // and a donut shop) will have rules that must never cross. Before this column
  // existed, an `order.placed` rule written for one fired on every order the
  // OTHER took, with that business's templates and products in its actions.
  //
  // THE ENGINE MUST FILTER ON THIS. The column alone changes nothing — see
  // wizeworks/packages/automation dispatch.
  //
  // CASCADE, not SetNull: deleting a site must NARROW a rule's reach, never
  // widen it. SetNull would silently promote a site rule to tenant-wide, which
  // is precisely the bug this removes.
  propertyId String? @map("property_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.Text
  status      String  @default("draft") @db.VarChar(20) // draft | active | paused | error

  // Trigger flattened to type + JSON config (@wizeworks/automation-schemas triggerToColumns).
  triggerType   String @map("trigger_type") @db.VarChar(100)
  triggerConfig Json   @default("{}") @map("trigger_config")

  // ConditionGroup ({ logic, conditions[] }) + the ordered action list. These
  // columns ARE the currently-PUBLISHED (live) rule document — the engine, the
  // ticks, and the SECURITY DEFINER scans all read them as-is. Versioning is
  // purely additive: edits stage in `draft` and only land here on publish.
  conditions Json @default("{}")
  actions    Json @default("[]")

  // WHAT THIS RULE IS FOR (docs/144 §9) — a ConditionGroup describing the
  // outcome the automation is trying to cause. Null = no goal declared.
  //
  // A goal changes what a run MEANS. Without one, an automation's history is a
  // list of things that happened ("sent 400 emails"); with one it answers the
  // only question the owner actually has — did it work. A run whose goal is met
  // exits early (there is nothing left to nudge someone toward) and is counted
  // as converted rather than merely completed.
  //
  // Evaluated against the same resolved fields conditions use, re-resolved at
  // each step boundary so it reflects state the run's own actions changed.
  goal Json?

  // Versioning (docs/84 Slice G-versioning) — Builder-style draft → publish +
  // immutable history. `version` is the live published version number (1 on
  // create = first publish); `draft` holds the staged, unpublished edit document
  // (null = no pending draft) in the same column-form as the live columns, so
  // publish is a straight copy. Snapshots live in `automation_versions`.
  version     Int       @default(1)
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  publishedBy String?   @map("published_by") @db.Uuid
  draft       Json?

  // AI authoring provenance (docs/81 §4).
  aiGenerated Boolean @default(false) @map("ai_generated")
  aiPrompt    String? @map("ai_prompt") @db.Text

  // Tier model (docs/81 §3.1): origin user|system + locked (non-disable-able);
  // cloned_from records "Duplicate to edit" lineage. System-managed, not tenant-set.
  origin     String  @default("user") @db.VarChar(10) // user | system
  locked     Boolean @default(false)
  clonedFrom String? @map("cloned_from") @db.Uuid

  // Loop-guard ceiling for rule -> event -> rule cascades (docs/81 §7).
  maxDepth Int @default(3) @map("max_depth") @db.SmallInt

  runCount    Int       @default(0) @map("run_count")
  errorCount  Int       @default(0) @map("error_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clonedFromAuto Automation?         @relation("AutomationClone", fields: [clonedFrom], references: [id], onDelete: SetNull)
  clones         Automation[]        @relation("AutomationClone")
  runs           AutomationRun[]
  versions       AutomationVersion[]
  // Campaigns this rule drives (docs/151). SetNull on the funnel side — the
  // evidence that a campaign converted outlives the rule that drove it.
  funnels        Funnel[]

  // propertyId TRAILS the dispatch predicate's three leading columns: the engine
  // selects on (tenant, status, triggerType) then narrows with
  // `property_id IS NULL OR property_id = ?`, so it belongs last rather than
  // first. Replaces the former (tenantId, status, triggerType) index, whose
  // leading columns this shares.
  @@index([tenantId, status, triggerType, propertyId])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("automations")
}

// Immutable published-version history (docs/84 Slice G-versioning). One row per
// publish — a frozen snapshot of the authoring document at that version. The
// History panel lists these; "Restore" copies a chosen snapshot back into the
// automation's `draft` (the tenant then reviews + publishes, which appends a NEW
// version). Append-only: rows are never updated or deleted (except by the
// automation's cascade). Tenant-scoped → its own tenant_id + FORCE RLS.
model AutomationVersion {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  version       Int
  name          String  @db.VarChar(255)
  description   String? @db.Text
  triggerType   String  @map("trigger_type") @db.VarChar(100)
  triggerConfig Json    @map("trigger_config")
  conditions    Json
  actions       Json
  goal          Json?
  maxDepth      Int     @map("max_depth") @db.SmallInt
  // Optional one-line publish note ("what changed").
  note          String? @db.Text

  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  publishedBy String?  @map("published_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, version], map: "automation_versions_automation_version_unique")
  @@index([tenantId])
  @@map("automation_versions")
}

model AutomationRun {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  // Which business this run acted on, stamped at creation from the automation.
  // Denormalized rather than joined so "what ran on this site" survives the
  // automation later being re-scoped — a run is a record of what DID happen.
  // SetNull (not Cascade, unlike the automation): deleting a site should not
  // erase the evidence that something ran, and a completed run cannot widen.
  propertyId String? @map("property_id") @db.Uuid

  triggerEvent Json   @map("trigger_event")
  // At-least-once guard: (automation_id, dedupe_key) is UNIQUE so a Pub/Sub
  // redelivery collapses to one run (docs/81 §7).
  dedupeKey    String @map("dedupe_key") @db.Text
  // Cascade depth for the loop-guard (docs/81 §7).
  causeDepth   Int    @default(0) @map("cause_depth") @db.SmallInt

  // running | waiting | completed | failed | skipped | converted
  //
  // `converted` is a TERMINAL SUCCESS distinct from `completed`: the run stopped
  // because the automation's goal was met, not because it ran out of actions.
  // Kept apart deliberately — collapsing them would make a rule that converts on
  // step one indistinguishable from one that sent every email and achieved
  // nothing, which is the exact comparison enrollment analytics exists to draw.
  status            String    @default("running") @db.VarChar(20)
  cursorIndex       Int       @default(0) @map("cursor_index") // next action to run
  resumeAt          DateTime? @map("resume_at") @db.Timestamptz // durable-delay wake time
  actionsTotal      Int       @map("actions_total")
  errorMessage      String?   @map("error_message") @db.Text
  // The published version that was live when this run was created (docs/84
  // Slice G-versioning). Stamped for observability — "which version did this?".
  // Nullable for runs created before versioning shipped.
  automationVersion Int?      @map("automation_version")

  // When the automation's goal was met (docs/144 §9). Set together with
  // `status = 'converted'`; null on every other outcome. A timestamp rather than
  // a boolean so "how long does this rule take to work" is a query.
  goalMetAt DateTime? @map("goal_met_at") @db.Timestamptz

  // Why the run stopped, when it stopped for a reason worth naming: a
  // `platform.stop` action's reason, or `goal_met`. Null for a plain completion.
  // Distinct from `error_message`, which only ever describes a failure.
  exitReason String? @map("exit_reason") @db.VarChar(255)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  automation Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps      AutomationRunStep[]

  @@unique([automationId, dedupeKey], map: "automation_runs_automation_dedupe_unique")
  @@index([tenantId, status])
  @@index([tenantId, propertyId, startedAt(sort: Desc)])
  // Owner-scoped tick scans wake-due runs across tenants (docs/81 §7).
  @@index([status, resumeAt])
  @@map("automation_runs")
}

model AutomationRunStep {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId    String @map("run_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid // FORCE RLS needs this on the row

  // Index into the COMPILED program, not into the authored action list — a
  // branching rule flattens to a linear step sequence before it runs (docs/144
  // §9, wizeworks/packages/automation/src/engine/compile.ts).
  actionIndex Int    @map("action_index")
  actionType  String @map("action_type") @db.VarChar(100)

  // Where this step sits in the AUTHORED tree — `2`, or `2.then.0` for the first
  // action inside a branch. The compiled index is what the engine resumes from;
  // this is what a person reads, and without it a run inside a branch is a list
  // of numbers that no longer line up with the rule on screen.
  path    String? @db.VarChar(255)
  status  String  @default("pending") @db.VarChar(20) // pending|running|completed|failed|skipped|gated
  input   Json?
  output  Json?
  error   String? @db.Text
  // Policy-decision audit: [{ gate, decision, reason }] — `gated` != `failed` (docs/81 §7.1).
  gateLog Json?   @map("gate_log")

  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, actionIndex])
  @@index([tenantId])
  @@map("automation_run_steps")
}
