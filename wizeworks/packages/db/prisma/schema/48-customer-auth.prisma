// Customer auth — Layer 2 (site shoppers), on Better Auth. See docs/27 v2.
//
// A DEDICATED Better Auth instance (separate from the staff instance in
// 03-auth*.prisma) with APPLICATION-LEVEL MULTI-TENANCY: the same email is a
// separate account per tenant. Better Auth normally keys sign-in on a GLOBALLY
// unique email; here the tenant is known before auth (the storefront host), so a
// request-scoped AsyncLocalStorage (@wizeworks/db tenantStore) carries it and the
// customer-auth tenant-scoping adapter runs every Better Auth op inside a
// `SET LOCAL app.tenant_id` transaction. Correctness is DB-enforced: every table
// is ENABLE + FORCE RLS with a tenant_isolation policy, `tenant_id` DEFAULTs to
// current_tenant_id() (BA never sets it — it is tenant-oblivious), and the user
// table is `@@unique([tenant_id, email])`.
//
// FIELD NAMES ARE LOAD-BEARING. Better Auth's prisma adapter reads/writes the
// camelCase FIELD names below verbatim (email, emailVerified, providerId,
// accessToken, …); these mirror the staff models in 03-auth*.prisma exactly.
// The customer instance remaps the CORE models to these Prisma model keys via
// `modelName` options (customerUser/customerSession/customerAccount/
// customerVerification); the OAuth provider's and jwt() plugin's keys
// (oauthClient / oauthResource / oauthClientResource / oauthRefreshToken /
// oauthAccessToken / oauthConsent / oauthClientAssertion / jwks) are remapped to
// the Customer* models below by the tenant-scoping adapter Proxy, so this
// instance can never reach the STAFF tables. Renaming a field silently breaks
// the adapter at runtime.
//
// The CRM `customers` spine (per-site membership, orders, consent — docs/58) is
// unchanged and links to the Better Auth user via `customers.auth_user_id`.

// Tenant-wide shopper IDENTITY (the login) — the Better Auth `user`. One per
// (tenant, email). A person who shops more than one of the tenant's sites is ONE
// CustomerUser linked to a per-site `customers` MEMBERSHIP each (docs/58 D2).
model CustomerUser {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  // Per-tenant unique (NOT global) — see @@unique below. Same email at another
  // tenant is a different CustomerUser.
  email         String  @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")
  // Required (NOT nullable): Better Auth marks name required, and the mcp() token
  // endpoint reads user.name unconditionally. The register wrapper always supplies
  // one (falls back to the email local-part); the backfill does the same.
  name          String  @db.VarChar(255)
  image         String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          CustomerSession[]
  accounts          CustomerAccount[]
  oauthClients       CustomerOauthClient[]
  oauthRefreshTokens CustomerOauthRefreshToken[]
  oauthAccessTokens  CustomerOauthAccessToken[]
  oauthConsents      CustomerOauthConsent[]
  // The per-site memberships (CRM spine) behind this login (docs/58 D2).
  memberships       Customer[]

  @@unique([tenantId, email], map: "customer_users_tenant_email_unique")
  @@index([tenantId])
  @@map("customer_users")
}

// Better Auth `session`. Opaque `token` in the sparx_customer_session cookie.
// Looked up by token alone under RLS — a token from tenant A presented on tenant
// B's host resolves to zero rows (correct isolation).
model CustomerSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OAuth tokens minted while this session was signed in (SET NULL on the token
  // side: signing out never disconnects a shopper's assistant).
  oauthRefreshTokens CustomerOauthRefreshToken[]
  oauthAccessTokens  CustomerOauthAccessToken[]

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

// Better Auth `account`. providerId 'credential' → `password` holds the Argon2
// hash; social providers ('google', …) carry the OAuth tokens. Same email at
// another tenant is a different account (composite unique on tenant).
model CustomerAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id") @db.VarChar(50)
  accountId             String    @map("account_id") @db.VarChar(255)
  password              String?   @db.Text
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?   @db.Text
  idToken               String?   @map("id_token") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId, accountId], map: "customer_accounts_tenant_provider_account_unique")
  @@index([tenantId])
  @@index([userId])
  @@map("customer_accounts")
}

// Better Auth `verification`. Short-lived single-use tokens (email verify /
// password reset). `value` is TEXT for the same reason as staff (03-auth.prisma):
// the mcp()/oidc provider stashes the full authorization-code JSON here.
model CustomerVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, identifier])
  @@index([expiresAt])
  @@map("customer_verifications")
}

// ─── Customer MCP OAuth authorization server (docs/07 §5 · docs/113) ─────────
// Mirrors the staff OAuth tables (03-auth-oauth.prisma, Better Auth 1.7's
// @better-auth/oauth-provider + jwt()) but tenant-scoped: a shopper's DCR client,
// tokens, consents, the store's MCP resource rows AND the signing keys belong to
// one tenant. Per-tenant `customer_jwks` means each store signs with its own
// key, so a token one store minted cannot verify at another even before RLS.
// Unique columns stay GLOBALLY unique (random ids, hashed tokens, one store
// origin per tenant): Better Auth addresses them as single-column unique keys.

model CustomerJwks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  publicKey  String    @map("public_key") @db.Text
  privateKey String    @map("private_key") @db.Text
  alg        String?   @db.VarChar(32)
  crv        String?   @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("customer_jwks")
}

model CustomerOauthClient {
  id                               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                         String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  clientId                         String   @unique @map("client_id") @db.VarChar(255)
  clientSecret                     String?  @map("client_secret") @db.Text
  clientDiscoveryId                String?  @map("client_discovery_id") @db.Text
  disabled                         Boolean  @default(false)
  skipConsent                      Boolean? @map("skip_consent")
  enableEndSession                 Boolean? @map("enable_end_session")
  subjectType                      String?  @map("subject_type") @db.VarChar(32)
  scopes                           String[] @default([])
  clientCredentialsScopes          String[] @default([]) @map("client_credentials_scopes")
  userId                           String?  @map("user_id") @db.Uuid
  name                             String?  @db.VarChar(255)
  uri                              String?  @db.Text
  icon                             String?  @db.Text
  contacts                         String[] @default([])
  tos                              String?  @db.Text
  policy                           String?  @db.Text
  softwareId                       String?  @map("software_id") @db.Text
  softwareVersion                  String?  @map("software_version") @db.Text
  softwareStatement                String?  @map("software_statement") @db.Text
  redirectUris                     String[] @default([]) @map("redirect_uris")
  postLogoutRedirectUris           String[] @default([]) @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?  @map("backchannel_logout_uri") @db.Text
  backchannelLogoutSessionRequired Boolean? @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?  @map("token_endpoint_auth_method") @db.VarChar(64)
  applicationType                  String?  @map("application_type") @db.VarChar(32)
  jwks                             String?  @db.Text
  jwksUri                          String?  @map("jwks_uri") @db.Text
  grantTypes                       String[] @default([]) @map("grant_types")
  responseTypes                    String[] @default([]) @map("response_types")
  requirePKCE                      Boolean? @map("require_pkce")
  dpopBoundAccessTokens            Boolean  @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?  @map("reference_id") @db.Text
  metadata                         String?  @db.Text

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          CustomerUser?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     CustomerOauthClientResource[]
  refreshTokens CustomerOauthRefreshToken[]
  accessTokens  CustomerOauthAccessToken[]
  consents      CustomerOauthConsent[]

  @@index([tenantId])
  @@index([userId])
  @@map("customer_oauth_clients")
}

// The store's own MCP endpoint(s), written by the authorize guard in
// @wizeworks/customer-auth the first time a client names one (an MCP resource is
// per store origin, so it cannot be a boot-time config value).
model CustomerOauthResource {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                      String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  identifier                    String   @unique @db.Text
  name                          String   @db.VarChar(255)
  accessTokenTtl                Int?     @map("access_token_ttl")
  refreshTokenTtl               Int?     @map("refresh_token_ttl")
  signingAlgorithm              String?  @map("signing_algorithm") @db.VarChar(32)
  signingKeyId                  String?  @map("signing_key_id") @db.Text
  allowedScopes                 String[] @default([]) @map("allowed_scopes")
  customClaims                  String?  @map("custom_claims") @db.Text
  dpopBoundAccessTokensRequired Boolean  @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean  @default(false)
  policyVersion                 Int      @default(1) @map("policy_version")
  metadata                      String?  @db.Text

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  tenant  Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clients CustomerOauthClientResource[]

  @@index([tenantId])
  @@map("customer_oauth_resources")
}

model CustomerOauthClientResource {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  clientId   String    @map("client_id") @db.VarChar(255)
  resourceId String    @map("resource_id") @db.Text
  metadata   String?   @db.Text
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   CustomerOauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource CustomerOauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([tenantId])
  @@index([resourceId])
  @@map("customer_oauth_client_resources")
}

model CustomerOauthRefreshToken {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  token                   String    @unique @db.Text
  clientId                String    @map("client_id") @db.VarChar(255)
  sessionId               String?   @map("session_id") @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  referenceId             String?   @map("reference_id") @db.Text
  authorizationCodeId     String?   @map("authorization_code_id") @db.Text
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([]) @map("requested_user_info_claims")
  scopes                  String[]  @default([])
  expiresAt               DateTime? @map("expires_at") @db.Timestamptz
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz
  revoked                 DateTime? @db.Timestamptz
  rotatedAt               DateTime? @map("rotated_at") @db.Timestamptz
  rotationReplayResponse  String?   @map("rotation_replay_response") @db.Text
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at") @db.Timestamptz
  authTime                DateTime? @map("auth_time") @db.Timestamptz
  confirmation            String?   @db.Text

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       CustomerOauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      CustomerSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         CustomerUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens CustomerOauthAccessToken[]

  @@index([tenantId])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("customer_oauth_refresh_tokens")
}

model CustomerOauthAccessToken {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  token                   String?   @unique @db.Text
  clientId                String    @map("client_id") @db.VarChar(255)
  sessionId               String?   @map("session_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  referenceId             String?   @map("reference_id") @db.Text
  authorizationCodeId     String?   @map("authorization_code_id") @db.Text
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([]) @map("requested_user_info_claims")
  refreshId               String?   @map("refresh_id") @db.Uuid
  scopes                  String[]  @default([])
  expiresAt               DateTime? @map("expires_at") @db.Timestamptz
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz
  revoked                 DateTime? @db.Timestamptz
  confirmation            String?   @db.Text

  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  CustomerOauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session CustomerSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    CustomerUser?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh CustomerOauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("customer_oauth_access_tokens")
}

model CustomerOauthConsent {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  clientId                String    @map("client_id") @db.VarChar(255)
  userId                  String?   @map("user_id") @db.Uuid
  referenceId             String?   @map("reference_id") @db.Text
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([]) @map("requested_user_info_claims")
  scopes                  String[]  @default([])
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client CustomerOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   CustomerUser?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@map("customer_oauth_consents")
}

model CustomerOauthClientAssertion {
  id        String   @id @db.Text
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@map("customer_oauth_client_assertions")
}
