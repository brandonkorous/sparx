// Site forms (docs/115) — public contact/lead form submissions from Builder
// pages, and the server-side routing config that never reaches the browser.
//
// A visitor submits a Builder form on a tenant site (POST /v1/public/forms/
// submit). api-rest stores a FormSubmission ROW regardless of which modules are
// on — the durable inbox is the backbone, and it is what makes the "turn on CRM
// and import your existing leads" upsell honest. It also publishes the owner
// notification + autoresponder as `email.send`, and `form.submitted` for the CRM
// lead consumer (upsert a prospect + log the message, gated on `crm`).
//
// SECURITY — the recipient ADDRESSES live in FormDefinition, NOT in the Builder
// tree. The published tree is delivered to every visitor's browser, so an email
// authored into a form node's props would be harvestable spam bait. At publish
// (wizeworks/packages/builder pageService.publish) each form node's routing is extracted
// into a FormDefinition row keyed by (property_id, form_node_id) and STRIPPED
// from the published tree. The submit endpoint reads recipients from here (or the
// tenant's account email as a fallback) — never from the request, never from
// anything the browser saw. This is the whole point of a separate table: the
// address boundary, not lookup speed.
//
// Both tables are tenant-scoped → FORCE RLS + tenant_isolation (hand-edited into
// the migration SQL; current_tenant_id() defined in 20260527000100_rls). New
// empty tables → no backfill, so no FORCE-RLS loop.

model FormSubmission {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The site the form was submitted on (docs/49). SetNull so a submission
  // outlives a deleted site (it stays in the inbox / CRM history).
  propertyId String? @map("property_id") @db.Uuid

  // Which form, and where. `formNodeId` is the STABLE Builder node id (persisted
  // with the tree, preserved across re-publishes — root CLAUDE.md), so it keys
  // both the FormDefinition lookup and the inbox "submissions for this form"
  // filter. `pageSlug` is null for the home page. `formName` is an author label
  // snapshot for the inbox ("Contact form").
  formNodeId String  @map("form_node_id") @db.VarChar(255)
  pageSlug   String? @map("page_slug") @db.VarChar(255)
  formName   String? @map("form_name") @db.VarChar(160)

  // The submitter is anonymous — these are a snapshot, not FKs. The recognised
  // trio is promoted to columns for the inbox + CRM mapping; `fields` carries the
  // full authored field set (including any custom fields) verbatim.
  name    String? @db.VarChar(200)
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)
  message String? @db.Text
  fields  Json    @default("{}")

  // Visitor-uploaded files (docs/115 Part D). A JSON array of FormAttachment refs
  // `{ key, filename, mimeType, byteSize }` — the bytes live in the PRIVATE media
  // bucket under `form-uploads/attached/…`, never a public URL; staff download via
  // an authenticated, RLS-scoped route. Empty for a form with no file field. The
  // keys are server-minted (a signed upload token binds them) so a submission can
  // never reference an arbitrary object.
  attachments Json @default("[]")

  // Captured request context — referrer, UTM params, user-agent, client IP, and
  // the submitted-at instant. Never rendered as HTML in the dashboard (escape on
  // display); this is untrusted public input.
  context Json @default("{}")

  // Triage lifecycle. `spam` is set when the honeypot trips or a later manual
  // flag; spam rows are excluded from the CRM backfill.
  status String @default("new") @db.VarChar(20) // new | read | spam | archived

  // Set once the submission is mirrored into the CRM as a prospect (idempotent).
  // SetNull so deleting the contact doesn't destroy the submission record.
  customerId String? @map("customer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, formNodeId, createdAt(sort: Desc)])
  @@map("form_submissions")
}

// The server-side routing config for one form node on one site — materialized at
// publish time (never edited directly by the submit path). Holds the SENSITIVE
// recipient addresses that are deliberately kept out of the client-delivered
// published tree. The non-sensitive toggles (notify on/off, addToCrm,
// autoresponder + its copy) stay in the Builder node props; only the addresses
// live here. `config` is a forward-compatible bag for any future server-only
// routing (e.g. a per-form reply-to).
model FormDefinition {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  // The site this form lives on. Cascade — a form definition is meaningless once
  // its site is gone (unlike a submission, which is kept for history).
  propertyId String @map("property_id") @db.Uuid

  formNodeId String  @map("form_node_id") @db.VarChar(255)
  pageSlug   String? @map("page_slug") @db.VarChar(255)

  // The notify addresses (the "email me" list + any custom recipients). Authored
  // in the inspector, extracted here at publish, stripped from the public tree.
  recipients String[] @default([]) @db.VarChar(255)
  config     Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, formNodeId], map: "form_definitions_property_node_unique")
  @@index([tenantId])
  @@map("form_definitions")
}
