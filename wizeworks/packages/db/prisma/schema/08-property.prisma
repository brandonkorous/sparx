// Property — a tenant's web property (a distinct site: presentation + page tree
// + domain) over the shared back office. The multi-site axis (docs/49): one
// TENANT has one-or-more PROPERTIES. Phase 1 seeds exactly one is_primary
// property per tenant and changes no behavior; the Builder presentation layer
// (builder_pages / builder_layouts) re-keys onto property_id in a later slice.
//
// NOT a security boundary. tenant_id remains the only RLS isolation boundary;
// property_id is application-tier scoping WITHIN a tenant (docs/49 §2). Two
// properties in one tenant can read each other's rows as far as Postgres is
// concerned — the app scopes by property_id. A tenant needing hard isolation
// uses two WORKSPACES, not two properties.
//
// Tenant-scoped + ENABLE/FORCE RLS on tenant_id (policy in the migration). The
// "exactly one primary per tenant" rule is a PARTIAL UNIQUE index
// (tenant_id) WHERE is_primary — hand-added in the migration (Prisma can't
// express the predicate), mirroring builder_layouts_one_active_per_tenant.

model Property {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Stable per-tenant handle. The primary property is seeded as 'primary'.
  slug String @db.VarChar(63)
  // The CUSTOMER-FACING site name (docs/49). Every storefront surface (title, header,
  // footer, OG, JSON-LD) and email (wordmark/footer, `{{site.name}}`) reads THIS —
  // never the tenant's legal/org name (`Tenant.name` is billing/ownership only). NOT
  // NULL: seeded from the tenant name at provisioning, edited in Settings → Sites.
  name String @db.VarChar(255)

  // Exactly one per tenant (DB-enforced by the partial unique index). The
  // primary keeps the tenant's existing subdomain for backward compatibility;
  // additional properties get their own hostnames (Phase 2).
  isPrimary Boolean @default(false) @map("is_primary")

  // active | paused | archived
  status String @default("active") @db.VarChar(20)

  // Per-property settings bag (shape validated in the service, not the DB).
  settings Json @default("{}")

  // Platform attribution — the always-on credit badge injected into this site's
  // footer by wizeworks/apps/site (shell chrome, NOT a deletable BuilderNode).
  // Defaults ON: at startup every site carries the credit (referral + brand
  // exposure). Flipping it to false hides the badge site-wide, no code change.
  //
  // NAMED FOR THE PLATFORM, NOT A PRODUCT. It was `show_sparx_credit`, from when
  // there was one brand and the badge said "Made with sparx" on every site the
  // renderer served — including every Piggles business's public footer. The badge
  // has been resolved per tenant from `platform_brand` since 2026-08-16; the
  // column kept the old name until 2026-08-21, which meant a Piggles owner's
  // switch for their own footer credit was still spelled after another company.
  showPlatformCredit Boolean @default(true) @map("show_platform_credit")

  // Per-site module scope (docs/49 Slice F) — a string[] of module slugs that are
  // DISABLED for this site only. Empty = all tenant-active modules are on.
  // Tenant-level module.activated/deactivated is still the primary gate;
  // this list can only narrow further, never grant a module that is not active at
  // the tenant level. Stored as JSONB, validated in the service.
  moduleScope Json @default("[]") @map("module_scope")

  // OPTIONAL per-site brand override (docs/49 §3 — the deliberate amendment to
  // doc-34's "brand overridable by none"). Null = inherit the tenant brand
  // (TenantBrand stays the default/source of truth). A partial override:
  // { businessName?, colorPrimary?, colorPrimaryForeground?, colorAccent?,
  //   logoMediaId? } — any absent/null field falls back to the tenant brand.
  // Presentation-only identity (display name + theme colors + logo), NOT a full
  // brand fork; merged over the tenant brand in the public tenant payload.
  brandOverride Json? @map("brand_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Builder presentation layer, re-keyed per-property (docs/49 Phase 1B).
  // Tenant-authored components stay tenant-wide and do NOT relate here.
  builderPages         BuilderPage[]
  builderNodeIndex     BuilderNodeIndex[]
  builderPageArtifacts BuilderPageArtifact[]
  builderReleases      BuilderRelease[]
  builderDraftVersions BuilderDraftVersion[]
  builderPageOps       BuilderPageOp[]
  builderLayouts       BuilderLayout[]
  builderAssignments   BuilderPageAssignment[]
  // The silica site record (docs/118): this site's authored theme + saved-component
  // symbols. Site-global, so it hangs off the property — never off a layout.
  builderSite          BuilderSite?
  // Per-site email overrides (docs/49 Phase 7b / docs/91 §6) — a site's fork of a
  // provisioned default, or a site-specific custom email. null-property emails are
  // tenant-wide (the 13 defaults + tenant custom emails). SetNull on delete.
  builderEmails        BuilderEmail[]

  // Sitebuilder applied-theme trio, re-keyed per-property (docs/49 Phase 6). Each
  // site keeps its own draft config + published version history + publish
  // schedules, and its own write-through CommerceSiteTheme. The saved-theme LIBRARY
  // (SiteTheme) + the legacy section tier stay tenant-wide and do NOT relate here.
  siteConfig           SiteConfig?
  siteVersions         SiteVersion[]
  sitePublishSchedules SitePublishSchedule[]
  commerceSiteTheme    CommerceSiteTheme?
  // Per-site commerce defaults + checkout policy (docs/49 Phase 6b); a site with
  // no row inherits the primary's at read time.
  commerceSiteSettings CommerceSiteSettings?
  // Per-site legal/footer doc placements (docs/49 Phase 6c); null-property
  // placements are tenant-wide and show on every site.
  docPlacements        SiteDocPlacement[]
  // Per-site email sends (docs/49 Phase 7) — broadcasts, queued sends, and the
  // engagement events they produce render/attribute against this site's brand.
  // null-property rows fall back to the tenant's primary brand.
  broadcasts           Broadcast[]
  scheduledSends       ScheduledSend[]
  emailEvents          EmailEvent[]
  // This site's SENDER IDENTITY — from name/address, reply-to, and the CAN-SPAM
  // postal address in the footer (docs/131 §3.4). Required + Cascade: unlike the
  // rows above it does NOT fall back to the primary, because falling back is what
  // put the other business's name on the envelope.
  emailSettings        EmailSettings?

  // Per-site AI (docs/131 §3.5). The `persona` prompt is the live-chat AI's
  // system prompt — the VOICE the business answers in — and tool policies are
  // per-site safety decisions. Both nullable on the other side: a null-property
  // row is tenant-wide, and the site's own row wins over it.
  aiPromptTemplates AiPromptTemplate[]
  aiToolPolicies    AiToolPolicy[]

  // Live chat (docs/131 §3.7). Conversations SetNull on delete — a support
  // thread is a record of something that really happened and outlives its site,
  // like orders above. Quick replies Cascade: authored copy for one business.
  chatConversations ChatConversation[]
  chatQuickReplies  ChatQuickReply[]

  // Per-site redirects (docs/131 §3.8) — a 301 is addressed to a PATH, and two
  // sites have unrelated path spaces. Nullable on the other side: a tenant-wide
  // rule fires everywhere, and the site's own rule wins for the same path.
  redirects Redirect[]

  // Per-site cookie consent (docs/131 §3.9). REQUIRED on both, with no
  // tenant-wide tier: consent is a legal relationship between one visitor and
  // one business, so inheriting a sibling's is the defect, not a convenience.
  consentSettings ConsentSettings?
  consentRecords  ConsentRecord[]

  // Invoicing (docs/131 §3.6). Documents are RESTRICT on delete — the only
  // relation here that blocks rather than cascading or nulling, because a
  // finalized invoice is a financial record with statutory retention. A site with
  // billing history is archived, never deleted. Templates cascade (artwork).
  billingDocuments         BillingDocument[]
  billingDocumentTemplates BillingDocumentTemplate[]

  // B2B spending controls (docs/131 §4) — a per-site approval threshold. Nullable
  // on the other side: a genuinely tenant-wide control ("anything over $10k gets
  // my eyes") is a real intent worth expressing once.
  purchaseApprovalRules PurchaseApprovalRule[]

  // Customer-facing commerce (docs/131 §4). Discounts use the JUNCTION pattern
  // (a portfolio-wide sale is ONE promotion, not N copies to keep in sync);
  // shipping zones and profiles use a nullable column. ShippingRate deliberately
  // has neither — it inherits its site from the zone it hangs off.
  discountLinks    DiscountProperty[]
  shippingZones    ShippingZone[]
  shippingProfiles ShippingProfile[]

  // SEO scorecards (docs/131 §4). Nullable on the other side: SET for pages,
  // which belong to one site, NULL for products/collections, which reach sites
  // through junctions and can appear on several while having one score.
  seoAudits SeoAudit[]

  // Per-site product rating aggregate (docs/131 §4) — the cheap per-(product,
  // site) rating lookup product-card grids read, so a storefront never shows a
  // star average blended across sibling businesses.
  productReviewRollups ProductReviewRollup[]

  // Per-site analytics rollups (docs/131 §6). Inventory valuation is deliberately
  // absent — it stays tenant-only (one stock pool serves every site).
  rollupCommerceDailyRevenue    RollupCommerceDailyRevenue[]
  rollupInvoicingDailyCollected RollupInvoicingDailyCollected[]
  rollupDropshipDailyOrders     RollupDropshipDailyOrders[]
  rollupAutomationDailyRuns     RollupAutomationDailyRuns[]
  rollupFinanceDailyProfit      RollupFinanceDailyProfit[]

  // Finance (docs/148 §3) — spend belongs to a BUSINESS, not a billing container:
  // two unrelated businesses under one owner never share a ledger, and a bookkeeper
  // for one has no business seeing the other's books. Nullable on the finance side,
  // where null is the "tenant-level, not attributable to one site" bucket.
  financeExpenses              FinanceExpense[]
  financeRecurringExpenses     FinanceRecurringExpense[]
  financeAccountingConnections FinanceAccountingConnection[]

  // Staff (docs/149) — someone can work for both of an owner's businesses, so the
  // roster link is a junction; their hours and commission land against the site
  // whose job they worked.
  staffMemberSites      StaffMemberSite[]
  staffTimeEntries      StaffTimeEntry[]
  staffShifts           StaffShift[]
  staffCommissions      StaffCommission[]
  staffSaleAttributions StaffSaleAttribution[]

  // Per-site pricing (docs/131 §4): price lists apply via a junction (Discount
  // shape). Markup + surcharge rules are deliberately tenant-wide — markup writes a
  // variant's single shared list price, and a surcharge is a per-tenant payment fee.
  priceListLinks PriceListProperty[]

  // The site a tenant markets AS on sparx.market (docs/131 §7) — its public merchant
  // identity is this property's, not the tenant's.
  marketMerchantProfiles MarketMerchantProfile[]

  // Shopper-authored content (docs/131 §4), stamped with WHERE IT WAS WRITTEN
  // rather than inferred from the product — a product reaches sites through a
  // junction and can be listed on several, so the act of writing is the only
  // thing that identifies a site. All SetNull: a real person wrote these, and
  // closing a storefront must not delete their words or empty their saved list.
  productReviews   ProductReview[]
  productQuestions ProductQuestion[]
  wishlists        Wishlist[]

  // CMS editorial (docs/131 §4). Authors SetNull — a byline is a PERSON, and
  // their published articles still reference it after a site closes. Taxonomies
  // and terms Cascade: editorial vocabulary belongs to the business that wrote
  // it. Note the two scope INDEPENDENTLY — a shared vocabulary ("categories")
  // holding per-site terms ("Diesel repair") is the useful arrangement.
  authors       Author[]
  taxonomies    Taxonomy[]
  taxonomyTerms TaxonomyTerm[]

  // Scheduling (docs/131 §4). Services/policies/intake forms + bookings take a
  // direct propertyId (bookings SetNull — they are records; the rest Cascade).
  // Resources and locations use JUNCTIONS because a person or a place can serve
  // both businesses — the same shape as warehouses.
  schedulingServices SchedulingService[]
  bookingPolicies    BookingPolicy[]
  intakeForms        IntakeForm[]
  bookings           Booking[]
  locationLinks      BusinessLocationProperty[]
  resourceLinks      SchedulingResourceProperty[]

  // External sales channels (docs/131 §4) — an Etsy/TikTok shop belongs to one
  // business, so the connection is per-site (Cascade: it holds that shop's OAuth
  // tokens). ChannelProductMapping inherits its site from the connection and has
  // no relation here.
  channelConnections ChannelConnection[]

  // Social posting (docs/133 §5) — a connected account speaks for one business, so
  // the connection is per-site (like a sales channel); SocialPost is per-site too.
  // SocialTarget/SocialPostTarget inherit their site from the connection/post.
  socialConnections  SocialConnection[]
  socialPosts        SocialPost[]
  // Hashtag sets, posting slots and the engagement inbox are per-site too: they are
  // this business's voice, its cadence, and its conversations.
  socialHashtagSets  SocialHashtagSet[]
  socialPostingSlots SocialPostingSlot[]
  socialInboxItems   SocialInboxItem[]

  // Legacy CMS (docs/131 §4). Pages take a direct propertyId (a slug is a URL,
  // like redirects); ContentType is a nullable vocabulary like Taxonomy (its
  // entries carry the real per-site scope via ContentEntryProperty).
  pages        Page[]
  contentTypes ContentType[]

  // Media library (docs/49 site-scoping). An asset belongs to one site, or is
  // shared tenant-wide (property_id NULL); SetNull on delete keeps the asset.
  mediaAssets MediaAsset[]

  // CRM audience (docs/131 §5) — a segment draws from one business's customers
  // and feeds its broadcasts. Nullable (a cross-business audience is real);
  // SegmentMember inherits and has no relation here.
  segments Segment[]

  // CRM sales pipelines (docs/131 §5). Pipeline is the authored process
  // (Cascade); Deal is the record, denormalized from its pipeline (SetNull,
  // outlives the site). PipelineStage inherits and has no relation here.
  pipelines     Pipeline[]
  deals         Deal[]
  // Same reasoning as Deal: a service request is a record of something a real
  // person asked for, so it survives the site closing (SetNull).
  tickets       Ticket[]
  // Reports and dashboards are per-site when a business runs more than one:
  // "how are we doing" means a different thing for each shopfront. Cascade,
  // unlike the records above — a report about a site that is gone is not a
  // record of anything that happened, just a query with no subject.
  crmReports    CrmReport[]
  crmDashboards CrmDashboard[]
  scoringModels ScoringModel[]

  // The CRM workspace layer (docs/144 §11/§12) — settings, saved views and
  // meeting links are all per-BUSINESS, because two unrelated businesses under
  // one owner do not agree on what a duplicate is, which columns matter, or
  // whose calendar `/meet/discovery-call` opens.
  crmSettings     CrmSettings[]
  crmSavedViews   CrmSavedView[]
  crmMeetingLinks CrmMeetingLink[]

  // CRM tasks (docs/131 §5) — a work queue item, denormalized from its
  // customer/deal so a site-scoped member sees only their business's tasks.
  // SetNull: a task outlives its site.
  tasks Task[]

  // Custom + purchased hostnames pointing at this site (docs/49 §5, docs/24).
  domains Domain[]

  // Model B per-site scoping (docs/49 §3) — which products / content entries /
  // collections / categories this site exposes. EMPTY = the site shows ALL (the
  // default, Model A behavior).
  productLinks      ProductProperty[]
  productTypes      ProductType[]
  contentEntryLinks ContentEntryProperty[]
  collectionLinks   CollectionProperty[]
  categoryLinks     CategoryProperty[]

  // Origin-site tagging (docs/58 D1) — orders + carts placed on this site. These
  // SetNull on delete (orders outlive their site); they are NOT a fork.
  orders Order[]
  carts  Cart[]

  // Per-site customer MEMBERSHIPS (docs/58 D2) — shoppers who belong to this site.
  customerMemberships Customer[]

  // Per-site navigation menus. null-property menus are tenant-wide fallbacks;
  // these override for this specific site.
  navigationMenus NavigationMenu[]

  // Per-site dropship supplier enablement (docs/14, docs/49 §3). A tenant-wide
  // supplier connection with NO rows here serves ALL sites; rows present restrict
  // it to those sites. JUNCTION — no fork, ON DELETE CASCADE.
  dropshipSupplierScopes DropshipSupplierProperty[]

  // ── P0 site scoping (docs/131 §3) ──────────────────────────────────────────
  // Rules that act only on THIS business. Null-property automations are
  // tenant-wide. CASCADE, not SetNull: deleting a site must narrow a rule's
  // reach, never promote it to every site.
  automations    Automation[]
  // Run history, SetNull — a run is a record of what happened and outlives the
  // site it happened on.
  automationRuns AutomationRun[]

  // API keys that may read and write only THIS business. Null-property keys
  // reach the whole tenant. CASCADE — a credential must never gain reach.
  apiKeys ApiKey[]

  // Which staff may open this site, when their membership is set to `selected`.
  // JUNCTION mirroring MemberModuleAccess — no rows under `all` means no
  // restriction at all.
  memberAccess MemberPropertyAccess[]

  // Site forms (docs/115) — submissions captured on this site + the server-side
  // routing config for its form nodes.
  formSubmissions FormSubmission[]
  formDefinitions FormDefinition[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("properties")
}
