// CRM — Companies (docs/144 §11, was b2b_accounts / docs/10 §2).
//
// The organisation a contact belongs to. Every CRM has one and the platform's
// was called `b2b_accounts`, because the first thing that needed one was
// wholesale — which meant a design agency tracking the firms it works with had
// to store them in a table named after a trading relationship it does not have.
//
// The rename separates the NAME from the JOB. The AR / pricing / fleet columns
// below are untouched and still hold the trading relationship; what changed is
// that they are presented as a "Trade terms" panel gated on the `b2b` module, so
// a CRM-only tenant never meets a credit limit. Module off → the panel does not
// render and these keep their defaults, which are the values a company that does
// not trade on account has anyway.
//
// The B2B module's own join tables keep the `b2b_account_*` names on purpose: a
// `B2bAccountContact` is not "a person at this company", it is a buyer
// AUTHORISED TO TRADE with a purchase limit and an approver. Same distinction,
// held in the naming.

model Company {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  companyName String  @map("company_name") @db.VarChar(255)
  taxId       String? @map("tax_id") @db.VarChar(64)
  website     String? @db.VarChar(2048)

  // Email domains belonging to this company (docs/144 §11). NOT derived from
  // `website`: a firm at acme.com may send mail from acme-group.com, an acquired
  // brand keeps its old domain for years, and plenty of companies have every
  // contact on one domain and no website at all.
  //
  // Used to OFFER a company on a new contact whose email matches — never to
  // apply one. Silent auto-association is how a CRM's data gets quietly wrong,
  // and the offer is itself off until a tenant turns it on in CrmSettings.
  //
  // Stored lowercased, without the `@`. GIN-indexed in the migration, because
  // the lookup is "which company owns this domain" — a containment search a
  // btree cannot answer.
  domains       String[] @default([])
  // Legacy free-text tier name kept during the FK migration window.
  pricingTier   String?  @map("pricing_tier") @db.VarChar(63)
  pricingTierId String?  @map("pricing_tier_id") @db.Uuid

  // ── TRADE TERMS (docs/144 §11) ──────────────────────────────────────────
  // Everything from here to `engineProfiles` is the trading relationship, and
  // it renders ONLY when the `b2b` module is on. The defaults are what a company
  // that does not trade on account looks like, so a CRM-only tenant's rows are
  // correct rather than merely unread — which matters the day they switch the
  // module on and expect to start from zero rather than from junk.
  creditLimit     Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditUsed      Decimal @default(0) @map("credit_used") @db.Decimal(12, 2)
  paymentTerms    String? @map("payment_terms") @db.VarChar(20)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  status String @default("active") @db.VarChar(20) // active | credit_hold | suspended | inactive

  // Fleet-specific (Gillett Diesel reference case)
  fleetSize      Int? @map("fleet_size")
  engineProfiles Json @default("[]") @map("engine_profiles")
  // ── end trade terms ─────────────────────────────────────────────────────

  notes String?  @db.Text
  tags  String[] @default([]) @db.VarChar(63)

  // Tenant-declared extra fields on a company (docs/144 §3) — "industry",
  // "renewal month", "account manager". Validated against the `company` row in
  // crm_object_defs. The object key is `company`, not `b2b_account`: this table
  // is the platform's company record and §11 renames it to match.
  customProperties Json @default("{}") @map("custom_properties")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedRep   User?           @relation("CompanyAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  pricingTierFk B2bPricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)

  customers  Customer[]
  deals      Deal[]
  tickets    Ticket[]
  activities CrmActivity[]

  // Commerce module inverse relations
  priceLists       PriceList[]
  contractPrices   ContractPrice[]
  checkoutSessions CheckoutSession[]
  taxExemptions    TaxExemption[]

  // B2B module inverse relations (net-terms AR is a BillingDocument — docs/87 §15)
  productOverrides B2bAccountProductOverride[]
  billingDocuments BillingDocument[]
  contacts         B2bAccountContact[]
  approvalRules    PurchaseApprovalRule[]
  fleetHolds       B2bFleetHold[]

  @@index([tenantId, status])
  @@index([tenantId, assignedRepId])
  @@index([tenantId, updatedAt(sort: Desc)])
  // `domains` gets a GIN index, hand-written in the migration — Prisma cannot
  // express an index type, and a btree on a text[] answers nothing.
  @@map("companies")
}
