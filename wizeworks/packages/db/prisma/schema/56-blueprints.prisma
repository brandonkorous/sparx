// Tenant blueprint installs (docs/54 §9) — one row per marketplace template a
// tenant installs into one of its web properties. The record is the idempotency
// key (one install per blueprint per property), the audit trail, the id map for
// the "Review & go live" surface, and the status (draft `installed` → `live`).
//
// Tenant-scoped, ENABLE + FORCE RLS on tenant_id (policy in the migration),
// mirroring `properties`. `property_id` is application-tier scoping (which site
// the blueprint was installed into), NOT a security boundary — no FK, no policy
// of its own (docs/49 §2).

model TenantBlueprintInstall {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The web property (site) the blueprint was installed into. App-tier scope.
  propertyId String @map("property_id") @db.Uuid

  // The blueprint key + the version installed (from the @wizeworks/blueprints catalog).
  blueprintKey     String @map("blueprint_key") @db.VarChar(63)
  blueprintVersion String @map("blueprint_version") @db.VarChar(20)

  // installed — artifacts created as drafts; live — the tenant published/went
  // live; failed — a run errored (partial artifacts may exist).
  status String @default("installed") @db.VarChar(20)

  // Did this install bring the design's EXAMPLES with it (issue 098)?
  //
  // A blueprint carries two different things: the structure (its look, its pages,
  // its chrome, its email designs) and the furniture that makes the structure
  // legible — example products, example articles, an example salon with example
  // stylists. Seeding the furniture is deliberate, because an empty console tells
  // a new owner nothing. But somebody who already knows what they are doing can
  // ask for the structure alone, and that answer has to OUTLIVE the install: the
  // backfill re-runs a slice when a module is switched on months later, and the
  // updater brings whatever a newer version added. Both read this, so neither can
  // quietly hand back the furniture she declined.
  //
  // Default true = how every install before this behaved.
  sampleData Boolean @default(true) @map("sample_data")

  // The id map (handle/key → created UUID) + per-slice counts + any upsell flags.
  result Json @default("{}")

  // Failure detail when status = failed.
  error String? @db.Text

  installedAt DateTime  @default(now()) @map("installed_at") @db.Timestamptz
  liveAt      DateTime? @map("live_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The per-artifact baseline/provenance rows that power non-destructive updates
  // (docs/55 §4). Cascade: deleting/uninstalling an install drops its artifact rows.
  artifacts TenantBlueprintInstallArtifact[]

  // One install per blueprint per property (re-install is an explicit reset).
  @@unique([tenantId, propertyId, blueprintKey])
  @@index([tenantId])
  @@map("tenant_blueprint_installs")
}

// Blueprint install artifacts (docs/55 §4) — one row per artifact a blueprint
// install created (or brought under management on a later update). It carries the
// stamped BASELINE (the three-way-merge ancestor: §5) plus the per-artifact
// managed/detached lifecycle. This is the merge SUBSTRATE layered alongside
// `TenantBlueprintInstall.result` (the lightweight id-map go-live/review/delete read):
// `result` says WHAT exists, this says WHAT IT ORIGINALLY WAS — which is what lets a
// blueprint update tell "the tenant changed this" from "the blueprint changed this"
// and so never clobber a tenant edit (docs/55 U1/U6).
//
// Tenant-scoped, ENABLE + FORCE RLS on tenant_id (policy in the migration).
// `install_id` FKs the install row (cascade); `ref_id` is app-tier (which row the
// baseline tracks) — null for the tenant-level `brand` sentinel.
model TenantBlueprintInstallArtifact {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  installId String @map("install_id") @db.Uuid

  // theme | brand | layout | page | email | component | product | content
  //  | category | collection
  kind String @db.VarChar(20)

  // The created row id this baseline tracks (null for the tenant-level `brand`).
  refId String? @map("ref_id") @db.Uuid

  // Correlation key back to the manifest: product/category/collection handle,
  // content `typeKey:slug`, page slug|recordType|name, email name, component key,
  // theme id, or the literal `brand` sentinel.
  naturalKey String @map("natural_key") @db.VarChar(255)

  // The stamped content = the merge ANCESTOR (base) for this artifact (docs/55 §4).
  baseline Json @default("{}")

  // The blueprint version `baseline` reflects — advances on each applied update so
  // the NEXT update detects what the tenant changed since this version (docs/55 §4).
  baselineVersion String @map("baseline_version") @db.VarChar(20)

  // managed=false ⇒ orphaned (upstream-removed; kept, never auto-updated, docs/55 U3).
  // detached=true ⇒ tenant ejected it; never offered updates again (docs/55 U8).
  managed  Boolean @default(true)
  detached Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  install TenantBlueprintInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@unique([installId, kind, naturalKey])
  @@index([tenantId])
  @@index([installId])
  @@map("tenant_blueprint_install_artifacts")
}
