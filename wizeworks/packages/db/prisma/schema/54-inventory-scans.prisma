// Scan events — the record of every trigger pull (docs/146 Phase 3.5–3.9).
//
// Two jobs, and the second is why the table exists rather than the first.
//
// ── 1. Idempotency, which is what makes offline scanning correct ─────────────
//
// A hand terminal in a metal-racked warehouse loses its connection constantly.
// The workable answer is to keep scanning into a local queue and replay when the
// signal comes back — but a replay that cannot tell "this scan again" from "this
// scan a second time" turns a dropped connection into a receiving error, and a
// warehouse that has been burned once by that will never trust the feature
// again. So every scan carries a client-generated key, and
// `UNIQUE (tenant_id, idempotency_key)` makes the replay safe by construction:
// the second arrival inserts nothing and reports `duplicate`.
//
// This is the same discipline as `inventory_movements.idempotency_key`, one
// layer out. The movement ledger protects the QUANTITY; this protects the ACT,
// including the acts that resolve to no movement at all (a lookup, a scan of
// something we do not stock).
//
// ── 2. What actually happened on the floor ───────────────────────────────────
//
// `scanned_at` is CLIENT time — when the trigger was pulled — and `created_at`
// is when the server heard about it. On a live connection they are the same
// thing; on a replayed queue the gap between them is the outage, recorded rather
// than inferred. That is the difference between "the count was entered at 09:14"
// and "the count was entered at 06:02 and reached us at 09:14", and only one of
// those is true.

model InventoryScanEvent {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Client-generated, one per trigger pull. The whole offline story rests on it.
  idempotencyKey String @map("idempotency_key") @db.VarChar(127)

  /// Exactly what came off the scanner, before normalization. Kept raw on
  /// purpose: when a code will not resolve, the first useful question is what
  /// the gun actually sent, and a cleaned-up copy cannot answer it.
  value String @db.VarChar(256)

  // What the scan was FOR. count | receipt | transfer | put_away | pick | lookup
  // A CHECK pins it. `lookup` is a scan that changed nothing and is recorded
  // anyway — "I scanned this and it said nothing" is a support conversation that
  // needs evidence.
  contextType String  @map("context_type") @db.VarChar(20)
  contextId   String? @map("context_id") @db.Uuid

  // applied | duplicate | not_found | rejected
  // `duplicate` is written by the client's own retry bookkeeping, never by the
  // conflicting insert — the insert simply does nothing, which is the point.
  outcome String  @db.VarChar(20)
  /// Why it was rejected, in the words shown to the person holding the scanner.
  message String? @db.Text

  // What it resolved to, where the resolution succeeded.
  variantId String? @map("variant_id") @db.Uuid
  binId     String? @map("bin_id") @db.Uuid

  /// Base units this scan contributed — the pack size already multiplied in, so
  /// a case-of-twelve scan reads 12 here and nobody has to remember to expand it.
  quantity Int @default(1)

  /// Of those units, how many arrived broken. Split at the moment of scanning
  /// rather than reconstructed later, because the receiver looking at the carton
  /// is the only person who will ever know, and a receipt that mixes the two
  /// silently books damaged goods as sellable stock. Mirrors the good/damaged
  /// split `GoodsReceiptLine` already makes.
  damagedQuantity Int @default(0) @map("damaged_quantity")

  /// Which handheld. Free text set by the client; the only way to tell a
  /// misbehaving gun from a misbehaving person.
  deviceId String? @map("device_id") @db.VarChar(64)

  actorId String? @map("actor_id") @db.VarChar(127)

  /// When the trigger was pulled, per the device.
  scannedAt DateTime @map("scanned_at") @db.Timestamptz
  /// When we heard about it. Later than `scannedAt` by exactly the outage.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  bin     InventoryBin?   @relation(fields: [binId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey], map: "inventory_scan_events_tenant_idempotency_unique")
  @@index([tenantId, contextType, contextId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, variantId])
  @@map("inventory_scan_events")
}
