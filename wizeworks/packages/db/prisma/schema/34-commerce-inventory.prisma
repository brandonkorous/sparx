// Inventory module — warehouses, levels, the movement ledger, reservations.
// Owned by @wizeworks/inventory (extracted from commerce per docs/100); commerce,
// b2b, and dropship are consumers. Tables are prefixed `inventory_*`.
//
// `inventoryService.reserve()` is the single entry point for stock holds —
// cart soft (TTL 30m), order hard (until fulfillment), subscription
// renewal hard (until charge). Dropship supplier feeds project a virtual
// warehouse here; the platform sees one model regardless of who owns
// the stock.
//
// onHand is mutated by exactly one internal writer — `applyMovement()` — which
// appends an InventoryMovement row, so `onHand == Σ(movements.delta)` always
// holds (docs/100 §2.5). Every source (checkout, manual, MCP/AI, ERP sync,
// returns, the reaper) funnels through it.

model Warehouse {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(127)
  code     String @db.VarChar(15)
  type     String @default("owned") @db.VarChar(20) // owned | 3pl | dropship | virtual

  // A system warehouse is provisioned by the platform, not the tenant — currently
  // the single per-tenant in-transit holding location that transfers route through
  // (docs/100 P4). Excluded from the warehouse pickers/list by default so it isn't
  // selectable or archivable as an ordinary location.
  isSystem Boolean @default(false) @map("is_system")

  // Bins are OPT-IN per location (docs/146 Phase 2). A shop with one stockroom
  // gains nothing from naming a shelf before it can receive a delivery, and
  // forcing that is how a warehouse feature makes the product worse for everyone
  // smaller. Off = every write lands in this location's DEFAULT bin silently and
  // no bin UI renders.
  usesBins Boolean @default(false) @map("uses_bins")

  // How a picker is routed through this location's bins (docs/146 Phase 4).
  // fifo | fefo | nearest_bin | single_bin. Stored now because put-away suggests
  // a bin using the same preference, so it earns its place before picking ships.
  allocationStrategy String @default("fifo") @map("allocation_strategy") @db.VarChar(20)

  line1      String? @db.VarChar(255)
  line2      String? @db.VarChar(255)
  city       String? @db.VarChar(120)
  region     String? @db.VarChar(120)
  postalCode String? @map("postal_code") @db.VarChar(32)
  country    String? @db.VarChar(2)
  phone      String? @db.VarChar(50)
  latitude   Float?
  longitude  Float?

  // Per-channel default — when a line item lacks an explicit warehouse,
  // the picker resolves through here. Stored as JSONB string[].
  defaultForChannel Json @default("[]") @map("default_for_channel")
  hoursOfOperation  Json @default("[]") @map("hours_of_operation")
  metadata          Json @default("{}")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels             InventoryLevel[]
  movements          InventoryMovement[]
  reservations       InventoryReservation[]
  lotBatches         LotBatch[]
  serialUnits        SerialUnit[]
  sourceLinks        InventorySourceLink[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  counts             InventoryCount[]
  transfersOut       InventoryTransfer[]    @relation("TransferFrom")
  transfersIn        InventoryTransfer[]    @relation("TransferTo")
  defaultForProducts Product[]              @relation("ProductDefaultWarehouse")
  fleetHolds         B2bFleetHold[]

  reconciliationDrifts InventoryReconciliationDrift[]
  oversellIncidents    InventoryOversellIncident[]
  channelBuffers       InventoryChannelBuffer[]

  bins         InventoryBin[]
  binLevels    InventoryBinLevel[]
  binMovements InventoryBinMovement[]

  pickLists      PickList[]
  costLayers     InventoryCostLayer[]
  assemblyOrders AssemblyOrder[]

  // Planning intelligence (docs/146 Phase 7)
  demandVelocity      DemandVelocity[]
  classifications     InventoryClassification[]
  reorderPolicies     ReorderPolicy[]
  cycleCountSchedules CycleCountSchedule[]
  poApprovalRules     PurchaseOrderApprovalRule[]
  supplierReturns     SupplierReturn[]

  // Demand-side commitments (docs/146 Phase 9)
  backorders             Backorder[]
  consignmentSettlements ConsignmentSettlementLine[]

  // Reporting + portability (docs/146 Phase 10)
  importBatches InventoryImportBatch[]

  @@unique([tenantId, code], map: "inventory_warehouses_tenant_code_unique")
  @@index([tenantId, isActive])
  @@map("inventory_warehouses")
}

// (variant, warehouse) snapshot. onHand is authoritative; allocated +
// available are derived (allocated = sum of active hard reservations;
// available = onHand - allocated). reorderPoint / leadTimeDays drive
// the low-stock report + inventory.low events.

model InventoryLevel {
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid

  onHand    Int @default(0) @map("on_hand")
  allocated Int @default(0) @map("allocated")

  // Oversell guard (docs/28 §5.3): units withheld from the SELLABLE `available`
  // (don't expose the last N units online) — a cushion against the lag between a
  // physical change at an external source and the next sync reaching us. Nets into
  // reserve's deny check, the allocator, and `computeAvailability`. 0 = no buffer.
  safetyBuffer Int @default(0) @map("safety_buffer")

  reorderPoint    Int? @map("reorder_point")
  reorderQuantity Int? @map("reorder_quantity")
  leadTimeDays    Int? @map("lead_time_days")

  // unitCostCents = the manually-set / standard cost (input). avgCostCents = the
  // moving-average cost basis recomputed on every costed inbound movement
  // (`new_avg = (onHand·old + qtyIn·costIn) / (onHand + qtyIn)`, docs/100 §2.3).
  // Valuation/margin read avgCostCents, falling back to unitCostCents then
  // ProductVariant.costCents before the first costed receipt.
  unitCostCents Int? @map("unit_cost_cents")
  avgCostCents  Int? @map("avg_cost_cents")

  // ── Planning intelligence, denormalised for reading (docs/146 Phase 7) ──
  //
  // Every one of these is DERIVED and rewritten by the nightly planning sweep;
  // the tables in 59-inventory-planning.prisma hold the inputs that produced
  // them. They live here so a stock list can sort by class, or filter to "less
  // than a fortnight of cover", without joining four tables per row.
  //
  // `dynamicReorderPoint` sits BESIDE `reorderPoint`, never on top of it: the
  // computed suggestion and the operative trigger are different facts, and the
  // sweep only copies one onto the other where the level is explicitly
  // auto-managed (`inventory_reorder_policies.is_auto_managed`).
  abcClass            String?   @map("abc_class") @db.VarChar(1)
  xyzClass            String?   @map("xyz_class") @db.VarChar(1)
  forecastDailyDemand Decimal?  @map("forecast_daily_demand") @db.Decimal(12, 4)
  dynamicReorderPoint Int?      @map("dynamic_reorder_point")
  planningComputedAt  DateTime? @map("planning_computed_at") @db.Timestamptz

  // ── Who owns these units (docs/146 Phase 9.5) ──
  //
  // owned | consignment | customer_owned | 3pl_owned. `owned` is the honest
  // default here, unlike most defaults in this schema: stock you received onto
  // your own shelves under your own purchase order IS yours, and every existing
  // row got there that way. The other three are states a person opts a level
  // into, never states something is silently classified as.
  //
  // The axis is deliberately ORTHOGONAL to availability: consigned stock is
  // sellable — that is the entire point of holding it — while being none of your
  // asset. So valuation filters on this column and availability does not, which
  // is the single behavioural difference the whole feature comes down to.
  //
  // At the LEVEL, not per unit: mixing owned and consigned units of one SKU at
  // one location has no answer to "which one did I just sell", so the model
  // refuses to pretend. A tenant holding both uses a second location or a bin,
  // and gets a real answer instead of a plausible one.
  ownership String @default("owned") @db.VarChar(20)

  /// The tenant's own columns for this stock position (docs/146 Phase 11.8) —
  /// keyed by an `inventory_custom_fields` definition with `entity = 'level'`.
  /// At the LEVEL rather than the item because the facts kept here are
  /// location-specific: the aisle in the old numbering, the customer a position
  /// is earmarked for, the date this shelf was last tidied.
  customFields Json @default("{}") @map("custom_fields")

  /// Whose, when `ownership` is not `owned`. Exactly one is set (a CHECK pins
  /// it), and settlement will not run against a consigned level that names
  /// nobody — there is no such thing as owing money to no one.
  ownerSupplierId String? @map("owner_supplier_id") @db.Uuid
  ownerCustomerId String? @map("owner_customer_id") @db.Uuid

  /// Units on hand here that a customer may NOT buy, because they sit on a shelf
  /// marked unsellable — quarantine, damaged, awaiting repair (docs/146 Phase
  /// 9.7).
  ///
  /// Denormalised from `inventory_bin_levels` and maintained by
  /// `applyBinMovement`, the single writer of bin levels, inside the same
  /// transaction. It exists because without it the quarantine shelf is decor:
  /// `on_hand` counts the whole location, availability subtracts only
  /// `allocated`, and a return routed to quarantine is back on sale the instant
  /// it is booked in. Zero for every location that does not use shelves, which
  /// is exactly right — with no shelves there is nowhere unsellable to be.
  unsellableOnHand Int @default(0) @map("unsellable_on_hand")

  asOf      DateTime @default(now()) @map("as_of") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([variantId, warehouseId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, onHand])
  @@map("inventory_levels")
}

// The movement ledger — the single source of truth for onHand. Every onHand
// change appends exactly one row here via `applyMovement()`, so the level is
// reconcilable to `Σ(delta)` and `balanceAfter` carries the running on-hand at
// the time of the movement. Reason categorizes the source; reference
// (Order, Return, Transfer, etc.) lets the dashboard surface "who touched this
// stock and when". Attribution + idempotency make the funnel safe for the many
// concurrent writers (checkout, manual, MCP/AI, ERP sync, returns) — docs/100 §2.5.

model InventoryMovement {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  delta        Int // signed
  balanceAfter Int?   @map("balance_after") // onHand AFTER this movement (running balance)
  reason       String @db.VarChar(20)
  // ^ sale | return | cancel | recount | loss | damage | transfer_in | transfer_out | receive | reserve | release | manual | sync

  referenceType String? @map("reference_type") @db.VarChar(63)
  referenceId   String? @map("reference_id") @db.Uuid

  // Attribution — every writer is one of these (docs/100 §2.5). actorId holds a
  // user uuid OR an integration/agent identifier (hence VarChar, not Uuid);
  // source names the origin system for integrations (e.g. "fishbowl").
  actorType String  @default("system") @map("actor_type") @db.VarChar(20) // user | ai | system | integration
  actorId   String? @map("actor_id") @db.VarChar(127)
  source    String? @db.VarChar(63)

  // Idempotency — integration retries, redelivered Pub/Sub events
  // (order.cancelled), and double-clicks apply exactly once. Null = not
  // idempotency-guarded (multiple null rows are allowed; nulls are distinct).
  idempotencyKey String? @map("idempotency_key") @db.VarChar(127)

  note          String? @db.Text
  unitCostCents Int?    @map("unit_cost_cents")

  // What the goods on this movement COST, in the tenant's base currency
  // (docs/146 Phase 5.9). Stamped on every movement that takes stock out — a
  // sale, a loss, a damage, a transfer leg — so margin is a subtraction rather
  // than an estimate, and shrinkage is priced at what the units really cost
  // rather than at today's average.
  //
  // SIGNED, and that matters: a reversal (a cancelled order restocking) carries
  // a NEGATIVE cost, because reversing a sale credits the cost of goods sold.
  // Summing the column over a period gives period COGS with no special cases.
  //
  // Null on ordinary inbound movements — a receipt's cost basis is
  // `unitCostCents` above, and stamping the same number twice under two names
  // is how two numbers start to disagree.
  costConsumedCents Int? @map("cost_consumed_cents")

  /// Who owned the units AT THE TIME this movement happened (docs/146 Phase 9.5).
  ///
  /// Stamped from the level's `ownership`, and stamped rather than joined
  /// because ownership CHANGES: a supplier's consignment gets bought outright,
  /// a 3PL contract ends and the stock comes in-house. Reading today's ownership
  /// to classify a sale from three months ago would silently re-write what you
  /// owed that quarter, and a settlement that moves after it was paid is worse
  /// than no settlement at all.
  ///
  /// NULL on every movement written before the axis existed. Null is NOT
  /// `owned` — it means nobody recorded it, and consignment settlement counts
  /// only rows explicitly stamped `consignment`, so an old ledger is silent
  /// rather than wrong.
  ownership String? @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], map: "inventory_movements_tenant_idempotency_unique")
  @@index([tenantId, variantId, createdAt(sort: Desc)])
  @@index([tenantId, warehouseId, createdAt(sort: Desc)])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_movements")
}

// Holds against future fulfillment. Cart reservations have a TTL
// (`expiresAt`) and are released by a cleanup worker; order/subscription
// reservations carry no TTL and are released only on fulfill / cancel.

model InventoryReservation {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  quantity   Int
  holderType String @map("holder_type") @db.VarChar(20) // cart | order | subscription
  holderId   String @map("holder_id") @db.Uuid

  status     String    @default("active") @db.VarChar(20) // active | released | committed | expired
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedAt DateTime? @map("released_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId, status])
  @@index([tenantId, holderType, holderId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}
