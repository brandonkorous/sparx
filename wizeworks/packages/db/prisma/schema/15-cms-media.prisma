// CMS — Media assets + transcoded variants.
//
// Defined now so ContentReference can carry asset edges and Author can link
// an avatar. Transcode worker, signed-URL routes, and focal-point UI all
// land in Phase 3 of the CMS workstream.

model MediaAsset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  // The site this asset belongs to (docs/49 site-scoping; mirrors SocialConnection).
  // A tenant can own more than one unrelated business, and their brand/product media
  // must NOT bleed across sites in the picker. NULL = tenant-wide/shared (a group
  // logo used everywhere, and every asset that predates this column). The library
  // browse scopes to `property_id = <active site> OR property_id IS NULL`; a NEW
  // upload is stamped with the site it was uploaded from. onDelete: SetNull — media
  // is a reusable library asset that may be referenced elsewhere, so deleting a site
  // FREES its media (back to shared), never destroys it.
  propertyId       String?   @map("property_id") @db.Uuid
  // What KIND of thing this asset is, for the picker's automatic groups (docs/49).
  // Stamped at upload from the surface it came from — 'brand' (logo/identity),
  // 'product' (a product image), 'marketing' (social/ads), 'content' (CMS body /
  // author) — so a non-technical owner gets Brand / Product / Marketing groupings
  // with ZERO manual filing. NULL = a plain library upload ("Uploaded"). A soft
  // label for grouping only, never a permission boundary; free-form VarChar so the
  // set can grow without a migration.
  source           String?   @db.VarChar(32)
  key              String    @db.VarChar(1024)
  originalFilename String    @map("original_filename") @db.VarChar(512)
  mimeType         String    @map("mime_type") @db.VarChar(127)
  byteSize         BigInt    @map("byte_size")
  width            Int?
  height           Int?
  durationSec      Float?    @map("duration_sec")
  dominantColor    String?   @map("dominant_color") @db.VarChar(9)
  blurhash         String?   @db.VarChar(128)
  focalPointX      Float     @default(0.5) @map("focal_point_x")
  focalPointY      Float     @default(0.5) @map("focal_point_y")
  altText          String?   @map("alt_text") @db.VarChar(500)
  caption          String?   @db.Text
  status           String    @default("uploading") @db.VarChar(20)
  processingError  String?   @map("processing_error") @db.Text
  usageCount       Int       @default(0) @map("usage_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property        Property?                  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  variants        MediaVariant[]
  refsTo          ContentReference[]
  authorAvatars   Author[]
  collections     MediaAssetCollection[]
  // Receipts + bills attached to a spend row (docs/148 §3). Media is the platform's
  // one upload path, so a receipt is an asset like any other rather than a second
  // file store nobody remembers to back up.
  financeReceipts FinanceExpenseAttachment[]
  // Staff paper (docs/149) — contracts, handbooks, ID, certificates. Same storage
  // as a finance receipt: the media library is the one place files live.
  staffDocuments  StaffDocument[]

  @@index([tenantId, status])
  @@index([tenantId, updatedAt(sort: Desc)])
  // The scoped library browse: tenant + (this site OR shared), newest first.
  @@index([tenantId, propertyId, updatedAt(sort: Desc)])
  @@map("media_assets")
}

// A named, manual collection of media (docs/49) — the "boards" a tenant makes by
// hand ("Spring campaign", "Hero shots"), ON TOP of the automatic source groups. A
// collection belongs to one site (property_id) or is shared tenant-wide (NULL), the
// same scoping as MediaAsset, so it only shows in the right site's picker. tenant_id
// / property_id kept as plain columns (no relation field) — every query filters them
// via RLS + withTenant, and the DB FKs are hand-added in the migration; nothing does
// a relational include through them, so a back-relation on Tenant/Property would be
// dead weight on those already-huge models.
model MediaCollection {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  name       String    @db.VarChar(120)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  items MediaAssetCollection[]

  @@index([tenantId, propertyId, name])
  @@map("media_collections")
}

// The many-to-many between an asset and a collection — an image can live in several
// collections at once (a hero shot is in "Spring campaign" AND "Homepage"), which is
// exactly why collections are a join and not a single folder column. Both sides
// cascade: dropping a collection or an asset removes the membership, never the other.
model MediaAssetCollection {
  tenantId     String   @map("tenant_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz

  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset      MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([collectionId, assetId])
  @@index([tenantId, assetId])
  @@map("media_asset_collections")
}

model MediaVariant {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  assetId  String @map("asset_id") @db.Uuid
  format   String @db.VarChar(20)
  width    Int
  height   Int

  // The social aspect crop this variant is, or NULL for the ordinary
  // scale-to-width ("fit inside", no crop) variant (docs/133 §8). One of the four
  // core crop ratios — '1:1' (feed square) | '4:5' (feed portrait) | '9:16'
  // (story/reel) | '16:9' (landscape) — a focal-point-aware cover crop the media
  // worker derives so a post's image arrives correctly framed on each platform
  // without the tenant cropping it by hand. The composer previews these + exposes
  // the draggable focal point (media_assets.focal_point_x/y); the social-worker
  // picks the crop nearest each target platform's required ratio.
  aspect String? @db.VarChar(12)

  byteSize  BigInt   @map("byte_size")
  key       String   @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // A crop adds `aspect` to the identity so a `1:1` and a `4:5` at the same width
  // coexist. Hand-edited to NULLS NOT DISTINCT in the migration so the ordinary
  // scale-to-width variants (aspect IS NULL) stay uniquely constrained per
  // (asset, format, width) — the plain compound unique treats every NULL as
  // distinct and would let duplicates through.
  @@unique([assetId, format, width, aspect], map: "media_variants_asset_format_width_aspect_unique")
  @@index([tenantId, assetId])
  @@map("media_variants")
}
