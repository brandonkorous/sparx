// A trade buyer's quote request while they are still putting it together
// (sparx persona issue 086).
//
// The /b2b page promised "From the catalog, the buyer builds a request
// (quantities, delivery needs, notes) and submits it. It lands in your
// dashboard, separate from the cart." The only way to ask was one form on the
// Quotes page, typed in one sitting, with nothing about delivery and no PO.
//
// WHY THIS IS NOT A DRAFT QUOTE. A quote is a BillingDocument on the
// `b2b-quotes` workflow, and making one is something the BUSINESS hears about:
// it publishes `crm.billing_document.created` (which automations trigger on),
// mints a Q- number, and lists it in the staff quotes queue. A request the
// buyer has not sent is none of those. So it is kept here, where no staff
// screen reads, and becomes a quote (at Submitted) only when they send it.
//
// One OPEN request per account (a partial unique index in the migration, which
// Prisma cannot express): every contact who can order builds the same one, from
// any device. A sent request stays as `submitted`, pointing at the quote it
// became, so the next "Add to quote request" starts a fresh one.

model B2bQuoteRequest {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  companyId           String  @map("company_id") @db.Uuid
  // open | submitted
  status              String  @default("open") @db.VarChar(20)
  // Who started it. A contact can leave the account and the request stays.
  startedByCustomerId String? @map("started_by_customer_id") @db.Uuid

  // Delivery needs: the day it is needed by, where it goes, and anything else
  // about getting it there. All optional; a buyer may not know yet.
  neededBy      DateTime? @map("needed_by") @db.Date
  deliverTo     String?   @map("deliver_to") @db.Text
  deliveryNotes String?   @map("delivery_notes") @db.Text
  // The buyer's own purchase order number. Carried onto the quote where the
  // quote's PO already lives (`metadata.poNumber`), so it rides onto the order
  // and the invoice.
  poNumber      String?   @map("po_number") @db.VarChar(63)
  notes         String?   @db.Text

  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz
  // The quote it became. No foreign key: a quote is a financial record with its
  // own lifecycle, and this is only the buyer's trail back to it.
  submittedDocumentId String?   @map("submitted_document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startedBy Customer?             @relation(fields: [startedByCustomerId], references: [id], onDelete: SetNull)
  lines     B2bQuoteRequestLine[]

  @@index([tenantId, companyId, status])
  @@map("b2b_quote_requests")
}

model B2bQuoteRequestLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  requestId   String  @map("request_id") @db.Uuid
  // A catalog item, or null for something typed in by hand ("brake pads for a
  // 2018 work truck"). SetNull, not Cascade: if the item leaves the catalog the
  // buyer still asked for it, and the words below still say what.
  variantId   String? @map("variant_id") @db.Uuid
  description String  @db.VarChar(500)
  quantity    Int
  position    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request B2bQuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, requestId])
  @@map("b2b_quote_request_lines")
}
