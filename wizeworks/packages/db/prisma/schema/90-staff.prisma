// Staff — the people who do the work, as first-class records (docs/149).
//
// WHY THIS EXISTS. For most service businesses wages are the largest single expense,
// and job profitability is arithmetically impossible without knowing who worked how
// long at what rate. Finance (docs/148) ships a "Wages" line you type in by hand;
// this module is what turns it into a derived number. Building the two apart is how
// you ship a profit figure that is confidently wrong by forty percent.
//
// WHAT THIS IS NOT, permanently: an HR compliance system. No payroll runs, no tax
// withholding, no W-2 or 1099 filing, no benefits administration, no ACA/EEO
// reporting, no background checks. Same boundary and the same reasoning as
// 89-finance.prisma — payroll means becoming a tax filer in fifty states, and the
// incumbents in that category already hold the trust it takes a decade to earn.
// sparx records HOURS and RATES; whoever runs payroll gets an export.
//
// THE FRAMING THAT MADE THIS SMALL. The person already exists in this database three
// times and nothing says they are one human:
//
//   • `Member`             (03-auth-org)  — who can log in, and what they can reach
//   • `SchedulingResource` (78-scheduling, kind='staff') — who is bookable, and when
//   • CRM ownership        — deal owner, ticket assignee, task assignee: bare uuids
//
// So this module is not "add HR", it is MAKE THE PERSON THE RECORD THOSE THREE ALREADY
// POINT AT. `StaffMember` LINKS to them and absorbs neither: Member keeps owning login
// and access, SchedulingResource keeps owning bookability. Both links are FK-LESS plain
// uuids on purpose — a hard FK would couple a standalone staff tenant to auth internals
// and to a scheduling module it never bought. Same reasoning as FinanceVendor's links
// out to Supplier and Company.
//
// A STAFF MEMBER DOES NOT REQUIRE A LOGIN. The shop-floor tech who never opens the
// workbench still has hours, a rate and certifications — and is very often exactly the
// person whose labour cost matters most. Gating the record on a `Member` row would
// exclude them.
//
// THE ONE TRAP THAT SILENTLY REWRITES HISTORY: a pay rate stored as a column on the
// person. The day someone gets a raise, the cost of every job they have ever worked
// changes, and last quarter's profit moves for a reason that has nothing to do with
// last quarter. So the rate is a ROW with a validity window (`StaffPayRate`), and the
// labour deriver reads the rate that was in force on the day worked. This is a locked
// decision, a CHECK, and a test — not a code-review note.
//
// Site scope follows docs/131 §4: someone can work for both of an owner's businesses,
// so the link is a join (`StaffMemberSite`) rather than a column, and their cost lands
// against the site whose job they worked.
//
// All tables are tenant-scoped with FORCE RLS + the canonical `tenant_isolation`
// policy. Owned by @wizeworks/staff; the labour deriver runs in the finance-worker.

// ─────────────────────────────────────────────────────────────────────────────
// 1. The person
// ─────────────────────────────────────────────────────────────────────────────

model StaffMember {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  firstName String  @map("first_name") @db.VarChar(120)
  // Optional because plenty of people go by one name, and a required surname is a
  // small cruelty that shows up on the roster of exactly the businesses this is for.
  lastName  String? @map("last_name") @db.VarChar(120)

  // Where certification reminders go. Not unique: a couple who run a shop together,
  // or a family business, legitimately share one address.
  email String? @db.VarChar(255)
  phone String? @db.VarChar(40)

  jobTitle String? @map("job_title") @db.VarChar(120)

  // employee | contractor | volunteer. CHECK-constrained.
  //
  // This is a COST-REPORTING distinction, never an employment-law determination.
  // sparx does not decide whether someone is a contractor, does not file anything on
  // the answer, and must never present this field as though it did.
  employmentType String @default("employee") @map("employment_type") @db.VarChar(20)

  // active | onboarding | suspended | former. CHECK-constrained. `former` is the
  // end state rather than a delete: their hours are in last year's profit figure and
  // deleting the person would leave that number unexplainable.
  status String @default("active") @db.VarChar(20)

  startedOn DateTime? @map("started_on") @db.Date
  endedOn   DateTime? @map("ended_on") @db.Date

  // The three links out, all optional, all FK-LESS (see the header). Resolved by the
  // service layer only when those modules are on.
  //
  //   userId     → users.id            the login, if they have one
  //   resourceId → scheduling_resources.id   the bookable resource, if scheduling is on
  userId     String? @map("user_id") @db.Uuid
  resourceId String? @map("resource_id") @db.Uuid

  // Their id in whatever actually runs payroll, carried so the hours export lands
  // against the right person without a human matching names in a spreadsheet.
  externalPayrollId String? @map("external_payroll_id") @db.VarChar(120)

  // Chip color on the schedule. Null = assigned from the palette on first render, so
  // a tenant who never opens settings still gets a legible week.
  color    String? @db.VarChar(7)
  photoUrl String? @map("photo_url") @db.Text

  notes String? @db.Text

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteLinks        StaffMemberSite[]
  payRates         StaffPayRate[]
  timeEntries      StaffTimeEntry[]
  shifts           StaffShift[]
  timeOffRequests  StaffTimeOffRequest[]
  certifications   StaffCertification[]
  documents        StaffDocument[]
  commissions      StaffCommission[]
  saleAttributions StaffSaleAttribution[]

  // One staff record per login, and per bookable resource. Without these, "add
  // person" run twice produces two Sarahs whose hours both derive into the ledger.
  //
  // Plain uniques, NOT nulls-not-distinct — and that is the whole reason they work
  // here. Most staff have neither link, so both columns are usually NULL, and under
  // Postgres' default semantics NULL is distinct from NULL: any number of unlinked
  // people coexist while a second record claiming the same login is rejected. Add
  // NULLS NOT DISTINCT to either of these and a tenant can have exactly one staff
  // member without a login.
  @@unique([tenantId, userId], map: "staff_members_tenant_user_unique")
  @@unique([tenantId, resourceId], map: "staff_members_tenant_resource_unique")
  @@index([tenantId, status, lastName])
  @@index([tenantId, archivedAt])
  @@map("staff_members")
}

// Which of the owner's businesses this person works for (docs/131 §4). A join rather
// than a column because working both is the normal case for a small operator, and a
// column would force a duplicate person record to express it.

model StaffMemberSite {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  staffMemberId String @map("staff_member_id") @db.Uuid
  propertyId    String @map("property_id") @db.Uuid

  // Where their cost lands when a time entry names no site of its own.
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, propertyId], map: "staff_member_sites_member_property_unique")
  @@index([tenantId, propertyId])
  @@map("staff_member_sites")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. What they cost — effective-dated, because history must not move
// ─────────────────────────────────────────────────────────────────────────────

model StaffPayRate {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  staffMemberId String @map("staff_member_id") @db.Uuid

  // hourly | salary | commission | none. CHECK-constrained.
  //
  // `none` is a real answer, not a missing one: a volunteer, an owner who does not
  // pay themselves a wage, a family member helping out. It means their hours cost
  // zero and the deriver skips them — which is different from "nobody has told us
  // what they earn", where the honest thing is to derive nothing at all and say so.
  basis String @default("hourly") @db.VarChar(20)

  // Cents. Per hour under `hourly`; per YEAR under `salary` (amortised across the
  // period by the deriver). Zero under `none`, and CHECK-constrained to zero there so
  // a rate cannot be quietly left on a basis that ignores it.
  amountCents Int    @map("amount_cents")
  currency    String @default("USD") @db.VarChar(3)

  // Employer cost ON TOP of the wage, as a percentage — the employer's share of
  // payroll taxes, workers' comp, insurance. It is a MULTIPLIER FOR THE OWNER'S OWN
  // COST REPORTING and nothing else: sparx never calculates a withholding, never
  // files, and never tells anyone what they owe. It is here because a labour figure
  // that ignores burden runs systematically 15–30% light, which is exactly the
  // "confidently wrong" failure this module exists to prevent.
  burdenPercent Decimal @default(0) @map("burden_percent") @db.Decimal(5, 2)

  // The percentage of a sale earned under `basis = 'commission'`, and zero under
  // every other basis (CHECK-constrained, the same way `amountCents` is pinned to
  // zero under `none`).
  //
  // It exists because `amountCents` could not express it: that field is per-hour
  // under `hourly` and per-YEAR under `salary`, so `commission` was a basis the
  // rate model could name but not describe. The commission SERVICE shipped before
  // this column did, which is why nothing calculated one — there was no rate to
  // calculate from.
  //
  // Decimal(6,3), so 7.5% is `7.500` and a third of a percent is expressible.
  // The arithmetic still goes through `commissionCents`, which converts to basis
  // points and rounds once — never a float multiply against money.
  commissionPercent Decimal @default(0) @map("commission_percent") @db.Decimal(6, 3)

  // The validity window. `effectiveTo` null = the rate in force today. The service
  // closes the previous row when a new one opens; overlapping windows for one person
  // are rejected there, because expressing that as a constraint needs an exclusion
  // index over a range type and the readability cost is not worth it.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, effectiveFrom], map: "staff_pay_rates_member_effective_from_unique")
  @@index([tenantId, staffMemberId, effectiveFrom])
  @@map("staff_pay_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Time — what actually happened
// ─────────────────────────────────────────────────────────────────────────────

// A TIME ENTRY IS NOT A SHIFT AND NOT A BOOKING. A booking is a customer's
// appointment; a shift is when someone is rostered; a time entry is what they
// actually worked. Collapsing any two of the three is how "scheduled hours" and
// "paid hours" become one wrong number, and it is the single most common way a
// scheduling product produces a labour cost nobody trusts.

model StaffTimeEntry {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  staffMemberId String  @map("staff_member_id") @db.Uuid
  // Which business the work was for. Null falls back to the person's primary site
  // at derivation time, and if they have none it lands in the unattributed bucket —
  // never silently on whichever site happens to be first.
  propertyId    String? @map("property_id") @db.Uuid

  // THE DAY THE WORK BELONGS TO, and what the deriver buckets on. Separate from
  // `startedAt` for the same reason finance separates `incurred_at` from `paid_at`:
  // a night shift that ends at 02:10 belongs to the day it started, and a duration
  // typed in on Friday for Tuesday's work belongs to Tuesday.
  workedOn DateTime @map("worked_on") @db.Date

  // Set by clock in/out. Null on a hand-entered duration, which is a legitimate and
  // common way to log time — a tech who writes "3.5h on the Ellison job" in the van.
  startedAt DateTime? @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  // The authoritative worked duration, NET of the break. Computed on clock-out,
  // typed directly otherwise. Zero while a clock is still running — an open entry
  // has no duration yet, and guessing one from `now()` would make the number move
  // every time the page refreshed.
  minutes      Int @default(0)
  breakMinutes Int @default(0) @map("break_minutes")

  // The job this time was for, if any. Same target vocabulary as a finance
  // allocation, so approved time can write straight through to one:
  // order | booking. CHECK-constrained, FK-less (commerce and scheduling are both
  // optional modules).
  jobType String? @map("job_type") @db.VarChar(20)
  jobId   String? @map("job_id") @db.Uuid

  // clock | manual | import. CHECK-constrained.
  source String @default("manual") @db.VarChar(20)

  // open | submitted | approved | rejected. CHECK-constrained.
  //
  // APPROVAL IS WHAT RELEASES THE LABOUR DERIVER, deliberately. A timesheet that
  // derives into the profit figure the moment someone clocks out means every
  // mistyped shift moves the month's numbers before anyone has looked at it.
  status String @default("open") @db.VarChar(20)

  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  approvedBy String?   @map("approved_by") @db.Uuid

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId, staffMemberId, workedOn])
  @@index([tenantId, status, workedOn])
  @@index([tenantId, workedOn])
  @@index([tenantId, jobType, jobId], map: "staff_time_entries_tenant_job_idx")
  @@map("staff_time_entries")
}

// Rostered time. Nobody is paid for a shift — they are paid for the time entry that
// happened during it — so this table never reaches the ledger.

model StaffShift {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  staffMemberId String  @map("staff_member_id") @db.Uuid
  propertyId    String? @map("property_id") @db.Uuid

  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt   DateTime @map("ends_at") @db.Timestamptz

  // "Open", "Close", "Bay 2", "Front counter" — the owner's word for the slot.
  label String? @db.VarChar(120)

  // draft | published | cancelled. CHECK-constrained. `draft` exists so a manager can
  // build next week without the team seeing a half-finished rota.
  status String @default("draft") @db.VarChar(20)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, staffMemberId, startsAt])
  @@map("staff_shifts")
}

model StaffTimeOffRequest {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  staffMemberId String @map("staff_member_id") @db.Uuid

  // vacation | sick | unpaid | other. CHECK-constrained. Deliberately short: a longer
  // list is an HR taxonomy, and this module is not one.
  kind String @default("vacation") @db.VarChar(20)

  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt   DateTime @map("ends_at") @db.Timestamptz
  allDay   Boolean  @default(true) @map("all_day")

  reason String? @db.Text

  // requested | approved | denied | cancelled. CHECK-constrained.
  status String @default("requested") @db.VarChar(20)

  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  decidedBy    String?   @map("decided_by") @db.Uuid
  decisionNote String?   @map("decision_note") @db.Text

  // The `AvailabilityException` approval wrote, so a later cancellation can take it
  // back rather than leaving the person permanently unbookable. FK-less: scheduling
  // is optional, and with it off approval simply records the decision.
  availabilityExceptionId String? @map("availability_exception_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, startsAt])
  // Mapped: Prisma's generated name for this triple is exactly 63 characters —
  // Postgres' identifier limit — so it is both unreadable and one rename away
  // from being silently truncated. Same reasoning as the finance allocation
  // index. The `map` has to be here or `migrate diff` reports permanent drift
  // against the shorter name the migration actually created.
  @@index([tenantId, staffMemberId, startsAt], map: "staff_time_off_requests_tenant_member_starts_at_idx")
  @@map("staff_time_off_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Paper — the two kinds that actually matter to a small operator
// ─────────────────────────────────────────────────────────────────────────────

// The surface that earns this module for a regulated trade: a licence that lapsed is
// a van that cannot leave the yard, and nobody finds out from a spreadsheet.

model StaffCertification {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  staffMemberId String @map("staff_member_id") @db.Uuid

  name            String  @db.VarChar(200)
  issuer          String? @db.VarChar(200)
  referenceNumber String? @map("reference_number") @db.VarChar(120)

  issuedOn  DateTime? @map("issued_on") @db.Date
  // Null is a real answer — a qualification that does not expire. It must NOT render
  // as "expiring today" or sort to the top of the warning list.
  expiresOn DateTime? @map("expires_on") @db.Date

  // How far ahead to warn. Per-certification because a licence you renew by post
  // needs more notice than one you book online.
  reminderLeadDays Int @default(30) @map("reminder_lead_days")

  // Stamped when the expiry reminder went out, so the worker sends once per window
  // rather than every night for thirty nights.
  lastRemindedAt DateTime? @map("last_reminded_at") @db.Timestamptz

  documentId String? @map("document_id") @db.Uuid

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  document    StaffDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, expiresOn])
  @@index([tenantId, staffMemberId])
  @@map("staff_certifications")
}

model StaffDocument {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  staffMemberId String @map("staff_member_id") @db.Uuid
  assetId       String @map("asset_id") @db.Uuid

  // contract | handbook | id | certification | other. CHECK-constrained.
  kind  String @default("other") @db.VarChar(20)
  title String @db.VarChar(200)

  // When they signed it. This is a RECORD that a signature happened, not a signing
  // workflow — that lives in the document-workflow module and is a different product.
  signedAt  DateTime? @map("signed_at") @db.Timestamptz
  expiresOn DateTime? @map("expires_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember    StaffMember          @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  asset          MediaAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  certifications StaffCertification[]

  @@index([tenantId, staffMemberId])
  @@map("staff_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Commission — the partner ledger's shape, for the people on the payroll
// ─────────────────────────────────────────────────────────────────────────────

// `PartnerCommission` has existed since the partner programme shipped; there has never
// been an equivalent for the staff who actually do the work. This is that, with the
// same lifecycle so the two read alike.

model StaffCommission {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  staffMemberId String  @map("staff_member_id") @db.Uuid
  propertyId    String? @map("property_id") @db.Uuid

  // order | deal. CHECK-constrained, FK-less — commerce and crm are both optional.
  sourceType  String  @map("source_type") @db.VarChar(20)
  sourceId    String  @map("source_id") @db.Uuid
  // What it was called when it was earned, so the row still reads after a delete.
  sourceLabel String? @map("source_label") @db.VarChar(200)

  // What the percentage was taken OF, kept alongside the result so a commission can
  // be checked without re-deriving the sale it came from.
  basisCents  Int      @map("basis_cents")
  ratePercent Decimal? @map("rate_percent") @db.Decimal(6, 3)
  amountCents Int      @map("amount_cents")
  currency    String   @default("USD") @db.VarChar(3)

  earnedOn DateTime @map("earned_on") @db.Date

  // pending | approved | paid | void. CHECK-constrained.
  status String    @default("pending") @db.VarChar(20)
  paidAt DateTime? @map("paid_at") @db.Timestamptz

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // One commission per person per sale. This is what makes a re-run of whatever
  // calculates commission update the row instead of paying someone twice.
  @@unique([tenantId, staffMemberId, sourceType, sourceId], map: "staff_commissions_tenant_member_source_unique")
  @@index([tenantId, status, earnedOn])
  @@index([tenantId, staffMemberId, earnedOn])
  @@map("staff_commissions")
}

// WHO SOLD IT.
//
// Commission needs an answer to "whose sale was this", and the platform only had
// half of one: a `Deal` carries `assignedRepId`, and an `Order` carries NOTHING —
// no rep, no salesperson, no attribution of any kind. So orders could never earn
// anybody a commission, whatever the rate said.
//
// This lives on the STAFF side rather than as a column on `orders`, for the same
// reason as locked decision #2: StaffMember LINKS to the records that already
// exist, it does not absorb them. A staff-side join means turning the module off
// leaves commerce and CRM untouched, and it gives orders and deals one shape
// instead of two code paths.
//
// It also serves as an OVERRIDE for deals: when a row exists here it wins over
// `assignedRepId`, because the rep who owns a deal in the pipeline is not always
// the person who should be paid for closing it.
model StaffSaleAttribution {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  staffMemberId String  @map("staff_member_id") @db.Uuid
  propertyId    String? @map("property_id") @db.Uuid

  // order | deal. CHECK-constrained and FK-less — commerce and crm are both
  // optional modules, exactly as on StaffCommission.
  sourceType String @map("source_type") @db.VarChar(20)
  sourceId   String @map("source_id") @db.Uuid

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // ONE seller per sale, deliberately. Split commissions between two people are a
  // real arrangement and a real design — they need a share per row, a rule for
  // what happens when the shares do not total 100%, and a UI that can express
  // both. Modelling that as "several attribution rows" by accident, with no share
  // column, would silently pay each of them the FULL commission.
  @@unique([tenantId, sourceType, sourceId], map: "staff_sale_attributions_tenant_source_unique")
  // `map:` because the migration names it — without it Prisma expects its own
  // default (`..._tenant_id_staff_member_id_idx`) and reports permanent drift.
  @@index([tenantId, staffMemberId], map: "staff_sale_attributions_tenant_member_idx")
  @@map("staff_sale_attributions")
}
