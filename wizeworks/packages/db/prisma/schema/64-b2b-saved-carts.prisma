// Named saved carts for a trade account (sparx persona issue 086).
//
// The /b2b page promised "Accounts keep named saved carts", and nothing kept
// one. A saved cart is a NAMED LIST of what to buy, kept for the ACCOUNT (any of
// its contacts who can place orders sees it), never a second live cart: the
// cart pipeline finds a shopper's open cart by customer, and a saved list held
// in that table would be picked up as one. No prices are kept. Loading it into
// the cart prices every line again, so the buyer pays today's account price,
// not the price on the day the list was saved.

model B2bSavedCart {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  companyId           String  @map("company_id") @db.Uuid
  name                String  @db.VarChar(120)
  // Who saved it, for "Saved by Renée". A contact can leave the account and
  // the list stays.
  createdByCustomerId String? @map("created_by_customer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy Customer?          @relation(fields: [createdByCustomerId], references: [id], onDelete: SetNull)
  items     B2bSavedCartItem[]

  @@index([tenantId, companyId, updatedAt(sort: Desc)])
  @@map("b2b_saved_carts")
}

model B2bSavedCartItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  savedCartId String @map("saved_cart_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  quantity    Int
  position    Int    @default(0)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedCart B2bSavedCart   @relation(fields: [savedCartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([savedCartId, variantId])
  @@index([tenantId, savedCartId])
  @@map("b2b_saved_cart_items")
}
