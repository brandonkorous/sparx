// Commerce — Checkout sessions. Multi-step state machine driving cart →
// order. The session captures the chosen provider refs (payment intent,
// shipping rate, tax breakdown) so the flow is idempotent across page
// reloads.

model CheckoutSession {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  cartId   String @map("cart_id") @db.Uuid

  step String @default("cart_review") @db.VarChar(20)
  // ^ cart_review | contact | shipping | payment | review | completed | expired

  channel  String @db.VarChar(20)
  currency String @db.VarChar(3)

  customerId       String? @map("customer_id") @db.Uuid
  companyId        String? @map("company_id") @db.Uuid
  customerEmail    String? @map("customer_email") @db.VarChar(255)
  customerPhone    String? @map("customer_phone") @db.VarChar(50)
  // Who is buying. Asked for on the CONTACT step, because it is the one thing
  // every order needs however it leaves. It used to arrive only inside
  // `shippingAddress`, which is why a customer collecting a bun over a counter
  // had to type a postal address to tell a bakery their name (issue 064).
  // Nullable: "nobody typed one" is a real state, and an empty string here
  // would read as a person who declined to say.
  customerName     String? @map("customer_name") @db.VarChar(255)
  acceptsMarketing Boolean @default(false) @map("accepts_marketing")

  // What the buyer wants the shop to know about THIS order: "leave it with the
  // neighbor", "it is a gift, no receipt", "collecting Saturday not Friday".
  // Copied onto `Order.customerNote` at complete(), which the console has always
  // printed under "From the customer" and which nothing could ever write: 0 of
  // 122 orders carried one (issue 874).
  //
  // IT LIVES ON THE SESSION, NOT IN THE PAGE. A hosted-redirect gateway sends the
  // shopper away from the tab (`window.location.href = intent.redirectUrl`), so
  // anything still in React state is gone by the time the order is written. A box
  // that asks "anything we should know?" and then silently drops the answer for
  // some shops' gateways is worse than no box.
  // [[feedback_a_promise_in_copy_is_a_contract]]
  customerNote String? @map("customer_note") @db.Text

  // Address snapshots persisted on the session so the storefront can
  // replay them between steps without re-fetching from CustomerAddress.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  // Provider refs captured at each step.
  shippingProviderSlug String? @map("shipping_provider_slug") @db.VarChar(63)
  shippingRateRef      String? @map("shipping_rate_ref") @db.VarChar(255)
  shippingDescription  String? @map("shipping_description") @db.VarChar(255)
  paymentProviderSlug  String? @map("payment_provider_slug") @db.VarChar(63)
  paymentRef           String? @map("payment_ref") @db.VarChar(255)
  taxProviderSlug      String? @map("tax_provider_slug") @db.VarChar(63)
  taxBreakdownRef      String? @map("tax_breakdown_ref") @db.VarChar(255)
  taxBreakdown         Json?   @map("tax_breakdown")

  // B2B-only inputs surfaced during net-terms checkout.
  poNumber              String? @map("po_number") @db.VarChar(63)
  paymentTermsRequested String? @map("payment_terms_requested") @db.VarChar(20)

  // Cached totals at session-completion time. After complete() runs,
  // these mirror the Order's totals so refund flows can find the
  // numbers without joining back to CRM.
  subtotalCents             Int @default(0) @map("subtotal_cents")
  discountTotalCents        Int @default(0) @map("discount_total_cents")
  shippingTotalCents        Int @default(0) @map("shipping_total_cents")
  taxTotalCents             Int @default(0) @map("tax_total_cents")
  giftCardAppliedCents      Int @default(0) @map("gift_card_applied_cents")
  accountCreditAppliedCents Int @default(0) @map("account_credit_applied_cents")
  // Document-level surcharge (docs/48 §6), computed at complete() after tax and
  // folded into totalCents. Cached here so refund/serialization paths read it.
  surchargeTotalCents       Int @default(0) @map("surcharge_total_cents")
  totalCents                Int @default(0) @map("total_cents")

  // Idempotency on complete(). The same key always resolves to the same
  // resulting orderId, even on retry.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(127)
  resultOrderId  String? @map("result_order_id") @db.Uuid

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey], map: "checkout_sessions_idempotency_unique")
  @@index([tenantId, cartId])
  @@index([tenantId, customerId])
  @@index([tenantId, step])
  @@index([tenantId, expiresAt])
  @@map("commerce_checkout_sessions")
}
