# services/social-worker local dev defaults (docs/133). Copy to `.env`.
#
# Real values for sparx-prod come from the Cloud Run service's env + Secret Manager
# bindings (terraform/envs/prod/serverless.tf), NOT from this file.

NODE_ENV=development
LOG_LEVEL=debug

# Every worker binds a DISTINCT local port — Cloud Run injects PORT in prod, but
# locally `pnpm dev` runs the whole fleet at once, so a shared default silently
# collides (the loser dies with EADDRINUSE and takes the turbo run down with it).
# 8080-8091 are taken by the other workers; social-worker owns 8092. Keep this in
# sync with scripts/kill-dev-ports.mjs.
PORT=8092

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# AES-256-GCM key (32 bytes, base64 or hex) decrypting the stored social OAuth
# grants. MUST match SOCIAL_TOKEN_KEY in wizeworks/services/api-rest/.env — api-rest encrypts
# the grant on connect and this worker decrypts it on publish, so a mismatch means
# every publish fails to decrypt. Unset → the worker acks each job as a no-op.
# SOCIAL_TOKEN_KEY=

# Set → result events (social.post.published/failed) publish to Pub/Sub.
# Unset → the logging (no-op) publisher, which is the local default.
# GCP_PROJECT_ID=

# Public origin serving processed media variants — a platform fetches a post's
# image from `${base}/v1/public/media/variants/{key}`. Unset → posts publish
# text-only (media skipped, logged). Locally this is the api-rest origin.
# MEDIA_PUBLIC_BASE_URL=http://localhost:3100
