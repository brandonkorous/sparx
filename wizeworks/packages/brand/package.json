{
  "name": "@wizeworks/brand",
  "version": "0.0.0",
  "private": true,
  "description": "The WizeWorks brand expressed as a silicaui theme — the operator-facing identity (pine, brass, clay on warm neutrals) that the staff console wears. WizeWorks is the company that runs sparx and Piggles, so this is neither of their palettes and must not drift toward either.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
