{
  "name": "@wizeworks/social",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Social — the SocialAdapter contract, adapter registry, per-platform constraints + one-post→N-platforms renderer, and the AES-256-GCM token box for social-posting OAuth grants (docs/133).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cadence": {
      "types": "./src/cadence.ts",
      "default": "./src/cadence.ts"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./src/crypto.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@wizeworks/api-core": "workspace:*",
    "@wizeworks/brand-core": "workspace:*",
    "@wizeworks/db": "workspace:*",
    "@wizeworks/integrations": "workspace:*",
    "zod": "^4.4.3"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
