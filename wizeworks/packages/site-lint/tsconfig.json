{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // `routes.test.ts` reads wizeworks/apps/site's real route files, so this one package needs
    // node's own types. The base config leaves `types` unset, and with TypeScript 6 an
    // unset `types` does NOT auto-include @types/node here — a bare `import 'node:fs'`
    // fails with "add 'node' to the types field in your tsconfig", which is what this
    // is. The engine itself does no I/O; only the drift guard does.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
