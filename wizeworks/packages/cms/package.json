{
  "name": "@wizeworks/cms",
  "version": "0.0.0",
  "private": true,
  "description": "sparx CMS service layer (docs/12) — content-type resolution + body validation, the entry serializer, and the shared revision/reference write path. Sibling of @wizeworks/cms-schemas (the field schemas); consumed by api-rest, api-graphql, and the CMS MCP tools.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wizeworks/api-core": "workspace:*",
    "@wizeworks/cms-schemas": "workspace:*",
    "@wizeworks/db": "workspace:*",
    "@wizeworks/events": "workspace:*",
    "@wizeworks/legal-templates": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
