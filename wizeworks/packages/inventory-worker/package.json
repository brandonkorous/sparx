{
  "name": "@wizeworks/inventory-worker",
  "version": "0.0.0",
  "private": true,
  "description": "sparx inventory sync worker. Handles inventory source sync (CSV + API) via Pub/Sub push (Cloud Run). docs/64 Inv Ph2.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests",
    "test:watch": "vitest --maxWorkers=1",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@wizeworks/commerce-schemas": "workspace:*",
    "@wizeworks/db": "workspace:*",
    "@wizeworks/events": "workspace:*",
    "@wizeworks/inventory": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
