{
  "name": "@wizeworks/automation-actions",
  "version": "0.0.0",
  "private": true,
  "description": "Module action executors for the automation engine (docs/81 §5.4, docs/84 Slice F). Registers crm.* / email.* / commerce.* / b2b.* effect executors through @wizeworks/automation's registerAction seam — each CALLS the existing module service (never re-implements domain logic), so events, audit, and the two-bus delivery happen exactly once at the source.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@wizeworks/automation": "workspace:*",
    "@wizeworks/automation-schemas": "workspace:*",
    "@wizeworks/builder-schemas": "workspace:*",
    "@wizeworks/crm": "workspace:*",
    "@wizeworks/email-sends": "workspace:*",
    "@wizeworks/email-sequences": "workspace:*",
    "@wizeworks/events": "workspace:*",
    "@wizeworks/inventory": "workspace:*",
    "@wizeworks/sms": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@wizeworks/db": "workspace:*",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
