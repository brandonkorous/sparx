# WizeWorks operator console (wizeworks/apps/admin) — local dev defaults.
# See docs/apps/admin/build-plan.md. In prod these come from the wize-admin-env
# ConfigMap + wize-admin-secrets Secret (synced by bootstrap.yml components=wize-admin).

# The operator Better Auth instance's DB handle — the `wize_operator` role, scoped
# to the `wize_admin` schema. Local docker Postgres (`pnpm --filter @wizeworks/db db:up`);
# the role + schema come from docker/init/01-roles.sql + the wize_admin migration.
OPERATOR_DATABASE_URL="postgresql://wize_operator:devpassword@localhost:5544/sparx?schema=wize_admin"

# The operator Better Auth secret. DISTINCT from the tenant BETTER_AUTH_SECRET
# (D3). Any long random string in dev; a real secret in prod (the app fails loud
# at boot if this is unset in production).
OPERATOR_AUTH_SECRET="dev-operator-secret-change-me-000000000000"

# Canonical origin — Better Auth derives cookie scope + absolute URLs from it.
# Admin dev server runs on port 3002.
OPERATOR_AUTH_URL="http://localhost:3002"

# api-rest origin for the /internal/operator/* seam + the shared Layer-5 token.
# The SAME token value must be set for api-rest (SPARX_INTERNAL_OPERATOR_TOKEN,
# min 16 chars) or the whoami round-trip 401s. In prod both read one Secret
# Manager value (sparx-internal-operator-token).
SPARX_API_REST_URL="http://localhost:3100"
SPARX_INTERNAL_OPERATOR_TOKEN="dev-operator-internal-token-change-me"

# Seed operator #1 (D10). After boot, POST /api/operator/bootstrap once with the
# token above (X-sparx-Internal-Operator-Token header) to provision this operator.
OPERATOR_SEED_EMAIL="brandon@wize.works"
OPERATOR_SEED_NAME="Brandon Korous"
OPERATOR_BOOTSTRAP_PASSWORD="change-me-at-least-12-chars"

# Pub/Sub project for the operator set-password email.send. Unset → @wizeworks/events
# logs the payload (incl. the reset URL) to stdout, which is the dev path.
# GCP_PROJECT_ID=sparxworks
# Platform tenant id for the operator email render context (optional in dev).
# OPERATOR_EMAIL_TENANT_ID=
