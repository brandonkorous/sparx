# Sparx Storefront (wizeworks/apps/site) — local dev environment.
#
# Copy to .env.local to run `pnpm --filter @wizeworks/site dev`. The storefront is
# SSR-only against api-rest (no direct DB); browser calls go through the
# same-origin /api/sparx proxy (app/api/sparx/[...path]/route.ts).

# api-rest origin the proxy + server components forward to. Defaults to
# http://localhost:3100 when unset (matches wizeworks/services/api-rest PORT).
SPARX_API_REST_URL="http://localhost:3100"

# Public api-rest base for browser-loaded assets — media variant <img src> and
# the analytics beacon. In dev point at the api-rest origin; in prod this is the
# CDN/public host. Defaults are app-specific, so set it for media/analytics.
NEXT_PUBLIC_API_URL="http://localhost:3100"

# Stripe.js publishable key (pk_test_... locally). REQUIRED for checkout +
# booking-deposit payment steps — Stripe Elements silently won't mount without
# it, so card entry never appears. This is sparx's PLATFORM publishable key (the
# same sandbox account that runs sparx Pay's Connect destination charges); the
# clientSecret each payment uses still comes from api-rest. Public by design
# (NEXT_PUBLIC_, baked into the client bundle) — never put a secret key here.
# IN PRODUCTION this is a BUILD-ARG, not a pod env var: the value is inlined into
# the client bundle at build time, so it comes from the GitHub repo VARIABLE
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY → build-images-gcp.yml → wizeworks/apps/site/Dockerfile.
# Setting it on the Deployment does nothing.
# A tenant on "Your own Stripe" (stripe_direct) needs THEIR publishable key instead;
# that one is captured per-tenant in Settings → Payments and rides back on each
# payment-intent response, so it never appears here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Apex zone for *.sparx.zone tenant subdomain resolution. Defaults to sparx.zone.
# SPARX_ZONE_DOMAIN="sparx.zone"

# Shared secret for on-demand ISR revalidation (POST /api/revalidate). Optional
# in dev; must match the value api-rest signs revalidation calls with in prod.
# SPARX_REVALIDATE_SECRET="dev-revalidate-secret"

# -- Which platform the footer credit badge names ---------------------------
#
# This renderer serves the public sites of EVERY brand from one process, so the
# badge resolves per tenant from tenants.platform_brand through
# @wizeworks/brand-core. None of it was configured locally, which meant the badge
# on a Piggles tenant site fell back to the brand KEY: a lowercase "piggles", in
# white, with no mark. Mirrors k8s/azure/infra/app-env-configmap.env.
SPARX_BRAND_NAME=sparx
SPARX_BRAND_URL=https://sparx.works
# Quoted because the value starts with '#', which an unquoted .env line reads as
# a comment -- the accent then arrives EMPTY and the badge paints its brand spot
# in plain white. (The k8s ConfigMap is not dotenv-parsed, so it needs no quotes
# and has none; this is the one place the two files legitimately differ.)
SPARX_BRAND_ACCENT="#e04631"
SPARX_BRAND_ACCENT_CHARS=1
SPARX_CREDIT_URL=https://sparx.works/?utm_source=powered_by&utm_medium=site_badge&utm_campaign=made_with_sparx

PIGGLES_BRAND_NAME=Piggles
PIGGLES_BRAND_URL=https://meetpiggles.com
PIGGLES_BRAND_ACCENT="#FF6F86"
PIGGLES_BRAND_ACCENT_CHARS=0
PIGGLES_CREDIT_URL=https://meetpiggles.com/?utm_source=powered_by&utm_medium=site_badge&utm_campaign=made_with_piggles

# The drawn wordmark. The pink dot over the "i" is the only painted shape in it,
# and it is the reason this is geometry and not a name set in bold type.
# Serialised from piggles/packages/brand/src/marks.ts -- DO NOT hand-edit; run
# `pnpm check:brand-wordmark --update` and copy the ConfigMap value.
