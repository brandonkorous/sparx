{
  "name": "@sparx/inventory",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Inventory — supply-domain service layer (warehouses, stock levels + movement ledger, reservations, lots/serials, low-stock). Owns all stock; Commerce/B2B/Dropship are consumers. Extracted from @sparx/commerce (docs/100).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sparx/commerce-schemas": "workspace:*",
    "@sparx/db": "workspace:*",
    "@sparx/events": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
