# automation-worker — local/dev configuration.
# Connects as sparx_app; the engine's cross-tenant discovery uses SECURITY
# DEFINER helpers, so NO owner/migration URL is needed here.

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# sparx_app (FORCE RLS-bound) connection — same role the app tier uses.
DATABASE_URL=postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public

# Unset locally → engine publisher is the logging stub. Set in prod to enable
# real per-topic Pub/Sub for events an action cascades.
# GCP_PROJECT_ID=

# Guards POST /internal/cron/tick. Min 16 chars. Unset → the tick endpoint 403s.
# SPARX_INTERNAL_CRON_TOKEN=

# Expected OIDC email claim for Pub/Sub push (POST /). Unset → accept any caller.
# PUBSUB_INVOKER_SA=sparx-pubsub-invoker@<project>.iam.gserviceaccount.com

# Due runs advanced per tick.
TICK_BATCH=100
