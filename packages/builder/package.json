{
  "name": "@sparx/builder",
  "version": "0.0.0",
  "private": true,
  "description": "sparx Builder — service layer for the composition-model page editor (page catalog, draft save, publish). One service, many transports (docs/41-builder-page-model.md).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./pubsub": {
      "types": "./src/pubsub-bridge.ts",
      "default": "./src/pubsub-bridge.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@sparx/builder-schemas": "workspace:*",
    "@sparx/db": "workspace:*",
    "@sparx/events": "workspace:*",
    "@sparx/silica-catalog": "workspace:*",
    "@sparx/surface-compile": "workspace:*",
    "@wizeworks/silicaui-html": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
