{
  "name": "@sparx/customer-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Layer-2 site shopper authentication on a dedicated tenant-scoped Better Auth instance (application-level multi-tenancy: (tenantId, email) identity). Distinct from @sparx/auth (staff). See docs/27-customer-accounts-site-auth.md.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@sparx/db": "workspace:*",
    "@sparx/events": "workspace:*",
    "better-auth": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
