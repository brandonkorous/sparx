// Legal/policy document placements — where a tenant's legal pages surface on
// its storefront (footer, checkout, terms gate). docs/42 §5.
//
// Polymorphic `source_kind`: today every placement points at a CMS content
// entry (`cms_entry`); the marketplace integration-published-docs bridge
// (ProviderMetadata.publishedDocs[], docs/09) adds `integration_doc` rows
// later WITHOUT a schema change. Resolution drops placements whose entry is
// unpublished/deleted, exactly like dead nav-item resolution.
//
// RLS: ENABLE + FORCE + tenant_isolation (tenant-scoped storefront data).

model StorefrontDocPlacement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  placement    String   @db.VarChar(40) // footer | checkout | terms_gate
  sourceKind   String   @map("source_kind") @db.VarChar(30) // cms_entry | integration_doc
  entryId      String?  @map("entry_id") @db.Uuid
  legalKind    String?  @map("legal_kind") @db.VarChar(40)
  providerSlug String?  @map("provider_slug") @db.VarChar(63)
  label        String?  @db.VarChar(120)
  columnKey    String?  @map("column_key") @db.VarChar(40)
  position     Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry  ContentEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, placement, sourceKind, entryId])
  @@index([tenantId, placement, enabled, position])
  @@map("storefront_doc_placements")
}
