// AI module (docs/07) — the persisted configuration the `ai` capability owns.
//
// Most of the AI/MCP surface already persists elsewhere: MCP connection keys live
// in `api_keys` (05), the MCP tool-call provenance lands in `audit_logs` (04, the
// `McpToolCall` entity the /ai dashboard reads), and the live-chat AI toggle is a
// `tenant.settings.chat` blob (57). What had NO home until now is two things:
//
//   1. ai_prompt_templates — a tenant-scoped LIBRARY of reusable, named AI prompts
//      (support persona, product-description writer, win-back email, SEO meta, …).
//      Seeded by the `ai` module preset + industry starters, demoable via sample
//      data, editable in the dashboard, and CONSUMED: the live-chat first-responder
//      reads the active `persona` template to ground its system prompt + pick its
//      model (services/api-rest/src/lib/chat/ai-handler.ts).
//
//   2. ai_tool_policies — a per-tenant allow/deny OVERLAY on the code-defined MCP
//      tool registry. Absence of a row = the tool is exposed (default-on, the prior
//      behavior); a row with enabled=false hides the tool from tools/list AND
//      refuses it at dispatch (services/api-mcp). This extends docs/07 §3 (which
//      previously left tool exposure to module+scope alone) with an explicit
//      per-tenant kill switch — see docs/07 §9.
//
// Both are tenant-scoped → ENABLE + FORCE RLS + tenant_isolation (current_tenant_id()),
// hand-edited in migration 20260926000000_ai_prompt_library. New empty tables → no
// backfill, so no FORCE-RLS per-tenant loop.

/// A reusable, named AI prompt the tenant can manage and the AI flows can apply.
model AiPromptTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Stable slug, unique per tenant — the idempotency key for preset/sample installs
  // (install is ensure-by-key) and the sample marker (`sample-*` keys clear cleanly).
  key String @db.VarChar(120)

  name        String  @db.VarChar(160)
  description String? @db.Text

  // What the prompt is for — drives grouping in the picker and which flow consumes
  // it. `persona` is special: the live-chat AI reads the active persona template.
  // support | email | product | seo | social | crm | persona | general
  category String @db.VarChar(24)

  // The prompt body. May carry `{{variable}}` placeholders the consumer fills.
  body String @db.Text

  // Declared `{{variables}}` for the editor's hint chips — an array of
  // { key, label, example? }. Purely advisory; the body is the source of truth.
  variables Json @default("[]")

  // Optional model override (e.g. a persona that wants a larger model). Null = the
  // platform default for the consuming flow.
  model String? @db.VarChar(64)

  // Disabled templates stay in the library but are skipped by the consumers (and
  // hidden from the active-persona lookup).
  enabled Boolean @default(true)

  // Engine/sample marker bag — `{ sample: true }` lets Clear find seeded rows
  // without a dedicated column (same convention as the sample-data engine elsewhere).
  metadata Json @default("{}")

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "ai_prompt_templates_tenant_key_unique")
  @@index([tenantId, category])
  @@map("ai_prompt_templates")
}

/// Per-tenant exposure override for one MCP tool. Absence = exposed (default-on);
/// a row with enabled=false hides + refuses the tool. The tool catalog itself is
/// code-defined (ALL_MCP_TOOLS); this only records the tenant's deviations.
model AiToolPolicy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The MCP tool name as registered in the tool registry, e.g. `update_order_status`.
  toolName String @map("tool_name") @db.VarChar(80)

  // false = the tenant has disabled this tool for all of its MCP connections.
  enabled Boolean @default(true)

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, toolName], map: "ai_tool_policies_tenant_tool_unique")
  @@index([tenantId])
  @@map("ai_tool_policies")
}
