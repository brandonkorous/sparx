// Analytics rollups (docs/97) — pre-aggregated, tenant-scoped summary tables
// that the dashboard overview pages read instead of running heavy GROUP BYs on
// the operational hot path. Each table is keyed by a time bucket (+ optional
// dimension) so a report is a trivial indexed range scan.
//
// Maintenance (docs/97 §5): a nightly cron `reconcile` recomputes a trailing
// window from the source-of-truth tables and overwrites the rollup (also the
// one-shot backfill). The READ endpoint live-overlays the most recent open
// day(s) so "today" is fresh without an event-increment consumer — for
// workload A (reporting over data we already own) the source is always
// recomputable, so reconcile + live-overlay is strictly correct and cheaper
// than an incremental worker. Money is stored as integer cents (BIGINT) to
// match the cents convention every `/reports/*` endpoint surfaces.

// One row per (tenant, UTC day) of commerce revenue. Buckets by `placed_at`'s
// UTC date over non-cancelled orders. `net_cents` = collected − refunds, the
// same definition the live `revenue-summary` KPI uses, so the chart and the
// headline never disagree.
model RollupCommerceDailyRevenue {
  tenantId String   @map("tenant_id") @db.Uuid
  // The UTC day this row aggregates (date only — no time component).
  bucket   DateTime @db.Date

  ordersCount   Int    @default(0) @map("orders_count")
  // Merchandise subtotal before discounts (sum of order.subtotal).
  grossCents    BigInt @default(0) @map("gross_cents")
  // Total discounts applied (sum of order.discount_total) — informational.
  discountCents BigInt @default(0) @map("discount_cents")
  // Total refunded (sum of order.refund_total).
  refundedCents BigInt @default(0) @map("refunded_cents")
  // Collected revenue net of refunds (sum(order.total) − sum(order.refund_total)).
  netCents      BigInt @default(0) @map("net_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, bucket], map: "rollup_commerce_daily_revenue_pkey")
  @@map("rollup_commerce_daily_revenue")
}

// One row per (tenant, UTC day) of invoicing cashflow (docs/87 §8, docs/97 §5).
// Holds two independent daily series keyed to the same calendar axis: money
// COLLECTED (payments received that day, bucketed by `billing_document_payments.
// received_at`) and money BILLED (documents finalized that day, bucketed by
// `billing_documents.finalized_at`). The Invoicing overview's "collected over
// time" chart overlays them and derives a collection rate. `collected_cents` is
// net of refunds — the same net cash definition `aggregatePayments` uses — so
// the chart never disagrees with the AR figures.
model RollupInvoicingDailyCollected {
  tenantId String   @map("tenant_id") @db.Uuid
  // The UTC day this row aggregates (date only — no time component).
  bucket   DateTime @db.Date

  // Payment/deposit events received this day (refunds excluded from the count).
  paymentsCount  Int    @default(0) @map("payments_count")
  // Documents finalized (became billable) this day.
  invoicesCount  Int    @default(0) @map("invoices_count")
  // Net cash received: sum(deposit + payment) − sum(refund), by received_at.
  collectedCents BigInt @default(0) @map("collected_cents")
  // Refunds issued this day (so gross collected = collected + refunded).
  refundedCents  BigInt @default(0) @map("refunded_cents")
  // Sum of finalized document totals — the amount billed this day.
  billedCents    BigInt @default(0) @map("billed_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, bucket], map: "rollup_invoicing_daily_collected_pkey")
  @@map("rollup_invoicing_daily_collected")
}

// One row per (tenant, UTC day) of dropship economics (docs/97 §5). Buckets
// dropship orders by `created_at`'s UTC date over the fulfilled-ish set
// (submitted | shipped | delivered — the same statuses the live `/v1/dropship/
// analytics` margin report counts). `cost_cents` sums each order's supplier
// line-item cost (the `line_items` JSON: Σ quantity × unitPriceCents);
// `revenue_cents` sums the matching storefront order-item revenue (order_items
// whose variant's `dropship_source_id` is this order's supplier). Profit and
// margin are DERIVED in the read (revenue − cost) so the chart never disagrees
// with the `/analytics` headline. Maintained by the nightly
// `/internal/dropship/orders-rollup` reconcile (also the backfill); the read
// live-overlays the most recent open day(s) so "today" stays fresh.
model RollupDropshipDailyOrders {
  tenantId String   @map("tenant_id") @db.Uuid
  // The UTC day this row aggregates (date only — no time component).
  bucket   DateTime @db.Date

  // Dropship orders routed (submitted | shipped | delivered) this day.
  ordersCount  Int    @default(0) @map("orders_count")
  // Storefront revenue attributed to those routed orders (sum of order-item
  // quantity × unit price, in cents).
  revenueCents BigInt @default(0) @map("revenue_cents")
  // Supplier cost of those routed orders (sum of line-item quantity ×
  // unitPriceCents, in cents). Net profit = revenue − cost.
  costCents    BigInt @default(0) @map("cost_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, bucket], map: "rollup_dropship_daily_orders_pkey")
  @@map("rollup_dropship_daily_orders")
}

// One row per (tenant, UTC day) of automation-engine run activity (docs/81,
// docs/97 §5). Buckets `automation_runs` by `started_at`'s UTC date across every
// automation the tenant owns — an aggregate the per-automation `/:id/runs` list
// can't give. `runs_count` is all runs started that day; the three terminal
// counters (completed | failed | skipped) let the read derive a success rate
// without re-scanning the run table. Runs still in-flight (running | waiting)
// are counted in `runs_count` but in none of the terminal counters until they
// settle — the nightly reconcile re-buckets by `started_at` once they do, and
// the read live-overlays the most recent open day(s). No money columns, so plain
// INTEGER counts (a tenant's daily run volume stays well under INT4's ceiling).
model RollupAutomationDailyRuns {
  tenantId String   @map("tenant_id") @db.Uuid
  // The UTC day this row aggregates (date only — no time component).
  bucket   DateTime @db.Date

  // All runs started this day (any status, including still in-flight).
  runsCount      Int @default(0) @map("runs_count")
  // Runs that reached `completed`.
  completedCount Int @default(0) @map("completed_count")
  // Runs that reached `failed`.
  failedCount    Int @default(0) @map("failed_count")
  // Runs short-circuited to `skipped` (e.g. conditions no longer matched).
  skippedCount   Int @default(0) @map("skipped_count")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, bucket], map: "rollup_automation_daily_runs_pkey")
  @@map("rollup_automation_daily_runs")
}

// One row per (tenant, UTC day) SNAPSHOT of inventory valuation (docs/97 §5).
// UNLIKE the other rollups, this is NOT recomputable from history: stock_levels
// carry only a CURRENT quantity (no per-day movement ledger), so a day's value
// can only be captured AS OF the nightly run. The snapshot cron upserts today's
// row each night; past rows are immutable point-in-time captures, so the "value
// over time" chart builds forward from first capture (no backfill is possible).
// The read live-overlays today (current valuation) so the chart is fresh before
// tonight's snapshot.
//
// Valuation mirrors the live `/v1/inventory/reports/summary` definition exactly:
// total_cost_cents = Σ(stock_level.on_hand × variant.cost_cents) and
// total_retail_cents = Σ(stock_level.on_hand × variant.price_cents).
model RollupInventoryDailyValuation {
  tenantId String   @map("tenant_id") @db.Uuid
  // The UTC day this snapshot was captured (date only — no time component).
  bucket   DateTime @db.Date

  // Total on-hand units across every (variant, location) stock level.
  totalUnits       Int    @default(0) @map("total_units")
  // Inventory value at cost / at retail, in integer cents.
  totalCostCents   BigInt @default(0) @map("total_cost_cents")
  totalRetailCents BigInt @default(0) @map("total_retail_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, bucket], map: "rollup_inventory_daily_valuation_pkey")
  @@map("rollup_inventory_daily_valuation")
}
