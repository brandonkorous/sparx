// Organizations, Members & Invitations (docs/114 Part A).
//
// The tenant IS the Better Auth "organization" (docs/16 §2, the 02-tenant.prisma
// header, root CLAUDE.md — "orgs map 1:1 to tenants"). These two tables give a
// tenant MANY users (staff/team) and a user MANY tenants (consultants/partners
// managing client accounts). `organization_id` is always a `tenants.id`.
//
// Auth-layer tables, exactly like users/sessions/accounts: ENABLE RLS + a
// policy, but NO FORCE — @sparx/auth connects as `sparx_owner` (bypasses
// non-forced RLS) and must resolve "which orgs is this user in?" BEFORE any
// tenant context exists (login, the client-accounts picker). `sparx_app` stays
// filtered by the policy as defense-in-depth. See migration
// 20261002000000_organizations_and_teams.

model Member {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The organization == the tenant this membership grants access to.
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  // Per-membership role (docs/78 §3) — supersedes the single users.role during
  // expand. owner | admin | editor | builder | marketing | support | viewer.
  role           String @default("editor") @db.VarChar(20)
  // Distinguishes internal staff from an external consultant/partner in the
  // tenant's team view (docs/78 §5). owner | staff | consultant.
  memberType     String @default("staff") @map("member_type") @db.VarChar(20)
  // active | invited | suspended
  status         String @default("active") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Tenant @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "members_org_user_unique")
  @@index([userId])
  @@index([organizationId])
  @@map("members")
}

model Invitation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @db.VarChar(255)
  role           String   @default("editor") @db.VarChar(20)
  memberType     String   @default("staff") @map("member_type") @db.VarChar(20)
  // pending | accepted | revoked | expired
  status         String   @default("pending") @db.VarChar(20)
  inviterId      String   @map("inviter_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Tenant @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}
