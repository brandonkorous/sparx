// Commerce — Per-tenant storefront settings + theme token overrides.
// Sitebuilder owns layout + page composition (separate module);
// Commerce owns the commerce-side defaults (currency, default warehouse,
// channels enabled, abandonment threshold) and the limited set of theme
// tokens a tenant can override without touching Sitebuilder.

// One row per (tenant, PROPERTY) — each site's commerce defaults + checkout
// policy (docs/49 Phase 6b). A site with no row of its own INHERITS the tenant's
// PRIMARY site's settings at read time (services resolve property → primary →
// code defaults), so adding a site never silently resets currency/locale. The
// migration adds property_id, backfills to the primary, and swaps the PK.
model CommerceSiteSettings {
  tenantId   String @map("tenant_id") @db.Uuid
  // One settings row per property → property_id is globally unique, making the
  // Property↔CommerceSiteSettings back-relation one-to-one.
  propertyId String @unique @map("property_id") @db.Uuid

  defaultCurrency         String  @default("USD") @map("default_currency") @db.VarChar(3)
  defaultLocale           String  @default("en-US") @map("default_locale") @db.VarChar(10)
  defaultWarehouseId      String? @map("default_warehouse_id") @db.Uuid
  channelsEnabled         Json    @default("[\"storefront\"]") @map("channels_enabled")
  cartAbandonmentMinutes  Int     @default(120) @map("cart_abandonment_minutes")
  showStockBelow          Int     @default(10) @map("show_stock_below")
  hidePricesWhenSignedOut Boolean @default(false) @map("hide_prices_when_signed_out")
  requireAuthForCheckout  Boolean @default(false) @map("require_auth_for_checkout")

  // Default dunning policy used by every subscription on this tenant
  // unless overridden per-subscription.
  defaultDunningPolicy Json @default("{}") @map("default_dunning_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@map("commerce_site_settings")
}

// PRESENTATION-only token overrides applied on top of @sparx/ui's storefront
// variants. Brand IDENTITY (primary/accent colour, typography, logo, favicon)
// is owned by the tenant-level TenantBrand (docs/30 §6) and read live + overlaid
// at render — it is NOT mirrored here. The former identity columns
// (color_primary/_primary_foreground/_accent, font_heading/_body,
// logo_media_id/logo_dark_media_id/favicon_media_id) were removed in migration
// 20260610000200 once every reader cut over to brand.

// One row per (tenant, PROPERTY) — the sitebuilder publish write-through target,
// now per-site (docs/49 Phase 6). Each site's publish compiles its own light
// tokens here; the migration adds property_id, backfills to the primary, and
// swaps the PK to the composite. property_id is NOT a security boundary.
model CommerceSiteTheme {
  tenantId   String @map("tenant_id") @db.Uuid
  // One theme per property → property_id is globally unique, making the
  // Property↔CommerceSiteTheme back-relation one-to-one.
  propertyId String @unique @map("property_id") @db.Uuid

  // VarChar(32), not (7). These were sized for `#RRGGBB` back when every theme
  // token was a hex triplet. sparx's first-party themes are authored in OKLCH
  // (`oklch(99.5% 0.003 200)` — 22 chars), so the write-through below threw
  // `value too long for type character varying(7)` and took the WHOLE publish
  // transaction down: on a shipped theme, `publish_site` could not complete at
  // all. A column width is a claim about the value space, and this one had
  // quietly stopped being true.
  //
  // Widened rather than converted to hex on the way in: OKLCH is the authored
  // truth (silica resolves `-content` pairs and AA contrast in that space), and
  // down-converting here would store a lossy second version of a colour the
  // storefront never reads from this table anyway — it renders the silica theme.
  // 32 covers the longest form these emit with room to spare.
  colorBackground String? @map("color_background") @db.VarChar(32)
  colorMuted      String? @map("color_muted") @db.VarChar(32)
  radiusBase      String? @map("radius_base") @db.VarChar(15)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@map("commerce_site_themes")
}
