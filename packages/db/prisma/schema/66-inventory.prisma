// Inventory Sync — multi-source stock management.
// (docs/64 Inventory Sync Ph1)
//
// InventorySource represents a feed/connection that provides stock counts
// (e.g. a warehouse CSV feed, a WMS API, or a 3PL).
//
// StockLocation is a named physical or virtual location (warehouse, bin, 3PL
// node) that holds units of a variant.
//
// StockLevel is the current on-hand quantity for a (variant, location) pair.
// A row per variant per location; updated in-place by the sync worker.
//
// InventorySourceLink binds a source's external SKU/location to the
// corresponding (ProductVariant, StockLocation) pair inside Sparx so the
// sync worker can map incoming rows to the right DB records.

model InventorySource {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String    @db.VarChar(255)
  // csv | api | shopify | wms | manual
  type            String    @db.VarChar(30)
  // Credentials/endpoint bag (URL, API key, etc.) — stored server-side.
  config          Json      @default("{}")
  // active | paused | error
  status          String    @default("active") @db.VarChar(20)
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz
  // Sync interval hint in seconds (0 = manual only).
  syncIntervalSec Int       @default(0) @map("sync_interval_sec")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  InventorySourceLink[]

  @@index([tenantId, status])
  @@map("inventory_sources")
}

model StockLocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  // human name, e.g. "Main Warehouse", "LA 3PL"
  name        String   @db.VarChar(255)
  // warehouse | bin | 3pl | virtual | transit
  type        String   @default("warehouse") @db.VarChar(20)
  // ISO 3166-1 alpha-2
  countryCode String?  @map("country_code") @db.VarChar(2)
  address     String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels      InventorySourceLink[]
  stockLevels StockLevel[]

  @@index([tenantId, active])
  @@map("stock_locations")
}

// Current on-hand quantity for a (variant, location) pair.
// Upserted by the sync worker; one row per variant × location.
model StockLevel {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  // Units currently on hand at this location.
  onHand    Int @default(0) @map("on_hand")
  // Units committed to open orders (allocated), not yet shipped.
  allocated Int @default(0)
  // onHand - allocated = available to promise.
  available Int @default(0) @map("available")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantId, locationId], map: "stock_levels_variant_location_unique")
  @@index([tenantId, locationId])
  @@map("stock_levels")
}

// Maps an external SKU/location reference from an InventorySource to a
// (ProductVariant, StockLocation) inside Sparx.
model InventorySourceLink {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  sourceId   String @map("source_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  // External identifiers as they appear in the source feed.
  externalSku      String  @map("external_sku") @db.VarChar(255)
  externalLocation String? @map("external_location") @db.VarChar(255)

  // active | disabled
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source   InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  variant  ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceId, externalSku, externalLocation], map: "inventory_source_link_unique")
  @@index([tenantId, sourceId])
  @@index([tenantId, variantId])
  @@map("inventory_source_links")
}
