// Authenticator-app two-step verification (Better Auth `twoFactor` plugin,
// docs/16 §2.4, §3.5).
//
// One row per user who has turned two-step verification on. Holds the shared
// TOTP secret their authenticator app was seeded with, plus their one-time
// backup codes. Purely per-user auth data, no tenant_id — same class as
// `sessions` / `accounts` / `passkeys`: ENABLE RLS with a user_isolation
// policy, but NOT FORCE, because the second-factor challenge is resolved
// between password-check and session-issue, when there is no session context
// for the policy to read.
//
// Field names mirror the plugin's schema verbatim (secret, backupCodes,
// verified) — the Prisma adapter keys on the model's JS field names, so these
// must not be renamed. Columns map to snake_case to match house style.
//
// BOTH stored values are secrets and BOTH are written encrypted, not plain:
// `secret` is what mints valid codes (a leak = a working second factor for the
// attacker), and `backupCodes` bypass the authenticator entirely. The plugin
// stores backup codes in PLAIN by default — `storeBackupCodes: 'encrypted'` in
// packages/auth/src/server.ts is what makes the column below ciphertext, and it
// is load-bearing. They are encrypted rather than hashed because the operator
// can re-display their unused codes; a one-way hash would make that impossible.

model TwoFactor {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  // Base32 TOTP shared secret, encrypted at rest with BETTER_AUTH_SECRET.
  secret String @db.Text
  // The user's remaining single-use backup codes, encrypted at rest as one
  // JSON array. Consumed codes are removed from the array on use.
  backupCodes String @map("backup_codes") @db.Text
  // Whether this enrollment completed its proving step. The enable flow writes
  // the row unverified, and only flips this once the operator has typed a code
  // their app generated — so a half-finished setup can never lock anyone out.
  verified Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}
