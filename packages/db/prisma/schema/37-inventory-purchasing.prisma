// Inventory supply path — Purchase Orders (docs/100 P3b). The inbound order: a
// commitment to BUY stock from a Supplier, received into a Warehouse (receiving
// lands in P3c). A PO carries a per-tenant human number, a lifecycle status,
// the destination warehouse, default terms (seeded from the supplier), and lines
// (one per variant — ordered qty + agreed unit cost). Owned by @sparx/inventory;
// standalone-usable — a WMS-lite tenant raises POs with no commerce.

model PurchaseOrder {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Per-tenant human identifier (PO-000001). Monotonic, gap-prone on deletes;
  // the (tenant_id, number) unique constraint is the collision backstop.
  number String @db.VarChar(20)

  supplierId  String @map("supplier_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  // draft | submitted | partial | received | closed | cancelled. A CHECK
  // constraint in the migration pins the vocabulary at the DB level; the Zod
  // PurchaseOrderStatus enum guards writes. draft is editable; submitted is
  // ordered; partial/received are driven by receiving (P3c); closed/cancelled
  // are terminal.
  status String @default("draft") @db.VarChar(20)

  currency     String  @default("USD") @db.VarChar(3)
  paymentTerms String? @map("payment_terms") @db.VarChar(20)

  // Buyer reference + lifecycle dates. orderedAt is stamped on submit;
  // expectedArrivalAt is set manually or derived from lead time on submit;
  // receivedAt on full receipt (P3c).
  reference         String?   @db.VarChar(120)
  orderedAt         DateTime? @map("ordered_at") @db.Timestamptz
  expectedArrivalAt DateTime? @map("expected_arrival_at") @db.Timestamptz
  receivedAt        DateTime? @map("received_at") @db.Timestamptz

  // Denormalized money — recomputed whenever lines change so list views + the
  // printed document read without re-summing. PO currency, minor units.
  subtotalCents Int @default(0) @map("subtotal_cents")
  shippingCents Int @default(0) @map("shipping_cents")
  totalCents    Int @default(0) @map("total_cents")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     PurchaseOrderLine[]

  @@unique([tenantId, number], map: "inventory_purchase_orders_tenant_number_unique")
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("inventory_purchase_orders")
}

// One ordered variant on a PO. description/supplierSku are snapshots captured at
// line time so the printed document stays stable even if the catalog or the
// supplier link later changes. quantityReceived is bumped by receiving (P3c);
// the PO advances to partial/received as lines fill.

model PurchaseOrderLine {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  variantId       String @map("variant_id") @db.Uuid

  description String? @db.VarChar(255)
  supplierSku String? @map("supplier_sku") @db.VarChar(127)

  quantityOrdered  Int @map("quantity_ordered")
  quantityReceived Int @default(0) @map("quantity_received")
  unitCostCents    Int @map("unit_cost_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, variantId], map: "inventory_po_lines_po_variant_unique")
  @@index([tenantId, variantId])
  @@map("inventory_purchase_order_lines")
}
