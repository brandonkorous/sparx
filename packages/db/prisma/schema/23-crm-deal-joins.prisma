// CRM — Deal/order and deal/billing-document join tables (locked decision #5).
//
// Pure join tables — no business state, no `deal_id` column on orders or
// billing documents. One deal can yield multiple orders; most orders have no
// deal. The CRM owns the deal lifecycle; orders and documents attach later
// without the commerce/B2B/invoicing engines ever knowing CRM exists.

model DealOrder {
  dealId    String   @map("deal_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([dealId, orderId])
  @@index([tenantId, orderId])
  @@map("deal_orders")
}

model DealBillingDocument {
  dealId     String   @map("deal_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([dealId, documentId])
  @@index([tenantId, documentId])
  @@map("deal_billing_documents")
}
