// Inventory module — Suppliers (vendors) + per-variant purchasing detail.
//
// The inbound counterpart to Warehouses: who stock is purchased FROM. A supplier
// carries contact + default terms + lead time; per-variant purchasing detail (the
// supplier's part number, purchase cost, MOQ) lives on SupplierVariant. Purchase
// orders (docs/100 P3b) reference a supplier and receiving (P3c) books goods
// against a PO; the supplier cost feeds the moving-average basis on receipt.
//
// Owned by @sparx/inventory; standalone-usable — a WMS-lite tenant records
// suppliers with no commerce.

model Supplier {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(160)
  code String @db.VarChar(32)

  contactName String? @map("contact_name") @db.VarChar(160)
  email       String? @db.VarChar(255)
  phone       String? @db.VarChar(50)
  website     String? @db.VarChar(255)

  line1      String? @db.VarChar(255)
  line2      String? @db.VarChar(255)
  city       String? @db.VarChar(120)
  region     String? @db.VarChar(120)
  postalCode String? @map("postal_code") @db.VarChar(32)
  country    String? @db.VarChar(2)

  // Default purchasing terms — overridable per PO. paymentTerms mirrors the
  // net-N vocabulary used elsewhere (billing/b2b). leadTimeDays seeds a PO's
  // expected arrival when the supplier-variant carries none.
  paymentTerms String? @map("payment_terms") @db.VarChar(20)
  leadTimeDays Int?    @map("lead_time_days")
  currency     String  @default("USD") @db.VarChar(3)
  notes        String? @db.Text

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants       SupplierVariant[]
  purchaseOrders PurchaseOrder[]
  barcodes       VariantBarcode[]

  @@unique([tenantId, code], map: "inventory_suppliers_tenant_code_unique")
  @@index([tenantId, isActive])
  @@map("inventory_suppliers")
}

// Per-variant purchasing detail for a supplier: the supplier's part number, the
// purchase cost (PO line default + the moving-average basis on receipt), MOQ,
// lead time, and whether this is the preferred source for the variant. One row
// per (supplier, variant); a variant can have many suppliers.

model SupplierVariant {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid

  supplierSku   String? @map("supplier_sku") @db.VarChar(127)
  unitCostCents Int?    @map("unit_cost_cents")
  minOrderQty   Int?    @map("min_order_qty")
  leadTimeDays  Int?    @map("lead_time_days")
  isPreferred   Boolean @default(false) @map("is_preferred")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, variantId], map: "inventory_supplier_variants_supplier_variant_unique")
  @@index([tenantId, variantId])
  @@index([tenantId, isPreferred])
  @@map("inventory_supplier_variants")
}
