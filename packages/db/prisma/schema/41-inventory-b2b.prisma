// B2B fleet / work-order holds (docs/100 P6d, docs/10) — the B2B module as a
// CONSUMER of the master inventory (docs/99 §4.0). A B2B account reserves stock
// against the master for a fleet job / work order BEFORE an order exists. The hold
// owns the account + work-order reference; the actual allocation is an
// `InventoryReservation` (holderType `work_order`) so total stock is conserved
// (it moves `allocated`, never `on_hand`). Releasing frees the reservation;
// consuming commits it to a `sale` through the ledger. Inventory owns the supply
// engine — this record is the B2B-specific scoping layered on top.

model B2bFleetHold {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  b2bAccountId String @map("b2b_account_id") @db.Uuid
  variantId    String @map("variant_id") @db.Uuid
  warehouseId  String @map("warehouse_id") @db.Uuid

  quantity     Int
  workOrderRef String  @map("work_order_ref") @db.VarChar(127)
  note         String? @db.Text
  // active | released | consumed
  status String @default("active") @db.VarChar(20)

  // Soft pointer to the InventoryReservation holding the `allocated` units (no FK
  // — the reaper/release may retire the reservation independently).
  reservationId    String? @map("reservation_id") @db.Uuid
  heldByCustomerId String? @map("held_by_customer_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  releasedAt DateTime? @map("released_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   B2BAccount     @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, b2bAccountId, status])
  @@index([tenantId, variantId, status])
  @@map("b2b_fleet_holds")
}
