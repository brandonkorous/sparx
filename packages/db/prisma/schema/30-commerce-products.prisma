// Commerce — Products.
//
// The wrapping row that variants hang off. A product carries the catalog-
// level shape (title, description, SEO, fulfillment type, hazmat class,
// shipping defaults); each Variant overrides for a purchasable SKU.
//
// Money columns store integer cents (matches @sparx/commerce-schemas
// MoneyCents). CRM-side Decimal columns are kept for historical orders;
// Commerce-side reads convert at the boundary.
//
// Hand-edited RLS lives in the migration SQL — Prisma does not generate
// `ENABLE / FORCE ROW LEVEL SECURITY` (memory/feedback_sparx_db_rls_pattern).

model Product {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title       String  @db.VarChar(255)
  handle      String  @db.VarChar(127)
  description String? @db.Text // rich-text HTML allowed

  status          String   @default("draft") @db.VarChar(20) // draft | active | archived
  productType     String?  @map("product_type") @db.VarChar(127)
  // The TYPED product-type link (docs/143) — mirrors ContentEntry.typeKey. A
  // string key (not an FK) resolved against ProductType.key by the product
  // service; it governs the `attributes` bag's schema. Distinct from the
  // free-text `productType` above, which stays the merchandising label / collection
  // facet. Null = untyped (renders no attributes; fully backward compatible).
  productTypeKey  String?  @map("product_type_key") @db.VarChar(63)
  // The typed, schema-validated descriptive attribute bag — mirrors
  // ContentEntry.body. Validated against the resolved ProductType.attributeSchema
  // on write (422 on mismatch, like a content entry). Distinct from `metadata`
  // below, which stays the untyped raw escape hatch.
  attributes      Json     @default("{}")
  vendor          String?  @db.VarChar(127)
  tags            String[] @default([]) @db.VarChar(63)
  fulfillmentType String   @default("physical") @map("fulfillment_type") @db.VarChar(20)
  // ^ physical | digital | service | configurable | bundle | subscription

  // Defaults inherited by variants when omitted.
  weightGrams      Int?    @map("weight_grams")
  lengthMm         Int?    @map("length_mm")
  widthMm          Int?    @map("width_mm")
  heightMm         Int?    @map("height_mm")
  hazmatClass      String  @default("none") @map("hazmat_class") @db.VarChar(32)
  requiresShipping Boolean @default(true) @map("requires_shipping")
  taxClass         String? @map("tax_class") @db.VarChar(63)
  originCountry    String? @map("origin_country") @db.VarChar(2)
  hsCode           String? @map("hs_code") @db.VarChar(15)
  metadata         Json    @default("{}")

  // SEO.
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)
  ogImageId      String? @map("og_image_id") @db.Uuid

  // Default fulfillment warehouse — order picker falls back to this when
  // a line item doesn't pin one explicitly.
  defaultWarehouseId String? @map("default_warehouse_id") @db.Uuid

  // Aggregated read columns updated by event consumers — never written
  // inline. Drives storefront sort + low-stock badges.
  priceMinCents  Int?    @map("price_min_cents")
  priceMaxCents  Int?    @map("price_max_cents")
  inStock        Boolean @default(false) @map("in_stock")
  // In stock, but at least one variant/warehouse level has fallen to/below its
  // reorder point — the canonical "running low" predicate (@sparx/inventory
  // isLowStock). Maintained in the SAME place as inStock (syncProductInStock),
  // and read by the collection-rule compiler's `inventory low_stock` predicate.
  lowStock       Boolean @default(false) @map("low_stock")
  bestSellerRank Int?    @map("best_seller_rank")
  averageRating  Float?  @map("average_rating")
  reviewCount    Int     @default(0) @map("review_count")

  // sparx.market product-graph opt-in (docs/106 §4.7, docs/72 §2). A product opts
  // ITSELF into the first-party marketplace; the global MarketListing projection
  // (80-market.prisma) is derived from `marketListed && status='active' &&
  // marketApproved` by the channel-sync-worker. `marketApproved` lets sparx delist
  // a policy-violating product without the merchant un-listing it.
  marketListed   Boolean @default(false) @map("market_listed")
  marketCategory String? @map("market_category") @db.VarChar(50)
  marketFeatured Boolean @default(false) @map("market_featured")
  marketApproved Boolean @default(true) @map("market_approved")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultWarehouse       Warehouse?               @relation("ProductDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  options                ProductOption[]
  variants               ProductVariant[]
  images                 VariantImage[]
  fitments               ProductFitment[]
  collectionLinks        CollectionProduct[]
  categoryLinks          CategoryProduct[]
  propertyLinks          ProductProperty[]
  shippingProfileLinks   ShippingProfileProduct[]
  bundlesAsWrapper       Bundle[]                 @relation("BundleWrapper")
  bundleComponents       BundleComponent[]
  configurationTemplates ConfigurationTemplate[]
  reviews                ProductReview[]
  reviewRollups          ProductReviewRollup[]
  questions              ProductQuestion[]
  translations           ProductTranslation[]
  orderItems             OrderItem[]
  dropshipLinks          DropshipProductLink[]
  billingDocumentLines   BillingDocumentLine[]
  channelMappings        ChannelProductMapping[]

  @@unique([tenantId, handle], map: "products_tenant_handle_unique")
  @@index([tenantId, status])
  @@index([tenantId, productType])
  @@index([tenantId, productTypeKey])
  @@index([tenantId, vendor])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("commerce_products")
}

// A typed PRODUCT TYPE (docs/143) — the commerce mirror of ContentType. It
// declares an `attributeSchema` (a @sparx/field-schema FieldSchema: the same 15
// field kinds content types use) that governs a product's `attributes` bag. The
// fixed commerce spine (variants/prices/inventory/images/SEO) is NEVER
// type-defined — only the variable descriptive attribute layer is. Built-in
// types (apparel, cosmetics, food_beverage, …) live under the sentinel platform
// tenant and the RLS policy exposes them read-visible to every tenant; editing a
// built-in forks it into a tenant-owned copy (same key, the caller's tenant_id),
// exactly like content types.
model ProductType {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // null = the type is available to every site — the common case (a type is a
  // SCHEMA, and schemas are generic). Mirrors ContentType.propertyId.
  propertyId String? @map("property_id") @db.Uuid

  key             String  @db.VarChar(63) // e.g. "apparel", "coffee"
  name            String  @db.VarChar(127) // "Apparel"
  pluralName      String? @map("plural_name") @db.VarChar(127)
  description     String? @db.Text
  attributeSchema Json    @map("attribute_schema") // FieldSchema { fields: FieldDef[] }
  icon            String? @db.VarChar(63)
  isBuiltIn       Boolean @default(false) @map("is_built_in")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Key uniqueness stays per TENANT (not per site): one key must mean one
  // attribute schema across the tenant, exactly like ContentType.key.
  @@unique([tenantId, key], map: "product_types_tenant_key_unique")
  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@map("commerce_product_types")
}

// Per-site catalog scoping (docs/49 §3 Model B) — which web PROPERTIES a product
// is visible on. NO rows for a product = visible on ALL sites (the default,
// backward-compatible); one-or-more rows = visible ONLY on those sites. A
// junction (composite PK, NO tenant_id — tenant scoping rides the FK parents,
// exactly like CollectionProduct), so "empty means all" keeps existing catalogs
// global with zero backfill. The storefront read filters
// `propertyLinks none OR propertyLinks some(propertyId)` (lib/property-scope.ts).
model ProductProperty {
  propertyId String @map("property_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([propertyId, productId])
  @@index([productId])
  @@map("commerce_product_properties")
}

// Localized title / description / SEO. Optional — Phase 1 ships en-US
// only; the table is here so locale rollout is a row insert, not a
// schema change.

model ProductTranslation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  locale    String @db.VarChar(10) // en-US | es-MX | fr-CA | ...

  title          String  @db.VarChar(255)
  description    String? @db.Text
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale], map: "product_translations_locale_unique")
  @@index([tenantId])
  @@map("commerce_product_translations")
}
