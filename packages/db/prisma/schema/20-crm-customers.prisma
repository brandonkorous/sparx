// CRM — Customers + addresses.
//
// The customer-intelligence spine introduced by the CRM module. Commerce
// and B2B FK into this row rather than defining a parallel customer table.
//
// Locked architectural commitments (memory/feedback_crm_architecture.md):
//   • One table, three orthogonal classification axes (docs/137) — `type`
//     (relationship), `lifecycle_stage` (journey), `lead_status` (work state).
//     Promotion is a column update, not a row migration. `type` was once the
//     single overloaded axis and carried `prospect`; 20270116000000 split it,
//     and a prospect is now lifecycle `lead`, not a relationship kind.
//   • `authUserId` is NOT a FK to staff `users` (which is staff-only per
//     docs/16 §2 Layer 1). It will FK to a customer-auth-layer table when
//     that module lands. Stored as plain UUID for now.
//   • `totalSpent` / `orderCount` are denormalized fast-read columns
//     updated by the order-event consumer. Never written inline.
//   • `mergedIntoCustomerId` carries the dedup audit trail — soft-deleted
//     duplicates retain a pointer to the surviving primary.

model Customer {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  // Classification is three orthogonal axes (docs/137). `type` = RELATIONSHIP
  // (how they transact); only `b2b` carries pricing/A-R behaviour.
  type           String  @default("retail") @db.VarChar(20) // retail | b2b | partner | vendor
  // LIFECYCLE STAGE — where they are in the journey (auto-advances to `customer`
  // on first order). subscriber|lead|marketing_qualified_lead|sales_qualified_lead|opportunity|customer|evangelist|other
  lifecycleStage String  @default("lead") @map("lifecycle_stage") @db.VarChar(30)
  // LEAD STATUS — the micro work-state, null once settled. new|open|in_progress|open_deal|unqualified|attempted_to_contact|connected|bad_timing
  leadStatus     String? @map("lead_status") @db.VarChar(30)
  // The Better Auth customer user (Layer 2 login, docs/27 v2) behind this
  // membership. null = a guest / CRM-imported contact with no storefront login.
  authUserId    String? @map("auth_user_id") @db.Uuid
  // Membership scoping (docs/58 D2): the SITE this customer belongs to. A
  // person who shops more than one of the tenant's sites is one CustomerUser
  // (auth_user_id) linked to a per-site membership each. property_id null = a
  // tenant-level CRM contact not tied to a site.
  propertyId    String? @map("property_id") @db.Uuid
  b2bAccountId  String? @map("b2b_account_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  email                  String?  @db.VarChar(255)
  phone                  String?  @db.VarChar(50)
  firstName              String?  @map("first_name") @db.VarChar(255)
  lastName               String?  @map("last_name") @db.VarChar(255)
  company                String?  @db.VarChar(255)
  jobTitle               String?  @map("job_title") @db.VarChar(255)
  preferredContactMethod String?  @map("preferred_contact_method") @db.VarChar(20) // email | phone | sms
  doNotContact           Boolean  @default(false) @map("do_not_contact")
  gdprConsent            Json     @default("{}") @map("gdpr_consent")
  tags                   String[] @default([]) @db.VarChar(63)
  metadata               Json     @default("{}")

  // The extra details THIS business tracks about a person (docs/144 §3) —
  // "warranty expires", "dietary needs", "referred by". Validated on write
  // against the `contact` row in crm_object_defs, which is the tenant's own
  // FieldSchema. Distinct from `metadata`, which is an untyped internal bag no
  // UI renders and no segment can filter: these are declared, typed, editable,
  // filterable and reportable — that is the whole difference.
  customProperties       Json     @default("{}") @map("custom_properties")

  // Optional profile photo — a SOFT reference to a MediaAsset (cms module), no
  // FK by design (mirrors CrmActivity.linkedEntityId's cross-module soft ref).
  // The client resolves the id to a URL and falls back to initials if the asset
  // is gone. A customer is never a staff user, so this is always editable.
  avatarMediaAssetId String? @map("avatar_media_asset_id") @db.Uuid

  totalSpent   Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  orderCount   Int       @default(0) @map("order_count")
  firstOrderAt DateTime? @map("first_order_at") @db.Timestamptz
  lastOrderAt  DateTime? @map("last_order_at") @db.Timestamptz

  mergedIntoCustomerId String? @map("merged_into_customer_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  authUser    CustomerUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  b2bAccount  B2BAccount?   @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  assignedRep User?         @relation("CustomerAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  mergedInto  Customer?     @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id], onDelete: SetNull)
  mergedFrom  Customer[]    @relation("CustomerMerge")

  addresses        CustomerAddress[]
  documents        CustomerDocument[]
  deals            Deal[]
  activities       CrmActivity[]
  tasks            Task[]
  segmentMembers   SegmentMember[]
  orders           Order[]
  billingDocuments BillingDocument[]

  // Commerce module inverse relations
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  accountCredits   AccountCredit[]
  subscriptions    Subscription[]
  paymentMethods   CustomerPaymentMethod[]
  reviews          ProductReview[]
  productQuestions ProductQuestion[]
  wishlists        Wishlist[]
  taxExemptions    TaxExemption[]

  // Customer-auth (Layer 2, docs/27 v2) — the login is the Better Auth
  // CustomerUser reached via `authUser`; sessions live on CustomerUser, not the
  // per-site membership. Membership + docs/58 recognition are resolved from
  // (authUserId, propertyId) on each authenticated request.

  // Cookie consent — records this shopper authored while signed in (docs/42 §4)
  consentRecords ConsentRecord[]

  // B2B portal — contact role membership rows (docs/64 B2B Ph5)
  b2bContactRoles B2bAccountContact[]

  // Live Chat — conversations opened by this customer (docs/56)
  chatConversations ChatConversation[]

  // Site forms (docs/115) — contact/lead submissions mirrored onto this contact
  formSubmissions FormSubmission[]

  @@unique([tenantId, propertyId, email], map: "customers_tenant_property_email_unique")
  @@index([tenantId, propertyId])
  @@index([tenantId, type])
  @@index([tenantId, assignedRepId])
  @@index([tenantId, b2bAccountId])
  @@index([tenantId, lastOrderAt(sort: Desc)])
  @@index([tenantId, totalSpent(sort: Desc)])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([authUserId])
  @@map("customers")
}

// Multiple addresses per customer; one flagged default per type. Used by
// Commerce / B2B for shipping/billing.

model CustomerAddress {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  type       String  @db.VarChar(20) // shipping | billing | both
  label      String? @db.VarChar(120) // "HQ", "Warehouse 2"
  isDefault  Boolean @default(false) @map("is_default")

  recipientName String? @map("recipient_name") @db.VarChar(255)
  company       String? @db.VarChar(255)
  line1         String  @db.VarChar(255)
  line2         String? @db.VarChar(255)
  city          String  @db.VarChar(120)
  region        String? @db.VarChar(120)
  postalCode    String? @map("postal_code") @db.VarChar(32)
  country       String  @db.VarChar(2)
  phone         String? @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

// A file attached to a customer — a signed contract, an ID scan, a spec sheet.
// The bytes live in the media pipeline (MediaAsset, cms module); this row is the
// link + a human label. `media_asset_id` is a SOFT reference (no FK), the same
// cross-module pattern as the avatar and crm_activities.linked_entity_id — the
// client resolves it to a name + download URL, and a missing asset degrades to a
// dangling row the UI simply skips. `tenant_id` is a scalar (RLS reads it); the
// cascade on customer deletion cleans these up, and customers themselves cascade
// from the tenant, so no direct tenant FK is needed.
model CustomerDocument {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String  @map("customer_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  label        String? @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@map("customer_documents")
}
