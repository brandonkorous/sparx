// B2B purchase approval rules — per-account or tenant-wide thresholds that
// require manager sign-off before a B2B portal order is placed.
// (docs/10 §12, docs/64 B2B Ph6)
//
// When an order's total exceeds `minAmountCents` (and the account has no
// explicit rule, or the account's rule fires), checkout sets
// `order.status = 'pending_approval'` and publishes `b2b.order.pending_approval`.
//
// Approval decisions are logged as `CrmActivity` rows for the audit trail; the
// order transitions to `placed` (approved) or `cancelled` (rejected).
//
// Rule evaluation order:
//   1. Account-specific rule (account_id IS NOT NULL) — most specific wins.
//   2. Tenant-wide rule (account_id IS NULL) — catch-all.
// If multiple account rules exist for the same account, the most recently
// created active one wins. Only one rule fires per order.

model PurchaseApprovalRule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  // null = tenant-wide catch-all; set = account-specific.
  accountId String? @map("account_id") @db.Uuid

  // Orders with total >= minAmountCents require approval. 0 = all B2B orders.
  minAmountCents Int @default(0) @map("min_amount_cents")

  // Specific approver; null = any staff user with editor role may approve.
  requiredApproverUserId String? @map("required_approver_user_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account          B2BAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requiredApprover User?       @relation("ApprovalRuleApprover", fields: [requiredApproverUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, isActive])
  @@map("purchase_approval_rules")
}
