// CRM — the object registry (docs/144 §3).
//
// ONE table describes what a tenant has ADDED to the built-in CRM objects AND
// the complete shape of the objects they invented. That is not two features
// wearing one table: both answers are "a FieldSchema for an object key", and
// splitting them would mean two property editors, two validators and two
// segment sources for the same idea.
//
// THE DISTINCTION THAT GOVERNS THE MODEL (docs/143 §2.2, applied to CRM):
// a content entry IS its type's fields, but a product is not — it carries a
// fixed commerce spine and the type layer is purely additive. A CONTACT is a
// product, not a blog post. `email`, `lifecycle_stage`, `total_spent` and
// `order_count` are indexed columns that segments, reports, the order consumer
// and RLS all depend on. So for a `builtin` object this row's schema holds ONLY
// the tenant's additions, which live in a `custom_properties` JSONB column on
// the object's own table. For a `custom` object it holds the whole record, which
// lives in `crm_records` below.
//
// tenant_id / property_id are plain scalars with FKs hand-added in the migration
// rather than Prisma relations — the same choice email_sequences makes, so the
// Tenant and Property models don't grow back-relations for leaf tables.

model CrmObjectDef {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// contact | company | deal | ticket for the built-ins; a tenant-authored
  /// snake_case key (`service_contract`, `property_listing`) for a custom one.
  key  String @db.VarChar(63)
  /// builtin — a fixed-spine object we ship, whose schema is the tenant's
  /// ADDITIONS. custom — an object the tenant invented, whose schema is all of
  /// it. The kind decides where a record's values live, so it is not cosmetic.
  kind String @default("custom") @db.VarChar(10)

  label       String  @db.VarChar(120)
  labelPlural String  @map("label_plural") @db.VarChar(120)
  /// A lucide icon name, resolved by the client. Custom objects get a generic
  /// one when unset; the built-ins already have icons in the surface catalog.
  iconKey     String? @map("icon_key") @db.VarChar(63)
  description String? @db.Text

  /// A `FieldSchema` from @sparx/field-schema — the SAME engine behind CMS
  /// content types and commerce product types. Validated on write; `{"fields":[]}`
  /// for a built-in nobody has extended yet.
  propertySchema Json @default("{\"fields\":[]}") @map("property_schema")

  /// Custom objects only: which property is the record's display title. Null on
  /// a built-in, whose title comes from its own spine (a contact's name).
  primaryFieldKey String? @map("primary_field_key") @db.VarChar(63)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  records CrmRecord[]

  @@unique([tenantId, key])
  @@index([tenantId, kind, archivedAt])
  @@map("crm_object_defs")
}

// A row of a tenant-invented object. One table for every custom object, keyed by
// `object_key` — the same shape `content_entries` uses for every content type.
//
// NOT EAV. A validated JSONB bag is already the platform's settled answer for
// typed user data, it round-trips through one field engine, and the property
// editor + form renderer already speak it. A three-table EAV would be a second
// answer to a solved problem, and every read would become a pivot.
//
// INDEXING, HONESTLY: the migration puts a GIN index on `values`, which serves
// containment and equality — what property filtering actually is. Range and sort
// on a custom numeric property fall back to a tenant-bounded scan. That is fine
// at the row counts one tenant holds; if a specific property ever becomes hot,
// the answer is an expression index minted for it, not a change to this model.
model CrmRecord {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The business this record belongs to (docs/131 §5); null = tenant-wide.
  propertyId String? @map("property_id") @db.Uuid

  objectKey String @map("object_key") @db.VarChar(63)

  /// Validated against the object's `property_schema` on every write, with
  /// calculated fields recomputed server-side (@sparx/field-schema `calc`).
  values Json @default("{}")

  /// The staff member who owns this record. Same shape as a deal's assigned rep.
  ownerId String? @map("owner_id") @db.Uuid

  /// Denormalized from `values[primaryFieldKey]` on write so a list, a search
  /// result and an association chip can name the record without parsing JSON.
  title String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  objectDef CrmObjectDef @relation(fields: [tenantId, objectKey], references: [tenantId, key], onDelete: Cascade)

  @@index([tenantId, objectKey, updatedAt(sort: Desc)])
  @@index([tenantId, propertyId, objectKey])
  @@index([tenantId, objectKey, title])
  @@index([tenantId, ownerId])
  @@map("crm_records")
}
