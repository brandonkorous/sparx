// Dashboard shell — per-user, per-tenant pinned navigation state.
//
// Favorites and Recents both key on (user_id, tenant_id) rather than a
// `tenant_membership_id` row, because the platform's User model carries
// `tenantId` directly today (one user, one tenant). When Better Auth's
// organization plugin lands and introduces real membership rows, this
// compound key migrates cleanly to `tenant_membership_id`.
//
// `action_id` is a free-form text matching a ModuleManifest action.id. No
// FK — manifests are code, not data. If a module is removed, orphaned
// favorites/recents become unrenderable and are filtered client-side.
//
// See docs/24-dashboard-shell.md §8.

model UserFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actionId  String   @map("action_id") @db.VarChar(120)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, actionId])
  @@index([userId, tenantId, position])
  @@map("user_favorites")
}

model UserRecent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actionId      String   @map("action_id") @db.VarChar(120)
  lastVisitedAt DateTime @default(now()) @map("last_visited_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, actionId])
  @@index([userId, tenantId, lastVisitedAt(sort: Desc)])
  @@map("user_recents")
}

// Saved views — a PLATFORM list-persistence primitive (not CRM-specific). Every
// dashboard list is URL-query-string driven (search/filters/sort/view live in
// the query params; the server component re-reads them and refetches). A saved
// view is therefore just a named snapshot of those params for one list surface,
// re-applied by navigating to `?<params>`. `target` is the list identity — the
// route path or a `module.surface` key (e.g. "/crm/deals", "commerce.products").
// `config` is opaque JSON the shared ListToolbar interprets (today: the saved
// query params). `ownerUserId` null = shared with the whole tenant; `isDefault`
// marks the view a list opens on when it has no params. Seeded per
// `module.activated(<slug>)` so each module ships starter views for its surfaces.
model SavedView {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  target      String   @db.VarChar(63) // list identity: route path or module.surface key
  name        String   @db.VarChar(120)
  config      Json     @default("{}")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, target, ownerUserId])
  @@map("saved_views")
}
