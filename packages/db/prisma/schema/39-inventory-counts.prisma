// Inventory corrections — Counts (docs/100 P4). A counting session reconciles
// recorded stock against a physical count: cycle counts a chosen subset, a full
// count covers every level in the warehouse. Each line snapshots the expected
// on-hand at count start, captures the counted quantity, and — when posted —
// writes a `recount` movement through the ledger (an absolute `setOnHand`, so the
// corrective delta is computed against LIVE on-hand inside the row lock, immune to
// a sale landing mid-count). Variance value over a per-count threshold gates the
// post behind an admin approval. Owned by @sparx/inventory; standalone-usable.

model InventoryCount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Per-tenant human identifier (CNT-000001). Monotonic, gap-prone on deletes;
  // the (tenant_id, number) unique constraint is the collision backstop.
  number      String @db.VarChar(20)
  warehouseId String @map("warehouse_id") @db.Uuid

  // cycle | full — a CHECK constraint pins the vocabulary at the DB level.
  type String @db.VarChar(12)

  // What the count COVERS (docs/146 Phase 2): the whole location, one zone, or
  // one bin. `location` keeps the pre-bins behaviour exactly, so nothing about an
  // existing count changes. A CHECK pins the vocabulary.
  //
  // Stored rather than inferred from the lines because it is the count's INTENT,
  // and intent is what decides whether a variant absent from the sheet means
  // "zero" or "not in scope" — the difference between a correction and a
  // catastrophe.
  scope String @default("location") @db.VarChar(12)

  // Set when scope = 'bin'; the zone name when scope = 'zone'.
  binId    String? @map("bin_id") @db.Uuid
  zoneName String? @map("zone_name") @db.VarChar(60)

  // A blind count hides the expected quantity from whoever is counting, so the
  // number they write down is what they SEE rather than what they were told to
  // expect. It is the single cheapest accuracy control in the category and the
  // reason cycle counts are worth doing at all.
  isBlind Boolean @default(false) @map("is_blind")

  // Set when a cycle-count schedule generated this count rather than a person
  // (docs/146 Phase 7.9). SET NULL on delete, not cascade — deleting the
  // standing instruction must never delete the counts it produced, which are
  // the evidence that counting happened.
  scheduleId String? @map("schedule_id") @db.Uuid

  // counting | review | approved | posted | cancelled. A CHECK pins it. counting
  // is editable; review freezes the variance + the approval requirement; approved
  // is the admin sign-off when over threshold; posted has applied the recounts;
  // cancelled is terminal with nothing applied.
  status String @default("counting") @db.VarChar(12)

  note String? @db.Text

  // Approval gate: when the absolute variance VALUE (Σ |Δ|·cost) computed at review
  // exceeds the threshold, the post requires an admin approval. Threshold is per
  // count (defaulted on create); requiresApproval + varianceValueCents are frozen
  // when the count is submitted for review.
  approvalThresholdCents Int     @default(5000) @map("approval_threshold_cents")
  requiresApproval       Boolean @default(false) @map("requires_approval")
  varianceValueCents     Int     @default(0) @map("variance_value_cents")

  // Lifecycle stamps. startedAt at creation; countedAt on submit-for-review;
  // approvedAt/approvedBy on sign-off; postedAt when the recounts are applied.
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  countedAt  DateTime? @map("counted_at") @db.Timestamptz
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  approvedBy String?   @map("approved_by") @db.VarChar(127)
  postedAt   DateTime? @map("posted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  schedule  CycleCountSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  lines     InventoryCountLine[]

  @@unique([tenantId, number], map: "inventory_counts_tenant_number_unique")
  @@index([tenantId, status])
  @@index([tenantId, warehouseId])
  // "Which counts did this schedule produce" — the schedule detail's history
  // read (docs/146 Phase 7.9). Declared here as well as in the migration: an
  // index the model cannot see is one a later `prisma migrate dev` would offer
  // to drop.
  @@index([tenantId, scheduleId])
  @@map("inventory_counts")
}

// One counted variant on a count. expectedQuantity is the on-hand snapshot at line
// creation (count start); countedQuantity is null until entered. On post, appliedDelta
// records the actual corrective delta the ledger applied (counted − LIVE on-hand,
// which may differ from counted − expected if stock moved mid-count) and movementId
// soft-points at the `recount` ledger row.

model InventoryCountLine {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  countId   String @map("count_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  // Which shelf this line counts (docs/146 Phase 2). A bin-scoped count has one
  // line per (variant, bin), so the same variant may appear several times on one
  // count — which is the point: "twelve on A-01 and three on B-04" is the answer,
  // and collapsing it to fifteen loses where to go and look when it is wrong.
  binId String? @map("bin_id") @db.Uuid

  // Base units, all three (docs/146 Phase 6.2). The pair below says what the
  // counter counted in — a shelf of sealed cartons is counted in cartons, and
  // making someone multiply by twelve at the shelf is how a count goes wrong.
  expectedQuantity Int  @map("expected_quantity")
  countedQuantity  Int? @map("counted_quantity")
  appliedDelta     Int? @map("applied_delta")

  uomCode     String? @map("uom_code") @db.VarChar(12)
  unitsPerUom Int     @default(1) @map("units_per_uom")
  // Soft pointer to the inventory_movements row this line wrote on post (no FK —
  // the ledger is append-only and never deleted under a count line).
  movementId  String? @map("movement_id") @db.Uuid
  note        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bin     InventoryBin?  @relation(fields: [binId], references: [id], onDelete: SetNull)

  // Uniqueness is TWO PARTIAL indexes in the migration, not a `@@unique` here:
  // once a line can name a bin, "one line per variant" is only true for a
  // location-wide count, and a plain unique over the nullable `bin_id` would let
  // a location-wide count hold unlimited duplicate lines for one variant (Postgres
  // treats NULLs as distinct) — the exact row that most needs to be unique.
  //   …_count_variant_unique      UNIQUE (count_id, variant_id) WHERE bin_id IS NULL
  //   …_count_variant_bin_unique  UNIQUE (count_id, variant_id, bin_id) WHERE bin_id IS NOT NULL
  @@index([tenantId, countId])
  @@index([tenantId, variantId])
  @@index([tenantId, binId])
  @@map("inventory_count_lines")
}
