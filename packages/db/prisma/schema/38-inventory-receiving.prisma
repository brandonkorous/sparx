// Inventory supply path — Receiving (docs/100 P3c). Booking goods against a
// submitted PO: a GoodsReceipt records what physically arrived; each line writes
// a `receive` movement through the ledger (updating moving-average cost) and
// bumps the PO line's received count, advancing the PO to partial/received. A
// receipt is posted atomically on creation — there is no editable draft (a
// correction is a later adjustment/count). Owned by @sparx/inventory;
// standalone-usable — a WMS-lite tenant receives stock with no commerce.

model GoodsReceipt {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  number          String @db.VarChar(20)
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  warehouseId     String @map("warehouse_id") @db.Uuid

  // Vendor packing-slip / carrier reference + a free note; when goods arrived.
  reference  String?  @db.VarChar(120)
  note       String?  @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, number], map: "inventory_goods_receipts_tenant_number_unique")
  @@index([tenantId, purchaseOrderId])
  @@map("inventory_goods_receipts")
}

// One received variant on a receipt. Carries the quantity received in THIS
// receipt + the actual landed unit cost (defaults from the PO line, overridable
// since the invoice cost may differ — this is the moving-average basis). lotNumber
// optionally mints/extends a LotBatch; movementId links to the ledger row written.

model GoodsReceiptLine {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  goodsReceiptId      String @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String @map("purchase_order_line_id") @db.Uuid
  variantId           String @map("variant_id") @db.Uuid

  quantityReceived Int     @map("quantity_received")
  unitCostCents    Int     @map("unit_cost_cents")
  lotNumber        String? @map("lot_number") @db.VarChar(63)

  // Which shelf it was put on (docs/146 Phase 2). Null on a location that does
  // not use bins, and on every receipt taken before bins existed — so the column
  // is nullable rather than backfilled to DEFAULT: recording "we put it in the
  // default bin" for a delivery nobody was asked about would be inventing a fact.
  binId String? @map("bin_id") @db.Uuid
  // Soft pointer to the inventory_movements row this line wrote (no FK — the
  // ledger is append-only and never deleted under a receipt line).
  movementId       String? @map("movement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bin               InventoryBin?     @relation(fields: [binId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderLineId])
  @@index([tenantId, variantId])
  @@map("inventory_goods_receipt_lines")
}
