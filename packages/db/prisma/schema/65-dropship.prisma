// Dropship connector framework — suppliers, products, links, orders.
// (docs/14, docs/64 Dropship Ph1)
//
// One DropshipSupplier per configured connection (CSV, DSers, Spocket, etc.).
// DropshipProduct holds the normalized catalog imported from that supplier.
// DropshipProductLink bridges a Sparx Product to a supplier's SKU.
// DropshipOrder tracks the per-supplier fulfillment groups for a Sparx order.

model DropshipSupplier {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  // csv | dsers | spocket | faire | autods | tapstitch | printful | zendrop | custom
  type        String    @db.VarChar(20)
  // Encrypted credentials bag (API key, secret, etc.) — never log raw.
  credentials Json      @default("{}")
  // connecting | active | error | disconnected
  status      String    @default("connecting") @db.VarChar(20)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz
  // Serialized PricingRule JSON (applied at import time)
  pricingRule Json?     @map("pricing_rule")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       DropshipProduct[]
  dropshipOrders DropshipOrder[]
  // Per-site enablement (docs/14, docs/49). A connection is tenant-wide — one
  // credential set + one imported catalog — and EITHER serves every site (NO
  // rows here, the default) OR is restricted to the listed sites. Mirrors the
  // commerce_product_properties "empty = all sites" convention.
  siteScopes     DropshipSupplierProperty[]

  @@index([tenantId, status])
  @@map("dropship_suppliers")
}

// dropship_suppliers ↔ properties — which SITES a tenant-wide supplier
// connection is enabled on (docs/14, docs/49 §3). JUNCTION table: composite PK,
// NO tenant_id, NO RLS — isolation rides the FK parents via ON DELETE CASCADE,
// exactly like commerce_product_properties. NO rows for a supplier = enabled on
// ALL of the tenant's sites (the default); rows present = enabled ONLY on those
// sites. The catalog (dropship_products) stays tenant-wide; this gates which
// sites may IMPORT/sell from the connection and which connection the order
// router considers for an order placed on a given site.
model DropshipSupplierProperty {
  supplierId String @map("supplier_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  supplier DropshipSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([supplierId, propertyId])
  @@index([propertyId])
  @@map("dropship_supplier_properties")
}

model DropshipProduct {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  supplierId        String @map("supplier_id") @db.Uuid
  supplierProductId String @map("supplier_product_id") @db.VarChar(255)

  title       String  @db.VarChar(255)
  description String? @db.Text
  // Normalized image URLs: string[]
  images      Json    @default("[]")
  // Normalized variant array: NormalizedProductVariant[]
  variants    Json    @default("[]")

  costPriceCents Int  @map("cost_price_cents")
  msrpCents      Int? @map("msrp_cents")

  // Raw supplier payload retained for debugging / re-parsing.
  raw        Json     @default("{}")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier DropshipSupplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  links    DropshipProductLink[]

  @@unique([tenantId, supplierId, supplierProductId], map: "dropship_products_supplier_product_unique")
  @@index([tenantId, supplierId])
  @@map("dropship_products")
}

model DropshipProductLink {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  dropshipProductId String   @map("dropship_product_id") @db.Uuid
  supplierSku       String   @map("supplier_sku") @db.VarChar(255)
  // active | discontinued
  status            String   @default("active") @db.VarChar(20)
  // Forward-compatible seam for print-on-demand (docs/14 §10 — POD authoring is
  // DEFERRED). When a POD supplier (Tapstitch, Printful) is wired for design
  // authoring, the artwork/design binding for this product↔supplier link
  // (designRef, printFileUrls, placement map) lands here without a migration.
  // Null for catalog/order-routing connections (every connection today).
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  dropshipProduct DropshipProduct @relation(fields: [dropshipProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, dropshipProductId], map: "dropship_product_link_unique")
  @@index([tenantId, productId])
  @@index([tenantId, dropshipProductId])
  @@map("dropship_product_links")
}

model DropshipOrder {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  supplierId      String  @map("supplier_id") @db.Uuid
  supplierOrderId String? @map("supplier_order_id") @db.VarChar(255)

  // pending | submitted | shipped | delivered | failed
  status         String  @default("pending") @db.VarChar(20)
  trackingNumber String? @map("tracking_number") @db.VarChar(255)
  trackingUrl    String? @map("tracking_url") @db.VarChar(2048)
  errorMessage   String? @map("error_message") @db.Text

  // Line items submitted to this supplier (subset of the order)
  lineItems Json @default("[]") @map("line_items")

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier DropshipSupplier @relation(fields: [supplierId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@map("dropship_orders")
}
