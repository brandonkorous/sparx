// Cookie consent — per-tenant config + append-only consent log. docs/42 §4.
//
// Config lives in its own 1:1-per-tenant table (NOT Tenant.settings, NOT the
// Commerce-owned CommerceSiteSettings) because consent applies to content-only
// tenants too and must never sit behind the Commerce module gate. The
// `bannerEnabled` flag is DERIVED in code (mode != off AND a non-essential
// category is active) — not stored.
//
// RLS: ENABLE + FORCE + tenant_isolation on both tables — every read/write
// runs inside withTenant() (the storefront always knows the tenant up front).

// Re-keyed from `@id tenantId` to `(tenantId, propertyId)` in docs/131 §3.9.
// Both businesses previously shared one banner, one GDPR/CCPA mode, and one
// policy version — so a tenant operating an EU donut site and a US-only parts
// site could not run the regime each actually needs, and the banner named one
// business to visitors of the other.
model ConsentSettings {
  tenantId         String   @map("tenant_id") @db.Uuid
  // Required, and @unique so Property→settings is a true one-to-one. Unlike
  // redirects or prompts there is NO tenant-wide tier here: consent is a legal
  // relationship between one visitor and one business, so "which site" always
  // has an answer and inheriting a sibling's regime is the defect itself.
  propertyId       String   @unique @map("property_id") @db.Uuid
  mode             String   @default("off") @db.VarChar(10) // off | gdpr | ccpa
  activeCategories Json     @default("[]") @map("active_categories") // e.g. ["analytics","marketing"]
  bannerTitle      String?  @map("banner_title") @db.VarChar(255)
  bannerBody       String?  @map("banner_body") @db.Text
  policyPageSlug   String   @default("cookie-policy") @map("policy_page_slug") @db.VarChar(255)
  policyVersion    String   @default("1") @map("policy_version") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@map("consent_settings")
}

// Append-only (like audit_logs). The latest row per visitor_id is the current
// consent state; the history is the legal proof of when consent was given or
// changed. visitor_id is the UUID held in the strictly-necessary sparx_consent
// cookie; customer_id is set only when the visitor is signed in.

model ConsentRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  // WHICH business this consent was given to (docs/131 §3.9). Required: consent
  // granted on one storefront was silently honoured on the other, which means
  // tracking a visitor on a site they never agreed to be tracked on. That is not
  // a scoping preference, it is the thing consent law exists to prevent — so the
  // column is NOT NULL rather than nullable-with-a-fallback.
  //
  // The `(visitorId, propertyId)` pair is now what identifies a consent state:
  // the same person deciding separately for two businesses is TWO decisions, and
  // that is correct rather than duplication.
  propertyId    String   @map("property_id") @db.Uuid
  visitorId     String   @map("visitor_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  mode          String   @db.VarChar(10) // gdpr | ccpa (snapshot at decision time)
  categories    Json // { strictly_necessary, preferences, analytics, marketing }
  action        String   @db.VarChar(20) // accept_all | reject_all | save_prefs | opt_out
  policyVersion String   @map("policy_version") @db.VarChar(20)
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade, unlike chat conversations — and the difference is worth stating.
  // A conversation is a record worth keeping after its site closes; a consent
  // record is only meaningful AS PERMISSION FOR a specific business. Once that
  // business is gone the permission has no subject, and retaining personal data
  // (ip, user agent) whose only purpose has ended is the wrong default under the
  // same regimes that require the record in the first place.
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // The lookup is now per (site, visitor) — "what did this person agree to ON
  // THIS SITE" — so property_id leads the index rather than trailing it.
  @@index([tenantId, propertyId, visitorId, createdAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@map("consent_records")
}
