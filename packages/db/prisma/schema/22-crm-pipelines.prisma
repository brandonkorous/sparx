// CRM — Sales pipelines + stages + deals.
//
// Tenants run multiple pipelines (e.g. "New B2B Acquisition", "Fleet
// Contract Renewals"). Stages are tenant-editable rows on PipelineStage.
//
// Deals attach to either a customer or a B2B account (or both for a B2B
// contact). Orders/quotes link via the join tables in 23-crm-deal-joins —
// never via a deal_id column on orders/quotes (locked decision #5).

model Pipeline {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The business whose sales process this is (docs/131 §5); null = tenant-wide.
  // The doc's own header cites "Fleet Contract Renewals" — a pipeline is one
  // business's way of working a deal, and a machine shop's stages ("Quote →
  // Approved → Fabricating → Invoiced") mean nothing on a donut wholesaler.
  // Nullable because a shared process is a legitimate default.
  propertyId String? @map("property_id") @db.Uuid
  name       String  @db.VarChar(120)
  slug       String  @db.VarChar(63)

  /// WHAT this process moves through its stages (docs/144 §7.2): `deal` today,
  /// `ticket` since phase 4, and a tenant-invented object key after that.
  ///
  /// A pipeline was implicitly a SALES pipeline, which is why the board and the
  /// funnel report both hardcoded deals. Naming the object turns one column into
  /// the thing that lets a support queue reuse every one of them unchanged —
  /// rather than a second board, a second funnel and a second stage editor that
  /// drift apart the week after they ship.
  objectKey String @default("deal") @map("object_key") @db.VarChar(63)

  isDefault  Boolean   @default(false) @map("is_default")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade: a pipeline is an authored process belonging to the business.
  property Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stages   PipelineStage[]
  deals    Deal[]
  tickets  Ticket[]

  // (tenant, property, object, slug), NULLS NOT DISTINCT — two sites may each
  // run a `sales` pipeline, and one site may run a `default` pipeline for deals
  // AND one for tickets; the tenant-wide tier still can't duplicate a slug
  // within one object.
  @@unique([tenantId, propertyId, objectKey, slug])
  @@index([tenantId, archivedAt])
  @@index([tenantId, objectKey, archivedAt])
  @@index([tenantId, propertyId, archivedAt])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  name        String   @db.VarChar(120)
  sortOrder   Int      @map("sort_order")
  probability Decimal  @default(0) @db.Decimal(5, 2)
  // open | won | lost | resolved | closed. The last two are the ticket vocabulary
  // (docs/144 §7.2): `resolved` = we answered, `closed` = filed and done with.
  // ONE column for both objects rather than a per-object enum, because everything
  // that reads it — the board's terminal columns, the funnel's denominator, the
  // "is this still ours to do" filter — asks the same question of either.
  stageType   String   @default("open") @map("stage_type") @db.VarChar(20)
  color       String?  @db.VarChar(9)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]
  tickets  Ticket[]

  // No property_id (docs/131 §2 pattern 3): a stage exists only under a pipeline,
  // so it inherits the pipeline's site. A column would be able to disagree.
  @@unique([pipelineId, sortOrder])
  @@index([tenantId, pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  // Denormalized from the pipeline AT CREATION (docs/131 §5), like Booking from
  // its service: "what is this business's open pipeline value" is answerable
  // without a join, and re-scoping a pipeline later cannot rewrite which business
  // past deals belonged to. Null = a deal in a tenant-wide pipeline.
  propertyId    String? @map("property_id") @db.Uuid
  pipelineId    String  @map("pipeline_id") @db.Uuid
  stageId       String  @map("stage_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid
  companyId     String? @map("company_id") @db.Uuid
  assignedRepId String? @map("assigned_rep_id") @db.Uuid

  title             String    @db.VarChar(255)
  value             Decimal   @default(0) @db.Decimal(12, 2)
  currency          String    @default("USD") @db.VarChar(3)
  probability       Decimal   @default(0) @db.Decimal(5, 2)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  closedReason      String?   @map("closed_reason") @db.VarChar(500)
  source            String?   @db.VarChar(63)
  tags              String[]  @default([]) @db.VarChar(63)
  metadata          Json      @default("{}")

  // DEAL HEALTH, 0–100 (docs/144 §10) — the same machinery as contact scoring
  // pointed at a different question. A contact's score asks "how interested are
  // they"; a deal's asks "is this one actually going to close", which is what
  // makes a pipeline sortable by something other than value. Zero until the
  // tenant writes a `deal` scoring model.
  score    Int       @default(0)
  scoredAt DateTime? @map("scored_at") @db.Timestamptz

  /// A standing hand adjustment that survives re-scoring — see the same column
  /// on customers for why. A rep who knows the buyer has already signed off
  /// internally can raise a deal's health, and the nightly evaluator keeps it.
  scoreOffset Int @default(0) @map("score_offset")

  // Tenant-declared extra fields on a deal (docs/144 §3) — "contract length",
  // "competitor", "renewal date". Validated against the `deal` row in
  // crm_object_defs. See the note on customers.custom_properties for why this
  // is not `metadata`.
  customProperties Json @default("{}") @map("custom_properties")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull: a deal is a RECORD of a sales opportunity and outlives its site,
  // like orders and bookings.
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage       PipelineStage @relation(fields: [stageId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedRep User?         @relation("DealAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)

  activities    CrmActivity[]
  tasks         Task[]
  orderLinks    DealOrder[]
  documentLinks DealBillingDocument[]

  @@index([tenantId, propertyId, stageId])
  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, assignedRepId, stageId])
  @@index([tenantId, customerId])
  @@index([tenantId, companyId])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, closedAt])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("deals")
}
