// sparx.market — the first-party marketplace (docs/106 §4.7, docs/72). sparx.market
// is "just one more channel" (`channel_connections.channel = 'sparx_market'`,
// shape `first_party`) whose orders are BORN in sparx instead of ingested: a shopper
// checks out on sparx.market, sparx is the merchant-of-record (charges through
// sparx's OWN platform Stripe account), and a weekly settlement run ACH-pays the
// seller tenant `gross − commission − refunds`.
//
// Two CLASSES of table here, mirroring the channels split (docs/106 §4.4):
//
//   GLOBAL projections (cross-tenant SELECT / tenant-scoped write) — the public,
//   unauthenticated marketplace reads every tenant's listings, but products +
//   merchant identity live in FORCE-RLS tenant tables it can't read. So a
//   denormalized, secret-free projection is maintained per write and read
//   globally, exactly like `channel_shop_links` routes a webhook with no session:
//     • MarketListing  — one row per opted-in product (the catalog the site renders).
//     • MarketMerchant — one row per participating tenant (the merchant directory).
//   No FK relations (a global table + FORCE-RLS cascades interact awkwardly — see
//   channel_shop_links); the channel-sync-worker keeps them consistent explicitly.
//
//   TENANT-scoped truth (FORCE RLS, canonical tenant_isolation) — the seller's
//   private market state, edited in the dashboard + read for settlement:
//     • MarketMerchantProfile — the editable bio/banner/enable flag + commission
//       override; the source the MarketMerchant projection is built from.
//     • MarketPayoutAccount   — the ACH bank details (AES-256-GCM ciphertext via
//       @sparx/channels/crypto, never plaintext — the channels token-key box).
//     • MarketSettlement      — one accrual per market order (gross/commission/net).
//     • MarketSettlementRun   — the weekly batch that groups accruals into one ACH.
//
// The product-graph opt-in columns (market_listed / market_category / …) live on
// commerce_products (30-commerce-products.prisma) — a product opts itself in; the
// projection is derived from that flag. Owned by @sparx/commerce (services) + the
// channel-sync-worker (projection). Part of the Commerce module (no separate fee).

// ── GLOBAL projection: the public catalog ───────────────────────────────────────

model MarketListing {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  // The sparx product this listing projects. Stable upsert key (one listing per
  // product); NO FK — this is a global table (cross-tenant readable) kept
  // consistent by the worker, not by a cascade (mirrors channel_shop_links).
  productId String @map("product_id") @db.Uuid

  // Denormalized merchant attribution — the marketplace renders the seller name +
  // logo + store link on every card without a cross-tenant read of FORCE-RLS rows.
  merchantSlug    String  @map("merchant_slug") @db.VarChar(63)
  merchantName    String  @map("merchant_name") @db.VarChar(255)
  merchantLogoUrl String? @map("merchant_logo_url") @db.Text

  // Denormalized product-card data (read straight onto the grid/detail page).
  title              String  @db.VarChar(255)
  handle             String  @db.VarChar(127)
  // The marketplace's own URL slug (`/products/{slug}`) — GLOBALLY unique across
  // every tenant, so the worker disambiguates a colliding handle with a short id
  // suffix. Distinct from `handle` (unique only within a tenant).
  slug               String  @db.VarChar(160)
  descriptionSnippet String? @map("description_snippet") @db.VarChar(512)
  imageUrl           String? @map("image_url") @db.Text
  // One of the market category slugs (auto | beauty | home | fashion | food | tech
  // | general | …) — see @sparx/commerce-schemas MARKET_CATEGORIES.
  category           String  @db.VarChar(50)
  priceMinCents      Int?    @map("price_min_cents")
  priceMaxCents      Int?    @map("price_max_cents")
  currency           String  @default("USD") @db.VarChar(3)
  inStock            Boolean @default(false) @map("in_stock")
  averageRating      Float?  @map("average_rating")
  reviewCount        Int     @default(0) @map("review_count")
  // Denormalized card-badge + trending signals (docs/117 S3). best_seller_rank
  // mirrors commerce_products.best_seller_rank (1 = top seller); low_stock is the
  // computed "in stock but running low" urgency flag. Both maintained by the
  // projection writer + refreshed on inventory drift.
  bestSellerRank     Int?    @map("best_seller_rank")
  lowStock           Boolean @default(false) @map("low_stock")
  // sparx-curated placement (admin-set, mirrors commerce_products.market_featured).
  featured           Boolean @default(false)
  // Absolute URL of the product's page on the seller's own storefront (the
  // "Visit their store" link), resolved from SPARX_SITE_BASE + handle.
  productUrl         String? @map("product_url") @db.Text
  // Lowercased title + description + merchant + category, the source of the
  // generated `search_tsv` tsvector (added in the migration; Prisma can't model it).
  searchText         String? @map("search_text") @db.Text

  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId], map: "market_listings_product_unique")
  @@unique([slug], map: "market_listings_slug_unique")
  @@index([category, featured])
  @@index([tenantId])
  @@index([bestSellerRank], map: "market_listings_best_seller_rank_idx")
  @@map("market_listings")
}

// ── GLOBAL projection: the merchant directory ───────────────────────────────────

model MarketMerchant {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The tenant slug → `/merchants/{slug}`. Globally unique (tenant slugs already are).
  slug         String  @db.VarChar(63)
  // The customer-facing merchant name (Property.name — NOT the legal Tenant.name).
  name         String  @db.VarChar(255)
  logoUrl      String? @map("logo_url") @db.Text
  bannerUrl    String? @map("banner_url") @db.Text
  bio          String? @db.VarChar(2000)
  location     String? @db.VarChar(160)
  headline     String? @db.VarChar(255)
  // The seller's own storefront URL (their *.sparx.zone or custom primary domain).
  siteUrl      String? @map("site_url") @db.Text
  // Ordered [{ platform, url }] mirror of Tenant.socials, for the profile page.
  socials      Json    @default("[]")
  // Count of currently-listed, approved products (drives "Browse N products").
  listingCount Int     @default(0) @map("listing_count")
  // Aggregate seller rating (docs/117 S5) — review-count-weighted mean across the
  // tenant's listings, maintained by the projection writer. Null until reviewed.
  rating       Float?
  ratingCount  Int     @default(0) @map("rating_count")
  featured     Boolean @default(false)
  approved     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId], map: "market_merchants_tenant_unique")
  @@unique([slug], map: "market_merchants_slug_unique")
  @@index([featured])
  @@map("market_merchants")
}

// ── TENANT truth: the editable merchant profile ─────────────────────────────────

model MarketMerchantProfile {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Whether this tenant participates in sparx.market — the first-party channel's
  // "connection" toggle. Off → its products never project, even if flagged.
  enabled               Boolean @default(false)
  bio                   String? @db.VarChar(2000)
  location              String? @db.VarChar(160)
  headline              String? @db.VarChar(255)
  bannerMediaId         String? @map("banner_media_id") @db.Uuid
  // Suggested category when opting a product in (auto-fills the product toggle).
  defaultCategory       String? @map("default_category") @db.VarChar(50)
  // Per-tenant commission override in BASIS POINTS (null → the platform default,
  // MARKET_COMMISSION_BPS). Covers "Enterprise: negotiated" WITHOUT a plan tier —
  // commission is a flat platform rate, not plan-based (the platform has modules,
  // not tiers; docs/106 §4.7 correction to docs/72's plan table).
  commissionBpsOverride Int?    @map("commission_bps_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId], map: "market_merchant_profiles_tenant_unique")
  @@map("market_merchant_profiles")
}

// ── TENANT truth: the ACH payout bank account ───────────────────────────────────

model MarketPayoutAccount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  accountHolderName String  @map("account_holder_name") @db.VarChar(255)
  bankName          String? @map("bank_name") @db.VarChar(255)
  // AES-256-GCM ciphertext (`iv.tag.cipher` base64) via @sparx/channels/crypto —
  // NEVER plaintext. Bank routing/account numbers are sensitive PII; a DB leak
  // alone must not yield them. Reuses the CHANNELS_TOKEN_KEY box (the proven
  // in-repo cipher), not Secret Manager (these never need cross-service decrypt).
  routingNumberEnc  String  @map("routing_number_enc") @db.Text
  accountNumberEnc  String  @map("account_number_enc") @db.Text
  // Last 4 of the account number (plaintext, for the masked dashboard display).
  accountLast4      String? @map("account_last4") @db.VarChar(4)
  // checking | savings
  accountType       String  @default("checking") @map("account_type") @db.VarChar(20)
  // pending | verified | disabled
  status            String  @default("pending") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId], map: "market_payout_accounts_tenant_unique")
  @@map("market_payout_accounts")
}

// ── TENANT truth: per-order settlement accrual ──────────────────────────────────

model MarketSettlement {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  // The native sparx order (channel='marketplace', source='sparx_market'). One
  // accrual per order; no FK relation (the order spine is in CRM — kept by the
  // ingest path, like channelFeeCents on the order itself).
  orderId  String  @map("order_id") @db.Uuid
  // The weekly run this accrual was rolled into; null until settled.
  runId    String? @map("run_id") @db.Uuid

  grossCents      Int     @map("gross_cents")
  commissionBps   Int     @map("commission_bps")
  commissionCents Int     @map("commission_cents")
  refundedCents   Int     @default(0) @map("refunded_cents")
  // gross − commission − refunds; what the seller is owed for this order.
  netCents        Int     @map("net_cents")
  currency        String  @default("USD") @db.VarChar(3)
  // accrued | included | settled | reversed
  status          String  @default("accrued") @db.VarChar(20)
  // The sparx platform PaymentIntent id that collected this order — reconciliation.
  paymentRef      String? @map("payment_ref") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    MarketSettlementRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([orderId], map: "market_settlements_order_unique")
  @@index([tenantId, status])
  @@index([runId])
  @@map("market_settlements")
}

// ── TENANT truth: the weekly settlement batch (one ACH) ─────────────────────────

model MarketSettlementRun {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Timestamptz
  periodEnd   DateTime @map("period_end") @db.Timestamptz

  grossCents           Int       @map("gross_cents")
  commissionCents      Int       @map("commission_cents")
  refundCents          Int       @default(0) @map("refund_cents")
  netCents             Int       @map("net_cents")
  orderCount           Int       @default(0) @map("order_count")
  currency             String    @default("USD") @db.VarChar(3)
  // pending | processing | paid | failed
  status               String    @default("pending") @db.VarChar(20)
  // Which payout rail disbursed this run ('stripe_ach' | 'manual') + its reference.
  disbursementProvider String?   @map("disbursement_provider") @db.VarChar(40)
  disbursementRef      String?   @map("disbursement_ref") @db.VarChar(255)
  failureReason        String?   @map("failure_reason") @db.Text
  reportEmailSentAt    DateTime? @map("report_email_sent_at") @db.Timestamptz
  paidAt               DateTime? @map("paid_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlements MarketSettlement[]

  @@index([tenantId, status])
  @@index([tenantId, periodEnd])
  @@map("market_settlement_runs")
}
