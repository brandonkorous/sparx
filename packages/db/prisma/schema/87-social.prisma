// Social posting module (docs/133) — connect the tenant's OWN social accounts
// (Facebook Page, Instagram, Threads, LinkedIn, Google Business Profile, X,
// TikTok, Pinterest, YouTube) and publish native posts to them, on a schedule,
// by automation, or on demand. FREE, cross-cutting module — gated on its own flag
// (no separate fee), NOT folded into commerce the way channels are.
//
//   SocialConnection  — one per (tenant, site, platform): the OAuth grant to one
//                       connected account. Tokens are AES-256-GCM ENCRYPTED on the
//                       row (never plaintext), boxed via @sparx/social/crypto with
//                       SOCIAL_TOKEN_KEY — the SAME row-cipher pattern channels
//                       uses (docs/106 §4.6). SEPARATE from ChannelConnection: a
//                       Meta *posting* grant and a Meta *feed/shop* grant are
//                       different OAuth scope sets on the same account (docs/133 §6).
//   SocialTarget      — a concrete destination under a connection (a specific
//                       Facebook Page, IG account, LinkedIn org page, GBP location).
//                       One OAuth grant can manage several — the tenant picks which.
//   SocialPost        — the composed, platform-agnostic post (text + media refs +
//                       link) with its draft→approve→schedule→publish lifecycle.
//   SocialPostTarget  — the fan-out join: one row per target a post publishes to,
//                       carrying the per-channel override AND the per-target result.
//                       Each target succeeds/fails independently (hence the post's
//                       `partially_published` state). Holds the published permalink,
//                       so it stores a FK-LESS targetId + denormalized name/platform
//                       (like ChannelShopLink) — publish history must survive a later
//                       account disconnect that cascades the SocialTarget away.
//
// All four are tenant-scoped (FORCE RLS, canonical tenant_isolation). Site scope
// follows docs/131 §4: a connection belongs to ONE business/site (an Instagram for
// Bob's Parts is not Savory Donuts'), so SocialConnection + SocialPost carry a
// nullable property_id (null = the tenant's one site); SocialTarget inherits its
// site from the connection and SocialPostTarget from the post (no property_id).
// Owned by @sparx/social, driven by the social-worker + the api-rest OAuth routes.

model SocialConnection {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The site whose brand this account speaks for (docs/131 §4). A connected social
  // account belongs to ONE business — mirrors ChannelConnection. Nullable so a
  // single-site tenant's connection stays valid as-is (null = the tenant's one
  // site); the manage UI defaults new connections to the working site.
  propertyId String? @map("property_id") @db.Uuid

  // facebook_page | instagram | threads | linkedin | google_business | x |
  // tiktok | pinterest | youtube (docs/133 §4).
  platform String @db.VarChar(40)

  // active | expired | revoked (docs/133 §6). `expired` when a refresh fails —
  // surfaces a "reconnect" prompt rather than a silent publish failure.
  status String @default("active") @db.VarChar(20)

  // The connected account's own id + display, captured after the OAuth handshake.
  externalId  String? @map("external_id") @db.VarChar(255)
  displayName String? @map("display_name") @db.VarChar(255)
  avatarUrl   String? @map("avatar_url") @db.Text

  // OAuth tokens, AES-256-GCM ciphertext (`iv.tag.cipher` base64) — NEVER plaintext
  // (docs/133 §5). Boxed/unboxed via @sparx/social/crypto with SOCIAL_TOKEN_KEY (a
  // dedicated key, not the channels key — blast-radius isolation). Text, not
  // VarChar: a boxed refresh token can exceed a 512 budget. Null until the
  // handshake completes.
  accessTokenEnc  String?   @map("access_token_enc") @db.Text
  refreshTokenEnc String?   @map("refresh_token_enc") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz

  // Granted OAuth scopes — surfaces a re-auth prompt when the required set grows.
  scopes String[] @default([]) @db.VarChar(120)

  // Last connect/refresh error [{ at, code, message }] for the manage UI.
  lastError Json? @map("last_error")
  metadata  Json  @default("{}")

  // When the health sweep last checked this grant (social-worker's connection
  // health drain). A grant is only usable until its token expires, so the sweep
  // refreshes AHEAD of expiry and flips `status` to `expired` the moment a refresh
  // fails — the tenant sees "reconnect needed" BEFORE a post is lost, rather than
  // discovering it from a failed publish (docs/133 §6.5). Null = never checked.
  healthCheckedAt DateTime? @map("health_checked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade: a connection is one business's link to its own account, holding that
  // account's OAuth tokens. It goes with the site.
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  targets  SocialTarget[]

  // One connection per platform per SITE for now (multi-account relaxes this to
  // (tenant, property, platform, external_id) later). The migration SQL hand-edits
  // this to NULLS NOT DISTINCT so at most one tenant-wide (property NULL) connection
  // per platform too — the plain compound unique would let unlimited
  // (tenant, NULL, 'instagram') rows coexist.
  @@unique([tenantId, propertyId, platform], map: "social_connections_tenant_property_platform_unique")
  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@map("social_connections")
}

// NOTE: SocialTarget carries NO property_id (docs/131 §4 pattern) — a target exists
// only under a connection, and the connection is site-scoped, so the target's site
// is its connection's. The `(connection_id, external_target_id)` unique binds it.
model SocialTarget {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  // Denormalized from the connection for query convenience (a target row is often
  // read without its connection — mirrors ChannelProductMapping carrying `channel`).
  platform String @db.VarChar(40)

  // The destination's id on the platform (the Facebook Page id, GBP location id,
  // LinkedIn org urn) + its human name for display + the composer picker.
  externalTargetId String  @map("external_target_id") @db.VarChar(255)
  name             String  @db.VarChar(255)
  avatarUrl        String? @map("avatar_url") @db.Text

  // Whether this target is an active publish destination (a tenant may attach a
  // Page but pause posting to it without disconnecting the whole account).
  enabled  Boolean @default(true)
  metadata Json    @default("{}")

  // When the engagement inbox last pulled comments/mentions/reviews for this
  // destination (docs/133 "Engage"). The sweep's cursor — null = never synced, so a
  // freshly attached destination backfills its recent activity on the first pass.
  inboxSyncedAt DateTime? @map("inbox_synced_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // One row per destination per connection.
  @@unique([connectionId, externalTargetId], map: "social_targets_connection_external_unique")
  @@index([tenantId, platform])
  @@index([connectionId])
  @@map("social_targets")
}

model SocialPost {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  // The site this post speaks for (docs/131 §4). Nullable = the tenant's one site.
  propertyId String? @map("property_id") @db.Uuid

  // The composed, platform-agnostic source. `body` is the base text; per-target
  // adaptations live on SocialPostTarget.
  body String  @db.Text
  link String? @db.Text

  // Media asset ids (from @sparx/media) attached to the post. FK-less String[]: the
  // media lifecycle is independent, and a deleted asset simply drops from the render
  // rather than blocking the post. The renderer resolves these to CDN URLs per
  // target (with per-platform aspect variants — docs/133 §8).
  mediaAssetIds String[] @default([]) @map("media_asset_ids") @db.Uuid

  // draft | pending_approval | scheduled | publishing | published |
  // partially_published | failed (docs/133 §7).
  status String @default("draft") @db.VarChar(24)

  // Where this post came from (docs/133 §8): manual | product | content | campaign |
  // automation. `sourceRef` is the originating entity id (a product/content id) for
  // the source mapper + later attribution; null for a plain brand post.
  source    String  @default("manual") @db.VarChar(20)
  sourceRef String? @map("source_ref") @db.VarChar(255)

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  // The approval gate (docs/133 §7). Approving is a staff permission; the ids are
  // staff user ids, FK-less (a staff user removal must not delete brand history).
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  createdById  String?   @map("created_by_id") @db.Uuid

  // Why a reviewer sent this post back (docs/133 §7). Without it a rejection is a
  // silent state change and the author has to guess what to fix. Cleared when the
  // post is resubmitted.
  reviewNote String? @map("review_note") @db.Text

  // The evergreen pool (docs/133 §8 "post sources"). An evergreen post is one the
  // tenant is happy to run again: once published it stays in the pool, and the slot
  // filler re-schedules the least-recently-used one into the next empty posting slot.
  // `lastRecycledAt` is that LRU cursor — null until it has been recycled once.
  evergreen      Boolean   @default(false)
  lastRecycledAt DateTime? @map("last_recycled_at") @db.Timestamptz

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  targets  SocialPostTarget[]

  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  // Drives the scheduled drain's cross-tenant scan (status='scheduled' AND
  // scheduled_at <= now()) mirroring find_due_scheduled_entries — see the RLS
  // migration's find_due_social_posts() SECURITY DEFINER function.
  @@index([status, scheduledAt])
  @@map("social_posts")
}

model SocialPostTarget {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  postId   String @map("post_id") @db.Uuid

  // The destination this row publishes to. FK-LESS (a plain uuid, no relation): the
  // published permalink + external id below are permanent history that must survive
  // a later account disconnect (which cascades the SocialTarget away). name +
  // platform are denormalized so the row stays self-describing without the target.
  socialTargetId String @map("social_target_id") @db.Uuid
  targetName     String @map("target_name") @db.VarChar(255)
  platform       String @db.VarChar(40)

  // Per-channel overrides (docs/133 §8). textOverride adapts the base body for this
  // platform; mediaOverride swaps assets / focal points; firstComment is e.g. the
  // hashtag block posted as the first comment on IG/LinkedIn.
  textOverride  String? @map("text_override") @db.Text
  mediaOverride Json?   @map("media_override")
  firstComment  String? @map("first_comment") @db.Text

  // pending | publishing | published | failed | skipped (docs/133 §7). Each target
  // resolves independently — the parent post is `partially_published` when some
  // published and some failed.
  status String @default("pending") @db.VarChar(20)

  // This destination's OWN send time, when it differs from the post's (docs/133 §8).
  // The audience on a Facebook Page and on a LinkedIn company page are awake at
  // different hours, so one composed post can land at the right local moment on each.
  // NULL = inherit `SocialPost.scheduledAt`, which is the common case.
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz

  // The result the platform returns on success — the published post id + its public
  // URL. Kept as permanent history (see the FK-less note above).
  externalId String? @map("external_id") @db.VarChar(255)
  permalink  String? @db.Text

  // Failure detail + the per-target retry budget (docs/133 §7). attemptCount backs
  // the per-connection exponential backoff in the worker.
  error        String? @db.Text
  attemptCount Int     @default(0) @map("attempt_count")

  publishedAt DateTime? @map("published_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // One row per (post, target) — the idempotency anchor (`postId:socialTargetId`)
  // the worker publishes with, so a replay is a no-op on a target already posted to.
  @@unique([postId, socialTargetId], map: "social_post_targets_post_target_unique")
  @@index([tenantId, status])
  @@index([postId])
  // Drives the per-destination drain (a target with its OWN scheduled_at fires on its
  // own clock, independent of its siblings) — mirrors social_posts(status, scheduled_at).
  @@index([status, scheduledAt])
  @@map("social_post_targets")
}

// Per-target performance SNAPSHOTS (docs/133 §4 `getMetrics` seam +
// docs/implementation/social.md "Measure"). One row per (post target, collection): a
// time series, because a post's numbers keep climbing for days after it goes out, so
// "how did it do?" is best read as the LATEST snapshot (max collected_at) with the
// earlier ones available for a trend. Filled by the social-worker on a
// `social.metrics.collect` event, which calls the platform adapter's getMetrics.
//
// EVERY metric is nullable on purpose: engagement counts (likes/comments/shares) come
// back on close to current scopes, but reach/impressions need extra platform review — a
// platform that can't report one leaves it NULL, never a misleading zero. FK-less to the
// SocialTarget (that row may be disconnected away); postTargetId points at the fan-out
// row whose external_id is the platform's own post id.
model SocialPostMetric {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  postId       String @map("post_id") @db.Uuid
  postTargetId String @map("post_target_id") @db.Uuid
  platform     String @db.VarChar(40)

  likes       Int?
  comments    Int?
  shares      Int?
  impressions Int?
  reach       Int?

  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Scalar FKs only (no Prisma relations): the cascade lives in the hand-edited
  // migration SQL, and the service reads by id — keeping this model from having to add
  // back-relations onto Tenant / SocialPost / SocialPostTarget.
  @@index([tenantId, postId])
  @@index([postTargetId, collectedAt])
  @@map("social_post_metrics")
}

// A saved block of hashtags the composer can drop into a post (or its first comment)
// in one click — the single most-repeated typing in social posting, and the thing a
// business gets wrong when it retypes it from memory every time. Site-scoped like the
// rest of the module; `platform` narrows a set to where it belongs (an Instagram tag
// block is noise on LinkedIn), null = offer it everywhere.
model SocialHashtagSet {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  propertyId String? @map("property_id") @db.Uuid

  name String  @db.VarChar(120)
  // Stored WITHOUT the leading '#': the service normalizes on write so a set is
  // comparable and the UI decides how to render it.
  tags     String[] @default([]) @db.VarChar(120)
  platform String?  @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, name], map: "social_hashtag_sets_tenant_property_name_unique")
  @@index([tenantId, propertyId])
  @@map("social_hashtag_sets")
}

// One recurring slot in the week's posting cadence ("Tuesdays at 9am"). Two jobs:
//   1. It is the shape of a plan — the calendar draws empty slots so a gap in next
//      week is visible as a gap, not as blank space.
//   2. It is where the evergreen filler puts things. A tenant with a pool of
//      evergreen posts and three slots a week never has a silent week.
// `minuteOfDay` + `timezone` rather than a timestamp: a slot is a recurring local
// time, and "9am" must stay 9am across a daylight-saving boundary.
model SocialPostingSlot {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  propertyId String? @map("property_id") @db.Uuid

  // 0 = Sunday … 6 = Saturday, matching JS `Date.getDay()`.
  weekday     Int
  minuteOfDay Int    @map("minute_of_day")
  timezone    String @default("UTC") @db.VarChar(64)

  // Which destinations an auto-filled post goes to. FK-less uuids (a destination can
  // be disconnected away); the filler skips ids that no longer resolve.
  targetIds String[] @default([]) @map("target_ids") @db.Uuid

  // Off by default is wrong here — a slot exists because someone created it — but a
  // tenant pauses a slot for a holiday without losing it.
  enabled Boolean @default(true)
  // Whether the evergreen filler may claim this slot. A slot can be plan-only (draw
  // the gap, never auto-fill it), which is the honest default for a brand that wants
  // a human in the loop.
  autoFill Boolean @default(false) @map("auto_fill")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId])
  @@index([enabled, autoFill])
  @@map("social_posting_slots")
}

// The engagement inbox (docs/implementation/social.md "Engage") — the inbound half of
// the module. Publishing without replying is half a social tool: a comment on a post
// is a customer talking to the business, and today it lands somewhere nobody at the
// business is looking.
//
// ONE table holds both directions. An inbound comment and our reply to it are the same
// shape (author, text, platform id, timestamp) and belong on one thread; splitting them
// would mean two tables that must be interleaved on every read. `direction` tells them
// apart; `parentExternalId` threads them.
//
// FK-less `socialTargetId` / `postTargetId` for the same reason SocialPostTarget is:
// conversation history is permanent and must survive a disconnect that cascades the
// destination away.
model SocialInboxItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  propertyId String? @map("property_id") @db.Uuid

  socialTargetId String  @map("social_target_id") @db.Uuid
  targetName     String  @map("target_name") @db.VarChar(255)
  platform       String  @db.VarChar(40)
  // The post this is a comment ON, when we published it and can join them up. Null for
  // a mention, a DM, or a comment on something posted outside sparx.
  postTargetId   String? @map("post_target_id") @db.Uuid

  // comment | mention | review | message (docs/133 "Engage"). A Google Business review
  // and a Facebook comment are different enough to filter on and similar enough to
  // answer in one place.
  kind String @db.VarChar(20)
  // inbound = they said it; outbound = we replied. One thread reads in order.
  direction String @default("inbound") @db.VarChar(10)

  // The item's own id on the platform + the thread it belongs to. The unique below
  // makes the sync idempotent: re-polling never duplicates a comment.
  externalId       String  @map("external_id") @db.VarChar(255)
  threadExternalId String? @map("thread_external_id") @db.VarChar(255)
  parentExternalId String? @map("parent_external_id") @db.VarChar(255)

  authorName      String? @map("author_name") @db.VarChar(255)
  authorHandle    String? @map("author_handle") @db.VarChar(255)
  authorAvatarUrl String? @map("author_avatar_url") @db.Text

  text String? @db.Text
  // 1–5 for a review; null for everything else.
  rating    Int?
  permalink String? @db.Text

  // open | replied | archived. `open` is the inbox; archiving is how a business says
  // "seen, nothing to do" without deleting a customer's words.
  status String @default("open") @db.VarChar(20)

  receivedAt  DateTime  @map("received_at") @db.Timestamptz
  repliedAt   DateTime? @map("replied_at") @db.Timestamptz
  handledById String?   @map("handled_by_id") @db.Uuid

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Idempotent sync: one row per platform item per destination.
  @@unique([socialTargetId, externalId], map: "social_inbox_items_target_external_unique")
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, propertyId])
  @@index([threadExternalId])
  @@map("social_inbox_items")
}
