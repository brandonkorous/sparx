// SEO — stored audit scorecard snapshots (docs/50 §7).
//
// One row per audited entity per tenant: the last computed score + grade + the
// full scorecard JSON. The live endpoint (`GET /v1/seo/audit`) recomputes on
// demand and upserts here; a reindex recomputes the whole site. The site-wide
// SEO overview reads these snapshots so it can rank every page without firing N
// live audits.
//
// Tenant-scoped + FORCE RLS, like the rest of the tenant tables — a callsite that
// forgets withTenant() sees nothing rather than leaking cross-tenant scores. The
// ENABLE+FORCE RLS and the tenant_isolation policy are hand-added in the migration
// SQL (Prisma doesn't generate RLS).

model SeoAudit {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The SITE this audited entity belongs to, when it belongs to exactly ONE
  // (docs/131 §4).
  //
  // Why this matters: an SEO score is an AVERAGE over a set of pages, so merging
  // two sites does not merely mislabel the number, it computes a DIFFERENT one —
  // a well-optimised machine-shop site drags up a neglected donut site's grade
  // and hides the problem, which is the opposite of what the overview exists to
  // surface.
  //
  // NULLABLE, though, and the reason is worth stating because "required" is the
  // tempting answer: the four audited entity types do not agree on site
  // membership. A `builder_page` carries `property_id` directly — it is one
  // site's page, full stop. A `product` or `collection` reaches sites through the
  // ProductProperty / CollectionProperty JUNCTIONS and can legitimately appear on
  // several, while having ONE score (its title and description are the same
  // wherever it shows). Forcing a single site onto those rows would be inventing
  // a fact the data does not have.
  //
  // So: SET for single-site entities, NULL for shared ones — and a site's
  // overview is "audits scoped to me, UNION audits for entities I expose",
  // resolved through the junctions that already answer that question.
  propertyId String? @map("property_id") @db.Uuid

  // builder_page | cms_page | product | collection (matches @sparx/seo-audit EntityType).
  entityType String @map("entity_type") @db.VarChar(20)
  entityId   String @map("entity_id") @db.Uuid

  // Denormalized for cheap sorting/filtering + rendering in the overview without
  // re-fetching each entity: the score, grade, top fix, the display title, and a
  // best-effort storefront path.
  score    Int
  grade    String  @db.VarChar(20)
  fixFirst String? @map("fix_first") @db.VarChar(500)
  title    String? @db.VarChar(300)
  path     String? @db.VarChar(2048)
  // The full Scorecard JSON — lets the overview render the report without a live
  // recompute. Shape owned by @sparx/seo-audit; never validated by the DB.
  card     Json

  computedAt DateTime @map("computed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade: a score is a derived measurement of pages that no longer exist once
  // the site is gone. Nothing is lost that a reindex could not recompute.
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Uniqueness stays on (tenant, entityType, entityId) WITHOUT property_id, and
  // that is deliberate: an entity belongs to exactly one site, so adding it would
  // let the same page hold two contradictory scores under different sites. The
  // key expresses "one score per thing"; property_id is an attribute of the
  // thing, not part of its identity.
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, score])
  @@index([tenantId, entityType])
  @@index([tenantId, propertyId, score])
  @@map("seo_audits")
}
