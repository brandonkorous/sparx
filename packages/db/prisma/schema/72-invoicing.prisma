// Invoicing module (docs/87) — authored billing documents.
//
// A BillingDocument is a human-built estimate / work order / invoice / ticket
// that moves through a tenant-configured stage workflow and bills a retail
// Customer OR a B2BAccount. The workflow/stage/line-type config tables below are
// the Phase 1 substrate — the documents, lines, snapshots and payments land in
// later phases (docs/87 §16). The shape deliberately mirrors the proven CRM
// Pipeline / PipelineStage pattern (22-crm-pipelines.prisma): tenant-owned,
// ordered, editable stages with a semantic `stageType` that drives behavior
// while the customer-facing label stays the tenant's.
//
// Gated by the `invoicing` module flag (docs/87 §14), not a plan tier.

// A tenant-configured document lifecycle. A "Quick Invoice" is a one-stage
// workflow; a shop builds "Estimate → Approved → In Progress → Invoiced → Paid".
model DocumentWorkflow {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(120)
  slug       String    @db.VarChar(63)
  isDefault  Boolean   @default(false) @map("is_default")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages    DocumentStage[]
  documents BillingDocument[]

  @@unique([tenantId, slug])
  @@index([tenantId, archivedAt])
  @@map("document_workflows")
}

// An ordered step in a workflow. `customerLabel` is the noun shown to the
// customer at this stage ("Estimate", "Invoice", "Work Order", "Ticket") — this
// is how one engine serves every industry. System behavior keys off `stageType`,
// never the label.
model DocumentStage {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  workflowId    String  @map("workflow_id") @db.Uuid
  name          String  @db.VarChar(120)
  customerLabel String  @map("customer_label") @db.VarChar(60)
  // draft | open | committed | final | paid | void
  // committed = customer-approved; final = billable/locked.
  stageType String @default("draft") @map("stage_type") @db.VarChar(20)
  // Freeze an immutable BillingDocumentSnapshot when a document enters here (§4).
  snapshotOnEnter Boolean @default(false) @map("snapshot_on_enter")
  // Mint a stage-specific document number on first entry (EST-… then INV-…) (§9).
  numberOnEnter Boolean @default(false) @map("number_on_enter")
  numberPrefix  String? @map("number_prefix") @db.VarChar(12)
  // Once final/paid, the document's lines are frozen.
  locksEditing Boolean @default(false) @map("locks_editing")
  color        String? @db.VarChar(9)
  sortOrder    Int     @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow  DocumentWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  documents BillingDocument[]
  snapshots BillingDocumentSnapshot[]

  @@index([tenantId, workflowId])
  @@index([workflowId, sortOrder])
  @@map("document_stages")
}

// Tenant-owned line-type registry. A line type carries BEHAVIOR (how the line is
// priced + taxed), not just a label — that is what lets "Part", "Labor",
// "Sublet", "Freight", "Shop materials" all flow through one document engine
// (docs/87 §5). Seeded with defaults on module activation; fully editable.
model BillingDocumentLineType {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  // Stable per-tenant reference key (idempotent seeding + line FKs); slug-like.
  key   String @db.VarChar(63)
  name  String @db.VarChar(80)
  label String @db.VarChar(80)
  // catalog | markup | labor | flat | pass_through (docs/87 §5)
  pricingMode String @default("flat") @map("pricing_mode") @db.VarChar(16)
  // Parts usually taxable; labor often not (jurisdiction-dependent). Per-line
  // overridable — this is just the default a new line of this type inherits.
  defaultTaxable Boolean @default(true) @map("default_taxable")
  // A `markup` line defaults to this rule/matrix (resolved by the shipped engine).
  defaultMarkupRuleId String? @map("default_markup_rule_id") @db.Uuid
  // Optional pricing helper, e.g. `percent_of_labor` for shop-materials.
  computation String? @db.VarChar(40)
  // Reporting buckets (parts vs labor vs sublet margin).
  glCode    String? @map("gl_code") @db.VarChar(40)
  category  String? @db.VarChar(40)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultMarkupRule MarkupRule? @relation("LineTypeDefaultMarkupRule", fields: [defaultMarkupRuleId], references: [id], onDelete: SetNull)
  lines             BillingDocumentLine[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("billing_document_line_types")
}

// An authored billing document (docs/87 §2/§6/§11). Bills a retail Customer OR
// a B2BAccount (at least one set — the Deal pattern). Lives on a workflow at a
// stage; lines carry the charges; totals are derived from the lines plus the
// per-document tax rate, shipping, and surcharge. Money is Decimal(12,2) dollars
// (matching orders/quotes); cost basis is Int cents (matching the markup engine).
model BillingDocument {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  workflowId     String  @map("workflow_id") @db.Uuid
  stageId        String  @map("stage_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid
  b2bAccountId   String? @map("b2b_account_id") @db.Uuid
  assignedUserId String? @map("assigned_user_id") @db.Uuid

  // Minted per `numberOnEnter` stage (Phase 3). Null until the document reaches
  // a numbering stage. Unique per tenant when set (NULLs don't collide).
  number String? @map("number") @db.VarChar(63)
  // Stable per-tenant document sequence, allocated once on first numbering. The
  // formatted `number` swaps prefix as the document advances (EST-000123 →
  // INV-000123) but keeps this suffix — one document carries one number for
  // life (§9). Unique per tenant when set; NULL until first numbered.
  numberSeq Int?    @map("number_seq")
  currency  String  @default("USD") @db.VarChar(3)

  // Denormalized party snapshots ({ name, address, … }) frozen onto the document
  // so a later customer-record edit never rewrites a finalized document (§6).
  billTo Json? @map("bill_to")
  shipTo Json? @map("ship_to")

  // Tax rate applied to taxable lines (0.0875 = 8.75%); the per-line `taxable`
  // flag selects which lines it hits. Jurisdiction automation deferred (§17).
  taxRate Decimal @default(0) @map("tax_rate") @db.Decimal(6, 4)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal  Decimal @default(0) @map("shipping_total") @db.Decimal(12, 2)
  surchargeTotal Decimal @default(0) @map("surcharge_total") @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  depositTotal   Decimal @default(0) @map("deposit_total") @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance        Decimal @default(0) @db.Decimal(12, 2)

  // AR status — payment-derived, independent of the workflow stage (§8):
  // unpaid | partial | paid | overdue | void.
  status String @default("unpaid") @db.VarChar(20)
  // Net-terms due date — set on finalize from the B2B account's payment terms,
  // or by hand. Drives overdue escalation (§8). Null for pay-now/retail docs.
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  overdueDays Int       @default(0) @map("overdue_days")

  notes       String?   @db.Text
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz
  metadata    Json      @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow     DocumentWorkflow @relation(fields: [workflowId], references: [id])
  stage        DocumentStage    @relation(fields: [stageId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  b2bAccount   B2BAccount?      @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  assignedUser User?            @relation("BillingDocumentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  lines        BillingDocumentLine[]
  snapshots    BillingDocumentSnapshot[]
  payments     BillingDocumentPayment[]

  @@unique([tenantId, number], map: "billing_documents_tenant_number_unique")
  @@unique([tenantId, numberSeq], map: "billing_documents_tenant_seq_unique")
  @@index([tenantId, workflowId, stageId])
  @@index([tenantId, customerId])
  @@index([tenantId, b2bAccountId])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("billing_documents")
}

// A single charge line on a billing document (docs/87 §5). Its behavior comes
// from the referenced line type's `pricingMode`; the computed snapshot
// (`appliedMarkup`) is stamped on markup/pass-through lines so the price is
// reproducible after cost drift (the §5 reproducibility requirement). `quantity`
// is Decimal to carry fractional labor hours (e.g. 2.5 h).
model BillingDocumentLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  documentId       String  @map("document_id") @db.Uuid
  lineTypeId       String? @map("line_type_id") @db.Uuid
  productId        String? @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  technicianUserId String? @map("technician_user_id") @db.Uuid

  description String  @db.VarChar(500)
  quantity   Decimal @default(1) @db.Decimal(12, 3)
  unitPrice  Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)

  // Cost basis (Int cents) + reproducibility snapshot for markup/pass-through
  // lines. Null for flat/labor/catalog lines that aren't cost-derived.
  costCents     Int?  @map("cost_cents")
  appliedMarkup Json? @map("applied_markup")

  taxable        Boolean @default(true)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineSubtotal   Decimal @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  sortOrder Int  @default(0) @map("sort_order")
  metadata  Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   BillingDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineType   BillingDocumentLineType? @relation(fields: [lineTypeId], references: [id], onDelete: SetNull)
  product    Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  technician User?                    @relation("BillingLineTechnician", fields: [technicianUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId])
  @@index([variantId])
  @@map("billing_document_lines")
}

// An immutable freeze of a billing document at a stage transition (docs/87 §4).
// The live `BillingDocument` keeps evolving; a snapshot is the document exactly
// as it stood when it entered a `snapshotOnEnter` stage — "the approved
// estimate" / "the final invoice," preserved forever. Append-only: never edited
// or deleted (mirrors CRM ContentRevision + the append-only activity log). A
// void/correction adds a NEW snapshot; it never rewrites one. `snapshot` is the
// full JSON freeze (lines + totals + party + stage); `pdfMediaId` is filled by
// the Phase 5 renderer so the frozen copy prints identically forever.
model BillingDocumentSnapshot {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  documentId     String  @map("document_id") @db.Uuid
  stageId        String  @map("stage_id") @db.Uuid
  // Stage metadata frozen at capture time so a later stage rename never
  // rewrites what this snapshot represents.
  stageType     String  @map("stage_type") @db.VarChar(20)
  customerLabel String  @map("customer_label") @db.VarChar(60)
  // The document number at the instant of capture (EST-000123 on the approved
  // estimate, INV-000123 on the final invoice).
  documentNumber String? @map("document_number") @db.VarChar(63)
  // The full freeze: { stage, document(+totals), party(+billTo/shipTo), lines }.
  snapshot Json
  // Phase 5 renders + stores the print artifact and back-fills this media id.
  pdfMediaId  String?  @map("pdf_media_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document  BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stage     DocumentStage   @relation(fields: [stageId], references: [id])
  createdBy User?           @relation("BillingSnapshotAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId, createdAt(sort: Desc)])
  @@map("billing_document_snapshots")
}

// A builder-authored PRINT TEMPLATE (docs/87 §10) — the document's printed
// presentation as ONE BuilderNode tree, AUTHOR-only. A peer of BuilderEmail in
// the builder framework: the editor edits `draftTree`, publishing snapshots it
// into `publishedTree`. The tenant's default template (one per tenant) drives the
// `…/pdf` render; absent a published default, the built-in code renderer is used,
// so a tenant never *must* design one. A built-in default tree ships seeded
// (lazy-materialised on first list); the builder edits that copy.
model BillingDocumentTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(120)
  // One default per tenant (partial-unique WHERE is_default, hand-SQL) — the
  // template `…/pdf` resolves when published.
  isDefault Boolean @default(false) @map("is_default")

  // The editor's working tree; publishing snapshots it into publishedTree. Both
  // are validated BuilderNode trees (the same shape the page/email builders store).
  draftTree     Json      @map("draft_tree")
  publishedTree Json?     @map("published_tree")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("billing_document_templates")
}

// A payment / deposit / refund recorded against a billing document (docs/87 §8).
// Append-only: a correction is a new (refund) row, never an edit or delete — the
// document's `amountPaid` / `depositTotal` / `balance` / `status` are derived from
// the sum of these rows. Money is Decimal(12,2) dollars, uniform with the
// document totals. `kind` separates a pre-finalize deposit from a regular payment
// and from a refund (refunds reduce amountPaid).
model BillingDocumentPayment {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  // deposit | payment | refund (§8)
  kind String @db.VarChar(16)
  // cash | card | check | ach | wire | store_credit | other
  method String  @db.VarChar(16)
  amount Decimal @db.Decimal(12, 2)
  // Free-text instrument reference (check #, memo) + optional provider charge id
  // when captured through a payment provider.
  reference   String? @db.VarChar(120)
  providerRef String? @map("provider_ref") @db.VarChar(200)
  note        String? @db.Text

  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz
  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recordedBy User?           @relation("BillingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId, receivedAt(sort: Desc)])
  @@map("billing_document_payments")
}
