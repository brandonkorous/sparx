# services/push-worker local dev defaults. Real values for sparx-prod come from
# Google Secret Manager (DATABASE_URL ← `database-url` secret; VAPID_* ← the
# web-push key secrets), mounted by the cloud-run-worker Terraform module. Copy
# this file to `.env` to run locally.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev, so it idles on its
# listen port. DATABASE_URL is OPTIONAL (the worker boots without it) but is
# needed to load push subscriptions, so the dev URL is included below.

NODE_ENV=development
LOG_LEVEL=debug
# Workers default to 8080; 8080-8090 are taken by other workers, so push-worker
# takes 8091 to avoid EADDRINUSE under `turbo dev`.
PORT=8091

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Web Push (VAPID) keys — unset locally → actual browser sends are skipped.
# Generate a dev pair with `npx web-push generate-vapid-keys` if you need to
# exercise real delivery. VAPID_SUBJECT defaults to mailto:support@sparx.works.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@sparx.works

# Unset locally → OIDC caller check is off.
# PUBSUB_INVOKER_SA=
