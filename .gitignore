node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/

# Test/coverage
coverage/
*.lcov
.vitest-cache/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Env
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.vscode/*
