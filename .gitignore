# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/

# Test/coverage
coverage/
*.lcov
.vitest-cache/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Env
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
.tsbuildinfo

# Misc
.cache/

# MCP / browser-automation scratch
.playwright-mcp/
.playwright-cli/
postal-*.png

# Marketplace bundle-authoring scratch (docs/85 — regenerated on demand)
# NOTE: _gen/ is TRACKED — it's the authored SOURCE that emits the committed blueprint
# bundles (the generator a developer hand-edits), not scratch. _src/_assets are raw inputs.
marketplace-catalog/_src/
marketplace-catalog/_assets/
apps/dashboard/_marketplace-assets.mjs

# Local media storage (LocalStorage MEDIA_LOCAL_DIR — generated, never committed)
**/.media-tmp/
**/raw videos/*
# Impeccable — local hook consent + session cache (regenerated; never committed).
# NOTE: the design spec apps/*/.impeccable/design.json IS tracked (pairs with DESIGN.md);
# only the machine-local *.local.json / *.cache.json scratch is ignored.
**/.impeccable/*.local.json
**/.impeccable/*.cache.json
# The live/ runtime dir (server port, sessions, annotations) is per-machine session state.
**/.impeccable/live/

# Local media storage — the LocalStorage driver's on-disk root (MEDIA_LOCAL_DIR) when
# api-rest runs in `local` mode. Real tenant uploads (originals + transcoded variants)
# land here at runtime; in prod the bytes live in GCS and this dir never exists. It is
# machine-local runtime state, never source.
**/.media-local/

# Adobe Illustrator lock/scratch files — written while a .ai doc is open and
# regenerated automatically. They are ~duplicates of the .ai (multi-MB) and must
# never be versioned.
~ai-*.tmp

# Playwright/workbench auth-state saves (session tokens — never commit).
# `.playwright-cli/` is already ignored; this covers custom state-save paths.
wb-auth.json
*-auth.json
