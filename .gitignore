.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
.tsbuildinfo

# Misc
.cache/

# MCP / browser-automation scratch
.playwright-mcp/
postal-*.png

# Marketplace bundle-authoring scratch (docs/85 — regenerated on demand)
# NOTE: _gen/ is TRACKED — it's the authored SOURCE that emits the committed blueprint
# bundles (the generator a developer hand-edits), not scratch. _src/_assets are raw inputs.
marketplace-catalog/_src/
marketplace-catalog/_assets/
apps/dashboard/_marketplace-assets.mjs

# Local media storage (LocalStorage MEDIA_LOCAL_DIR — generated, never committed)
**/.media-tmp/

# Impeccable — local hook consent + session cache (regenerated; never committed).
# NOTE: the design spec apps/*/.impeccable/design.json IS tracked (pairs with DESIGN.md);
# only the machine-local *.local.json / *.cache.json scratch is ignored.
**/.impeccable/*.local.json
**/.impeccable/*.cache.json
