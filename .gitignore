# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/

# Test/coverage
coverage/
*.lcov
.vitest-cache/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Env
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
.tsbuildinfo

# Misc
.cache/

# MCP / browser-automation scratch
.playwright-mcp/
.playwright-cli/
postal-*.png

# Marketplace bundle-authoring scratch (docs/85 — regenerated on demand)
# NOTE: _gen/ is TRACKED — it's the authored SOURCE that emits the committed blueprint
# bundles (the generator a developer hand-edits), not scratch. _src/_assets are raw inputs.
marketplace-catalog/_src/
marketplace-catalog/_assets/
apps/dashboard/_marketplace-assets.mjs
# Template preview HTML + full-site screenshots — the visual-review artifacts a generator
# writes (writeTemplatePreview) and screenshot-template.mjs shoots. Regenerated on demand.
marketplace-catalog/_gen/.preview/

# Local media storage (LocalStorage MEDIA_LOCAL_DIR — generated, never committed)
**/.media-tmp/
**/raw videos/*
# Impeccable — local hook consent + session cache (regenerated; never committed).
# NOTE: the design spec apps/*/.impeccable/design.json IS tracked (pairs with DESIGN.md);
# only the machine-local *.local.json / *.cache.json scratch is ignored.
**/.impeccable/*.local.json
**/.impeccable/*.cache.json
# The live/ runtime dir (server port, sessions, annotations) is per-machine session state.
**/.impeccable/live/

# Local media storage — the LocalStorage driver's on-disk root (MEDIA_LOCAL_DIR) when
# api-rest runs in `local` mode. Real tenant uploads (originals + transcoded variants)
# land here at runtime; in prod the bytes live in GCS and this dir never exists. It is
# machine-local runtime state, never source.
**/.media-local/

# Adobe Illustrator lock/scratch files — written while a .ai doc is open and
# regenerated automatically. They are ~duplicates of the .ai (multi-MB) and must
# never be versioned.
~ai-*.tmp

# Playwright/workbench auth-state saves (session tokens — never commit).
# `.playwright-cli/` is already ignored; this covers custom state-save paths.
wb-auth.json
*-auth.json

# Local self-hosted deployment (k8s/local) — real credentials for the
# workstation stack. secrets.env is the filled-in copy of secrets.example.env
# (which IS committed, as the template); tunnel-credentials.json is the
# Cloudflare Tunnel secret written by `cloudflared tunnel create`.
k8s/local/secrets.env
k8s/local/tunnel-credentials.json

# Terraform. Never mattered before — terraform/envs/prod uses a GCS backend, so
# no state ever landed on disk. terraform/envs/azure now uses an azurerm backend,
# but a local `terraform.tfstate` still appears from the pre-migration runs, and
# state contains the generated Postgres admin password in plaintext. State is
# also not something to version: it is a lock-managed database, not source, and
# committing it is how two applies overwrite each other.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# A saved plan is a binary snapshot of one moment's diff, and it embeds the same
# secrets state does.
#
# All three patterns are needed. `tfplan` matches only that exact name and
# `*.tfplan` only that suffix, so the natural habit of naming a plan after what
# it does — `tfplan.ingress`, `tfplan.dns` — slipped through both and left a
# file containing the Postgres admin password sitting untracked but committable.
tfplan
tfplan.*
*.tfplan
# `terraform apply ... > apply.log` — Terraform writes the exit code nowhere else
# when its output is piped, so these get kept around during a long apply.
apply.log
crash.log
override.tf
override_*.tf
apps-workbench-reverted-*.patch
