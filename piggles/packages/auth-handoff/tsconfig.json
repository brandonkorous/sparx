{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // @wizeworks/auth-client-server reads `process.env`. Type roots are
    // per-compilation, so the dependency having @types/node does not help
    // here — without this, every consumer typechecks the dependency's source
    // with no node globals at all.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
