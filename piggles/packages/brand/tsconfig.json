{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // `react-jsx`, overriding the base's `preserve`.
    //
    // Under `preserve` TypeScript resolves JSX against the GLOBAL `JSX`
    // namespace, which only exists in a compilation that has pulled in
    // @types/react — in practice, one where some file writes
    // `import * as React from 'react'`. `sparx/packages/brand` (sparx) does exactly
    // that and typechecks; the marks here deliberately do not import React at
    // all, because nothing in them needs it at runtime.
    //
    // `react-jsx` resolves JSX types from `react/jsx-runtime` instead, so the
    // components typecheck on their own merits without a redundant import added
    // purely to satisfy the compiler. It is also the correct setting for React
    // 19 generally — the automatic runtime is what Next compiles these with.
    "jsx": "react-jsx",

    // `og.tsx` runs on the edge and reads fonts off disk (`node:fs`, `Buffer`,
    // `process`). Type roots are per-compilation, so a dependency having
    // @types/node does not help here — without this the package cannot be
    // typechecked on its own at all, which is how it went unchecked.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
