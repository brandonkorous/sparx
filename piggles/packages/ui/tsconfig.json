{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // `react-jsx`, overriding the base's `preserve` — same reason as
    // sparx/packages/brand: these components do not import React at runtime, and the
    // automatic runtime is what Next compiles them with anyway.
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}
