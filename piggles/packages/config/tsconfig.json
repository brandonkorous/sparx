{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Resolves @piggles/brand from source without requiring a build or an
    // install to have run. The workspace link is the real resolution path in an
    // app; this keeps `tsc -p` on this package self-contained.
    "paths": {
      "@piggles/brand": ["../brand/src/index.ts"]
    },

    // `notice.ts` and `product.ts` read `process.env`. Type roots are
    // per-compilation, so a consumer having @types/node does not help here —
    // without this the package cannot be typechecked on its own at all, which
    // is how it went unchecked while every consumer stayed green.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
