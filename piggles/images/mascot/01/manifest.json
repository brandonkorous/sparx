  "rules": {
    "defaultBackground": "transparent",
    "renderStyle": "soft polished 3D character illustration",
    "personality": ["warm", "capable", "friendly", "slightly mischievous", "never childish"],
    "body": "very round/chubby with short limbs and soft proportions",
    "ears": "large soft floppy ears",
    "eyes": "large warm dark-brown eyes with simple highlights",
    "snout": "rounded pink snout with two oval nostrils",
    "clothing": "none by default",
    "props": "only when the prop communicates the feature/context",
    "logoUse": "Piggles P mark may appear on owned objects such as laptop or mug, sparingly",
    "doNot": [
      "change Piggles into a skinny or long-limbed character",
      "add clothing unless a specific campaign requires it",
      "use farm/barn stereotypes",
      "turn every pose into a pig joke",
      "use an angry or threatening expression",
      "use props that compete with the actual UI message"
    ]
