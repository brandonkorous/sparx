auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true
link-workspace-packages=true

@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_TOKEN}


# silicaui is consumed from CSS via `@plugin "silicaui"` (and, later, `@source`).
# Turbopack resolves CSS @plugin/@source from the WORKSPACE ROOT, not the CSS
# file's package — so an app-level pnpm dep (symlinked only into the app's
# node_modules) isn't reachable and dev throws "Can't resolve 'silicaui'". A
# targeted public-hoist makes the silicaui family resolvable from the root while
# keeping shamefully-hoist off (surgical, like the default eslint/prettier hoists).
# NOT a silicaui defect — the package resolves fine via node/plain Tailwind; this
# is a pnpm-layout × Turbopack-resolution quirk, so the fix lives here in the
# consumer. Covers every app in the platform-wide silicaui migration.
public-hoist-pattern[]=silicaui*
