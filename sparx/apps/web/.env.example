# sparx/apps/web reads marketing-page content from the Sparx CMS at boot/render
# time. Defaults point at the local docker stack; sparx-prod values come
# from the sparx-app-env ConfigMap.

SPARX_API_REST_URL=http://localhost:3100
SPARX_MARKETING_TENANT_SLUG=sparx-marketing

# PostHog analytics — browser-side only (NEXT_PUBLIC_ prefix).
# Only initialises in production builds; localhost (`pnpm dev`) never sends events.
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
