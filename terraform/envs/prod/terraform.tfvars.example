project_id = "REPLACE_WITH_GCP_PROJECT_ID"
region     = "us-central1"
ops_email  = "ops@sparx.works"

# Cloudflare — leave disabled until domain transfers from GoDaddy complete.
# Token goes in terraform.tfvars (gitignored), NOT this .example file.
cloudflare_enabled    = false
cloudflare_api_token  = ""

# admin.wize.works Origin CA cert (origin-ca.tf). Flip to true AFTER adding
# Zone:SSL and Certificates:Edit to the cloudflare_api_token above — the cert is
# signed with that token (no separate/deprecated Origin CA Key).
cloudflare_origin_ca_enabled = false
