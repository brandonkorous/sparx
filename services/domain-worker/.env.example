# services/domain-worker local dev defaults. Real values for sparx-prod come
# from the sparx-app-env ConfigMap + sparx-app-secrets Secret synced from
# Google Secret Manager.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev so it idles on its
# listen port. Use the /internal/cron/renewal-check endpoint with curl to
# exercise the nightly cron logic locally.

NODE_ENV=development
LOG_LEVEL=debug
# Distinct local port — 8083 avoids conflict with other workers.
PORT=8083

DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Pub/Sub: when GCP_PROJECT_ID is unset the publisher logs to stdout.
# GCP_PROJECT_ID=

# Optional: SA email validated from the Pub/Sub OIDC token's `email` claim.
# Unset in dev (no OIDC verification). In prod: set to the Pub/Sub invoker SA.
# PUBSUB_INVOKER_SA=

# Cron endpoint guard. Required in prod; optional in dev.
# SPARX_INTERNAL_CRON_TOKEN=

# GoDaddy Reseller API — used to retry DNS configuration on domain.purchased
# events where the initial configureDNS call failed (dnsConfigured: false).
# OTE credentials for non-production; prod credentials for production.
# GODADDY_API_KEY_OTE=
# GODADDY_API_SECRET_OTE=
# GODADDY_API_KEY_PROD=
# GODADDY_API_SECRET_PROD=

# CNAME target that purchased domains should point at. Defaults to
# customers.sparx.zone. Override in dev to point at a local tunnel.
# SPARX_CNAME_TARGET=customers.sparx.zone

# Base URL used in renewal reminder email CTAs.
# SPARX_DASHBOARD_URL=https://app.sparx.works
