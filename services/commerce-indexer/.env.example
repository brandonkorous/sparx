# commerce-indexer local dev env. Cloud Run Pub/Sub push worker.
#
# In dev you usually DON'T run this — product writes still publish to the
# Pub/Sub stub (GCP_PROJECT_ID unset in api-rest), so nothing pushes here and
# it never connects to Typesense (ENSURE_SCHEMAS_ON_BOOT is false by default).
#
# Run it only when exercising the full index path against a local Typesense.

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Pub/Sub push OIDC invoker SA — leave unset in dev (no token check).
# PUBSUB_INVOKER_SA=

# Typesense — same engine the docker-compose service runs (pnpm db:up brings
# it up alongside Postgres). Point host at localhost for local runs. Set
# ENSURE_SCHEMAS_ON_BOOT=true on first run to create the collections.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_TIMEOUT_SECONDS=5
ENSURE_SCHEMAS_ON_BOOT=false
