{
  "name": "@sparx/event-worker",
  "version": "0.0.0",
  "private": true,
  "description": "The sparx event worker: one process running every broker subscription that does not need its own runtime. Twelve former worker services are libraries under packages/*-worker; media-worker and import-worker stay separate. See src/index.ts for why.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sparx/automation-worker": "workspace:*",
    "@sparx/channel-sync-worker": "workspace:*",
    "@sparx/commerce-indexer": "workspace:*",
    "@sparx/db": "workspace:*",
    "@sparx/domain-worker": "workspace:*",
    "@sparx/dropship-worker": "workspace:*",
    "@sparx/email-worker": "workspace:*",
    "@sparx/events": "workspace:*",
    "@sparx/inventory-worker": "workspace:*",
    "@sparx/legal-seed-worker": "workspace:*",
    "@sparx/markup-recompute-worker": "workspace:*",
    "@sparx/platform-crm-worker": "workspace:*",
    "@sparx/push-worker": "workspace:*",
    "@sparx/social-worker": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
