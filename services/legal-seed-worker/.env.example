# services/legal-seed-worker local dev defaults. Real values for sparx-prod come
# from Google Secret Manager (DATABASE_URL ← `database-url` secret), mounted by
# the cloud-run-worker Terraform module. Copy this file to `.env` to run locally.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev, so it idles on its
# listen port. Every tenant.created message writes legal pages to the DB, so
# DATABASE_URL is REQUIRED here (unlike email-worker) — a missing URL is a hard
# config error and the worker exits 78 at boot.

NODE_ENV=development
LOG_LEVEL=debug
# Distinct local port — workers default to 8080; 8080-8083 are taken by
# cache-revalidation (8080), email (8081), media (8082), and commerce-indexer
# (8083), so legal-seed-worker takes 8084 to avoid EADDRINUSE under `turbo dev`.
PORT=8084

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"
