# services/api-rest local dev defaults. Real values for sparx-prod come from
# the sparx-app-env ConfigMap + sparx-app-secrets Secret synced from
# Google Secret Manager (see k8s/apps/api-rest.example.yaml).

NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# Points at the same docker-compose Postgres the dashboard / @sparx/db use
# (packages/db/docker-compose.yml). RLS GUCs are set by withTenant() inside
# every tenant-scoped route handler.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Shared with the dashboard. Must be >=32 chars; rotate by rolling both
# services together. Dev value is fine for local; prod reads it from the
# sparx-internal-jwt-secret entry in Google Secret Manager.
SPARX_INTERNAL_JWT_SECRET="dev-only-internal-jwt-secret-change-me-32chars"

# Customer (Layer 2 shopper) Better Auth instance — runs INSIDE api-rest (docs/27
# v2), DISTINCT from the staff BETTER_AUTH_SECRET (in the dashboard). Isolation is
# mandatory: separate secret, cookie (sparx_customer_session), and customer_* tables.
# Prod reads customer-auth-secret from Google Secret Manager (sparx-app-secrets).
CUSTOMER_AUTH_SECRET="dev-only-customer-auth-secret-change-me-32chars"
# Base URL Better Auth builds absolute URLs from + drives the cookie Secure prefix
# (dev http = no prefix; prod https = __Secure- prefix). Prod = https api-rest origin.
CUSTOMER_AUTH_URL=http://localhost:3100
# Where /mcp/authorize redirects an unauthenticated shopper to sign in (the
# per-store login page is finalized in the storefront-MCP customer tier).
CUSTOMER_MCP_LOGIN_PAGE=/account/login

# Pub/Sub: when GCP_PROJECT_ID is unset the publisher logs to stdout
# instead of calling Google Cloud (default for local dev).
# GCP_PROJECT_ID=
PUBSUB_TOPIC=sparx.events

# Stripe (docs/92 integration map, docs/94 ADR payments). The platform sandbox
# account doubles as BOTH the Connect platform (sparx Pay destination charges) and
# the billing account (module subscriptions). Copy the keys from
# Dashboard → Developers → API keys (test mode); store in Secret Manager in prod.
#
#   STRIPE_SECRET_KEY  — platform/Connect account secret key (sk_test_... locally)
#   STRIPE_CLIENT_ID   — Connect OAuth client_id (ca_...) — Dashboard → Connect →
#                        Settings → enable OAuth (Standard). Powers the dashboard
#                        "Connect Stripe" onboarding (writes tenant.stripeAccountId).
#   STRIPE_PUBLISHABLE_KEY — informational here; the storefront actually reads it as
#                        NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in apps/site/.env.local.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_CLIENT_ID=ca_...
#
# Webhook signing secrets. For LOCAL dev, run one `stripe listen` per endpoint and
# paste the printed whsec — there is no dashboard endpoint pointing at localhost:
#   sparx Pay (commerce): stripe listen --forward-to localhost:3100/v1/public/webhooks/sparx-pay
#   platform billing:     stripe listen --forward-to localhost:3100/v1/public/webhooks/stripe/billing
# Until STRIPE_WEBHOOK_SECRET_SPARX_PAY is set, the sparx-pay webhook 200-acks
# without reconciling (the order still finalizes client-side on /complete; the
# webhook is the async source of truth for ACH/refunds/disputes).
# STRIPE_WEBHOOK_SECRET_SPARX_PAY=whsec_...
# STRIPE_WEBHOOK_SECRET_BILLING=whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # legacy pre-gateway commerce secret (unused)
#
# Platform billing price IDs — generated by the provisioner, paste its printed block:
#   STRIPE_SECRET_KEY=sk_test_... pnpm --filter @sparx/billing provision-stripe
# It prints STRIPE_PRICE_<MODULE>_MONTHLY/_ANNUAL (+ managed hosting) to set here.
# STRIPE_PRICE_COMMERCE_MONTHLY=price_...
# (…one MONTHLY + ANNUAL per module; see docs/92 §4)

# AES-256-GCM key (32 bytes, base64 or hex) encrypting bring-your-own gateway
# credentials AND channel OAuth tokens at rest (@sparx/channels/crypto, docs/111 §2
# / docs/106). REQUIRED to save any non-sparx-Pay gateway credentials in Finance →
# Payments (Square / Authorize.net / 1stPayGateway / custom / your-own-Stripe) —
# without it the save returns a clear "encryption key not configured" error. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates every stored gateway credential + channel grant (reconnect).
# CHANNELS_TOKEN_KEY=

# AES-256-GCM key (32 bytes, base64 or hex) encrypting tenant-pasted provider
# credentials at rest (@sparx/integration-framework/secret-crypto, docs/09 provider
# marketplace) — e.g. the Shippo API token a tenant pastes into Commerce → Providers
# → Install. REQUIRED to install any provider whose config has a secret field;
# without it the install returns a clear "encryption key not configured" error.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every stored provider secret (tenants reconnect).
# PROVIDER_SECRET_KEY=

# Google Search Console connector (docs/50 §7, docs/97 §4). Per-tenant OAuth: each
# tenant authorizes THEIR Search Console; a nightly job ingests organic metrics.
# INERT until all three are set — the SEO overview keeps showing representative
# data and the connect endpoints return "not configured".
#   GOOGLE_OAUTH_CLIENT_ID / _SECRET — a GCP OAuth 2.0 *Web* client (console.cloud
#     .google.com → APIs & Services → Credentials). Enable the "Search Console API"
#     on the project. Add the dashboard callback as an authorized redirect URI:
#     https://<dashboard-host>/seo/search-console/callback
#   SEARCH_CONSOLE_TOKEN_KEY — a 32-byte AES-256-GCM key (base64 or hex) encrypting
#     the stored OAuth tokens at rest. Generate: `openssl rand -base64 32`. Rotating
#     it invalidates every stored grant (tenants re-authorize). Prod: Secret Manager.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SEARCH_CONSOLE_TOKEN_KEY=

# ─── Social posting (docs/133, docs/134) ────────────────────────────────────────
# Publishes native posts to a tenant's connected accounts. Every platform is gated at
# runtime by THREE things (GET /v1/social reports it `coming_soon` until all hold):
#   1. SOCIAL_TOKEN_KEY is set (below) — REQUIRED before ANY platform can connect;
#      without it the whole connect flow is off and every card reads coming_soon.
#   2. the platform's adapter is registered (always true — shipped in code), and
#   3. the platform's OAuth app id + secret are set (the pairs below).
# So the fastest path to a live connection is SOCIAL_TOKEN_KEY + ONE platform's pair,
# then restart api-rest. A platform lights up the instant its pair lands — no code
# change. Prod stores every value in Google Secret Manager → sparx-app-secrets.
#
# The AES-256-GCM key encrypting stored OAuth grants on social_connections at rest.
# DEDICATED (separate from CHANNELS_TOKEN_KEY / SEARCH_CONSOLE_TOKEN_KEY) for blast-
# radius isolation. Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Rotating it makes every stored grant undecryptable (tenants reconnect).
# SOCIAL_TOKEN_KEY=
#
# ── Phase 1 (lightest approval) ──
# Google Business Profile REUSES the GOOGLE_OAUTH_CLIENT_ID/_SECRET pair above (scope
# business.manage) — no separate app. YouTube (Shorts uploader) also reuses it (scopes
# youtube.upload + youtube.readonly). So once GOOGLE_OAUTH_* + SOCIAL_TOKEN_KEY are set,
# BOTH Google Business and YouTube become connectable.
#
# LinkedIn organization posts. Create an app at linkedin.com/developers (products:
# "Share on LinkedIn" + "Advertising API" for org access). Redirect URI:
# https://<dashboard-host>/social/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# ── Phase 2 (Meta — ONE app, three surfaces; needs App Review + Business verification) ──
# Facebook Pages + Instagram share one Meta app (developers.facebook.com). Add the use
# cases "Manage everything on your Page" + "Manage messaging & content on Instagram".
# Advanced Access (to serve live tenants) requires a demo screencast per permission.
# META_APP_ID=
# META_APP_SECRET=
# Threads rides the SAME Meta app + verification but has its own app credentials +
# host (graph.threads.net). Add the "Access the Threads API" use case.
# THREADS_APP_ID=
# THREADS_APP_SECRET=
#
# ── Phase 3 (platform tail; each is its own app + content-API approval) ──
# Pinterest (developers.pinterest.com) — Pins on boards. Scopes boards:read,pins:write.
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# TikTok (developers.tiktok.com) — Content Posting API (Direct Post). The app must be
# audited to post publicly, and the media CDN domain URL-ownership-verified (PULL_FROM_URL).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# X (Twitter) is INTENTIONALLY not shipped — its posting API is paid-tier (~$200/mo).
# No adapter exists until the paid tier is committed; the card stays coming_soon.

# Outbound-webhook signing secrets at rest (docs/12 CMS webhooks). A 32-byte
# AES-256-GCM key (base64 or hex) that encrypts webhook_subscriptions.signing_secret
# so a DB leak can't hand out live HMAC keys. Generate: `openssl rand -base64 32`.
# When unset the secret is stored plaintext (dev/test only) — PRODUCTION MUST SET
# IT (Secret Manager). Rotating it makes existing encrypted secrets undecryptable
# (subscriptions must be recreated).
# WEBHOOK_SIGNING_SECRET_KEY=

# Active domain registrar. The registrar is abstracted behind @sparx/registrar's
# RegistrarClient contract; this picks the provider. 'godaddy' (default) or
# 'namecom' once the @sparx/namecom client is wired. Leave unset for GoDaddy.
# REGISTRAR=godaddy

# GoDaddy Reseller API (docs/24 §3, docs/24 §10). Get keys from developer.godaddy.com
# (each key is tagged Test/OTE or Production at creation; copy the Key AND Secret
# from the same screen — the secret is shown once). Both pairs live in Google Secret
# Manager in prod (sparx-app-secrets).
#
# Which pair is used follows NODE_ENV by default (production -> *_PROD, else *_OTE),
# but GODADDY_ENV overrides it. GoDaddy's OTE sandbox is chronically degraded (blanket
# 500s), so for LOCAL testing point at the FREE production read endpoints
# (available/suggest cost nothing; only purchase charges):
#   GODADDY_ENV=prod
#   GODADDY_API_KEY_PROD=...
#   GODADDY_API_SECRET_PROD=...
# GODADDY_ENV=
# GODADDY_API_KEY_OTE=
# GODADDY_API_SECRET_OTE=
# GODADDY_API_KEY_PROD=
# GODADDY_API_SECRET_PROD=
#
# Domain-checkout kill-switch. Buying/renewing a domain is a real, non-refundable
# charge to the reseller account, so it's OFF until tenant billing (Stripe
# card-on-file) is wired and we can charge the tenant BEFORE registering. Leave
# unset/false to keep checkout closed (purchase + renew return 403; the dashboard
# shows "checkout opens soon"). Free *.sparx.zone addresses and connecting an owned
# domain are unaffected. Only the literal "true"/"1" enables it.
# DOMAIN_PURCHASE_ENABLED=false

# Typesense — powers the /v1/search/* read path. Defaults match the
# docker-compose service in packages/db/docker-compose.yml (pnpm db:up). In
# prod the host is the in-cluster `typesense` Service and the key comes from
# Secret Manager (see k8s/apps/api-rest.yaml). @sparx/search reads these.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key

# Dev-only: forward standalone-worker events (dropship/email/media/...) to local
# worker HTTP push endpoints so they run without Pub/Sub. JSON array of {url,events}.
# Leave unset to log-and-no-op (default). Example for the dropship-worker:
# SPARX_DEV_WORKER_ROUTES=[{"url":"http://localhost:8089","events":["dropship.supplier.sync_started","dropship.order.route","order.placed"]}]
