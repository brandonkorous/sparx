{
  "name": "@sparx/automation-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Automation engine runtime (docs/81, docs/84 Slice D). Cloud Scheduler tick → runScheduleTick + runAutomationTick; Pub/Sub push (automation.trigger) → handleTrigger. Runs as sparx_app; cross-tenant discovery via SECURITY DEFINER helpers.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sparx/automation": "workspace:*",
    "@sparx/db": "workspace:*",
    "@sparx/events": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
