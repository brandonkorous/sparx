# services/platform-crm-worker local dev defaults. Real values for sparx-prod
# come from Google Secret Manager (DATABASE_URL ← `database-url-cloudrun`),
# mounted by the cloud-run-worker Terraform module. Copy this file to `.env` to
# run locally.
#
# Pub/Sub-push consumer. To exercise it locally, point the publishers at this
# port via SPARX_DEV_WORKER_ROUTES — in BOTH api-rest's env (module + billing
# events) and the workbench's (tenant.created is published from the signup
# action there):
#
#   SPARX_DEV_WORKER_ROUTES=[{"url":"http://localhost:8093","events":["tenant.created","tenant.updated","tenant.subscription.changed","module.activated","module.deactivated"]}]
#
# Every message reads a tenant and writes CRM rows, so DATABASE_URL is REQUIRED
# — a missing URL is a hard config error and the worker exits 78 at boot.

NODE_ENV=development
LOG_LEVEL=debug
# Distinct local port — 8080-8092 are taken by the other workers (see each
# service's .env.example), so platform-crm-worker takes 8093 to avoid EADDRINUSE
# under `turbo dev`.
PORT=8093

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# WHERE the mirror writes: sparx's own tenant-of-record. The dev seed creates the
# `wizeworks` tenant, so the slug is enough locally; prod sets the immutable
# SPARX_PLATFORM_TENANT_ID instead. With NEITHER set the worker exits 78 rather
# than silently skipping every signup.
SPARX_PLATFORM_TENANT_SLUG=wizeworks
