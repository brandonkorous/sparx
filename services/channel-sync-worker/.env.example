# services/channel-sync-worker local dev defaults. Real values for the cluster come
# from the shared sparx-app-env ConfigMap + sparx-app-secrets Secret (k8s/self-hosted/
# workers.yaml). Copy this file to `.env` to run locally.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev, so it idles on its listen
# port. DATABASE_URL is OPTIONAL (the worker boots without it) but every sync handler
# reads the tenant's catalog through `withTenant`, so the dev URL is included below.

NODE_ENV=development
LOG_LEVEL=debug
# Workers default to 8080 — which is cache-revalidation-worker's port. Without this
# file channel-sync-worker took that default and lost the bind under `turbo dev`
# (EADDRINUSE), so it takes 8094: 8080-8092 are the other workers and 8093 is
# platform-crm-worker (see each service's .env.example).
PORT=8094

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Unset locally → Pub/Sub publisher is the dev stub; OIDC caller check is off.
# GCP_PROJECT_ID=
# PUBSUB_INVOKER_SA=

# AES-256-GCM key decrypting per-tenant channel OAuth tokens on channel_connections.
# MUST match api-rest's CHANNELS_TOKEN_KEY. Unset → decryption throws and pushes are
# skipped with a recorded error, which is the dev default (no channels connected).
# CHANNELS_TOKEN_KEY=

# Storefront base for the product landing URL every feed requires ({slug} placeholder).
# Unset → products are skipped, because there is no absolute URL to feed.
# SPARX_SITE_BASE="https://{slug}.sparx.zone"

# Public media resolution for feed image URLs — one of a CDN or a public bucket.
# SPARX_MEDIA_CDN_URL=
# GCS_MEDIA_PUBLIC_BUCKET=
# GCS_MEDIA_BUCKET=

# Per-channel app credentials. Each is the PLATFORM's approved app, not a tenant's —
# unset means a connected shop on that channel records a sync error instead of pushing,
# which is the dev default. Set them only when exercising a real channel locally.
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# ETSY_API_KEY=
# ETSY_API_SECRET=
# WALMART_CLIENT_ID=
# WALMART_CLIENT_SECRET=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# FAIRE_CLIENT_ID=
# FAIRE_CLIENT_SECRET=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_MARKETPLACE_ID=
# AMAZON_REGION=
