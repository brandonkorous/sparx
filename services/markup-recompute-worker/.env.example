# services/markup-recompute-worker local dev defaults. Real values for sparx-prod
# come from Google Secret Manager (DATABASE_URL ← `database-url` secret), mounted
# by the cloud-run-worker Terraform module. Copy this file to `.env` to run locally.
#
# Pub/Sub-push consumer: nothing pushes to it in local dev, so it idles on its
# listen port. DATABASE_URL is OPTIONAL (the worker boots without it) but is
# needed for it to actually recompute markup, so the dev URL is included below.

NODE_ENV=development
LOG_LEVEL=debug
# Workers default to 8080; 8080-8089 are taken by other workers, so
# markup-recompute-worker takes 8090 to avoid EADDRINUSE under `turbo dev`.
PORT=8090

# Same docker-compose Postgres the rest of the stack uses.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"

# Unset locally → Pub/Sub publisher is the dev stub; OIDC caller check is off.
# GCP_PROJECT_ID=
# PUBSUB_INVOKER_SA=
