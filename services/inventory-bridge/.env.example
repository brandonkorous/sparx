# services/inventory-bridge — the Tier A ON-PREM agent's config template.
#
# UNLIKE every other file in services/, this is not a sparx deployment's env: it is
# the file the installer drops next to the binary on the TENANT'S machine, inside
# their network. Copy it to `.env` there (or pass the same variables through
# `docker run --env-file`). The bridge has no `dev` script and is not part of
# `pnpm dev` — see README.md § Run.
#
# The three required values come from the dashboard, not from this file's defaults:
# Inventory -> Sources -> create a source of type "On-prem bridge agent", open it,
# and click "Pair agent". The key is shown ONCE. A bad or missing value exits 78 at
# boot with a readable message rather than failing mid-loop.

# -- sparx connection (all required) --
# The API origin the agent pushes to.
SPARX_BASE_URL="https://api.sparx.works"
# The source's UUID, from its connection page.
SPARX_SOURCE_ID=""
# The `sk_live_…` key from "Pair agent", scoped to `inventory:push`.
SPARX_API_KEY=""

# -- what to read --
# `file` is the universal path and works for every on-prem system: point the ERP's
# scheduled export at a folder. `fishbowl` is not finalized (README § Fishbowl).
BRIDGE_READER=file
# Required when BRIDGE_READER=file. The ERP's exported snapshot.
BRIDGE_FILE_PATH="C:/sparx/exports/on-hand.csv"
# `csv` | `json`. Columns: sku, quantity (aliases qty/on_hand), optional location.
BRIDGE_FILE_FORMAT=csv

# -- cadence (optional; defaults shown) --
# Every push is a FULL on-hand snapshot, so this is how stale sparx's stock can be.
# SYNC_INTERVAL_SEC=300      # 30-86400
# HEARTBEAT_INTERVAL_SEC=60  # 15-3600; drives the online/offline dot in the dashboard
# REQUEST_TIMEOUT_MS=30000   # 1000-120000
# MAX_RETRIES=3              # 0-10, exponential backoff capped at 30s
