{
  "name": "@sparx/inventory-worker",
  "version": "0.0.0",
  "private": true,
  "description": "sparx inventory sync worker. Handles inventory source sync (CSV + API) via Pub/Sub push (Cloud Run). docs/64 Inv Ph2.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@sparx/db": "workspace:*",
    "@sparx/events": "workspace:*",
    "@sparx/inventory": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
