{
  "name": "sparx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "sparx — WizeWorks' modular content and commerce operating system.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs || exit 0",
    "postinstall": "pnpm --filter @sparx/db db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "dev:kill": "node scripts/kill-dev-ports.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:up": "pnpm --filter @sparx/db db:up",
    "db:down": "pnpm --filter @sparx/db db:down",
    "db:migrate": "pnpm --filter @sparx/db db:migrate",
    "db:seed": "pnpm --filter @sparx/db db:seed",
    "db:studio": "pnpm --filter @sparx/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "//": "LOCAL-ONLY silicaui link overrides — DO NOT COMMIT. Points the whole silicaui family at the local checkout (G:\\code\\@wizeworks\\silicaui) for builder-migration testing. Remove this entire `overrides` block and re-run `pnpm install` before pushing/releasing so the lockfile snaps back to registry versions.",
    "overrides": {
      "silicaui": "link:../silicaui/packages/silicaui",
      "silicaui-react": "link:../silicaui/packages/silicaui-react",
      "silicaui-builder": "link:../silicaui/packages/silicaui-builder",
      "silicaui-editor": "link:../silicaui/packages/silicaui-editor",
      "silicaui-dnd": "link:../silicaui/packages/silicaui-dnd",
      "silicaui-panels": "link:../silicaui/packages/silicaui-panels",
      "silicaui-behaviors": "link:../silicaui/packages/silicaui-behaviors",
      "silicaui-charts": "link:../silicaui/packages/silicaui-charts",
      "silicaui-html": "link:../silicaui/packages/silicaui-html",
      "silicaui-mcp": "link:../silicaui/packages/silicaui-mcp",
      "silicaui-table": "link:../silicaui/packages/silicaui-table"
    }
  }
}
