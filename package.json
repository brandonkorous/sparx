{
  "name": "sparx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "sparx — WizeWorks' modular content and commerce operating system.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "node --input-type=commonjs -e \"const f='scripts/setup-hooks.mjs';require('fs').existsSync(f)&&require('child_process').execSync('node '+f,{stdio:'inherit'})\"",
    "postinstall": "pnpm --filter @wizeworks/db db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "dev:kill": "node scripts/kill-dev-ports.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:brand": "node scripts/check-platform-brand.mjs",
    "check:events": "node scripts/check-event-topics.mjs",
    "check:worker-events": "node scripts/check-worker-events.mjs",
    "check:routes": "node scripts/check-surface-routes.mjs",
    "check:module-graph": "node scripts/check-module-graph.mjs",
    "check:notify-entities": "node scripts/check-notification-entities.mjs",
    "check:docker": "node scripts/check-dockerfile-deps.mjs",
    "check:service-env": "node scripts/check-service-env.mjs",
    "check:brand-wordmark": "node scripts/check-brand-wordmark.mjs",
    "check:docker-paths": "node scripts/check-dockerfile-paths.mjs",
    "check:piggles-nav": "node piggles/scripts/check-nav-vocabulary.mjs",
    "check:screen-names": "node piggles/scripts/check-screen-names.mjs",
    "check:screen-name-collisions": "node piggles/scripts/check-screen-name-collisions.mjs",
    "check:toolbar-names": "node piggles/scripts/check-toolbar-names.mjs",
    "check:copy-key-sentences": "node piggles/scripts/check-copy-key-sentences.mjs",
    "check:piggles-plain-words": "node piggles/scripts/check-plain-words.mjs",
    "check:app-count": "node piggles/scripts/check-app-count.mjs",
    "check:em-dashes": "node piggles/scripts/check-em-dashes.mjs",
    "check:colors": "node scripts/check-color-names.mjs",
    "check:shadowed": "node scripts/check-shadowed-relations.mjs",
    "check:confirm": "node scripts/check-destructive-confirm.mjs",
    "check:workflow-exit": "node scripts/check-workflow-exit.mjs",
    "check:field-names": "node scripts/check-field-names.mjs",
    "check:broker-topics": "node scripts/check-broker-topics.mjs",
    "check:price-offers": "node scripts/check-price-offers.mjs",
    "check:toolbars": "node scripts/check-toolbar-primary.mjs",
    "check:toolbar-glyph": "node scripts/check-toolbar-glyph.mjs",
    "check:select-name-width": "node scripts/check-select-name-width.mjs",
    "check:country-picker": "node scripts/check-country-picker.mjs",
    "check:currency-picker": "node scripts/check-currency-picker.mjs",
    "check:scroll-squash": "node scripts/check-scroll-squash.mjs",
    "check:load-error-reason": "node scripts/check-load-error-reason.mjs",
    "check:piggles-theme": "node piggles/scripts/check-theme-opacity.mjs",
    "check:piggles-apps": "node piggles/scripts/check-apps.mjs",
    "provision:piggles-stripe": "node piggles/scripts/provision-stripe.mjs",
    "check:webhooks": "node scripts/check-webhook-events.mjs",
    "check:billing-plans": "node scripts/check-billing-plans.mjs",
    "check:inventory-api": "node scripts/check-inventory-api-docs.mjs",
    "check:migration-order": "node scripts/check-migration-order.mjs",
    "check:migration-drops": "node scripts/check-migration-drops.mjs",
    "check:prisma-selects": "node scripts/check-prisma-selects.mjs",
    "check:cancelled-in-sql": "node scripts/check-cancelled-in-sql.mjs",
    "check:nullable-inputs": "node scripts/check-nullable-inputs.mjs",
    "check:platform-seed": "node scripts/check-platform-seed.mjs",
    "check:exposed-headers": "node scripts/check-exposed-headers.mjs",
    "check:blueprint-versions": "node scripts/check-blueprint-versions.mjs",
    "check:blueprint-journal": "node scripts/check-blueprint-journal.mjs",
    "gen:inventory-api": "node scripts/gen-inventory-api-reference.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:up": "pnpm --filter @wizeworks/db db:up",
    "db:down": "pnpm --filter @wizeworks/db db:down",
    "db:migrate": "pnpm --filter @wizeworks/db db:migrate",
    "db:seed": "pnpm --filter @wizeworks/db db:seed",
    "db:studio": "pnpm --filter @wizeworks/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:console-parity": "node scripts/check-console-parity.mjs",
    "check:column-floor": "node scripts/check-column-floor.mjs",
    "check:pane-load": "node scripts/check-pane-load.mjs",
    "check:host-cores": "node scripts/check-host-cores.mjs",
    "check:saved-view-targets": "node scripts/check-saved-view-targets.mjs",
    "check:date-conversions": "node scripts/check-date-conversions.mjs",
    "check:day-boxes": "node scripts/check-day-boxes.mjs",
    "check:silica-colors": "node scripts/check-silica-color-utilities.mjs",
    "check:search-entities": "node scripts/check-search-entities.mjs",
    "check:action-labels": "node scripts/check-action-labels.mjs",
    "check:counted-in-words": "node scripts/check-counted-in-words.mjs",
    "check:automation-health": "node scripts/check-automation-health.mjs",
    "check:count-ink": "node scripts/check-count-ink.mjs",
    "check:counts-known": "node scripts/check-counts-before-known.mjs",
    "check:app-names": "node scripts/check-app-names.mjs",
    "check:orphan-surfaces": "node scripts/check-orphan-surfaces.mjs",
    "check:api-hrefs": "node scripts/check-api-hrefs.mjs",
    "check:open-targets": "node scripts/check-open-targets.mjs",
    "check:cms-routes": "node scripts/check-cms-routes.mjs",
    "check:sellable-terms": "node scripts/check-sellable-terms.mjs",
    "check:running-meta": "node scripts/check-running-meta.mjs",
    "check:calendar-dates": "node scripts/check-calendar-dates.mjs",
    "check:american-spelling": "node scripts/check-american-spelling.mjs",
    "check:deletability": "node scripts/check-deletability.mjs",
    "check:deletability:build": "node scripts/check-deletability.mjs --build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
