# Sparx Dashboard — local dev environment.
#
# Copy to .env to run `pnpm --filter @sparx/dashboard dev` end-to-end against
# the local Postgres started by `pnpm --filter @sparx/db db:up`.

# Database — must match packages/db/.env (the dashboard uses the same Prisma
# client). Use sparx_app (runtime, FORCE RLS) for the application connection.
DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"
# Auth service connects as sparx_owner so it can read users/sessions/accounts
# before a tenant context is established. See docs/16-auth-security.md §4 and
# packages/db/prisma/migrations/20260527162200_auth_tables_no_force_rls.
AUTH_DATABASE_URL="postgresql://sparx_owner:devpassword@localhost:5544/sparx?schema=public"

# Better Auth — secret for token signing + session cookie URL.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-me-in-each-environment"
BETTER_AUTH_URL="http://localhost:3001"

# Google OAuth (Better Auth social provider) — optional in dev. The "Continue
# with Google" button only renders/works when BOTH are set; otherwise the
# provider stays inert (@sparx/auth server.ts registers it conditionally).
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console and
# add the redirect URI ${BETTER_AUTH_URL}/api/auth/callback/google
# (locally: http://localhost:3001/api/auth/callback/google).
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"

# api-rest internal endpoint + shared JWT secret. Must match the values in
# services/api-rest/.env. The dashboard signs short-lived (5 min) HS256 JWTs
# from the staff session and forwards them as Authorization: Bearer <jwt>.
SPARX_API_REST_URL="http://localhost:3100"
SPARX_INTERNAL_JWT_SECRET="dev-only-internal-jwt-secret-change-me-32chars"

# Public base URL for this dashboard app — used to build absolute callback URLs
# (e.g. Stripe Connect OAuth redirect_uri). In dev defaults to localhost:3001;
# in prod set to https://app.sparx.works (or your custom dashboard domain).
# NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# PostHog analytics — browser-side only (NEXT_PUBLIC_ prefix).
# Only initialises in production builds; localhost (`pnpm dev`) never sends events.
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
