# Copy to .env for local development.
#
# Most values match apps/dashboard/.env — the workbench talks to the same
# database, the same Better Auth tables, and the same api-rest. The two that
# MUST differ are called out below.

DATABASE_URL="postgresql://sparx_app:devpassword@localhost:5544/sparx?schema=public"
AUTH_DATABASE_URL="postgresql://sparx_owner:devpassword@localhost:5544/sparx?schema=public"

# Must be the SAME secret as the dashboard — both apps read and write the same
# Better Auth session tables, so a differing secret makes sessions unverifiable.
BETTER_AUTH_SECRET="ZTtjC/n97adyGwtmyjGqgiGcJ2EQVziS+fHGkxX7V2U="

# MUST point at THIS app, not the dashboard. Better Auth derives its trusted
# origin from this value and answers 403 FORBIDDEN to a sign-in posted from any
# other origin — which looks exactly like a wrong password, because the UI
# deliberately refuses to distinguish auth failures.
BETTER_AUTH_URL="http://localhost:3011"

# api-rest. NEXT_PUBLIC_API_URL is the origin the BROWSER calls directly with
# the bearer token from /api/token, so it must be reachable from the browser —
# not an in-cluster service address.
SPARX_API_REST_URL="http://localhost:3100"
NEXT_PUBLIC_API_URL="http://localhost:3100"

# Must match api-rest's own secret — this app mints the short-lived internal
# JWTs that api-rest verifies.
SPARX_INTERNAL_JWT_SECRET="dev-only-internal-jwt-secret-change-me-32chars"

# PostHog product analytics — browser-side only (NEXT_PUBLIC_ prefix).
# Only initialises in production builds; localhost (`pnpm dev`) never sends
# events, so these can stay as-is for local work.
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
